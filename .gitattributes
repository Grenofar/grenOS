# Auto detect text files and perform LF normalization
* text=auto

# Les fichiers qui partent dans une image Linux gardent des fins de ligne LF :
# un script shell en CRLF ne demarre pas.
linux/** text eol=lf
*.sh text eol=lf
kernel/scripts/* text eol=lf

# Les images restent binaires, meme sous linux/ : la regle « text eol=lf »
# ci-dessus convertirait leurs octets 0x0D 0x0A et casserait le fichier.
linux/**/*.png binary
linux/**/*.ico binary
linux/**/*.jpg binary
linux/**/*.wav binary
linux/**/*.ttf binary
linux/**/*.otf binary
linux/**/*.woff2 binary
# Les cles de depot au format binaire (NVIDIA, 20 novembre) : une conversion
# de fins de ligne en changerait les octets, et apt refuserait le depot.
linux/**/*.gpg binary
