{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Créateur de clé grenOS",
  "version": "1.0.0",
  "identifier": "fr.grenos.createur",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Créateur de clé grenOS",
        "width": 800,
        "height": 660,
        "minWidth": 640,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#05060a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
