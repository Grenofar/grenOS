#!/bin/sh
# La description de l'image grenOS, lue par live-build (lb config).
#
# Debian trixie, bureau grenOS (openbox + grenos-shell), session live en français avec clavier
# AZERTY, et l'installateur Calamares pour poser le système sur le disque.
# Tout ce qui fait grenOS — thème, fond d'écran, réglages, accueil — est
# ajouté par config/includes.chroot et config/hooks.

set -e

# K3 — CONSTRUCTIONS REPRODUCTIBLES (18 novembre). Deux constructions du même
# commit doivent donner la même image, à l'octet près. La première condition
# est d'avoir les MÊMES paquets : deb.debian.org change tous les jours, donc
# on lit Debian figé à une date, sur snapshot.debian.org. La date est écrite
# dans `linux/debian-instantane` : la changer est un commit, donc une décision
# qu'on voit passer — pas une dérive silencieuse.
#
# Le système INSTALLÉ, lui, garde deb.debian.org et security.debian.org
# (`--mirror-binary`) : figer la machine de quelqu'un à une date le priverait
# des correctifs de sécurité.
#
# Seulement quand GRENOS_INSTANTANE est donné (build.sh le lit dans le
# fichier quand REPRODUCTIBLE=1) : snapshot est lent, et la construction de
# tous les jours n'en dépend pas tant que la preuve n'est pas verte.
if [ -n "${GRENOS_INSTANTANE:-}" ]; then
    S="http://snapshot.debian.org/archive"
    D="$S/debian/$GRENOS_INSTANTANE/"
    SEC="$S/debian-security/$GRENOS_INSTANTANE/"
    set -- \
        --mirror-bootstrap "$D" --parent-mirror-bootstrap "$D" \
        --mirror-chroot "$D" --parent-mirror-chroot "$D" \
        --mirror-chroot-security "$SEC" --parent-mirror-chroot-security "$SEC" \
        --mirror-binary "http://deb.debian.org/debian/" --parent-mirror-binary "http://deb.debian.org/debian/" \
        --mirror-binary-security "http://security.debian.org/debian-security/" \
        --parent-mirror-binary-security "http://security.debian.org/debian-security/" \
        --apt-options "--yes --allow-downgrades -o Acquire::Check-Valid-Until=false" \
        "$@"
fi

lb config noauto \
    --distribution trixie \
    --backports true \
    --archive-areas "main contrib non-free non-free-firmware" \
    --architectures amd64 \
    --linux-flavours amd64 \
    --binary-images iso-hybrid \
    --debian-installer none \
    --apt-indices false \
    --apt-source-archives false \
    --memtest none \
    --win32-loader false \
    --iso-application "grenOS" \
    --iso-publisher "grenOS; https://grenos-dev.vercel.app" \
    --iso-volume "grenOS" \
    --image-name "grenos" \
    --compression xz \
    --chroot-squashfs-compression-type zstd \
    --chroot-squashfs-compression-level 19 \
    --apt-recommends false \
    --apt-options "--yes --allow-downgrades" \
    --bootappend-live "boot=live components locales=fr_FR.UTF-8 keyboard-layouts=fr keyboard-model=pc105 timezone=Europe/Paris username=grenos user-fullname=grenOS hostname=grenos persistence persistence-encryption=none quiet splash loglevel=3 udev.log_level=3 rd.systemd.show_status=false systemd.show_status=false vt.global_cursor_default=0 console=tty1 rd.udev.log_level=3 noprompt noeject" \
    "${@}"
