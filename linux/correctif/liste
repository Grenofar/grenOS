# Ce que porte grenos-correctif.squashfs, la couche posée PAR-DESSUS l'image
# d'une clé déjà faite (voir fabriquer.sh). Chemins relatifs à
# linux/config/includes.chroot : ce sont LES MÊMES fichiers que la prochaine
# construction complète, jamais une copie à part qui divergerait.
#
#   fichier <chemin>
#   lien <chemin du lien> <cible>
#   paquet <paquet Debian trixie> <chemin dans le paquet>
#     (un fichier d'un paquet ajouté à package-lists, absent de l'image publiée)
#   seul <chemin>
#     (un fichier propre au correctif, pris dans linux/correctif/seul)
#
# 21 novembre, midi — base : linux-20261121-0935 (qui contient déjà tout le
# correctif précédent : installateur, écrans, son, filet de l'écran). Ce
# correctif n'apporte que ce qui a changé depuis.

# Sur l'image du firmware, lightdm attendait sans fin après l'assistant
# (écran noir) : logind ne comptait pas /dev/fb0 comme un écran.
fichier etc/udev/rules.d/72-grenos-image-firmware.rules

# Le curseur dans l'assistant : le thème du bureau, et une flèche sur le fond.
fichier usr/bin/grenos-premier-lanceur

# 21 novembre, après-midi — l'installation (quatre échecs chez Grenofar) :
# la clé cachée à l'installateur, et la pose de GRUB avec shim au chemin de
# secours, jamais sur la partition EFI de Windows.
fichier usr/bin/grenos-installer
fichier usr/lib/grenos/grenos-cle-masquee
fichier etc/systemd/system/grenos-cle-masquee.service
fichier usr/lib/grenos/grenos-grub-install
fichier usr/share/grenos/bootloader.conf

# 22 novembre — le compte à mot de passe reste listé à l'écran de connexion
# (le moteur de l'installation appelle ce script dans le disque installé).
fichier usr/lib/grenos/grenos-compte

# 22 novembre au soir — le disque installé de Grenofar : lobby recouvert,
# bureau jamais ouvert au démarrage suivant, « debian » au BIOS, menu ; et
# le lobby seulement sur le grenOS installé.
fichier usr/lib/grenos/grenos-ecran-libre
fichier etc/systemd/system/lightdm.service.d/20-grenos-ecran-libre.conf
fichier usr/bin/grenos-premier-x
fichier usr/lib/grenos/grenos-demarrage
fichier etc/systemd/system/grenos-demarrage.service
lien etc/systemd/system/multi-user.target.wants/grenos-demarrage.service /etc/systemd/system/grenos-demarrage.service
fichier etc/systemd/system/grenos-redemarrer-windows.service
fichier usr/lib/grenos/grenos-revenir-ici
fichier usr/lib/grenos/grenos-recuperation
fichier usr/lib/grenos/appliquer-systeme
fichier etc/default/grub.d/grenos.cfg
fichier etc/grub.d/06_grenos_discret

# L'installateur recopie aussi ce correctif (fichier propre au correctif,
# dans linux/correctif/seul : il n'a pas de sens dans l'image complète).
seul etc/calamares/modules/unpackfs.conf
