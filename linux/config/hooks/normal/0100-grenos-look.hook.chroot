#!/bin/sh
# Ce qui fait que l'image ressemble à grenOS, et pas à une Debian nue.
#
# Tout ce qui se voit est écrit ici ou dans config/includes.chroot : le nom du
# système, le fond d'écran, la session, l'écran de chargement, les entrées de
# menu, l'installateur. Aucune configuration d'un bureau tiers : depuis le
# 18 septembre 2026, le bureau de grenOS est `grenos-shell`, écrit dans ce
# dépôt et posé sur openbox — Plasma composait l'écran par le GPU, et sans
# accélération 3D la souris tombait à trois images par seconde.
#
# Piège déjà payé : avec `set -e`, une commande qui finit en erreur à la fin
# d'une boucle fait sortir tout le hook, et le thème disparaît sans qu'aucune
# étape ne rougisse. D'où les `|| true` et les `rm -f` sans test.

set -e

VERSION="1.0"

echo "--- grenOS : identite du systeme ---"

cat > /etc/os-release <<EOF
PRETTY_NAME="grenOS ${VERSION}"
NAME="grenOS"
VERSION_ID="${VERSION}"
VERSION="${VERSION}"
ID=grenos
ID_LIKE=debian
HOME_URL="https://grenos-dev.vercel.app"
SUPPORT_URL="https://grenos-dev.vercel.app"
BUG_REPORT_URL="https://github.com/Grenofar/grenOS/issues"
EOF

cat > /etc/lsb-release <<EOF
DISTRIB_ID=grenOS
DISTRIB_RELEASE=${VERSION}
DISTRIB_CODENAME=grenos
DISTRIB_DESCRIPTION="grenOS ${VERSION}"
EOF

printf 'grenOS %s\n\n' "${VERSION}" > /etc/issue
cp /etc/issue /etc/issue.net

echo "--- grenOS : la session ---"

# Le thème de départ, hérité par tout compte créé ensuite — y compris celui de
# l'installation sur disque. Le bureau n'est pas vide : ce qu'on y pose reste,
# et ce qui s'y trouve se déplace à la souris.
mkdir -p /etc/skel/.config/grenos /etc/skel/Bureau /etc/skel/Documents \
         /etc/skel/Images /etc/skel/Téléchargements
echo nuit > /etc/skel/.config/grenos/theme

# Les dossiers que les applications cherchent, déclarés une fois pour toutes.
cat > /etc/xdg/user-dirs.defaults <<'EOF'
DESKTOP=Bureau
DOWNLOAD=Téléchargements
DOCUMENTS=Documents
PICTURES=Images
MUSIC=Musique
VIDEOS=Vidéos
EOF

# L'ouverture de session. LightDM lit lightdm.conf *après* lightdm.conf.d :
# c'est donc lui qui décide, et c'est là que live-config écrit le compte du
# live. On l'écrit nous-mêmes ; le premier écran le réécrira avec le nom choisi.
mkdir -p /etc/lightdm
cat > /etc/lightdm/lightdm.conf <<'EOF'
# Écrit par grenOS.
[Seat:*]
autologin-user=grenos
autologin-user-timeout=0
autologin-session=grenos
user-session=grenos
greeter-session=lightdm-gtk-greeter
EOF

# Nos choix d'applications par défaut, plutôt que le hasard de l'installation.
update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal || true
update-alternatives --set x-www-browser /usr/bin/firefox-esr || true

# LightDM est le seul gestionnaire de connexion, et il ouvre notre session.
echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager

# Le premier écran (le nom de la machine), puis la preuve que le bureau s'est
# vraiment ouvert — c'est elle que lit la CI sur le port série.
systemctl enable grenos-premier.service || true
systemctl enable grenos-preuve.service || true

echo "--- grenOS : le clavier et la langue ---"

cat > /etc/default/keyboard <<'EOF'
XKBMODEL="pc105"
XKBLAYOUT="fr"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF

echo "fr_FR.UTF-8 UTF-8" > /etc/locale.gen
echo "LANG=fr_FR.UTF-8" > /etc/default/locale
locale-gen >/dev/null 2>&1 || true

# L'environnement global : sans cela, l'écran de connexion s'affiche en anglais.
# Il démarre avant qu'une session n'ait lu /etc/default/locale.
cat > /etc/environment <<'EOF'
LANG=fr_FR.UTF-8
LC_ALL=fr_FR.UTF-8
EOF

echo "--- grenOS : l'ecran de chargement ---"

# Plymouth, thème « spinner » : notre fond, notre nom monté haut sur l'écran,
# et aucun logo Debian.
if [ -d /usr/share/plymouth/themes/spinner ]; then
    cp /usr/share/grenos/grenos-nuit.png \
       /usr/share/plymouth/themes/spinner/background-tile.png 2>/dev/null || true
    sed -i 's/^WatermarkVerticalAlignment=.*/WatermarkVerticalAlignment=.22/' \
        /usr/share/plymouth/themes/spinner/spinner.plymouth 2>/dev/null || true
    plymouth-set-default-theme spinner >/dev/null 2>&1 || true
fi
update-initramfs -u >/dev/null 2>&1 || true

echo "--- grenOS : les entrees de menu ---"

mkdir -p /usr/share/applications

ecrire_entree () {
    cat > "/usr/share/applications/grenos-$1.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$2
Comment=$3
Exec=grenos-$1
Icon=$4
Terminal=false
Categories=System;Settings;
EOF
}

ecrire_entree bienvenue "Bienvenue" "Ce que l'on peut faire, tout de suite" "user-home"
ecrire_entree parametres "Réglages" "L'apparence, l'écran, le son, le compte, les mises à jour" "preferences-system"
ecrire_entree maj "Mettre à jour grenOS" "Les nouveautés et les correctifs de sécurité" "system-software-update"
ecrire_entree theme "Jour et nuit" "Changer la lumière du bureau" "weather-clear-night"

# GrenPlace ne suit pas le nommage grenos-* : c'est une marque, pas un outil.
cat > /usr/share/applications/grenplace.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=GrenPlace
Comment=Ajouter des applications en un clic, Steam compris
Exec=grenplace
Icon=system-software-install
Terminal=false
Categories=System;PackageManager;
EOF

# Ce qu'on trouve sur le bureau au premier démarrage : de quoi commencer.
for raccourci in grenos-bienvenue grenplace; do
    if [ -f "/usr/share/applications/${raccourci}.desktop" ]; then
        install -m 0755 "/usr/share/applications/${raccourci}.desktop" /etc/skel/Bureau/
    fi
done

cat > /usr/share/applications/grenos-installer.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Installer grenOS
Comment=Poser le système sur le disque de cette machine
Exec=pkexec calamares
Icon=drive-harddisk
Terminal=false
Categories=System;
EOF

# Ce que personne ne doit trouver dans le menu : outils internes et doublons.
for cachee in calamares.desktop openbox.desktop debian-uxterm.desktop \
              debian-xterm.desktop display-im6.q16.desktop feh.desktop \
              lightdm-gtk-greeter.desktop; do
    if [ -f "/usr/share/applications/${cachee}" ]; then
        echo "NoDisplay=true" >> "/usr/share/applications/${cachee}"
    fi
done

echo "--- grenOS : l'installateur ---"

# Calamares porte nos couleurs (l'habillage est dans includes.chroot). Son
# fichier de marque réclame un logo.png à côté de lui : c'est le nom de grenOS,
# rendu à la construction par build.sh.
if [ -d /usr/share/calamares/branding/grenos ] && [ -f /usr/share/grenos/logo.png ]; then
    install -m 0644 /usr/share/grenos/logo.png \
        /usr/share/calamares/branding/grenos/logo.png || true
fi

if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: grenos/' /etc/calamares/settings.conf || true
    grep -q '^branding:' /etc/calamares/settings.conf || \
        echo "branding: grenos" >> /etc/calamares/settings.conf
fi

echo "--- grenOS : le magasin ---"

# Flathub, branché d'avance : le magasin installe Steam sans rien configurer.
# L'ajout ne télécharge rien.
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo || true
fi

echo "--- grenOS : les icones ---"

# Papirus apporte un jeu complet et moderne ; on ne garde que les deux
# variantes dont grenOS se sert. Les autres pèsent une centaine de mégaoctets
# pour rien.
rm -rf /usr/share/icons/ePapirus /usr/share/icons/ePapirus-Dark        /usr/share/icons/Papirus-Light
if [ -d /usr/share/icons/Papirus-Dark ]; then
    for fichier in /etc/gtk-3.0/settings.ini /etc/skel/.config/gtk-3.0/settings.ini; do
        mkdir -p "$(dirname "$fichier")"
        if [ -f "$fichier" ]; then
            sed -i 's/^gtk-icon-theme-name=.*/gtk-icon-theme-name=Papirus-Dark/' "$fichier"
        fi
    done
fi
gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark >/dev/null 2>&1 || true
gtk-update-icon-cache -f /usr/share/icons/Adwaita >/dev/null 2>&1 || true

echo "--- grenOS : verification des styles ---"

# GTK refuse une feuille de style entière pour une seule propriété qu'il ne
# connaît pas, et le programme qui la charge meurt avec elle. Une faute de
# style ne se voit donc pas comme un défaut d'apparence : la fenêtre ne
# s'ouvre pas. On le vérifie ici, pendant la construction, et on refuse de
# produire une image dont l'interface ne se chargerait pas.
python3 /usr/lib/grenos/verif-style.py

echo "--- grenOS : menage ---"

rm -f /usr/share/applications/xfce4-about.desktop
rm -f /usr/share/applications/org.gnome.Nautilus.desktop

echo "grenos: look installed"
