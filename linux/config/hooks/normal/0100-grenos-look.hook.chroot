#!/bin/sh
# Ce qui fait que l'image ressemble à grenOS, et pas à une Debian nue.
#
# Tout ce qui se voit est écrit ici ou dans config/includes.chroot : le nom du
# système, le fond d'écran, la session, l'écran de chargement, les entrées de
# menu, l'installateur. Aucune configuration d'un bureau tiers : depuis le
# 18 septembre 2026, le bureau de grenOS est `grenos-shell`, écrit dans ce
# dépôt et posé sur openbox — Plasma composait l'écran par le GPU, et sans
# accélération 3D la souris tombait à trois images par seconde.
#
# Piège déjà payé : avec `set -e`, une commande qui finit en erreur à la fin
# d'une boucle fait sortir tout le hook, et le thème disparaît sans qu'aucune
# étape ne rougisse. D'où les `|| true` et les `rm -f` sans test.

set -e

VERSION="1.0"

echo "--- grenOS : identite du systeme ---"

cat > /etc/os-release <<EOF
PRETTY_NAME="grenOS ${VERSION}"
NAME="grenOS"
VERSION_ID="${VERSION}"
VERSION="${VERSION}"
ID=grenos
ID_LIKE=debian
HOME_URL="https://grenos-dev.vercel.app"
SUPPORT_URL="https://grenos-dev.vercel.app"
BUG_REPORT_URL="https://github.com/Grenofar/grenOS/issues"
EOF

cat > /etc/lsb-release <<EOF
DISTRIB_ID=grenOS
DISTRIB_RELEASE=${VERSION}
DISTRIB_CODENAME=grenos
DISTRIB_DESCRIPTION="grenOS ${VERSION}"
EOF

printf 'grenOS %s\n\n' "${VERSION}" > /etc/issue
cp /etc/issue /etc/issue.net

echo "--- grenOS : la session ---"

# Le thème de départ, hérité par tout compte créé ensuite — y compris celui de
# l'installation sur disque. Le bureau n'est pas vide : ce qu'on y pose reste,
# et ce qui s'y trouve se déplace à la souris.
mkdir -p /etc/skel/.config/grenos /etc/skel/Bureau /etc/skel/Documents \
         /etc/skel/Images /etc/skel/Téléchargements
echo nuit > /etc/skel/.config/grenos/theme

# Les dossiers que les applications cherchent, déclarés une fois pour toutes.
cat > /etc/xdg/user-dirs.defaults <<'EOF'
DESKTOP=Bureau
DOWNLOAD=Téléchargements
DOCUMENTS=Documents
PICTURES=Images
MUSIC=Musique
VIDEOS=Vidéos
EOF

# L'ouverture de session. LightDM lit lightdm.conf *après* lightdm.conf.d :
# c'est donc lui qui décide, et c'est là que live-config écrit le compte du
# live. On l'écrit nous-mêmes ; le premier écran le réécrira avec le nom choisi.
mkdir -p /etc/lightdm
cat > /etc/lightdm/lightdm.conf <<'EOF'
# Écrit par grenOS.
[Seat:*]
autologin-user=grenos
autologin-user-timeout=0
autologin-session=grenos
user-session=grenos
greeter-session=lightdm-gtk-greeter
EOF

# Nos choix d'applications par défaut, plutôt que le hasard de l'installation.

# LightDM est le seul gestionnaire de connexion, et il ouvre notre session.
echo "/usr/sbin/lightdm" > /etc/X11/default-display-manager


echo "--- grenOS : le clavier et la langue ---"

cat > /etc/default/keyboard <<'EOF'
XKBMODEL="pc105"
XKBLAYOUT="fr"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF

echo "fr_FR.UTF-8 UTF-8" > /etc/locale.gen
echo "LANG=fr_FR.UTF-8" > /etc/default/locale
locale-gen >/dev/null 2>&1 || true

# Et on VERIFIE, parce que le `|| true` ci-dessus a menti pendant dix jours.
#
# `locales` est de priorite standard : debootstrap ne l'installe pas, et aucune
# de nos dependances ne le reclamait. `locale-gen` n'existait donc pas, son
# echec etait avale, et `LANG=fr_FR.UTF-8` designait une locale jamais
# generee — la glibc retombait sur C. Resultat : tout Debian en anglais dans un
# systeme qui se dit francais, et un dossier « TA©lA©chargements » dans le
# compte de la personne.
#
# Invisible parce que NOS programmes portent leurs textes francais en dur :
# la barre, le bureau et les Reglages avaient l'air parfaitement francais.
# Il a fallu ouvrir l'explorateur, qui lui depend de la locale.
if ! locale -a 2>/dev/null | grep -qi '^fr_FR\.utf'; then
    echo "grenos: la locale fr_FR.UTF-8 n'est PAS generee" >&2
    echo "grenos: tout ce qui n'est pas ecrit par nous s'afficherait en anglais" >&2
    exit 1
fi
echo "grenos: langue : fr_FR.UTF-8 generee, les applications parleront francais"

# L'environnement global : sans cela, l'écran de connexion s'affiche en anglais.
# Il démarre avant qu'une session n'ait lu /etc/default/locale.
cat > /etc/environment <<'EOF'
LANG=fr_FR.UTF-8
LC_ALL=fr_FR.UTF-8
EOF

echo "--- grenOS : l'ecran de chargement ---"

# Plymouth, thème « spinner » : notre fond, notre nom monté haut sur l'écran,
# et aucun logo Debian.
if [ -d /usr/share/plymouth/themes/spinner ]; then
    # Tout l'habillage est dans un seul script, que `appliquer-systeme` rejoue
    # après chaque mise à jour : `spinner.plymouth` appartient à Debian, donc on
    # le modifie au lieu de le livrer, et une remise à jour du paquet effacerait
    # notre travail sans cela.
    /usr/lib/grenos/habiller-plymouth
    plymouth-set-default-theme spinner >/dev/null 2>&1 || true
fi

update-initramfs -u >/dev/null 2>&1 || true

echo "--- grenOS : le magasin ---"

# Flathub, branché d'avance : le magasin installe Steam sans rien configurer.
# L'ajout ne télécharge rien.
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo || true
fi

echo "--- grenOS : les icones ---"

# Papirus apporte un jeu complet et moderne ; on ne garde que les deux
# variantes dont grenOS se sert. Les autres pèsent une centaine de mégaoctets
# pour rien.
rm -rf /usr/share/icons/ePapirus /usr/share/icons/ePapirus-Dark        /usr/share/icons/Papirus-Light

echo "--- grenOS : branchement du systeme ---"

# Une seule description du branchement, appelée ici et après chaque mise à
# jour du paquet. Deux descriptions auraient divergé au premier oubli — et
# c'est ce qui arrivait : les entrées de menu écrites ici n'atteignaient
# jamais une machine déjà installée.
/usr/lib/grenos/appliquer-systeme

echo "--- grenOS : verification des styles ---"

# GTK refuse une feuille de style entière pour une seule propriété qu'il ne
# connaît pas, et le programme qui la charge meurt avec elle. Une faute de
# style ne se voit donc pas comme un défaut d'apparence : la fenêtre ne
# s'ouvre pas. On le vérifie ici, pendant la construction, et on refuse de
# produire une image dont l'interface ne se chargerait pas.
python3 /usr/lib/grenos/verif-style.py

echo "--- grenOS : l'installateur est-il complet ---"

# Ce que l'on promet de l'installateur doit être dans l'image. Personne ne
# lance Calamares en intégration — cela demanderait un disque et une suite de
# clics — mais rien n'empêche de vérifier que sa configuration y est, et de
# refuser l'image sinon. C'est moins qu'une preuve, et c'est mieux que rien.
#
# Cette vérification reste ici, et pas dans `appliquer-systeme` : c'est un
# refus de construction. Sur la machine de quelqu'un, un `exit 1` casserait
# une mise à jour au lieu de protéger quoi que ce soit.
manque=""
[ -f /etc/calamares/settings.conf ] || manque="$manque settings.conf"
grep -q '^branding: grenos' /etc/calamares/settings.conf 2>/dev/null || \
    manque="$manque branding-grenos"
[ -f /usr/share/calamares/branding/grenos/branding.desc ] || manque="$manque branding.desc"
grep -q '^initialPartitioningChoice: erase' /etc/calamares/modules/partition.conf 2>/dev/null || \
    manque="$manque tout-le-disque"
grep -q '^allowManualPartitioning: true' /etc/calamares/modules/partition.conf 2>/dev/null || \
    manque="$manque choix-manuel"
if [ -n "$manque" ]; then
    echo "grenos: l'installateur est incomplet :$manque" >&2
    exit 1
fi
echo "grenos: installateur verifie (nos couleurs, tout le disque par defaut, choix manuel possible)"

echo "--- grenOS : le magasin s'appelle-t-il encore GrenPlace ---"

# Grenofar a demande « fais grenplace au lieu de magasin », et le nom est
# revenu tout seul : le 24 septembre, un agent travaillant depuis une base
# ancienne a ressuscite grenos-magasin.desktop et magasin.html. Personne ne
# l'aurait vu avant de regarder le menu de l'image publiee.
revenus=""
for mort in /usr/share/applications/grenos-magasin.desktop \
            /usr/share/grenos/magasin.html; do
    if [ -e "$mort" ]; then
        revenus="$revenus $mort"
    fi
done
if [ -n "$revenus" ]; then
    echo "grenos: le « Magasin » est revenu :$revenus" >&2
    exit 1
fi

# Le nom peut aussi revenir dans un TEXTE, sans qu'aucun fichier ne
# reapparaisse. C'est ce qui s'est passe : le diaporama de l'installateur
# disait encore « Un magasin, et Steam » et « Le magasin installe les
# applications » — dans le seul ecran qu'un nouveau venu ne peut pas eviter.
# Trouve le 2026-09-25, quatre jours apres le renommage.
#
# On ne regarde que ce qui s'affiche : le nom d'une entree de menu, et le texte
# du diaporama. Le mot reste libre dans les commentaires du code, ou il n'est
# qu'un nom commun francais.
dits=""
for entree in /usr/share/applications/*.desktop; do
    [ -f "$entree" ] || continue
    if grep -qi '^Name\(\[[^]]*\]\)\?=.*[Mm]agasin' "$entree"; then
        dits="$dits $entree"
    fi
done
for diapo in /usr/share/calamares/branding/grenos/show.qml; do
    [ -f "$diapo" ] || continue
    if grep -qi 'text:.*[Mm]agasin' "$diapo"; then
        dits="$dits $diapo"
    fi
done
if [ -n "$dits" ]; then
    echo "grenos: « Magasin » s'affiche encore dans :$dits" >&2
    echo "grenos: la boutique s'appelle GrenPlace partout ou quelqu'un la lit" >&2
    exit 1
fi
echo "grenos: le magasin s'appelle bien GrenPlace, fichiers et textes compris"

echo "--- grenOS : nos icones existent-elles en petite taille ---"
# Elles n'existaient qu'en 256x256. GTK cherche alors un 24x24, ne trouve que
# le 256, et le rend TEL QUEL : dans la barre, le logo grenOS, le haut-parleur
# et l'icone du reseau faisaient quarante-huit pixels au lieu de vingt-quatre,
# et passaient sous le bas de l'ecran.
#
# Aucune ligne serie ne pouvait le dire — il a fallu agrandir la capture quatre
# fois pour le voir. D'ou ce controle : la prochaine fois, la construction
# refusera avant la publication.
petites=""
for nom in grenos grenplace grenos-fichiers grenos-taches grenos-jeux \
           grenos-son grenos-son-muet grenos-reseau-cable grenos-reseau-aucun \
           grenos-parametres grenos-maj grenos-installer grenos-theme; do
    if [ ! -f "/usr/share/icons/hicolor/24x24/apps/$nom.png" ]; then
        petites="$petites $nom"
    fi
done
if [ -n "$petites" ]; then
    echo "grenos: ces icones manquent en 24x24 :$petites" >&2
    echo "grenos: sans petite taille, GTK rend le 256 tel quel et la barre deborde" >&2
    exit 1
fi
echo "grenos: nos icones existent en 24x24, la barre ne debordera pas"

echo "--- grenOS : les commandes que nos programmes appellent existent-elles ---"
# Trois fois la meme faute en un jour : ca-certificates absent (ni Flathub ni
# notre depot ne repondaient), puis libgtk-3-bin (le cache d'icones jamais
# rafraichi, le bouton Fortnite inerte), puis desktop-file-utils (la base du
# menu jamais reconstruite apres une mise a jour).
#
# A chaque fois la meme forme : un paquet seulement RECOMMANDE, donc absent
# puisqu'on construit sans les recommandes ; un appel dont l'echec est avale
# par un « || true » ; et personne ne le sait avant d'appuyer sur le bouton.
#
# Ce controle tourne ICI, dans l'image, ou `which` repond pour de vrai.
python3 /usr/lib/grenos/verif-commandes.py

echo "--- grenOS : nos autorisations designent-elles de vraies actions ---"
# Une regle polkit qui nomme une action inexistante n'autorise rien, et ne le
# dit pas. La notre portait « io.calamares.calamares. » ; le paquet calamares
# declare « com.github.calamares.calamares.pkexec.run ». Resultat : « Installer
# grenOS » lancait pkexec, polkit demandait un mot de passe, et sur une machine
# grenOS par defaut il n'y en a pas. **L'installateur ne pouvait pas demarrer.**
#
# Personne ne s'en etait apercu parce que personne n'avait jamais clique dessus,
# et que l'icone est cachee dans les machines virtuelles — donc dans la machine
# d'essai. Ce controle ferme cet angle mort : chaque prefixe permis doit
# correspondre a au moins une action reellement declaree sur le disque.
python3 - <<'POLKIT'
import glob
import re
import sys

regle = "/etc/polkit-1/rules.d/49-grenos-administration.rules"
try:
    with open(regle, encoding="utf-8") as fichier:
        texte = fichier.read()
except OSError:
    print("grenos: la regle d'administration est absente", file=sys.stderr)
    sys.exit(1)

# Les prefixes de la liste « permis », tels qu'ils sont ecrits.
bloc = texte.split("var permis = [", 1)[1].split("]", 1)[0]
prefixes = re.findall(r'"([^"]+)"', bloc)
if not prefixes:
    print("grenos: aucune action permise : la regle ne sert a rien", file=sys.stderr)
    sys.exit(1)

# Toutes les actions que le systeme declare vraiment.
actions = []
for chemin in glob.glob("/usr/share/polkit-1/actions/*.policy"):
    with open(chemin, encoding="utf-8", errors="replace") as fichier:
        actions += re.findall(r'<action id="([^"]+)"', fichier.read())

print("grenos: %d actions declarees sur cette image" % len(actions))
orphelins = []
for prefixe in prefixes:
    combien = sum(1 for a in actions if a.startswith(prefixe))
    print("grenos:   %-34s %d action(s)" % (prefixe, combien))
    if combien == 0:
        orphelins.append(prefixe)

if orphelins:
    print("grenos: ces prefixes ne designent AUCUNE action : " + ", ".join(orphelins),
          file=sys.stderr)
    print("grenos: une regle qui n'autorise rien est pire qu'une regle absente, "
          "parce qu'elle rassure", file=sys.stderr)
    sys.exit(1)
print("grenos: chaque autorisation designe une action qui existe")
POLKIT

echo "--- grenOS : le navigateur sait-il decoder une video ---"
# grenOS n'embarque aucun lecteur video : toute video regardee ici est une
# video WEB. Or Firefox ne decode pas lui-meme sur Linux, il appelle
# libavcodec — qu'il ne fait que RECOMMANDER. Sans les recommandes, il n'y en
# avait aucun : pas de H.264, et surtout **pas de decodage materiel**, le
# chemin VA-API de Firefox passant par ffmpeg.
#
# C'est pour cela que `va-driver-all`, ajoute ce matin, ne suffisait pas : un
# bon moteur sans conduite vers le reservoir. Grenofar a dit « les videos
# buggent avec 200 Mbit » ; le reseau n'y etait pour rien, et la premiere
# correction non plus.
decodeur=$(ls /usr/lib/x86_64-linux-gnu/libavcodec.so.* 2>/dev/null | head -n 1)
if [ -z "$decodeur" ]; then
    echo "grenos: AUCUN libavcodec : le navigateur n aura ni H.264 ni VA-API" >&2
    echo "grenos: firefox-esr ne fait que le recommander, et on construit sans" >&2
    exit 1
fi
echo "grenos: decodeur present : $(basename "$decodeur")"

# Les pilotes materiels servent les deux API : autant verifier qu'ils sont la.
pilotes=$(ls /usr/lib/x86_64-linux-gnu/dri/*_drv_video.so 2>/dev/null | wc -l)
if [ "$pilotes" -lt 1 ]; then
    echo "grenos: aucun pilote VA-API : le decodage se fera au processeur" >&2
    exit 1
fi
echo "grenos: $pilotes pilotes VA-API, et vainfo/vdpauinfo pour les interroger"

echo "--- grenOS : savons-nous formater ce que l installateur propose ---"
# `partition.conf` OFFRE une liste de systemes de fichiers, et une partition
# EFI, et le chiffrement. Offrir n'est pas savoir faire : chacun de ces choix
# a besoin d'un outil, et ces outils ne sont que RECOMMANDES.
#
# Trouve par `verif-recommandes.py`, et le premier fait mal : `dosfstools`
# etait absent, donc pas de `mkfs.vfat`, donc **pas de partition EFI**. Sur un
# PC UEFI — presque tous depuis 2012 — l'installation aurait echoue APRES avoir
# efface le disque. `btrfs-progs` et `xfsprogs` manquaient aussi, alors que la
# page d'installation propose les deux dans sa liste deroulante.
#
# C'est le meme defaut que la regle polkit juste au-dessus : une promesse a
# l'ecran sans rien derriere. Ce controle tourne dans l'image, ou l'outil
# existe ou n'existe pas.
python3 - <<'FORMATER'
import shutil
import sys

CONF = "/usr/share/grenos/partition.conf"
OUTIL = {
    "ext4": "mkfs.ext4", "ext3": "mkfs.ext3", "ext2": "mkfs.ext2",
    "btrfs": "mkfs.btrfs", "xfs": "mkfs.xfs", "f2fs": "mkfs.f2fs",
    "jfs": "mkfs.jfs", "reiserfs": "mkfs.reiserfs", "fat32": "mkfs.vfat",
}

try:
    lignes = open(CONF, encoding="utf-8").read().split("\n")
except OSError:
    print("grenos: partition.conf est absent de l image", file=sys.stderr)
    sys.exit(1)

# On lit la liste a la main : pas de PyYAML dans l image, et le format est
# celui-ci, une entree par ligne sous « availableFileSystemTypes: ».
demandes, dans_liste, efi, luks = [], False, False, False
for ligne in lignes:
    nue = ligne.strip()
    if nue.startswith("#"):
        continue
    if nue.startswith("availableFileSystemTypes:"):
        dans_liste = True
        continue
    if dans_liste:
        if nue.startswith("- "):
            demandes.append(nue[2:].strip().strip('"'))
            continue
        dans_liste = False
    if nue.startswith("defaultFileSystemType:"):
        demandes.append(nue.split(":", 1)[1].strip().strip('"'))
    if nue.startswith("efiSystemPartition:"):
        efi = True
    if nue.startswith("enableLuksAutomatedPartitioning:"):
        luks = nue.split(":", 1)[1].strip().lower() == "true"

# Ce que la partition EFI exige, et ce que le chiffrement exige.
besoins = {}
for systeme in sorted(set(demandes)):
    if systeme not in OUTIL:
        print("grenos: systeme de fichiers inconnu dans partition.conf : "
              + systeme, file=sys.stderr)
        sys.exit(1)
    besoins[OUTIL[systeme]] = "propose dans la liste : " + systeme
if efi:
    besoins["mkfs.vfat"] = "la partition EFI, sans quoi aucun PC UEFI ne demarre"
if luks:
    besoins["cryptsetup"] = "le chiffrement, que partition.conf active"

if not besoins:
    print("grenos: partition.conf ne propose rien : la lecture a echoue",
          file=sys.stderr)
    sys.exit(1)

absents = []
for outil in sorted(besoins):
    ou = shutil.which(outil) or shutil.which("/usr/sbin/" + outil)
    if ou is None:
        for essai in ("/sbin/", "/usr/sbin/"):
            import os
            if os.path.exists(essai + outil):
                ou = essai + outil
                break
    print("grenos:   %-14s %s  (%s)"
          % (outil, "present" if ou else "ABSENT ", besoins[outil]))
    if not ou:
        absents.append(outil)

if absents:
    print("grenos: l installateur propose ce qu il ne sait pas faire : "
          + ", ".join(absents), file=sys.stderr)
    print("grenos: une installation qui echoue APRES avoir efface le disque est"
          " le pire moment pour echouer", file=sys.stderr)
    sys.exit(1)
print("grenos: tout ce que l installateur propose, il sait le formater")
FORMATER

echo "--- grenOS : saurons-nous poser le chargeur de demarrage ---"
# Le controle ci-dessus verifie qu'on sait FORMATER ce que l'installateur
# propose. Formater n'est que la moitie du travail : une installation qui
# partitionne bien, copie bien, puis ne sait pas poser GRUB laisse une machine
# qui ne demarre pas — et elle a deja efface le disque. C'est le pire endroit
# ou echouer, et c'est la toute derniere etape.
#
# Les paquets sont dans la liste (grub2-common, grub-pc-bin, grub-efi-amd64-bin,
# efibootmgr). Mais un paquet present ne veut pas dire une commande presente :
# c'est exactement l'erreur commise avec les modules de Calamares, ou j'avais
# compte des fichiers sans regarder leur chemin. Ici, `which` repond pour de
# vrai, dans l'image.
manque=""
for outil in grub-install grub-mkconfig update-grub efibootmgr; do
    if command -v "$outil" >/dev/null 2>&1; then
        echo "grenos:   $outil present"
    else
        echo "grenos:   $outil ABSENT"
        manque="$manque $outil"
    fi
done
# Les modules de GRUB eux-memes : sans eux, `grub-install` n'a rien a installer.
for genre in i386-pc x86_64-efi; do
    if [ -d "/usr/lib/grub/$genre" ]; then
        echo "grenos:   modules $genre presents ($(ls -1 "/usr/lib/grub/$genre" | wc -l) fichiers)"
    else
        echo "grenos:   modules $genre ABSENTS"
        manque="$manque grub/$genre"
    fi
done
if [ -n "$manque" ]; then
    echo "grenos: l installateur ne pourrait pas rendre le disque amorcable :$manque" >&2
    echo "grenos: la machine serait effacee, puis ne demarrerait pas" >&2
    exit 1
fi
echo "grenos: l installateur saura rendre le disque amorcable, en BIOS et en UEFI"

echo "--- grenOS : que verra-t-on en eteignant ---"
# « a l extinction : pas de logs » est une demande du 23 septembre, « verifiee »
# pendant une semaine en relisant la ligne de commande du noyau — donc pas
# verifiee. Le 29, la CI a photographie l'arret pour la premiere fois, et les
# quatre lignes etaient la.
#
# Elles ne sont pas ecrites PENDANT l'arret : ce sont des messages du DEMARRAGE
# restes sur tty1, que l'on redecouvre a la seconde ou X s'en va. Trois pieces
# les font disparaitre, et un fichier absent ne fait aucun bruit — d'ou ce
# garde.
manque=""
[ -f /etc/systemd/system/grenos-console-propre.service ] || manque="$manque console-propre"
[ -f /etc/systemd/system.conf.d/20-grenos-silence.conf ] || manque="$manque silence-systemd"
[ -f /etc/modprobe.d/grenos-pas-de-disquette.conf ] || manque="$manque pas-de-disquette"
if [ -n "$manque" ]; then
    echo "grenos: l ecran d extinction n est pas nettoye :$manque" >&2
    echo "grenos: les messages du demarrage reapparaitront quand X s en ira" >&2
    exit 1
fi
if ! grep -q 'grenos-console-propre' /usr/lib/grenos/appliquer-systeme; then
    echo "grenos: appliquer-systeme n active pas grenos-console-propre" >&2
    echo "grenos: le service serait livre et ne tournerait jamais" >&2
    exit 1
fi
echo "grenos: extinction : tty1 efface, systemd muet, pas de sonde de disquette"

echo "--- grenOS : le volet de l explorateur demande-t-il une icone SOMBRE ---"
# Papirus-Dark n'a que trois dossiers `devices` : le 16x16 est reel, les 22x22
# et 24x24 sont des LIENS vers le theme clair. En demandant 20, GTK prenait le
# plus proche — donc 22, donc le clair — et l'icone « Appareils » sortait a
# #333333 sur un volet #2d2d2d : 1,07 : 1, invisible. GTK ne dit rien quand il
# suit un lien de ce genre.
#
# Ce controle refuse toute taille de volet qui ne tombe pas sur un vrai dossier
# du theme sombre. Meme famille que les boutons d'openbox et l'habillage de
# Calamares : un repli silencieux qu'un garde doit rendre bruyant.
volet=$(sed -n 's/^pane_icon_size=\([0-9]*\).*/\1/p' /etc/xdg/libfm/libfm.conf | tail -1)
case "$volet" in ''|*[!0-9]*) volet=0 ;; esac
sombre=/usr/share/icons/Papirus-Dark
if [ "$volet" -gt 0 ] && [ -d "$sombre" ]; then
    dossier="$sombre/${volet}x${volet}/devices"
    if [ ! -d "$dossier" ]; then
        echo "grenos: le volet demande ${volet}px, or le theme sombre n a pas ce dossier" >&2
        echo "grenos: GTK prendrait la taille voisine, qui est un lien vers le theme clair" >&2
        exit 1
    fi
    # On ne demande pas « est-ce un lien ? » mais « d ou vient vraiment cette
    # icone ? ». C est la question qui compte, et elle reste juste le jour ou
    # Papirus changera sa facon de ranger ses fichiers.
    reel=$(readlink -f "$dossier" 2>/dev/null || echo "$dossier")
    case "$reel" in
        *Papirus-Dark*) : ;;
        *)
            echo "grenos: le volet demande ${volet}px, mais cette taille mene a $reel" >&2
            echo "grenos: c est le theme CLAIR — l icone « Appareils » serait sombre sur fond sombre" >&2
            exit 1
            ;;
    esac
    echo "grenos: volet de l explorateur : ${volet}px, icones prises dans le theme sombre"
fi

echo "--- grenOS : l habillage de l installateur nomme-t-il des fichiers reels ---"
# `branding.desc` nommait `logo.png` TROIS fois — productLogo, productIcon,
# productWelcome — et le fichier n'a jamais existe. D'ou une bavure grise de
# 9x4 px dans la barre de titre de la seule fenetre qu'un nouveau venu ne peut
# pas eviter, et la seule sans notre marque. Qt ne dit rien quand une icone
# manque : il en met une par defaut et continue.
#
# Meme famille que la regle polkit nommant une action inexistante, que
# `partition.conf` offrant btrfs sans `mkfs.btrfs`, que `allowed_paths` nommant
# un fichier qu'on ne montre pas. Un fichier de configuration qui nomme une
# ressource absente est un defaut, pas un detail.
habillage=/usr/share/calamares/branding/grenos
if [ -f "$habillage/branding.desc" ]; then
    manque=""
    for fichier in $(sed -n 's/.*: *"\([A-Za-z0-9._-]*\.\(png\|jpg\|svg\|qml\|qss\)\)".*/\1/p' \
                     "$habillage/branding.desc" | sort -u); do
        if [ ! -f "$habillage/$fichier" ]; then
            manque="$manque $fichier"
        fi
    done
    if [ -n "$manque" ]; then
        echo "grenos: l habillage de l installateur nomme des fichiers absents :$manque" >&2
        echo "grenos: Qt ne dira rien — il mettra une icone par defaut et continuera" >&2
        exit 1
    fi
    echo "grenos: chaque image nommee par l habillage de l installateur existe"
fi

echo "--- grenOS : les boutons des barres de titre ---"
# Openbox ne dit RIEN quand il ne trouve pas le dessin d'un bouton : il prend
# son bitmap interne de 6x6 et continue. Notre themerc reglait la couleur de
# chaque bouton dans ses six etats depuis des semaines, sans une seule image —
# et la croix de Fermer etait donc un carre plein a quatre encoches, sur toutes
# les fenetres du systeme. Un repli silencieux est exactement ce qu'un garde
# doit rendre bruyant.
boutons=/usr/share/themes/grenOS/openbox-3
manque=""
for glyphe in close max max_toggled iconify; do
    if [ ! -f "$boutons/$glyphe.xbm" ]; then
        manque="$manque $glyphe"
    fi
done
if [ -n "$manque" ]; then
    echo "grenos: dessins de boutons absents :$manque" >&2
    echo "grenos: openbox retomberait sur ses bitmaps de 6x6, ou Fermer n est pas une croix" >&2
    exit 1
fi
# Et qu'ils soient bien plus grands que le repli : un fichier present mais
# dessine en 6x6 ne vaudrait pas mieux que pas de fichier du tout.
cote=$(sed -n 's/^#define close_width \([0-9]*\).*/\1/p' "$boutons/close.xbm")
case "$cote" in ''|*[!0-9]*) cote=0 ;; esac
if [ "$cote" -lt 8 ]; then
    echo "grenos: la croix de Fermer fait $cote px : trop petite pour etre une croix" >&2
    exit 1
fi
echo "grenos: boutons de fenetre dessines en ${cote}x${cote}, Fermer est une vraie croix"

echo "--- grenOS : l ecran de la mise a jour au redemarrage ---"
# L'ecran que Grenofar verra vraiment quand il appuiera sur « Mettre a jour et
# redemarrer ». Il etait, jusqu'au 28 septembre, une roulette sur fond grenOS
# et rien d'autre : notre page console etait peinte DERRIERE la splash de
# Plymouth, qui possede l'ecran a ce moment-la.
#
# Trois choses doivent tenir ensemble, et aucune ne se voit en relisant :
#   1. le mode `updates` du theme porte une barre de progression ;
#   2. son titre est en francais — une remise a jour de `plymouth-themes`
#      remettrait l'anglais, et c'est pour cela que `appliquer-systeme` rejoue
#      `habiller-plymouth` ;
#   3. il n'interdit plus les messages, sans quoi l'etape en cours ne
#      s'afficherait pas et la barre avancerait sans dire de quoi.
#
# Meme famille que la regle polkit et que `partition.conf` offrant btrfs sans
# `mkfs.btrfs` : une promesse a l'ecran sans rien derriere.
theme=/usr/share/plymouth/themes/spinner/spinner.plymouth
if [ -f "$theme" ]; then
    bloc=$(sed -n '/^\[updates\]/,/^\[/p' "$theme")
    manque=""
    # En `if`, jamais en `cmd || var=…` : avec `set -e`, un `&&` dont la partie
    # gauche echoue fait sortir le hook, et c'est un piege que ce projet a deja
    # paye. Ici le cas NORMAL est justement un grep qui ne trouve rien.
    if ! printf '%s' "$bloc" | grep -q '^UseProgressBar=true'; then
        manque="$manque barre"
    fi
    if ! printf '%s' "$bloc" | grep -q '^Title=Mise à jour de grenOS'; then
        manque="$manque titre-francais"
    fi
    if printf '%s' "$bloc" | grep -q '^SuppressMessages='; then
        manque="$manque messages-interdits"
    fi
    if [ -n "$manque" ]; then
        echo "grenos: l ecran de la mise a jour au redemarrage est incomplet :$manque" >&2
        echo "grenos: c est le seul ecran que la personne verra pendant que dpkg travaille" >&2
        exit 1
    fi
    echo "grenos: ecran de maj au redemarrage : barre, titre en francais, messages permis"
    # Et les deux images que le greffon `two-step` cherche a cote du theme.
    # Debian n'en livre AUCUNE : ni le fond, ni la marque. Nous posions le fond
    # et pas la marque, tout en reglant soigneusement sa position — donc
    # l'ecran de chargement n'a jamais porte le nom de grenOS. Un fichier
    # absent ne fait aucun bruit chez Plymouth : il prend son repli et continue.
    for image in background-tile watermark; do
        if [ ! -f "/usr/share/plymouth/themes/spinner/$image.png" ]; then
            echo "grenos: l ecran de chargement n a pas son $image.png" >&2
            echo "grenos: le theme le cherche, Plymouth ne dira rien, et il manquera" >&2
            exit 1
        fi
    done
    echo "grenos: ecran de chargement : notre fond et notre marque sont poses"
    if [ ! -x /usr/lib/grenos/habiller-plymouth ]; then
        echo "grenos: habiller-plymouth absent de l image" >&2
        exit 1
    fi
    if ! grep -q 'habiller-plymouth' /usr/lib/grenos/appliquer-systeme; then
        echo "grenos: appliquer-systeme ne rejoue pas l habillage de Plymouth" >&2
        echo "grenos: une remise a jour de plymouth-themes remettrait l anglais" >&2
        exit 1
    fi
    echo "grenos: et appliquer-systeme le repose apres chaque mise a jour"
fi

echo "--- grenOS : le bouton et le service de maj disent-ils la meme chose ---"
# Deux endroits lancent apt pour mettre grenOS a jour : la fenetre « Mettre a
# jour grenOS » (maj.py) et le service automatique. Ils portaient TOUS LES DEUX
# `--with-new-pkgs`, que apt refuse avec `full-upgrade` — donc ni l'un ni
# l'autre n'a jamais pu s'executer, et Grenofar l'a decouvert en appuyant sur
# le bouton.
#
# Corriger les deux ne suffit pas : rien n'empeche qu'ils divergent a nouveau.
# Le service doit donc porter exactement les memes options que la commande du
# module, qui est desormais la seule source.
python3 - <<'MAJ'
import re
import sys

sys.path.insert(0, "/usr/lib/grenos")
try:
    import maj
except Exception as souci:
    print("grenos: impossible de lire maj.py : %s" % souci, file=sys.stderr)
    raise SystemExit(1)

# Tout ce qui suit `apt-get`, valeurs comprises : un `-o` dont la valeur
# differe est une divergence comme une autre.
attendu = list(maj.COMMANDE_MAJ[1:])
print("grenos: le bouton lance : %s" % " ".join(maj.COMMANDE_MAJ))

service = "/etc/systemd/system/grenos-maj-auto.service"
try:
    texte = open(service, encoding="utf-8").read()
except OSError:
    print("grenos: le service de mise a jour automatique est absent", file=sys.stderr)
    raise SystemExit(1)

ligne = [l for l in texte.split("\n")
         if l.startswith("ExecStart=") and "full-upgrade" in l]
if not ligne:
    print("grenos: le service n'a aucune ligne full-upgrade", file=sys.stderr)
    raise SystemExit(1)

trouve = ligne[0].split("apt-get", 1)[1].split()
if trouve != attendu:
    print("grenos: le service et le bouton ne lancent pas la meme chose",
          file=sys.stderr)
    print("grenos:   bouton  : %s" % " ".join(attendu), file=sys.stderr)
    print("grenos:   service : %s" % " ".join(trouve), file=sys.stderr)
    raise SystemExit(1)
print("grenos: le service automatique lance exactement la meme commande")
MAJ

echo "--- grenOS : la mise a jour au demarrage est-elle bien desarmee ---"
# Ce service installe les mises a jour AVANT que le bureau ne s'ouvre, comme
# Windows. Il ne doit tourner que lorsque la personne a choisi « Mettre a jour
# et redemarrer » : livre actif, il installerait des paquets a CHAQUE
# demarrage, sans que personne ne l'ait demande, en retardant l'ouverture du
# bureau de plusieurs minutes.
#
# C'est le genre de defaut qu'on ne voit qu'en production, et qui donne
# exactement l'impression que Grenofar reproche a Windows. On le refuse ici.
service=/etc/systemd/system/grenos-maj-demarrage.service
if [ ! -f "$service" ]; then
    echo "grenos: le service de mise a jour au demarrage est absent" >&2
    exit 1
fi
if [ ! -x /usr/lib/grenos/grenos-maj-demarrage ]; then
    echo "grenos: grenos-maj-demarrage n est pas executable" >&2
    exit 1
fi
# `systemctl is-enabled` rend « disabled » tant qu'aucun lien n'existe dans
# multi-user.target.wants. Un lien present ici serait l'erreur.
if [ -e /etc/systemd/system/multi-user.target.wants/grenos-maj-demarrage.service ]; then
    echo "grenos: le service de mise a jour au demarrage est ACTIF dans l image" >&2
    echo "grenos: il installerait des paquets a chaque demarrage" >&2
    exit 1
fi
# Et il doit passer avant l'ecran de connexion, sinon le bureau s'ouvrirait
# pendant que dpkg travaille — tout l'interet disparaitrait.
if ! grep -q '^Before=.*lightdm' "$service"; then
    echo "grenos: le service ne s ordonne pas avant lightdm" >&2
    exit 1
fi
echo "grenos: mise a jour au demarrage : presente, desarmee, avant le bureau"

echo "--- grenOS : le bureau de depart est-il garni ---"

# La CI a dit « bureau pret, 0 icones » et c'est comme cela que j'ai vu que
# j'avais emporte ce bloc en deplacant les entrees de menu. Un bureau vide au
# premier demarrage ne fait rougir aucune etape : on le verifie donc ici.
garnis=$(ls -1 /etc/skel/Bureau 2>/dev/null | wc -l)
if [ "$garnis" -lt 2 ]; then
    echo "grenos: le bureau de depart ne contient que $garnis raccourci(s)" >&2
    exit 1
fi
echo "grenos: bureau de depart garni de $garnis raccourcis"

echo "--- grenOS : nos programmes compilent-ils ---"

# Meme lecon que ci-dessus, d'un cran plus bas : une faute de syntaxe empeche
# le programme de demarrer, et rien ne rougit pendant la construction. On s'en
# apercevrait en cliquant sur une icone qui ne fait rien.
# On lit le fichier sans rien ecrire : `py_compile` deposerait des dossiers
# __pycache__ jusque dans /usr/bin, que personne ne lirait jamais.
compiler () {
    if ! python3 -c 'import ast, sys; ast.parse(open(sys.argv[1], encoding="utf-8").read(), sys.argv[1])' "$1"; then
        echo "grenos: $1 ne compile pas" >&2
        exit 1
    fi
}
# Nos modules : un fichier .py est du Python, sans avoir a le demander.
# Ecrit en clair, et pas « [ -f x ] && ... » : avec `set -e`, cette forme en
# fin de boucle fait sortir le hook en erreur des que le motif ne trouve rien.
# La lecon est deja dans CLAUDE.md, payee une fois.
for module in /usr/lib/grenos/*.py; do
    if [ -f "$module" ]; then
        compiler "$module"
    fi
done

# Et maintenant on DEPOSE leur bytecode, ce qu'on n'avait jamais fait.
#
# Grenofar : « dans certaines applications ca met du temps a ouvrir ». Le
# chronometre pose ce soir a donne les premiers chiffres : 810 a 1199 ms pour
# cinq fenetres, 2789 ms pour l'accueil. Une partie de ce temps est payee
# AVANT que la fenetre n'existe, a l'import de nos modules.
#
# Le controle ci-dessus lit les fichiers sans rien ecrire — c'est voulu pour
# /usr/bin, ou un __pycache__ ne servirait a personne : Python ne met jamais en
# cache le script principal. Mais /usr/lib/grenos est IMPORTE par les douze
# programmes, et la le cache compte.
#
# Sans lui, Python recompile grenosui.py et ses neuf voisins a chaque
# lancement, parce que le squashfs est en lecture seule : il ne peut pas
# deposer le resultat, donc il recommence. Le faire ici, une fois, pendant la
# construction.
#
# `-q` pour ne pas noyer le journal, et on ne s'arrete pas dessus : un cache
# manquant rend le demarrage plus lent, il ne casse rien.
if python3 -m compileall -q /usr/lib/grenos >/dev/null 2>&1; then
    caches=$(find /usr/lib/grenos -name '*.pyc' | wc -l)
    echo "grenos: $caches modules pre-compiles, ils ne le seront plus a chaque lancement"
else
    echo "grenos: la pre-compilation a echoue — le demarrage sera plus lent" >&2
fi

# Le cache des themes d'icones, deuxieme piste du temps d'ouverture.
#
# La pre-compilation ci-dessus n'a RIEN change aux chiffres — 810 ms avant,
# 810 ms apres. Ce n'etait donc pas la. Papirus compte des dizaines de milliers
# de fichiers : sans `icon-theme.cache`, GTK les parcourt a chaque demarrage
# d'application. `appliquer-systeme` lance bien `gtk-update-icon-cache`, mais
# personne n'a jamais verifie que le fichier existait ensuite — et une commande
# qui echoue en silence derriere `|| true` est la forme exacte des defauts de
# cette semaine.
#
# Rapporte, pas bloquant : on cherche encore ou part le temps.
for theme in hicolor Papirus-Dark Papirus; do
    cache="/usr/share/icons/$theme/icon-theme.cache"
    if [ -f "$cache" ]; then
        echo "grenos: cache d icones $theme : $(( $(wc -c < "$cache") / 1024 )) Kio"
    elif [ -d "/usr/share/icons/$theme" ]; then
        echo "grenos: cache d icones $theme ABSENT — GTK parcourra les fichiers un a un"
    fi
done
# Nos programmes : eux portent une ligne #!, et certains sont du shell.
for programme in /usr/bin/grenos-* /usr/bin/grenplace /usr/lib/grenos/grenos-*; do
    [ -f "$programme" ] || continue
    head -1 "$programme" | grep -q python3 || continue
    compiler "$programme"
done
echo "grenos: tous nos programmes compilent"

# Aucune fenetre ne suppose la taille de l'ecran.
#
# Grenofar a demarre grenOS en 1280x720 : « il est casse, en 720p on voit pas
# tout ». Les Reglages demandaient 660 pixels de haut, la page Jeux et
# GrenPlace 720, et sous la barre il n'en reste que 668 : les boutons du bas
# tombaient hors de l'ecran, la ou aucune souris ne va les chercher.
#
# Ces tailles passent desormais par `grenosui.poser_taille`, qui les ramene a
# ce que l'ecran offre. Ce controle empeche la prochaine d'y echapper : un
# nombre ecrit en dur dans `set_default_size` refuse la construction.
python3 - <<'TAILLES'
import ast
import glob
import sys

fautes = []
for chemin in sorted(glob.glob("/usr/bin/grenos-*") + ["/usr/bin/grenplace"]):
    try:
        with open(chemin, encoding="utf-8") as fichier:
            tete = fichier.readline()
            if "python3" not in tete:
                continue
            fichier.seek(0)
            arbre = ast.parse(fichier.read(), chemin)
    except (OSError, SyntaxError):
        continue
    for noeud in ast.walk(arbre):
        if not isinstance(noeud, ast.Call):
            continue
        cible = noeud.func
        if not isinstance(cible, ast.Attribute) or cible.attr != "set_default_size":
            continue
        # Une taille CALCULEE est legitime : la barre prend la largeur de
        # l'ecran, le premier ecran le prend en entier. Ce qu'on refuse, c'est
        # un nombre ecrit a la main.
        durs = [a for a in noeud.args
                if isinstance(a, ast.Constant) and isinstance(a.value, int)]
        if durs:
            fautes.append("%s ligne %d : set_default_size(%s)"
                          % (chemin, noeud.lineno,
                             ", ".join(str(a.value) for a in durs)))

if fautes:
    for faute in fautes:
        print("grenos: taille en dur — " + faute, file=sys.stderr)
    print("grenos: passe par grenosui.poser_taille(), qui tient compte de l ecran",
          file=sys.stderr)
    sys.exit(1)
print("grenos: aucune fenetre ne suppose la taille de l ecran")
TAILLES

# Et un programme juste peut manquer d'une bibliotheque : `import cairo` n'a
# de sens que si le paquet est la. On demande a l'image d'importer ce dont nos
# programmes ont besoin, plutot que de l'esperer.
python3 - <<'VERIF'
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Wnck  # noqa: F401
import cairo  # noqa: F401
print("grenos: les bibliotheques de l'interface repondent")
VERIF

echo "--- grenOS : la splash d arret peut-elle etre levee ---"

# RAPPORTE, PAS ENCORE BLOQUANT.
#
# La regle du projet est tenue depuis le 12 septembre : on ne rend une preuve
# obligatoire qu APRES l avoir vue verte. Un garde neuf qui refuse a tort coute
# une construction entiere et fait douter de tous les autres — c est arrive
# quatre fois a `verif-commandes.py`. Celui-ci sera promu quand il aura passe.
#
# Ce qu il surveille : nos fragments recopient la commande de l unite Debian,
# au `-` pres. Si Debian la change — une option, un chemin, un mode —, le
# fragment la figerait a l ancienne et la splash ne se leverait plus, SANS que
# rien ne rougisse. Exerce hors image sur quatre cas : identiques (accepte),
# option ajoutee, chemin change, mode change (refuses).
ecart=0
for unite in plymouth-poweroff plymouth-reboot plymouth-halt plymouth-kexec; do
    livree="/usr/lib/systemd/system/${unite}.service"
    notre="/etc/systemd/system/${unite}.service.d/10-grenos-tolerant.conf"
    if [ ! -f "$livree" ]; then
        echo "grenos: ATTENTION $livree a disparu du paquet plymouth"
        ecart=1
        continue
    fi
    if [ ! -f "$notre" ]; then
        echo "grenos: ATTENTION notre fragment manque pour $unite"
        ecart=1
        continue
    fi
    sienne=$(grep -m1 '^ExecStart=/' "$livree" | sed 's/^ExecStart=//')
    notre_cmd=$(grep -m1 '^ExecStart=-' "$notre" | sed 's/^ExecStart=-//')
    if [ "$sienne" != "$notre_cmd" ]; then
        echo "grenos: ATTENTION $unite a change chez Debian"
        echo "grenos:   paquet : $sienne"
        echo "grenos:   nous   : $notre_cmd"
        ecart=1
    fi
done
if [ "$ecart" = 0 ]; then
    echo "grenos: les 4 fragments plymouth portent la commande du paquet, au - pres"
fi

# Et la splash doit avoir de quoi se dessiner : le demon, son client, un theme.
# Une splash levee sur un theme absent est un ecran noir, ce qui ne vaut pas
# mieux qu un journal — et c est le genre d echange qu on a deja failli faire.
for outil in /usr/sbin/plymouthd /usr/bin/plymouth; do
    [ -x "$outil" ] || echo "grenos: ATTENTION $outil manque"
done
theme=$(plymouth-set-default-theme 2>/dev/null || echo "")
echo "grenos: theme plymouth par defaut : ${theme:-AUCUN}"

echo "--- grenOS : menage ---"

rm -f /usr/share/applications/xfce4-about.desktop
rm -f /usr/share/applications/org.gnome.Nautilus.desktop

echo "grenos: look installed"
