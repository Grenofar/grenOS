// Mettre à jour et installer sans mot de passe, pour les comptes
// administrateurs de cette machine.
//
// Pourquoi : grenOS s'ouvre sans mot de passe tant que la personne n'en a pas
// choisi un. Sans cette règle, le premier clic sur « Mise à jour » ou sur le
// magasin demanderait un mot de passe qui n'existe pas, et rien ne se
// passerait. La règle ne couvre que les paquets, les Flatpak et
// l'installation du système — pas l'exécution de n'importe quoi en root.
//
// ---------------------------------------------------------------------------
// Un nom d'action écrit de mémoire ne permet rien du tout.
//
// Cette liste portait « io.calamares.calamares. ». Ce nom n'existe nulle part :
// le paquet `calamares` 3.3.14-1 déclare
// `com.github.calamares.calamares.pkexec.run`, avec `allow_active = auth_admin`.
// Lu dans le .deb, dans
// /usr/share/polkit-1/actions/com.github.calamares.calamares.policy — pas
// deviné.
//
// La conséquence était sérieuse et invisible : « Installer grenOS » lance
// `pkexec calamares`, polkit demandait un mot de passe, et sur une machine
// grenOS par défaut il n'y en a pas. **L'installateur ne pouvait pas démarrer**,
// et personne ne s'en était aperçu parce que personne n'avait jamais cliqué
// dessus — l'icône est même cachée dans les machines virtuelles, donc dans la
// machine d'essai.
//
// Le hook de construction refuse désormais une image où l'un de ces préfixes
// ne correspond à aucune action déclarée : une règle qui n'autorise rien est
// pire qu'une règle absente, parce qu'elle rassure.
// ---------------------------------------------------------------------------
// LA MÊME PANNE, SUR LES DISQUES — trouvée le 7 octobre
//
// Grenofar : « que l'os detecte plusieur disques de stockage ». Les disques
// étaient bien *vus* depuis le 27 septembre (`show_internal_volumes`), et ils
// ne pouvaient pas être *ouverts*.
//
// Lu dans le paquet udisks2 2.10.1-12.1+deb13u2, dans
// /usr/share/polkit-1/actions/org.freedesktop.UDisks2.policy — pas deviné :
//
//     filesystem-mount          allow_active = yes
//     filesystem-mount-system   allow_active = auth_admin_keep
//
// Une clé USB est amovible : elle se monte (`yes`). Un disque interne est un
// « périphérique système » pour udisks2, et son montage demande un mot de
// passe d'administrateur. Sur une machine grenOS il n'y en a pas : la demande
// est insatisfiable, le clic ne fait rien, et rien ne s'affiche.
//
// C'est à la virgule près la panne de l'installateur ci-dessus, deux semaines
// plus tard, sur un autre sous-système. D'où les quatre actions nommées une à
// une plus bas, et non le préfixe `org.freedesktop.udisks2.` en entier :
// `modify-device-system` partitionne un disque, et personne ne l'a demandé
// depuis l'explorateur de fichiers.
// ---------------------------------------------------------------------------
polkit.addRule(function (action, subject) {
    // Chacun de ces prefixes correspond a une action REELLEMENT declaree sur
    // cette image, verifiee dans les paquets :
    //   flatpak   -> org.freedesktop.Flatpak.policy
    //   calamares -> com.github.calamares.calamares.policy
    //   systemd   -> org.freedesktop.systemd1.policy, org.freedesktop.timedate1.policy
    //   udisks2   -> org.freedesktop.UDisks2.policy
    //
    // Les quatre actions udisks2 sont nommees ENTIERES, pas en prefixe : ce
    // sont les seules dont un explorateur de fichiers a besoin sur un disque
    // interne. Ouvrir « org.freedesktop.udisks2. » en entier donnerait aussi
    // `modify-device-system`, c'est-a-dire le partitionnement.
    //
    // « org.freedesktop.packagekit. » et « org.debian.apt. » ont ete retires :
    // nous n'installons ni packagekit ni aptdaemon, et le magasin comme les
    // mises a jour passent par `sudo -n`, jamais par polkit. Reclamer des
    // droits pour un logiciel absent ne protege de rien et fait croire que
    // quelque chose est couvert.
    // ---------------------------------------------------------------------
    // ET LA TROISIEME FOIS, SUR LES INSTANTANES — 15 octobre
    //
    // C1 de sa liste : « a chaque installation de pilote, de mise a jour de
    // noyau ou d'OS, l'OS fait un snapshot ». L'outil est timeshift, et ses
    // DEUX actions sont en `auth_admin`. Lu dans le .deb de timeshift
    // 24.06.6-2, dans un seul fichier
    // /usr/share/polkit-1/actions/in.teejeetech.pkexec.timeshift.policy :
    //
    //     <action id="in.teejeetech.pkexec.timeshift-gtk">  auth_admin
    //     <action id="in.teejeetech.pkexec.timeshift">      auth_admin
    //
    // Sans ces deux lignes, « Instantanes » s'ouvrirait, demanderait un mot
    // de passe que la machine n'a pas, et ne ferait rien. Troisieme fois
    // exactement, apres l'installateur et les disques.
    // ---------------------------------------------------------------------
    // UN DEFAUT TROUVE EN RELISANT CE FICHIER, ET IL ETAIT LA DEPUIS LE DEBUT.
    //
    // Le commentaire ci-dessus dit que les actions udisks2 sont « nommees
    // ENTIERES, pas en prefixe ». Le code, lui, faisait `indexOf(...) === 0`
    // sur TOUTES les entrees : elles etaient donc toutes des prefixes, et
    // `org.freedesktop.udisks2.filesystem-mount-system` aurait ouvert une
    // hypothetique `...-system-quelque-chose`. L'intention etait ecrite dans
    // les donnees — les prefixes voulus finissent par un point, les actions
    // entieres non — et le code ne l'honorait pas.
    //
    // Cela compte deux fois plus ici : `in.teejeetech.pkexec.timeshift` est
    // un prefixe de `in.teejeetech.pkexec.timeshift-gtk`. En prefixe, le
    // premier ouvrirait tout ce que timeshift declarera un jour sous ce nom,
    // sans que personne ne relise cette liste.
    var permis = [
        "org.freedesktop.Flatpak.",
        "com.github.calamares.calamares.",
        "org.freedesktop.systemd1.",
        "org.freedesktop.timedate1.",
        "org.freedesktop.udisks2.filesystem-mount-system",
        "org.freedesktop.udisks2.encrypted-unlock-system",
        "org.freedesktop.udisks2.eject-media-system",
        "org.freedesktop.udisks2.power-off-drive-system",
        "in.teejeetech.pkexec.timeshift-gtk",
        "in.teejeetech.pkexec.timeshift"
    ];
    if (!subject.isInGroup("sudo")) {
        return polkit.Result.NOT_HANDLED;
    }
    for (var i = 0; i < permis.length; i++) {
        var motif = permis[i];
        var est_prefixe = motif.charAt(motif.length - 1) === ".";
        if (est_prefixe ? action.id.indexOf(motif) === 0 : action.id === motif) {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
