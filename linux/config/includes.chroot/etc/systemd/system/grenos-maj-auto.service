# Le mode « Automatiques » — seulement si la personne l'a choisi.
#
# La condition est un fichier, écrit par les Réglages ou l'assistant. Tant
# qu'il n'existe pas, ce service ne fait rien : une machine qui s'installe des
# choses sans qu'on le lui ait demandé n'est pas une machine à soi.
#
# Il N'INSTALLE PLUS RIEN À CHAUD : il télécharge, met à jour les Flatpak, et
# arme l'installation au prochain démarrage (voir grenos-maj-auto).

[Unit]
Description=grenOS : installer les mises a jour
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/grenos/maj-automatique

[Service]
Type=oneshot
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/usr/lib/grenos/grenos-maj-auto
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
