# Appliquer les mises à jour au démarrage, avant que le bureau ne s'ouvre.
#
# Ce service est **désactivé par défaut**. Il ne s'active que lorsque la
# personne choisit « Mettre à jour et redémarrer » dans l'écran d'arrêt, et il
# se désactive lui-même dès qu'il démarre : un démarrage ordinaire ne passe
# jamais par ici, et une installation interrompue ne peut pas boucler.
#
# `Before=lightdm.service` est tout l'intérêt : rien d'autre ne tourne pendant
# que dpkg travaille. C'est ce qui permet de remplacer le bureau lui-même sans
# le relancer à chaud au milieu de la session de quelqu'un.

[Unit]
Description=grenOS : installer les mises a jour avant d ouvrir le bureau
DefaultDependencies=no
After=network-online.target local-fs.target
# `Wants=network-online.target` EST NÉCESSAIRE, ET JE L'AI RETIRÉ À TORT.
#
# Le 15 octobre j'ai supprimé cette ligne en écrivant : « cette unité est
# `Before=lightdm`, donc tout ce qu'elle attend, le bureau l'attend aussi ;
# `NetworkManager-wait-online.service` porte `NM_ONLINE_TIMEOUT=60`, donc une
# machine sans réseau attend une minute devant un écran noir ». Le
# raisonnement était juste et **sa prémisse était fausse** : cette unité est
# `disabled` à un démarrage ordinaire — l'image le dit elle-même sur le port
# série, `maj: installation au demarrage presente, etat disabled` — et une
# unité désactivée n'entre pas dans la transaction. Elle ne faisait donc
# attendre personne. J'ai supprimé une attente qui n'existait pas.
#
# Ce que ça a coûté, mesuré : la construction suivante est repartie verte et
# **n'a rien publié**. `After=` seul n'ordonne que si quelqu'un d'autre
# demande le réseau ; ici personne ne le demande, donc apt tournait avant
# que la machine n'ait une adresse, ne joignait pas le dépôt, et
# n'installait rien — en rendant 0, comme il le doit. « La mise a jour au
# redemarrage n'a rien installe : la promesse "plus jamais d'ISO" ne tient
# pas. »
#
# Et le seul démarrage où cette unité tourne est celui où quelqu'un a cliqué
# « Mettre à jour et redémarrer ». Attendre le réseau y est exactement ce
# qu'il a demandé — d'autant que cette unité est `Before=plymouth-quit`,
# donc l'attente se passe derrière une barre de progression, pas un écran
# noir.
Wants=network-online.target
Before=lightdm.service display-manager.service shutdown.target
# Et AVANT que Plymouth ne s'en aille : c'est lui qui possède l'écran pendant
# tout ce qui précède le bureau, et c'est donc lui qui montre la barre de
# progression. Sans cette ligne, la splash pourrait disparaître au milieu du
# travail et laisser la personne devant un écran noir sans explication.
Before=plymouth-quit.service plymouth-quit-wait.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=no
Environment=DEBIAN_FRONTEND=noninteractive
# Le script rend toujours 0 : un echec de mise a jour ne doit pas empecher la
# machine de demarrer. Il ecrit son verdict dans /run/grenos/maj-resultat.
ExecStart=/usr/lib/grenos/grenos-maj-demarrage
# Vingt minutes : au-dela, systemd passe a la suite et le bureau s'ouvre. Mieux
# vaut une mise a jour inachevee qu'un ecran noir sans fin.
TimeoutStartSec=1200
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1

[Install]
WantedBy=multi-user.target
