<?xml version="1.0" encoding="UTF-8"?>
<!--
  Le terminal de grenOS : les couleurs de la palette « nuit » de grenosui.py,
  la police Hack, ni barre de menus ni barre d'outils, un curseur fin.

  Grenofar, le 18 novembre : « customise l'ui de cmd, rend le bien et clean ».
  xfce4-terminal 1.x lit ses réglages dans xfconf, et xfconf prend ses valeurs
  par défaut ici (XDG_CONFIG_DIRS). Ce sont des DÉFAUTS : ce que la personne
  change dans les préférences du terminal l'emporte et lui reste.

  Les seize couleurs sont choisies pour se lire sur #0b101c (contraste AA au
  moins pour le texte courant) tout en restant dans les teintes du bureau :
  le bleu et le violet de l'accent, un vert et un rouge doux.
-->
<channel name="xfce4-terminal" version="1.0">
  <property name="font-name" type="string" value="Hack 11"/>
  <property name="font-use-system" type="bool" value="false"/>
  <property name="font-allow-bold" type="bool" value="true"/>
  <property name="color-use-theme" type="bool" value="false"/>
  <property name="color-foreground" type="string" value="#eef2fa"/>
  <property name="color-background" type="string" value="#0b101c"/>
  <property name="color-cursor" type="string" value="#60a5fa"/>
  <property name="color-cursor-use-default" type="bool" value="false"/>
  <property name="color-cursor-foreground" type="string" value="#0b101c"/>
  <property name="color-selection" type="string" value="#eef2fa"/>
  <property name="color-selection-background" type="string" value="#2c3d60"/>
  <property name="color-selection-use-default" type="bool" value="false"/>
  <property name="color-bold-is-bright" type="bool" value="true"/>
  <property name="color-palette" type="string" value="#1a2338;#ef4d5e;#2bc48a;#f5b84a;#3b82f6;#a78bfa;#22d3ee;#c9d2e3;#4a5a7a;#ff6b7b;#4ade9f;#fcd27a;#60a5fa;#c4b5fd;#67e8f9;#ffffff"/>
  <property name="tab-activity-color" type="string" value="#a78bfa"/>
  <property name="misc-menubar-default" type="bool" value="false"/>
  <property name="misc-toolbar-default" type="bool" value="false"/>
  <property name="misc-borders-default" type="bool" value="true"/>
  <property name="misc-cursor-shape" type="string" value="TERMINAL_CURSOR_SHAPE_IBEAM"/>
  <property name="misc-cursor-blinks" type="bool" value="true"/>
  <property name="misc-default-geometry" type="string" value="100x28"/>
  <property name="misc-tab-close-buttons" type="bool" value="true"/>
  <property name="misc-show-unsafe-paste-dialog" type="bool" value="true"/>
  <property name="misc-confirm-close" type="bool" value="false"/>
  <property name="scrolling-bar" type="string" value="TERMINAL_SCROLLBAR_NONE"/>
  <property name="scrolling-lines" type="uint" value="10000"/>
  <property name="title-mode" type="string" value="TERMINAL_TITLE_REPLACE"/>
  <property name="title-initial" type="string" value="Terminal grenOS"/>
</channel>
