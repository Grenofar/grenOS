#!/bin/sh
# Les pilotes de cartes graphiques n'ont rien à faire dans l'initrd
# (19 novembre).
#
# `nouveau` et `amdgpu` déclarent TOUS leurs firmwares (MODULE_FIRMWARE), et
# initramfs-tools copie tout ce qu'un module déclare. L'initrd de l'image
# 1801 pesait 158 Mo, en DEUX exemplaires sur l'ISO et un dans le système.
# Avec le firmware NVIDIA de backports (152 Mo au lieu de 63, pour les RTX 50),
# l'ISO est passée à 2,17 Go et la CI l'a refusée — une Release GitHub
# s'arrête à 2 Go (run 44588740729).
#
# Et c'est aussi du temps : Grenofar voyait DEUX MINUTES d'écran noir au
# démarrage sur une clé USB 2.0, le temps que le firmware lise l'initrd.
#
# Rien n'en a besoin si tôt : l'écran de chargement s'affiche sur le tampon
# du firmware (simpledrm, à la définition que GRUB a choisie), le disque
# chiffré se déverrouille au clavier sur ce même écran, et le vrai pilote se
# charge une fois le système monté, avec son firmware, depuis /usr/lib/firmware.
# Les pilotes des machines virtuelles (bochs, virtio, vmwgfx, qxl) restent :
# ils sont petits et sans firmware.
#
# COMMENT. Les crochets ne copient pas les modules : `manual_add_modules` les
# INSCRIT dans le fichier "$__MODULES_TO_ADD", et mkinitramfs ne les copie
# — firmwares compris, par dracut-install — qu'APRÈS tous les crochets
# (`apply_add_modules`, lu dans mkinitramfs 0.148.4). Supprimer les fichiers
# ici ne servait donc à rien : la première version de ce crochet l'a fait,
# et la construction l'a refusé (initrd de 252 Mo, run 44598026241). On raye
# ces pilotes de la liste avant qu'elle soit lue. C'est plymouth qui les y
# met (`copy_modules_dir kernel/drivers/gpu/drm`), par leur nom court.
#
# « zz » : nos crochets passent après ceux de /usr/share/initramfs-tools.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

[ -n "$DESTDIR" ] || exit 0
MODULES_NOYAU="${MODULESDIR:-/lib/modules/${version:-}}"
if [ -n "${__MODULES_TO_ADD:-}" ] && [ -f "$__MODULES_TO_ADD" ] && [ -d "$MODULES_NOYAU" ]; then
    # Chaque module de ces dossiers, par son nom court (comme plymouth l'écrit).
    noms=$(find "$MODULES_NOYAU/kernel/drivers/gpu/drm/nouveau" \
                "$MODULES_NOYAU/kernel/drivers/gpu/drm/amd" \
                "$MODULES_NOYAU/kernel/drivers/gpu/drm/radeon" \
                "$MODULES_NOYAU/kernel/drivers/gpu/drm/i915" \
                "$MODULES_NOYAU/kernel/drivers/gpu/drm/xe" \
                -name '*.ko*' -printf '%f\n' 2>/dev/null | sed 's/\.ko.*$//' | sort -u)
    # Le pilote officiel de NVIDIA (20 novembre) range ses modules hors de
    # drivers/gpu (updates/dkms) : on les nomme. Son firmware n'est plus dans
    # l'initrd ; chargés trop tôt, ils échoueraient.
    noms=$(printf '%s
nvidia
nvidia_drm
nvidia_modeset
nvidia_uvm
nvidia_peermem' "$noms")
    if [ -n "$noms" ]; then
        printf '%s\n' "$noms" > "$DESTDIR/.grenos-sans-graphique"
        grep -vxF -f "$DESTDIR/.grenos-sans-graphique" "$__MODULES_TO_ADD" > "$__MODULES_TO_ADD.grenos" || true
        cat "$__MODULES_TO_ADD.grenos" > "$__MODULES_TO_ADD"
        rm -f "$__MODULES_TO_ADD.grenos" "$DESTDIR/.grenos-sans-graphique"
    fi
fi
# Et ceux qu'un premier passage aurait déjà copiés.
for racine in "$DESTDIR/usr/lib/modules" "$DESTDIR/lib/modules"; do
    [ -d "$racine" ] || continue
    for pilote in nouveau amd/amdgpu radeon i915 xe; do
        rm -rf "$racine"/*/kernel/drivers/gpu/drm/"$pilote"
    done
done
for racine in "$DESTDIR/usr/lib/firmware" "$DESTDIR/lib/firmware"; do
    [ -d "$racine" ] || continue
    for dossier in nvidia amdgpu radeon i915 xe; do
        rm -rf "$racine/$dossier"
    done
done
exit 0
