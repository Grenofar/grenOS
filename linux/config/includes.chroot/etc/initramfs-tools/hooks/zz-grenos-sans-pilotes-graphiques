#!/bin/sh
# Les pilotes de cartes graphiques n'ont rien à faire dans l'initrd
# (19 novembre).
#
# `nouveau` et `amdgpu` déclarent TOUS leurs firmwares (MODULE_FIRMWARE), et
# initramfs-tools copie tout ce qu'un module déclare. L'initrd de l'image
# 1801 pesait 158 Mo, en DEUX exemplaires sur l'ISO et un dans le système.
# Avec le firmware NVIDIA de backports (152 Mo au lieu de 63, pour les RTX 50),
# l'ISO est passée à 2,17 Go et la CI l'a refusée — une Release GitHub
# s'arrête à 2 Go (run 44588740729).
#
# Et c'est aussi du temps : Grenofar voyait DEUX MINUTES d'écran noir au
# démarrage sur une clé USB 2.0, le temps que le firmware lise l'initrd.
#
# Rien n'en a besoin si tôt : l'écran de chargement s'affiche sur le tampon
# du firmware (simpledrm, à la définition que GRUB a choisie), le disque
# chiffré se déverrouille au clavier sur ce même écran, et le vrai pilote se
# charge une fois le système monté, avec son firmware, depuis /usr/lib/firmware.
# Les pilotes des machines virtuelles (bochs, virtio, vmwgfx, qxl) restent :
# ils sont petits et sans firmware.
#
# COMMENT. Les crochets ne copient pas les modules : `manual_add_modules` les
# INSCRIT dans le fichier "$__MODULES_TO_ADD", et mkinitramfs ne les copie
# — firmwares compris, par dracut-install — qu'APRÈS tous les crochets
# (`apply_add_modules`, lu dans mkinitramfs 0.148.4). Supprimer les fichiers
# ici ne servait donc à rien : la première version de ce crochet l'a fait,
# et la construction l'a refusé (initrd de 252 Mo, run 44598026241). On raye
# ces pilotes de la liste avant qu'elle soit lue. C'est plymouth qui les y
# met (`copy_modules_dir kernel/drivers/gpu/drm`), par leur nom court.
#
# « zz » : nos crochets passent après ceux de /usr/share/initramfs-tools.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

[ -n "$DESTDIR" ] || exit 0
MODULES_NOYAU="${MODULESDIR:-/lib/modules/${version:-}}"
if [ -n "${__MODULES_TO_ADD:-}" ] && [ -f "$__MODULES_TO_ADD" ] && [ -d "$MODULES_NOYAU" ]; then
    # Chaque module de ces dossiers, par son nom court (comme plymouth l'écrit).
    noms=$(find "$MODULES_NOYAU/kernel/drivers/gpu/drm/nouveau" \
                "$MODULES_NOYAU/kernel/drivers/gpu/drm/amd" \
                "$MODULES_NOYAU/kernel/drivers/gpu/drm/radeon" \
                "$MODULES_NOYAU/kernel/drivers/gpu/drm/i915" \
                "$MODULES_NOYAU/kernel/drivers/gpu/drm/xe" \
                -name '*.ko*' -printf '%f\n' 2>/dev/null | sed 's/\.ko.*$//' | sort -u)
    # Le pilote officiel de NVIDIA (20 novembre) range ses modules hors de
    # drivers/gpu (updates/dkms) : on les nomme. Son firmware n'est plus dans
    # l'initrd ; chargés trop tôt, ils échoueraient.
    noms=$(printf '%s
nvidia
nvidia_drm
nvidia_modeset
nvidia_uvm
nvidia_peermem' "$noms")
    # LES CARTES RÉSEAU NON PLUS (20 novembre, « rends le boot plus
    # rapide »). Mesuré par cle.yml dans l'initrd de 2059 (88 Mo) : `MODULES=
    # most` y met TOUS les pilotes réseau, et chacun ses firmwares — Netronome
    # 35 Mo, LiquidIO 5 Mo, QLogic, Broadcom (bnx2x, qed), Chelsio, Myricom…
    # des cartes de serveur. Personne ne démarre grenOS par le réseau : la
    # clé et le disque se lisent sans réseau, et le réseau arrive avec le
    # système, depuis /usr/lib/modules. Moins à lire avant l'écran de
    # chargement, sur la clé comme sur le système installé.
    reseau=$(find "$MODULES_NOYAU/kernel/drivers/net" -name '*.ko*' -printf '%f\n' 2>/dev/null \
             | sed 's/\.ko.*$//' | sort -u)
    noms=$(printf '%s\n%s' "$noms" "$reseau")
    if [ -n "$noms" ]; then
        printf '%s\n' "$noms" > "$DESTDIR/.grenos-sans-graphique"
        # … et les DOSSIERS entiers (21 novembre). Le crochet de live-boot
        # appelle `auto_add_modules net` (live.hook 1:20250815, ligne 180),
        # qui inscrit « =drivers/net/ethernet », « =drivers/net/phy » et
        # « =drivers/net/mdio » : des dossiers, pas des noms. Ils passaient le
        # filtre par nom, et mkinitramfs les recopiait APRÈS les crochets
        # (second `apply_add_modules`), Netronome et LiquidIO compris. C'est
        # pour ça que les deux constructions d'avant restaient à 82 Mo (runs
        # 44835521238 et 44844273146) : rien de ce crochet n'y pouvait.
        grep -vxF -f "$DESTDIR/.grenos-sans-graphique" "$__MODULES_TO_ADD" \
            | grep -vE '^=(kernel/)?drivers/net(/|$)' > "$__MODULES_TO_ADD.grenos" || true
        cat "$__MODULES_TO_ADD.grenos" > "$__MODULES_TO_ADD"
        rm -f "$__MODULES_TO_ADD.grenos" "$DESTDIR/.grenos-sans-graphique"
    fi
fi
# Et ceux qu'un premier passage aurait déjà copiés.
for racine in "$DESTDIR/usr/lib/modules" "$DESTDIR/lib/modules"; do
    [ -d "$racine" ] || continue
    for pilote in nouveau amd/amdgpu radeon i915 xe; do
        rm -rf "$racine"/*/kernel/drivers/gpu/drm/"$pilote"
    done
done
for racine in "$DESTDIR/usr/lib/firmware" "$DESTDIR/lib/firmware"; do
    [ -d "$racine" ] || continue
    for dossier in nvidia amdgpu radeon i915 xe; do
        rm -rf "$racine/$dossier"
    done
done
# LES PILOTES RÉSEAU SONT DÉJÀ COPIÉS quand ce crochet tourne (lu dans
# mkinitramfs 0.148.4 : `auto_add_modules` puis `apply_add_modules` AVANT
# les crochets, « because some hooks rely on them »). Les rayer de la liste
# ne suffisait pas — la construction l'a refusé (run 44835521238, initrd de
# 82 Mo avec Netronome). On les efface donc de l'initrd, puis les firmwares
# que seuls ces pilotes demandent — et quand ce nom est un LIEN, ce qu'il
# désigne : dans linux-firmware, netronome/nic_….nffw pointe vers nic/…,
# et effacer le lien seul laissait les 35 Mo. Ce qu'un module restant
# déclare reste (la liste « garder »). Et ce qu'on retirerait de trop,
# mkinitramfs le remet : après les crochets, `hidden_dep_add_modules`
# repasse chaque module restant, ses dépendances et leurs firmwares (qed
# pour le stockage qedf, cnic pour bnx2i…) — lu dans hook-functions 0.148.4.
# `depmod`, que mkinitramfs passe après les crochets, refait l'index.
for racine in "$DESTDIR/usr/lib/modules" "$DESTDIR/lib/modules"; do
    [ -d "$racine" ] || continue
    rm -rf "$racine"/*/kernel/drivers/net
done
if command -v modinfo >/dev/null 2>&1 && [ -d "$MODULES_NOYAU/kernel/drivers/net" ]; then
    reel=$(readlink -f "$DESTDIR")
    garder="$DESTDIR/.grenos-firmwares-gardes"
    find "$DESTDIR/usr/lib/modules" "$DESTDIR/lib/modules" -name '*.ko*' 2>/dev/null \
        | while read -r m; do modinfo -F firmware "$m" 2>/dev/null; done | sort -u > "$garder"
    find "$MODULES_NOYAU/kernel/drivers/net" -name '*.ko*' 2>/dev/null \
        | while read -r m; do modinfo -F firmware "$m" 2>/dev/null; done | sort -u \
        | grep -vxF -f "$garder" \
        | while read -r fw; do
            for racine in "$DESTDIR/usr/lib/firmware" "$DESTDIR/lib/firmware"; do
                for f in "$racine/$fw" "$racine/$fw.xz" "$racine/$fw.zst"; do
                    if [ -L "$f" ]; then
                        # Seulement DANS l'initrd : un lien absolu mènerait
                        # aux firmwares du système lui-même.
                        cible=$(readlink -f "$f")
                        case "$cible" in "$reel"/*) rm -f "$cible" ;; esac
                    fi
                    rm -f "$f"
                done
            done
        done
    rm -f "$garder"
fi
# Netronome et LiquidIO par dossier, quoi qu'il arrive au-dessus : ce sont
# eux que la garde de l'image vérifie (0100-grenos-look) — 40 Mo pour des
# cartes de serveur que rien d'autre ne demande.
for racine in "$DESTDIR/usr/lib/firmware" "$DESTDIR/lib/firmware"; do
    [ -d "$racine" ] || continue
    rm -rf "$racine/netronome" "$racine/liquidio"
    find "$racine" -xtype l -delete 2>/dev/null
    find "$racine" -type d -empty -delete 2>/dev/null
done
exit 0
