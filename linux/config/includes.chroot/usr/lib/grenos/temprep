def aide(_args):
    dire(c(VIOLET, "● ") + c(BLEU, _("temprep — commands sent to another PC on your network", "temprep — des commandes envoyées à un autre PC de ton réseau"), True))
    lignes = (
        (_("open [CODE]", "ouvrir [CODE]"), _("on the PC to help: accept commands (with sudo for repairs)", "sur le PC à aider : accepter des commandes (avec sudo pour réparer)")),
        (_("send CODE -- <command>", "envoyer CODE -- <commande>"), _("run it there, see its output here (or a script on stdin)", "l'exécuter là-bas, voir sa sortie ici (ou un script sur l'entrée)")),
        (_("put CODE <file> <path>", "poser CODE <fichier> <chemin>"), _("copy a file there", "copier un fichier là-bas")),
        (_("get CODE <path> [<file>]", "prendre CODE <chemin> [<fichier>]"), _("bring a file back", "rapatrier un fichier")),
        (_("find CODE", "trouver CODE"), _("the other PC's address", "l'adresse de l'autre PC")),
        (_("close CODE", "fermer CODE"), _("end the session over there", "finir la séance là-bas")),
        ("code", _("draw a new code", "tirer un code neuf")),
    )
    for verbe, texte in lignes:
        dire(f"  {c(BLEU, ('grenget temprep ' + verbe).ljust(46))} {texte}")
    dire(c(GRIS, _("  Options: --address IP (skip the search), --timeout SECONDS (default 1800).",
                   "  Options : --adresse IP (sans recherche), --delai SECONDES (1800 par défaut).")))
    return 0


ACTIONS = {"ouvrir": ouvrir, "envoyer": envoyer, "poser": poser, "prendre": prendre,
           "fermer": fermer, "trouver": trouver, "code": code, "aide": aide}
SYNONYMES = {"open": "ouvrir", "send": "envoyer", "run": "envoyer", "put": "poser", "get": "prendre",
             "close": "fermer", "find": "trouver", "help": "aide", "-h": "aide", "--help": "aide"}


def main(args):
    if not args:
        return aide([])
    action = SYNONYMES.get(args[0], args[0])
    if action not in ACTIONS:
        non(_(f"“{args[0]}” isn't a temprep action.", f"« {args[0]} » n'est pas une action de temprep."))
        aide([])
        return 2
    try:
        return ACTIONS[action](args[1:])
    except Refus as e:
        non(str(e))
        return 255
    except (ssl.SSLError, ConnectionError, socket.timeout) as e:
        non(_(f"connection refused ({e}): wrong code, or temprep closed over there",
              f"connexion refusée ({e}) : mauvais code, ou temprep fermé là-bas"))
        return 255
    except OSError as e:
        non(str(e))
        return 255


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
