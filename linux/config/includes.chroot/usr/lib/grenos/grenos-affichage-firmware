#!/bin/sh
# Le serveur graphique sur l'IMAGE DU FIRMWARE quand aucune carte n'a de pilote.
#
# 20 novembre, RTX 5060 de Grenofar, version 20261120-2059 : `nouveau` n'est
# plus chargé sur les RTX 50 (écran vert), donc l'écran reste sur l'image que
# le firmware a laissée. Le chargement s'affiche, puis : « écran tout noir,
# pas déconnecté ». La CI ne pouvait pas le voir : dans QEMU, la carte a
# toujours son pilote (bochs).
#
# PROUVÉ le même soir par cle.yml (run 44823344458, carte PCI sans pilote,
# UEFI Secure Boot, rapport relu sur la clé) : le noyau 7.3.4 de backports
# n'a AUCUN pilote DRM pour l'image du firmware (ni simpledrm ni efidrm,
# seulement efifb : CONFIG_FB_EFI=y), donc aucun /dev/dri/card0 ; et le
# pilote X `fbdev`, le seul qui sache peindre sur /dev/fb0, n'était pas dans
# l'image. Xorg : « Failed to load module "fbdev" », « open /dev/dri/card0:
# No such file or directory », « vesa: Refusing to run, Framebuffer
# present », « no screens found ». Plymouth, lui, sait peindre sur efifb :
# d'où le chargement, puis le noir.
#
# On ne laisse donc pas X deviner. Deux cas, refaits à CHAQUE démarrage, et
# le fichier est effacé dès qu'un vrai pilote est là (amdgpu, i915, nouveau,
# nvidia…), pour qu'une carte qui reçoit son pilote retrouve tout de suite
# l'affichage complet :
#   - aucun périphérique DRM, seulement /dev/fb0 : X prend `fbdev` dessus ;
#   - seulement des images du firmware en DRM (simpledrm, efidrm, vesadrm,
#     selon le noyau) : X prend modesetting sur celle-ci — Xorg 21.1.16
#     n'accepte d'office que le nom « simpledrm ».
#
# `grenos.firmware-x=0` sur la ligne du noyau le désactive (essais en CI).

set -u
CONF=/etc/X11/xorg.conf.d/10-grenos-image-firmware.conf

dire() {
    echo "grenos: $*" > /dev/kmsg 2>/dev/null || true
}

if grep -qw 'grenos.firmware-x=0' /proc/cmdline 2>/dev/null; then
    rm -f "$CONF"
    dire "affichage : image du firmware laissee a X (grenos.firmware-x=0)"
    exit 0
fi

# Un vrai pilote qui arrive tard remplacerait l'image du firmware : on laisse
# udev finir ce qu'il a en cours (dix secondes au plus, souvent zéro).
udevadm settle -t 10 >/dev/null 2>&1 || true

firmware=""
nom_firmware=""
reel=""
for c in /sys/class/drm/card*; do
    n=$(basename "$c")
    case "$n" in card*-*) continue ;; esac   # les connecteurs (card0-DP-1)
    [ -e "$c/device" ] || continue
    pilote=$(basename "$(readlink -f "$c/device/driver" 2>/dev/null)" 2>/dev/null)
    noyau=$(sed -n 's/^DRIVER=//p' "$c/device/uevent" 2>/dev/null)
    case "$pilote:$noyau" in
        simple-framebuffer:*|efi-framebuffer:*|vesa-framebuffer:*|*:simpledrm|*:efidrm|*:vesadrm|*:ofdrm)
            if [ -z "$firmware" ]; then
                firmware="/dev/dri/$n"
                nom_firmware="${pilote:-$noyau}"
            fi
            ;;
        *)
            reel="$reel ${pilote:-$noyau}"
            ;;
    esac
done

if [ -z "$reel" ] && [ -n "$firmware" ] && [ -e "$firmware" ]; then
    mkdir -p "$(dirname "$CONF")"
    cat > "$CONF.tmp" <<EOF
# Écrit à chaque démarrage par /usr/lib/grenos/grenos-affichage-firmware :
# aucune carte n'a de pilote, l'écran est l'image du firmware ($nom_firmware).
# Effacé tout seul dès qu'un vrai pilote est là.
Section "Device"
    Identifier "grenOS : image du firmware"
    Driver "modesetting"
    Option "kmsdev" "$firmware"
    Option "AccelMethod" "none"
EndSection
EOF
    mv -f "$CONF.tmp" "$CONF"
    dire "affichage : aucune carte n a de pilote, X prend l image du firmware ($nom_firmware sur $firmware)"
elif [ -z "$reel" ] && [ -z "$firmware" ] && [ -c /dev/fb0 ] \
        && [ -f /usr/lib/xorg/modules/drivers/fbdev_drv.so ]; then
    nom_fb=$(cat /sys/class/graphics/fb0/name 2>/dev/null)
    mkdir -p "$(dirname "$CONF")"
    cat > "$CONF.tmp" <<EOF
# Écrit à chaque démarrage par /usr/lib/grenos/grenos-affichage-firmware :
# aucune carte n'a de pilote et le noyau n'offre que /dev/fb0 (${nom_fb:-?}).
# Effacé tout seul dès qu'un vrai pilote est là.
Section "Device"
    Identifier "grenOS : image du firmware"
    Driver "fbdev"
    Option "fbdev" "/dev/fb0"
EndSection
EOF
    mv -f "$CONF.tmp" "$CONF"
    dire "affichage : aucune carte n a de pilote, X peint sur /dev/fb0 (${nom_fb:-?}) par fbdev"
else
    rm -f "$CONF"
    if [ -n "$reel" ]; then
        dire "affichage : pilote de carte present ($reel), X choisit seul"
    elif [ -c /dev/fb0 ]; then
        dire "affichage : seulement /dev/fb0 et pas de pilote X fbdev — l ecran restera noir"
    else
        dire "affichage : aucun peripherique d affichage du noyau"
    fi
fi
exit 0
