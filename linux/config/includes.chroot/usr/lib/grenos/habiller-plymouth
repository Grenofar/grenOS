#!/bin/sh
# L'écran de chargement, et surtout celui de la mise à jour au redémarrage.
#
# POURQUOI CE FICHIER EXISTE
#
# Plymouth possède l'écran pendant tout ce qui précède le bureau. Notre service
# de mise à jour écrivait sagement sur /dev/tty1 — un écran complet, centré,
# aux couleurs de grenOS — **derrière** la splash. Personne ne l'aurait jamais
# vu. Trouvé le 28 septembre en regardant la première capture jamais prise
# PENDANT une mise à jour : un fond grenOS, une roulette, et rien d'autre.
#
# Le thème « spinner » de Debian porte déjà ce qu'il faut, et personne ne
# l'avait lu : une section [updates] avec une barre de progression, un
# pourcentage, un titre et un sous-titre. C'est Windows Update, livré dans le
# paquet. Deux choses clochaient seulement : c'est en anglais, et la section
# interdit les messages, donc on ne pouvait pas dire l'étape en cours.
#
# POURQUOI ON MODIFIE AU LIEU DE LIVRER
#
# `spinner.plymouth` appartient à `plymouth-themes`. Deux paquets ne peuvent
# pas posséder le même chemin — appris le 24 septembre en voyant dpkg refuser
# l'installation. On modifie donc le fichier de Debian, et `appliquer-systeme`
# rejoue ce script après chaque mise à jour, comme pour les autres réglages
# partagés. C'est aussi ce qui le répare si `plymouth-themes` est remis à jour.
#
# Appelé par la construction (le hook) ET par `appliquer-systeme` : le même
# code aux deux endroits, jamais deux copies. Deux dessins d'une même chose
# finissent par diverger, et c'est alors celui qu'on regarde qu'on croit.
set -u

THEME=/usr/share/plymouth/themes/spinner/spinner.plymouth
[ -f "$THEME" ] || exit 0

IMAGES=/usr/share/plymouth/themes/spinner

# Notre fond. Le thème de Debian n'en livre aucun : `background-tile.png` est
# une image que le greffon `two-step` cherche et qui n'existe pas dans le
# paquet. C'est nous qui la créons, et c'est pour cela que l'écran de chargement
# montre notre fond d'écran.
if [ -f /usr/share/grenos/grenos-nuit.png ]; then
    cp /usr/share/grenos/grenos-nuit.png "$IMAGES/background-tile.png" \
        2>/dev/null || true
fi

# Et notre marque. `watermark.png` est cherchée au même endroit, et elle
# n'existait PAS non plus — ni dans le paquet, ni chez nous. Nous réglions donc
# soigneusement `WatermarkVerticalAlignment` depuis des semaines pour placer une
# image absente, et l'écran de chargement n'a jamais porté le nom de grenOS.
#
# Troisième fois le 28 septembre qu'un réglage désigne un fichier qui n'existe
# pas — après `logo.png` de l'installateur et les dessins de boutons d'openbox.
# La forme est toujours la même : le programme ne dit rien, il prend son repli
# et continue.
for marque in /usr/share/icons/hicolor/256x256/apps/grenos.png \
              /usr/share/grenos/logo.png; do
    if [ -f "$marque" ]; then
        cp "$marque" "$IMAGES/watermark.png" 2>/dev/null || true
        break
    fi
done
sed -i 's/^WatermarkVerticalAlignment=.*/WatermarkVerticalAlignment=.22/' \
    "$THEME" 2>/dev/null || true

# La barre de progression à notre bleu, son creux à notre gris.
sed -i 's/^ProgressBarForegroundColor=.*/ProgressBarForegroundColor=0x3b82f6/' \
    "$THEME" 2>/dev/null || true
sed -i 's/^ProgressBarBackgroundColor=.*/ProgressBarBackgroundColor=0x2a3450/' \
    "$THEME" 2>/dev/null || true

# Les quatre modes hors démarrage, en français. La plage `/^\[x\]/,/^\[/`
# s'arrête à l'en-tête suivant : rien ne déborde sur la section d'à côté.
#
# `SuppressMessages` est retiré du seul mode qui nous serve : c'est lui qui
# empêchait `plymouth display-message` d'afficher l'étape en cours. Les trois
# autres modes le gardent — nous ne leur parlons pas.
sed -i "/^\[updates\]/,/^\[/ {
    s/^Title=.*/Title=Mise à jour de grenOS/
    s/^SubTitle=.*/SubTitle=N'éteins pas l'ordinateur./
    /^SuppressMessages=/d
}" "$THEME" 2>/dev/null || true

sed -i "/^\[system-upgrade\]/,/^\[/ {
    s/^Title=.*/Title=Mise à niveau de grenOS/
    s/^SubTitle=.*/SubTitle=N'éteins pas l'ordinateur./
}" "$THEME" 2>/dev/null || true

sed -i "/^\[firmware-upgrade\]/,/^\[/ {
    s/^Title=.*/Title=Mise à jour du micrologiciel/
    s/^SubTitle=.*/SubTitle=N'éteins pas l'ordinateur./
}" "$THEME" 2>/dev/null || true

sed -i "/^\[system-reset\]/,/^\[/ {
    s/^Title=.*/Title=Réinitialisation de grenOS/
    s/^SubTitle=.*/SubTitle=N'éteins pas l'ordinateur./
}" "$THEME" 2>/dev/null || true

# ---- L'extinction et le redémarrage, à nos couleurs -------------------------
#
# Les quatre modes ci-dessus avaient déjà un `Title=` dans le thème de Debian :
# un `s/^Title=.*/` suffisait. Les sections `[shutdown]` et `[reboot]`, elles,
# ne portent qu'une ligne — `UseEndAnimation=false` — vérifié dans le paquet
# `plymouth-themes` 24.004.60-5. Une substitution n'y trouverait rien à
# remplacer et ne dirait rien : il faut AJOUTER.
#
# Pourquoi maintenant : depuis le 1er octobre la splash d'arrêt est enfin levée
# à temps, et les trois photos d'extinction sont noires — le journal a disparu.
# Noir, c'est déjà ce que Grenofar demandait ; ce n'est pas encore « notre »
# écran, et c'est exactement ce qu'il désigne par « ça se voit que l'UI n'est
# pas la tienne ».
#
# On ne promet rien : le greffon `two-step` lit bien un `Title=` dans les
# sections de mode, mais rien ne garantit qu'il le DESSINE en mode arrêt. La CI
# photographie l'extinction à chaque image ; si l'écran reste noir, on l'aura
# su pour le prix d'une construction, et sans rien casser — un titre que
# personne ne dessine ne coûte rien.
poser_titre () {
    # Idempotent : ce script est rejoué par `appliquer-systeme` après CHAQUE
    # mise à jour. Sans l'effacement préalable, chaque passage ajouterait une
    # ligne de plus, et le fichier grossirait sans fin — avec un titre doublé
    # à l'écran dès le deuxième.
    sed -i "/^\[$1\]/,/^\[/ { /^Title=/d; /^SubTitle=/d; }" "$THEME" 2>/dev/null || true
    # Ajoutés dans l'ordre inverse : `a` insère juste après l'en-tête, donc le
    # dernier ajouté se retrouve en premier.
    sed -i "/^\[$1\]/a SubTitle=$3" "$THEME" 2>/dev/null || true
    sed -i "/^\[$1\]/a Title=$2" "$THEME" 2>/dev/null || true
}

poser_titre shutdown "Extinction de grenOS" "Tu peux laisser l'ordinateur."
poser_titre reboot "Redémarrage de grenOS" "Ce sera rapide."

exit 0
