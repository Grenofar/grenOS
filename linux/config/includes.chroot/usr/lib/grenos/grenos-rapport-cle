#!/bin/sh
# Le RAPPORT DE DÉMARRAGE, écrit sur la clé elle-même (20 novembre).
#
# Grenofar, sur sa RTX 5060 : « après le chargement pas d'affichage, écran
# tout noir, pas déconnecté », puis « regarde ma clé bootable, peut-être qu'il
# y a des logs ». Il n'y en avait aucun : le système de la clé n'écrivait rien
# dessus, et un écran noir ne laisse rien lire à personne. Chaque essai sur sa
# machine coûtait un aller-retour de deux heures pour une phrase.
#
# Désormais, sur la clé (et seulement là : boot=live), la machine écrit
# elle-même ce qu'il faut pour comprendre, dans grenos-rapports/ à la racine
# de la clé — lisible depuis Windows en la rebranchant. Rien à faire pour
# lui : démarrer, attendre, éteindre.
#
#   - quand : 25 s, 60 s, 2 min et 4 min après le démarrage, puis à l'arrêt.
#     Un écran noir pousse à couper au bouton : les instantanés du début
#     sont déjà écrits.
#   - en DEUX TEMPS (21 novembre) : d'abord ce qui ne touche ni la carte
#     graphique ni X (résumé, journal, noyau…), écrit sur la clé tout de
#     suite ; ensuite seulement ce qui les interroge. Écran vert du 21 à
#     18 h 50 : le filet de l'écran a redémarré la machine avant le premier
#     instantané, et celui de l'arrêt interrogeait l'écran figé — il
#     attendait, systemd l'a tué au bout de 45 s : AUCUN rapport. Une
#     commande coincée dans le noyau (état D) ne meurt pas, même tuée ; on
#     ne l'attend donc plus jamais (voir `borne`).
#   - quoi : journal et noyau, serveur graphique (Xorg, lightdm), cartes
#     graphiques et écrans, temps de démarrage. Rien de personnel n'y est
#     cherché ; c'est le journal de la machine.
#   - sûreté : la clé (FAT32) n'est ouverte en écriture que le temps de la
#     copie, puis refermée en lecture seule, et vidée sur le disque (`sync`)
#     — une coupure au mauvais moment ne doit pas abîmer la clé qui démarre.
#     Sur une clé gravée en ISO (iso9660), rien ne s'écrit et rien ne casse.
#   - place : les huit derniers démarrages, pas plus.
#
# Tout est borné dans le temps et rend toujours 0 : un rapport ne doit jamais
# retenir ni empêcher un démarrage.
#
#   grenos-rapport-cle boucle     (le service, au démarrage)
#   grenos-rapport-cle arret      (le service, à l'arrêt)
#   grenos-rapport-cle maintenant (à la main)

set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
# Les essais (linux/tools/essai-rapport-cle.sh) posent leurs commandes
# factices devant, et une fausse clé ; rien de cela n'existe au démarrage.
[ -n "${GRENOS_CHEMIN_ESSAI:-}" ] && PATH="$GRENOS_CHEMIN_ESSAI:$PATH"
export PATH LC_ALL=C.UTF-8

CLE=${GRENOS_CLE:-/run/live/medium}
RUN=${GRENOS_RUN:-/run/grenos}
DOSSIER=grenos-rapports
GARDER=8

grep -qw 'boot=live' "${GRENOS_LIGNE:-/proc/cmdline}" 2>/dev/null || exit 0

ID=$(cut -c1-8 /proc/sys/kernel/random/boot_id 2>/dev/null || echo inconnu)
# Le nom du dossier est fixé UNE fois par démarrage (fichier dans /run) : les
# instantanés successifs remplacent le même dossier au lieu d'en créer cinq.
NOMF=$RUN/rapport-cle-nom
mkdir -p "$RUN" 2>/dev/null || true
if [ ! -s "$NOMF" ]; then
    printf '%s-%s\n' "$(date +%Y%m%d-%H%M%S 2>/dev/null || echo date)" "$ID" > "$NOMF" 2>/dev/null || true
fi
NOM=$(cat "$NOMF" 2>/dev/null || echo "rapport-$ID")

# Le processus est-il fini (ou zombie, en attente d'être ramassé) ?
fini() { # pid
    e=$(sed -n 's/^[0-9]* (.*) \([A-Za-z]\) .*/\1/p' "/proc/$1/stat" 2>/dev/null)
    [ -z "$e" ] || [ "$e" = Z ] || [ "$e" = X ]
}

# Une commande bornée, sa sortie dans un fichier, jamais d'échec — et JAMAIS
# d'attente au-delà du délai. `timeout` tue, puis ATTEND que la commande
# meure ; coincée dans le noyau (état D : un écran figé qu'on interroge),
# elle ne meurt pas, et le rapport attendait avec elle (21 novembre). Ici
# elle est tuée, puis abandonnée là : le rapport continue.
borne() { # secondes fichier commande...
    s=$1; f=$2; shift 2
    echo "\$ $*" >> "$f" 2>/dev/null
    "$@" >> "$f" 2>&1 < /dev/null &
    p=$!
    i=0
    while ! fini "$p"; do
        if [ "$i" -ge $((s * 5)) ]; then
            kill -KILL "$p" 2>/dev/null
            printf '(abandonnée après %s s : elle ne répondait plus)\n\n' "$s" >> "$f" 2>/dev/null
            return 0
        fi
        sleep 0.2
        i=$((i + 1))
    done
    wait "$p" 2>/dev/null
    c=$?
    [ "$c" = 0 ] || echo "(code $c)" >> "$f" 2>/dev/null
    echo >> "$f" 2>/dev/null
    return 0
}

# Le serveur X de l'instant : celui de l'assistant (xinit, root) ou celui de
# lightdm. On cherche une autorisation qui marche plutôt que de la deviner.
# Rend 2 si X ne répond plus du tout : inutile alors d'essayer les autres
# clés, chacune coûterait le même délai (et c'est déjà un renseignement).
x_essayer() {
    for a in /var/run/lightdm/root/:0 /run/lightdm/root/:0 /root/.Xauthority \
             /home/*/.Xauthority /root/.serverauth.* /dev/null; do
        # /dev/null en dernier : le serveur de l'assistant (xinit, sans
        # -auth) n'exige aucune clé.
        [ -r "$a" ] || continue
        DISPLAY=:0 XAUTHORITY="$a" timeout -k 1 4 xdpyinfo >/dev/null 2>&1
        case $? in
            0) echo "$a"; return 0 ;;
            124|137) return 2 ;;
        esac
    done
    return 1
}

# Le lien PCIe de chaque carte graphique et du port qui la porte (21
# novembre). Sa RTX 5060 tourne en PCIe 5.0 x8, et ce lien fait des
# erreurs à chaque démarrage, sous Windows aussi (70 « WHEA 17 » par
# seconde) : vitesse, compteurs d'erreurs, économie d'énergie (ASPM). Que
# des lectures de sysfs que le noyau tient en mémoire : rien n'interroge la
# carte elle-même.
lien_pcie() {
    echo "== lien PCIe des cartes graphiques =="
    echo "politique ASPM du noyau : $(cat /sys/module/pcie_aspm/parameters/policy 2>/dev/null || echo illisible)"
    for d in /sys/bus/pci/devices/*; do
        case "$(cat "$d/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
        port=$(basename "$(dirname "$(readlink -f "$d" 2>/dev/null)")")
        for x in "$(basename "$d")" "$port"; do
            p=/sys/bus/pci/devices/$x
            [ -d "$p" ] || continue
            echo "$x : $(cat "$p/current_link_speed" 2>/dev/null) x$(cat "$p/current_link_width" 2>/dev/null) (au plus $(cat "$p/max_link_speed" 2>/dev/null) x$(cat "$p/max_link_width" 2>/dev/null))"
            for c in aer_dev_correctable aer_dev_nonfatal aer_dev_fatal; do
                [ -r "$p/$c" ] || continue
                v=$(grep -v ' 0$' "$p/$c" 2>/dev/null | tr '\n' ' ')
                echo "  $c : ${v:-aucune}"
            done
            [ -r "$p/aer_rootport_total_err_cor" ] && \
                echo "  erreurs corrigées signalées à ce port : $(cat "$p/aer_rootport_total_err_cor" 2>/dev/null)"
            if [ -d "$p/link" ]; then
                printf '  ASPM :'
                for f in "$p"/link/*; do
                    [ -f "$f" ] && printf ' %s=%s' "$(basename "$f")" "$(cat "$f" 2>/dev/null)"
                done
                echo
            fi
        done
    done
    k=$(timeout 20 journalctl -k -b -o cat --no-pager 2>/dev/null)
    echo "lignes « PCIe Bus Error » du noyau : $(printf '%s\n' "$k" | grep -c 'PCIe Bus Error')"
    echo "écran figé (nouveau, wndw timeout) : $(printf '%s\n' "$k" | grep -cE 'nouveau [0-9a-f:.]+: drm: [a-z]+-[0-9]+: timeout')"
}

# Les écrans vus par le noyau (connecteurs DRM). À part, et lancé par
# `borne` : lire les modes d'un connecteur prend un verrou que tient une
# mise à jour d'écran figée.
connecteurs() {
    for c in /sys/class/drm/card*; do
        [ -e "$c" ] || continue
        n=$(basename "$c")
        case "$n" in
            *-*)
                echo "  $n : $(cat "$c/status" 2>/dev/null), actif=$(cat "$c/enabled" 2>/dev/null), modes : $(head -3 "$c/modes" 2>/dev/null | tr '\n' ' ')"
                ;;
            *)
                echo "$n : pilote $(basename "$(readlink -f "$c/device/driver" 2>/dev/null)" 2>/dev/null) ($(sed -n 's/^DRIVER=//p' "$c/device/uevent" 2>/dev/null))"
                ;;
        esac
    done
}

instantane() { # moment
    moment=$1
    T=$(mktemp -d "$RUN/rapport.XXXXXX" 2>/dev/null) || return 0

    # ---- 00 : le résumé, ce qu'on lit en premier --------------------------
    R="$T/00-resume.txt"
    {
        echo "grenOS — rapport de démarrage (moment : $moment)"
        echo "écrit le $(date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null), $(cut -d' ' -f1 /proc/uptime 2>/dev/null) s après le démarrage"
        echo "version : $(cat /usr/share/grenos/version 2>/dev/null || cat /etc/grenos/version 2>/dev/null || echo inconnue)"
        echo "noyau : $(uname -r)"
        echo "ligne du noyau : $(cat /proc/cmdline)"
        sb=inconnu
        for v in /sys/firmware/efi/efivars/SecureBoot-*; do
            [ -f "$v" ] || continue
            case "$(od -An -t u1 -j 4 -N 1 "$v" 2>/dev/null | tr -d ' ')" in
                1) sb=actif ;; 0) sb=inactif ;;
            esac
        done
        [ -d /sys/firmware/efi ] || sb="sans objet (BIOS)"
        echo "secure boot : $sb"
        echo "verrouillage du noyau : $(cat /sys/kernel/security/lockdown 2>/dev/null || echo illisible)"
        # L'horloge (21 novembre) : après une session sur la clé, Windows
        # retardait encore d'une heure, alors que l'image dit LOCAL. Ce que
        # le système croit VRAIMENT, en marche : /etc/adjtime, timedated, et
        # si systemd a recalé l'heure lue au démarrage.
        echo "horloge : /etc/adjtime dit $(sed -n 3p /etc/adjtime 2>/dev/null || echo 'rien (donc UTC)') ; $(timeout 5 timedatectl show -p Timezone -p LocalRTC -p NTPSynchronized 2>/dev/null | tr '\n' ' ')"
        echo "  au démarrage : $(timeout 10 journalctl -b -o cat --no-pager 2>/dev/null | grep -m2 -E 'RTC configured in local time|setting system clock to' | tr '\n' ' ')"
        echo "processeur : $(sed -n 's/^model name\t*: //p' /proc/cpuinfo 2>/dev/null | head -1) ($(nproc 2>/dev/null) coeurs)"
        echo "mémoire : $(sed -n 's/^MemTotal: *//p' /proc/meminfo 2>/dev/null)"
        echo "machine : $(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_name 2>/dev/null | tr '\n' ' ')"
        echo
        echo "== cartes graphiques (PCI) =="
        for d in /sys/bus/pci/devices/*; do
            case "$(cat "$d/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
            pil=$(basename "$(readlink -f "$d/driver" 2>/dev/null)" 2>/dev/null)
            echo "$(basename "$d") $(cat "$d/vendor" 2>/dev/null):$(cat "$d/device" 2>/dev/null) boot_vga=$(cat "$d/boot_vga" 2>/dev/null) pilote=${pil:-AUCUN}"
        done
        echo
        lien_pcie
        echo
        echo "(les écrans vus par le noyau et par X : 50-ecrans.txt)"
        echo
        echo "== modules d'affichage chargés =="
        grep -E '^(nouveau|nvidia[a-z_]*|amdgpu|radeon|i915|xe|bochs|virtio_gpu|vmwgfx|qxl|simpledrm|efidrm|vesadrm) ' /proc/modules 2>/dev/null | cut -d' ' -f1 | tr '\n' ' '
        echo
        echo
        echo "== serveurs graphiques et session =="
        ps -eo pid,etimes,args 2>/dev/null | grep -E '[X]org|[x]init|[l]ightdm|[g]renos-ui|[o]penbox|[g]renos-(shell|bureau|session|premier)|[p]icom|[c]alamares' | cut -c1-220
        echo
        echo "== unités en échec =="
        systemctl --failed --no-legend --plain 2>/dev/null | head -20
        echo
        echo "== ce que Xorg a dit de grave =="
        for x in /var/log/Xorg.0.log /var/log/Xorg.0.log.old /var/log/Xorg.1.log; do
            [ -r "$x" ] || continue
            echo "-- $x"
            grep -E '\(EE\)|Fatal|fatal|no screens|Cannot run|LoadModule: "(modesetting|nouveau|vesa|fbdev|nvidia)"|modeset\(0\)|NOUVEAU\(0\)|VESA\(0\)|Output .* connected|using drv|kmsdev|Refusing|glamor' "$x" 2>/dev/null | head -60
        done
        echo
        echo "== le premier démarrage (assistant) =="
        echo "identité posée : $([ -e /etc/grenos/identite ] && echo oui || echo non)"
        systemctl show -p ActiveState -p SubState -p ExecMainStatus grenos-premier.service lightdm.service 2>/dev/null | tr '\n' ' '
        echo
        echo
        echo "== lignes grenOS du journal =="
        journalctl -b --no-pager -o short-monotonic 2>/dev/null | grep -E 'grenos[:-]' | tail -80
    } > "$R" 2>&1

    # ---- 10 : le temps de démarrage ---------------------------------------
    # Tant que l'assistant est ouvert, systemd dit « démarrage pas fini » :
    # on lit donc les JALONS dans le journal (secondes depuis le noyau). Et
    # la page de l'arrêt ne remplace pas celle du démarrage.
    D="$T/10-demarrage.txt"
    if [ "$moment" != arret ] || [ ! -s "$CLE/$DOSSIER/$NOM/10-demarrage.txt" ]; then
        {
            echo "== jalons (secondes depuis le démarrage du noyau) =="
            timeout 20 journalctl -b --no-pager -o short-monotonic 2>/dev/null | grep -E \
                'Run /init as init process|live-boot|Mounted .*medium|Switching root|systemd 2[0-9][0-9] running|efifb: mode|nouveau .*(DRM|fb0|firmware)|plymouth|Started grenos-premier|X.Org X Server|premier : interface grenos-ui affichee|premier : ecran bienvenue|Started lightdm|session : |Reached target (multi-user|graphical)' \
                | sed 's/^\[ *\([0-9.]*\)\] [^ ]* /\1 s  /' | cut -c1-170 | head -60
            echo
        } > "$D" 2>/dev/null
        borne 15 "$D" systemd-analyze
        borne 15 "$D" sh -c 'systemd-analyze blame | head -60'
    fi

    # ---- 20, 30 : le journal et le noyau ----------------------------------
    timeout 30 journalctl -b --no-pager -o short-monotonic 2>/dev/null | tail -n 40000 > "$T/20-journal.txt" 2>/dev/null
    timeout 10 dmesg 2>/dev/null > "$T/30-noyau.txt"

    # ---- 40 : le serveur graphique ----------------------------------------
    X="$T/40-xorg.txt"
    for f in /var/log/Xorg.0.log /var/log/Xorg.0.log.old /var/log/Xorg.1.log \
             /var/log/lightdm/lightdm.log /var/log/lightdm/x-0.log \
             /var/log/lightdm/seat0-greeter.log \
             /home/*/.xsession-errors /home/*/.local/share/xorg/Xorg.*.log \
             /root/.local/share/xorg/Xorg.*.log; do
        [ -r "$f" ] || continue
        { echo "======== $f"; tail -n 3000 "$f"; echo; } >> "$X" 2>/dev/null
    done
    { echo "======== /etc/X11/xorg.conf.d"; head -50 /etc/X11/xorg.conf.d/*.conf; } >> "$X" 2>/dev/null

    # ---- 60 : l'installateur et les disques (21 novembre) ----------------
    # « Il bloque au partitionnement, on ne peut plus choisir » : sans le
    # journal de Calamares et la liste de ce qui était monté, on devine.
    I="$T/60-installateur.txt"
    borne 10 "$I" lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MODEL,MOUNTPOINTS
    borne 10 "$I" findmnt -rn -t ext4,ext3,ext2,vfat,exfat,ntfs,ntfs3,fuseblk,btrfs,xfs -o TARGET,SOURCE,FSTYPE,OPTIONS
    for f in /root/.cache/calamares/session.log /home/*/.cache/calamares/session.log; do
        [ -r "$f" ] || continue
        { echo "======== $f"; tail -n 4000 "$f"; echo; } >> "$I" 2>/dev/null
    done

    # ---- 70 : le son (21 novembre) ----------------------------------------
    # « Sur la clé, il n'a pas trouvé tous mes périphériques audio » : ce que
    # le noyau voit (cartes ALSA, contrôleurs PCI et leur pilote), ce que
    # PipeWire en fait (sorties et entrées de la session), et ce qui a échoué.
    A="$T/70-son.txt"
    { echo "== /proc/asound/cards"; cat /proc/asound/cards; echo; } >> "$A" 2>/dev/null
    borne 10 "$A" aplay -l
    borne 10 "$A" arecord -l
    borne 10 "$A" sh -c 'lspci -nnk | grep -A3 -iE "audio|0403"'
    for u in /run/user/[0-9]*; do
        [ -d "$u" ] || continue
        qui=$(stat -c %U "$u" 2>/dev/null)
        [ -n "$qui" ] && [ "$qui" != root ] || continue
        borne 10 "$A" runuser -u "$qui" -- env XDG_RUNTIME_DIR="$u" pactl list short sinks
        borne 10 "$A" runuser -u "$qui" -- env XDG_RUNTIME_DIR="$u" pactl list short sources
        borne 10 "$A" runuser -u "$qui" -- env XDG_RUNTIME_DIR="$u" pactl list cards
    done
    { echo "== journal (son)"; timeout 20 journalctl -b --no-pager -o short-monotonic 2>/dev/null \
        | grep -iE 'snd|hda|sof-|sof_|audio|codec|pipewire|wireplumber|alsa' | tail -n 300; } >> "$A" 2>/dev/null

    # ---- Premier temps : sur la clé TOUT DE SUITE -------------------------
    # Rien de ce qui précède ne parle à la carte graphique ni à X : même
    # écran figé, ceci arrive sur la clé.
    ecrire_sur_la_cle "$T" "premier temps"

    # ---- 50 : les écrans, vus par le noyau et par X -----------------------
    # Tout ici peut buter sur un écran figé : chaque commande passe par
    # `borne`, qui abandonne au lieu d'attendre.
    E="$T/50-ecrans.txt"
    echo "== écrans vus par le noyau (DRM)" >> "$E"
    borne 5 "$E" "$0" connecteurs
    AUTH=$(x_essayer)
    case $? in
        0)
            echo "autorisation X : $AUTH" >> "$E"
            (
                export DISPLAY=:0 XAUTHORITY="$AUTH"
                # --current : surtout pas une nouvelle interrogation des
                # écrans, qui fige X (le défaut des Réglages, 20 novembre).
                borne 10 "$E" xrandr --current --verbose
                borne 10 "$E" xdpyinfo
                borne 10 "$E" glxinfo -B
            )
            ;;
        2) echo "le serveur X (:0) ne répond plus : figé ?" >> "$E" ;;
        *) echo "aucun serveur X joignable sur :0 à ce moment" >> "$E" ;;
    esac
    for s in /sys/kernel/debug/dri/*/state; do
        [ -r "$s" ] || continue
        echo "======== $s" >> "$E"
        borne 5 "$E" cat "$s"
    done
    { echo "======== /proc/bus/input/devices"; cat /proc/bus/input/devices; } >> "$E" 2>/dev/null
    borne 10 "$E" lspci -nnk
    # Le détail du lien (LnkSta, LnkCtl2, erreurs) de chaque carte et de son
    # port : ce que les compteurs du résumé ne disent pas.
    for d in /sys/bus/pci/devices/*; do
        case "$(cat "$d/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
        port=$(basename "$(dirname "$(readlink -f "$d" 2>/dev/null)")")
        borne 10 "$E" lspci -vv -s "$(basename "$d")"
        [ -d "/sys/bus/pci/devices/$port" ] && borne 10 "$E" lspci -vv -s "$port"
    done

    # ---- Second temps : la copie complète --------------------------------
    ecrire_sur_la_cle "$T" "complet"
    rm -rf "$T" 2>/dev/null
    return 0
}

ecrire_sur_la_cle() { # dossier, temps
    src=$1
    [ -d "$CLE/live" ] || return 0
    type=$(findmnt -no FSTYPE "$CLE" 2>/dev/null | head -1)
    case "$type" in
        vfat|exfat|ntfs|ntfs3|ext2|ext3|ext4) ;;
        *) return 0 ;;   # iso9660 : une clé gravée ne s'écrit pas
    esac
    (
        # Un seul écrivain à la fois : l'arrêt peut croiser le dernier
        # instantané.
        flock -w 20 9 || exit 0
        etait_ro=0
        findmnt -no OPTIONS "$CLE" 2>/dev/null | grep -qE '(^|,)ro(,|$)' && etait_ro=1
        if [ "$etait_ro" = 1 ]; then
            timeout 15 mount -o remount,rw "$CLE" 2>/dev/null || exit 0
        fi
        mkdir -p "$CLE/$DOSSIER/$NOM" 2>/dev/null
        for f in "$src"/*.txt; do
            [ -s "$f" ] && cp -f "$f" "$CLE/$DOSSIER/$NOM/" 2>/dev/null
        done
        if [ ! -e "$CLE/$DOSSIER/LISEZMOI.txt" ]; then
            printf '%s\r\n' \
                "Ces dossiers sont écrits par grenOS quand il démarre depuis cette clé." \
                "Un dossier par démarrage (date-identifiant), les huit derniers seulement." \
                "Ils servent à comprendre un écran noir ou une panne : rien de personnel n'y est cherché." \
                "Tu peux les effacer sans risque." > "$CLE/$DOSSIER/LISEZMOI.txt" 2>/dev/null
        fi
        # Les plus anciens partent : huit démarrages suffisent.
        ls -1d "$CLE/$DOSSIER"/2*/ 2>/dev/null | sort | head -n "-$GARDER" | while read -r vieux; do
            rm -rf "$vieux" 2>/dev/null
        done
        sync
        if [ "$etait_ro" = 1 ]; then
            timeout 15 mount -o remount,ro "$CLE" 2>/dev/null || true
        fi
    ) 9>"$RUN/cle.verrou"
    echo "grenos: rapport de demarrage ecrit sur la cle ($DOSSIER/$NOM, ${2:-complet})" 2>/dev/null > /dev/kmsg || true
    return 0
}

case "${1:-maintenant}" in
    connecteurs)
        # Appelé par l'instantané lui-même, à travers `borne`.
        connecteurs
        ;;
    boucle)
        # Le début compte le plus : c'est là que l'écran devient noir.
        for etape in 25:25s 35:1min 60:2min 120:4min; do
            sleep "${etape%%:*}"
            instantane "${etape#*:}"
        done
        # Le service doit rester « actif » pour que l'arrêt écrive le dernier.
        exec sleep infinity
        ;;
    arret)
        instantane arret
        ;;
    *)
        instantane "${1:-maintenant}"
        ;;
esac
exit 0
