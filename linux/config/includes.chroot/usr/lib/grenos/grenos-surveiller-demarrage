#!/bin/sh
# C15 et C16 : « apres un plantage noyau, un pilote fautif ou un demarrage
# rate, grenOS demarre seul en environnement minimal et dit : le dernier
# demarrage a echoue, cause probable : pilote reseau ».
#
# CE FICHIER NE FAIT QUE LA PREMIERE MOITIE, ET C EST CELLE QUI MANQUE A TOUT
# LE RESTE : savoir qu un demarrage a echoue. Sans elle, C15 n a rien sur quoi
# se declencher et C16 n a rien a expliquer.
#
# COMMENT ON LE SAIT. Un demarrage qui echoue ne laisse rien derriere lui : la
# machine s arrete, ou elle tourne sans bureau, et personne n ecrit « j ai
# echoue ». On prend donc le probleme par l autre bout — le bureau, quand il
# s ouvre, DEPOSE UN JETON au nom de ce demarrage. Au demarrage suivant, un
# demarrage precedent sans jeton ne peut vouloir dire qu une chose.
#
# LA PREMIERE VERSION FAISAIT L INVERSE, ET ELLE ETAIT FAUSSE. Le service
# posait un temoin que la session devait EFFACER. Mais la session tourne en
# tant que la personne, et `/var/lib/grenos` appartient a root : l effacement
# ne pouvait pas avoir lieu. Pire, il etait garde derriere un `[ -w ]`, donc
# il echouait EN SILENCE — et la machine d integration a immediatement annonce
# « le dernier demarrage n a pas ouvert de bureau » sur un demarrage qui avait
# parfaitement ouvert le sien. Une mesure fausse, stable, qui aurait declenche
# le mode sans echec a chaque demarrage reussi.
#
# Le sens est donc inverse : deposer demande moins de droits qu effacer. Le
# service cree `bureau/` en 1777 — le bit collant, comme /tmp : chacun y
# depose, personne n y efface ce qui n est pas a lui — et c est la session qui
# y ecrit un fichier vide portant le `boot_id`.
#
# ET IL NE DOIT JAMAIS BLOQUER UN DEMARRAGE. Il rend toujours 0, et chaque
# lecture est bornee. Un compteur d echecs qui empeche de demarrer serait la
# panne qu il est cense prevenir.

set -u

ETAT=/var/lib/grenos
JETONS="$ETAT/bureau"
PRECEDENT="$ETAT/dernier-demarrage"
COMPTEUR="$ETAT/demarrages-echoues"
CAUSE="$ETAT/derniere-cause"

dire() {
    if command -v grenos-dire >/dev/null 2>&1; then
        grenos-dire "secours : $1"
    else
        echo "grenos: secours : $1"
    fi
}

mkdir -p "$ETAT" 2>/dev/null || true
# 1777 : le bit collant. N importe quelle session peut y deposer son jeton,
# et personne ne peut effacer celui d un autre.
mkdir -p "$JETONS" 2>/dev/null || true
chmod 1777 "$JETONS" 2>/dev/null || true

ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo inconnu)

# ---------------------------------------------------------------- C16, la cause
#
# On ne devine pas : on demande au journal du demarrage PRECEDENT. Chaque
# reponse est bornee dans le temps, parce que `journalctl` sur un journal
# abime peut prendre longtemps, et nous sommes avant le bureau.
#
# L ordre compte : du plus grave au plus explicite. Une panique noyau explique
# tout ce qui suit, donc elle passe avant les unites en echec.
cause_probable() {
    if ! command -v journalctl >/dev/null 2>&1; then
        echo "journal indisponible, cause inconnue"
        return
    fi
    noyau=$(timeout 10 journalctl -b -1 -k -p 3 --no-pager -o cat 2>/dev/null \
            | grep -m 1 -i 'kernel panic\|Oops\|BUG:\|general protection fault' || true)
    if [ -n "$noyau" ]; then
        echo "le noyau s est arrete : $(printf '%s' "$noyau" | cut -c1-80)"
        return
    fi
    pilote=$(timeout 10 journalctl -b -1 -k --no-pager -o cat 2>/dev/null \
             | grep -m 1 -i 'failed to load firmware\|probe.*failed\|Direct firmware load.*failed' || true)
    if [ -n "$pilote" ]; then
        echo "un pilote n a pas pu se charger : $(printf '%s' "$pilote" | cut -c1-80)"
        return
    fi
    unite=$(timeout 10 journalctl -b -1 --no-pager -o cat 2>/dev/null \
            | grep -m 1 -o 'Failed to start [^.]*' || true)
    if [ -n "$unite" ]; then
        echo "un service n a pas demarre : $(printf '%s' "$unite" | cut -c1-80)"
        return
    fi
    # Et si le journal ne dit rien, on le DIT au lieu d inventer. Une machine
    # coupee au bouton ne laisse aucune trace, et c est le cas le plus
    # frequent — y compris sur la machine d integration, qui est TUEE.
    echo "rien dans le journal : coupure de courant ou arret au bouton"
}

# ------------------------------------------- le demarrage precedent, juge au jeton
AVANT=$(head -n 1 "$PRECEDENT" 2>/dev/null)
if [ -z "$AVANT" ]; then
    dire "premier demarrage connu, rien a comparer"
elif [ "$AVANT" = "$ID" ]; then
    # Le meme `boot_id` : nous relisons notre propre passage. Cela ne peut
    # arriver que si le service tourne deux fois dans le meme demarrage, et
    # conclure ici compterait un echec imaginaire — la faute exacte du temoin
    # de persistance du 27 septembre.
    dire "deja passe dans CE demarrage, rien a conclure"
elif [ -e "$JETONS/$AVANT" ]; then
    printf '0\n' > "$COMPTEUR" 2>/dev/null || true
    dire "le dernier demarrage avait ouvert son bureau"
else
    N=$(cat "$COMPTEUR" 2>/dev/null)
    case "$N" in ''|*[!0-9]*) N=0 ;; esac
    N=$((N + 1))
    printf '%s\n' "$N" > "$COMPTEUR" 2>/dev/null || true
    POURQUOI=$(cause_probable)
    printf '%s\n' "$POURQUOI" > "$CAUSE" 2>/dev/null || true
    dire "le dernier demarrage n a pas ouvert de bureau ($N d affilee)"
    dire "cause probable : $POURQUOI"
fi

# On garde le dossier de jetons borne : seuls le demarrage precedent et le
# notre ont encore un sens. Sans ce menage, un an de demarrages s y
# accumulerait, et personne ne le regarderait jamais.
for jeton in "$JETONS"/*; do
    [ -e "$jeton" ] || continue
    nom=$(basename "$jeton")
    [ "$nom" = "$AVANT" ] || [ "$nom" = "$ID" ] || rm -f "$jeton" 2>/dev/null || true
done

printf '%s\n' "$ID" > "$PRECEDENT" 2>/dev/null || true
exit 0
