#!/bin/sh
# LE FILET DE L'ÉCRAN DES RTX 50 (20 novembre) — la moitié « garder ».
#
# Sur la RTX 5060 de Grenofar, `nouveau` a donné un écran VERT plusieurs
# fois ; sans lui, l'image du firmware est toujours lisible (60 Hz, un
# écran). grenos-nouveau-ou-pas réessaie `nouveau` (X sans glamor) tant que
# cette machine n'a pas été jugée illisible. Ce service s'assure que
# personne ne reste devant un écran qu'il ne voit pas :
#
#   1. AVANT les serveurs X (oneshot : l'assistant attend qu'il ait fini
#      d'armer), il pose un témoin d'essai, sur la clé ou dans /etc/grenos.
#      Une coupure au bouton le laisse en place, et le démarrage suivant
#      prend alors l'image du firmware ;
#   2. l'assistant (grenos-premier-lanceur) l'efface dès que la personne
#      quitte l'écran de bienvenue : elle le voit, « nouveau » est gardé.
#      Sur un grenOS déjà installé (réessai depuis les Réglages), c'est la
#      session qui demande « Tu vois bien cet écran ? » (Réglages › Écran).
#      Et un BUREAU OUVERT (openbox lancé) vaut confirmation : X marche ;
#   3. trois minutes SANS assistant affiché NI bureau — X n'a rien pu
#      montrer — et la machine garde « firmware » puis redémarre d'elle-même.
#      Jamais pendant qu'un assistant ou un bureau est à l'écran (21
#      novembre : ce filet a redémarré la session de Grenofar qui marchait).
#
# Armé seulement quand l'assistant va s'ouvrir (machine pas encore nommée)
# et quand le choix peut être gardé : sans cela, personne ne confirmerait
# et la machine redémarrerait pour rien.
#
#   grenos-affichage-garde          armer (le service)
#   grenos-affichage-garde attendre (lancé par le premier, en arrière-plan)

set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
ETAT=/usr/lib/grenos/grenos-affichage-etat
DELAI=180

dire() {
    echo "grenos: $*" > /dev/kmsg 2>/dev/null || true
}

if [ "${1:-}" = attendre ]; then
    t=0
    while [ "$t" -lt "$DELAI" ]; do
        sleep 5
        t=$((t + 5))
        if ! "$ETAT" existe affichage-essai; then
            dire "ecran : confirme apres ${t} s, nouveau garde"
            exit 0
        fi
        if [ -e /run/grenos/affichage-garde-suspendu ]; then
            dire "ecran : garde suspendue (assistant de secours ouvert), le temoin reste"
            exit 0
        fi
        # UN BUREAU OUVERT EST UNE PREUVE (21 novembre). Sur la RTX 5060 de
        # Grenofar, l'assistant n'a pas pu s'afficher (plymouth tenait la
        # carte), lightdm a ouvert le bureau — à 300 Hz, curseur fluide — et
        # ce filet, qui n'attendait QUE l'assistant, a écrit « firmware » et
        # REDÉMARRÉ sa machine en pleine session au bout de 180 s (rapport de
        # sa clé, 20261121-002001). Le gestionnaire de fenêtres de la
        # session tourne : X marche sous `nouveau`, sans glamor — la cause du
        # vert d'avant. On garde « nouveau », et on ne touche à rien.
        if pgrep -x openbox >/dev/null 2>&1; then
            "$ETAT" effacer affichage-essai
            "$ETAT" ecrire affichage nouveau
            dire "ecran : bureau ouvert sous nouveau apres ${t} s — affichage garde, rien n est redemarre"
            exit 0
        fi
    done
    # L'assistant est affiché mais personne n'a encore avancé : quelqu'un qui
    # lit, ou qui est parti boire un café. On ne redémarre JAMAIS sous ses
    # yeux : le lanceur confirmera quand il avancera, et s'il coupe au bouton
    # parce qu'il ne voit rien, le témoin resté fera prendre l'image du
    # firmware au démarrage suivant.
    if [ -e /run/grenos/premier-ui-pret ]; then
        dire "ecran : assistant affiche mais pas encore passe apres $DELAI s — on attend, rien n est redemarre"
        exit 0
    fi
    # Ni assistant ni bureau en trois minutes : X n'a rien pu afficher.
    dire "ecran : ni assistant ni bureau en $DELAI s — image du firmware, redemarrage"
    "$ETAT" ecrire affichage firmware
    "$ETAT" effacer affichage-essai
    sync
    systemctl reboot
    exit 0
fi

# Une RTX 50 (0x2B00 à 0x2FFF chez NVIDIA) dans la machine ?
carte_rtx50() { # pilote attendu, ou vide pour « n'importe lequel »
    for d in /sys/bus/pci/devices/*; do
        [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] || continue
        case "$(cat "$d/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
        id=$(($(cat "$d/device" 2>/dev/null || echo 0)))
        [ "$id" -ge $((0x2b00)) ] && [ "$id" -le $((0x2fff)) ] || continue
        [ -z "$1" ] && return 0
        [ "$(basename "$(readlink -f "$d/driver" 2>/dev/null)")" = "$1" ] && return 0
    done
    return 1
}

choix() {
    for f in /run/live/medium/grenos/affichage /etc/grenos/affichage; do
        if [ -r "$f" ]; then
            tr -dc 'a-z' < "$f"
            return 0
        fi
    done
}

grep -qw 'grenos.nouveau=1' /proc/cmdline 2>/dev/null && exit 0
# Une machine déjà nommée n'ouvre plus l'assistant : on ne s'arme alors que
# sur un RÉESSAI demandé dans les Réglages (la session posera la question).
reessai=0
"$ETAT" existe affichage-reessai 2>/dev/null && reessai=1
if [ "$reessai" = 1 ]; then
    "$ETAT" effacer affichage-reessai 2>/dev/null
elif [ -e /etc/grenos/identite ]; then
    exit 0
fi
carte_rtx50 "" || exit 0
# `nouveau` se charge pendant que udev parcourt les cartes : on lui laisse
# le temps d'arriver (dix secondes au plus, seulement sur ces machines).
udevadm settle -t 10 >/dev/null 2>&1 || true
carte_rtx50 nouveau || exit 0
[ "$(choix)" = nouveau ] && exit 0

if ! "$ETAT" ecrire affichage-essai "$(date +%s)"; then
    dire "ecran : RTX 50 sous nouveau, mais le choix ne peut pas etre garde ici (cle gravee en ISO ?) — pas de filet"
    exit 0
fi
dire "ecran : RTX 50 sous nouveau, essai sous surveillance ($DELAI s pour passer le premier ecran)"
"$0" attendre &
exit 0
