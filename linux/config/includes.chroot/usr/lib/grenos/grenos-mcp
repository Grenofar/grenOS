# ---- Le protocole -----------------------------------------------------------

def repondre(identifiant, resultat=None, erreur=None):
    message = {"jsonrpc": "2.0", "id": identifiant}
    if erreur is not None:
        message["error"] = erreur
    else:
        message["result"] = resultat
    sys.stdout.write(json.dumps(message, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def traiter(message):
    methode = message.get("method")
    identifiant = message.get("id")
    parametres = message.get("params") or {}
    if identifiant is None:
        return  # une notification (notifications/initialized…) : rien à rendre
    if methode == "initialize":
        repondre(identifiant, {
            # La version que le client demande : nos outils n'en dépendent pas.
            "protocolVersion": parametres.get("protocolVersion") or "2025-06-18",
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "grenos", "version": VERSION},
            "instructions": "grenOS (Debian) piloté sur la machine de la personne. Prendre une capture "
                            "avant d'agir à la souris ; les coordonnées suivent la dernière capture.",
        })
    elif methode == "ping":
        repondre(identifiant, {})
    elif methode == "tools/list":
        repondre(identifiant, {"tools": [{"name": n, "description": d, "inputSchema": s}
                                         for n, (_, d, s) in OUTILS.items()]})
    elif methode == "tools/call":
        nom = parametres.get("name")
        if nom not in OUTILS:
            repondre(identifiant, erreur={"code": -32602, "message": "outil inconnu : %s" % nom})
            return
        try:
            repondre(identifiant, OUTILS[nom][0](parametres.get("arguments") or {}))
        except Exception as souci:  # l'outil échoue : Claude doit le lire, pas le serveur mourir
            journal("%s : %s" % (nom, souci))
            repondre(identifiant, texte("%s : %s" % (nom, souci), erreur=True))
    else:
        repondre(identifiant, erreur={"code": -32601, "message": "méthode inconnue : %s" % methode})


def main():
    retrouver_session()
    journal("pret (%d outils)" % len(OUTILS))
    for ligne in sys.stdin:
        ligne = ligne.strip()
        if not ligne:
            continue
        try:
            message = json.loads(ligne)
        except ValueError:
            repondre(None, erreur={"code": -32700, "message": "JSON illisible"})
            continue
        for m in (message if isinstance(message, list) else [message]):
            traiter(m)


if __name__ == "__main__":
    main()
