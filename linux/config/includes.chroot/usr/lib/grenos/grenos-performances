#!/bin/sh
# Demander à la machine tout ce qu'elle sait donner.
#
# Grenofar, le 1er octobre : « l'os doit pouvoir utiliser ABSOLUMENT TOUTES LES
# PERF DISPO ET BIEN LES GERER, PRIVILEGIER LES JEUX ».
#
# CE QU'IL NE FAUT PAS LUI RACONTER
#
# Linux prend déjà tout ce que la machine donne : il n'y a aucune bride à
# lever, et prétendre le contraire serait vendre du vide. Ce qui existe
# vraiment, et qui change quelque chose, c'est **quand** le processeur monte en
# fréquence, et **qui** encaisse les interruptions.
#
# LE GOUVERNEUR, ET POURQUOI IL COMPTE DANS UN JEU
#
# Debian laisse `schedutil` : il monte en fréquence APRÈS avoir vu la charge.
# Entre l'instant où une image de jeu demande du calcul et celui où le
# processeur accélère, il s'écoule quelques millisecondes — et cette fraction
# de seconde est exactement une saccade. `performance` tient la fréquence
# haute en permanence : plus d'attente, au prix du courant.
#
# CE QUI PEUT NE PAS EXISTER, ET QU'IL FAUT DIRE AU LIEU DE SUPPOSER
#
# Beaucoup de machines virtuelles n'exposent **aucun** pilote de fréquence : le
# dossier `cpufreq` n'existe pas, et il n'y a rien à régler. C'est le cas de
# QEMU et souvent de VirtualBox. Dans ce cas ce script ne force rien et le dit
# sur le port série, plutôt que d'échouer en silence ou de prétendre avoir agi.
#
# Il rend toujours 0 : un réglage de confort ne doit jamais empêcher une
# machine de finir son démarrage.
set -u

dire () {
    echo "grenos: $1" > /dev/ttyS0 2>/dev/null || true
}

# ---- Le droit, pour un jeu, de passer devant ---------------------------------
#
# CE BLOC EXISTE PARCE QUE MON PROPRE COMMENTAIRE ETAIT FAUX.
#
# J'avais écrit, dans `gamemode.ini` et dans la page Jeux, que
# « `appliquer-systeme` ajoute au groupe gamemode à chaque mise à jour ». C'est
# vrai, et c'est insuffisant : `appliquer-systeme` ne s'exécute QUE depuis le
# paquet et depuis la mise à jour au démarrage. Sur l'image live que Grenofar
# démarre, et sur une installation fraîche avant la première mise à jour,
# **personne n'ajoute le compte au groupe**.
#
# La construction l'a dit elle-même, en une ligne que j'avais rendue
# facultative exprès : « le groupe gamemode n'existe PAS encore dans l'image ».
# Il est créé par `systemd-sysusers` au premier démarrage — donc après la
# construction, et avant ce service-ci.
#
# Le faire ici coûte zéro processus de plus : cette unité est un `oneshot` qui
# existe déjà et qui se termine aussitôt. Grenofar a demandé « éviter les
# processus en trop » dans la même phrase que « privilégier les jeux » ; en
# ajouter un pour cela serait lui donner une main et lui reprendre l'autre.
#
# `usermod -aG` ne change rien à une session DÉJÀ ouverte — la page de manuel
# de gamemoded le dit (« and then rebooted »). Ce service passe avant lightdm
# au démarrage suivant, donc la session en profite.
groupe_des_jeux () {
    getent group gamemode >/dev/null 2>&1 || {
        dire "perf : le groupe gamemode n existe pas, rien a faire"
        return 0
    }
    ajoutes=0
    for compte in $(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd 2>/dev/null); do
        if id -nG "$compte" 2>/dev/null | tr ' ' '\n' | grep -qx gamemode; then
            continue
        fi
        if usermod -aG gamemode "$compte" >/dev/null 2>&1; then
            ajoutes=$((ajoutes + 1))
        fi
    done
    dire "perf : $ajoutes compte(s) ajoute(s) au groupe gamemode"
}

groupe_des_jeux

# ---- LE GESTIONNAIRE DE CONNEXION EST-IL ENCORE PRÉVU ? ---------------------
#
# CETTE LIGNE EXISTE PARCE QUE L'ABSENCE DE BUREAU N'A LAISSÉ AUCUNE TRACE.
#
# Le 2 octobre, l'image a démarré jusqu'au premier écran puis s'est arrêtée sur
# un écran noir. `serial.log` faisait 216 octets, et le journal de la
# construction ne disait rien : notre ligne de commande porte `quiet` et
# `loglevel=3`, donc les avertissements de systemd — dont « Job
# lightdm.service/start deleted to break ordering cycle » — ne sortent nulle
# part. J'ai dû raisonner au lieu de lire.
#
# Cette unité s'exécute précisément au bon moment pour répondre : après
# `multi-user.target`, c'est-à-dire quand le travail de lightdm est déjà en
# file s'il doit l'être. Si systemd l'a supprimé pour casser un cycle, il n'y
# est plus — et c'est la seule différence observable entre « lightdm va
# démarrer » et « lightdm ne démarrera jamais ».
#
# Un faux cycle réintroduit un jour par une unité quelconque se verra alors en
# UN passage, au lieu de cinq.
etat_lightdm=$(systemctl is-active display-manager.service 2>/dev/null || true)
travaux=$(systemctl list-jobs --no-legend --no-pager 2>/dev/null \
          | grep -c -e display-manager -e lightdm || true)
if [ "$etat_lightdm" = active ] || [ "$etat_lightdm" = activating ]; then
    dire "perf : gestionnaire de connexion $etat_lightdm"
elif [ "${travaux:-0}" -gt 0 ]; then
    dire "perf : gestionnaire de connexion en file ($travaux travail/travaux)"
else
    dire "perf : AUCUN travail lightdm en file — le bureau ne s ouvrira PAS"
fi

CPUFREQ=/sys/devices/system/cpu/cpu0/cpufreq

if [ ! -d "$CPUFREQ" ]; then
    dire "perf : aucun pilote de frequence sur cette machine, rien a regler"
    exit 0
fi

# Ce que le pilote accepte vraiment. Forcer `performance` sur un pilote qui ne
# le connaît pas écrirait dans un fichier et ne changerait rien — la forme de
# défaut que ce dépôt passe son temps à trouver.
DISPOS=$(cat "$CPUFREQ/scaling_available_governors" 2>/dev/null || echo "")
case " $DISPOS " in
    *" performance "*) ;;
    *)
        dire "perf : le pilote n offre pas performance, il offre [${DISPOS:-rien}]"
        exit 0
        ;;
esac

POSES=0
for gouverneur in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$gouverneur" ] || continue
    if echo performance > "$gouverneur" 2>/dev/null; then
        POSES=$((POSES + 1))
    fi
done

# On relit. Écrire n'est pas poser : c'est la règle qui a coûté une semaine sur
# l'affichage des messages d'arrêt — la commande réussissait et la valeur
# revenait à l'ancienne.
RELU=$(cat "$CPUFREQ/scaling_governor" 2>/dev/null || echo "?")
dire "perf : gouverneur demande sur $POSES coeur(s), relu = $RELU"
exit 0
