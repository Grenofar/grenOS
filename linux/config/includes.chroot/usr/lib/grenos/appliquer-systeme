#!/bin/sh
# Brancher grenOS dans le système : services, icônes, entrées de menu.
#
# Ce script est le **seul** endroit qui décrit ce branchement, et il est appelé
# à deux moments : quand l'image se construit, et quand le paquet
# `grenos-desktop` s'installe ou se met à jour. C'est ce qui permet à une mise
# à jour d'apporter une vraie nouveauté — un service qui n'existait pas, une
# entrée de menu, une icône — et pas seulement de remplacer des fichiers.
#
# Sans lui, ajouter un service voulait dire regraver une image : le fichier
# serait bien arrivé, mais personne ne l'aurait allumé.
#
# Il ne touche jamais au dossier personnel de qui que ce soit, ni au compte, ni
# au mot de passe, ni aux réglages déjà choisis : uniquement /usr et /etc.

set -e

echo "grenos: branchement du systeme"

# ---- Les services -----------------------------------------------------------
# `daemon-reload` d'abord : sans lui, systemd ne voit pas un service nouveau.
systemctl daemon-reload >/dev/null 2>&1 || true

# Le premier écran ne se rallume pas sur une machine déjà nommée : sa condition
# (l'absence de /etc/grenos/identite) s'en charge, mais autant être clair.
for service in grenos-premier.service grenos-preuve.service grenos-maj-verif.timer \
               grenos-console-propre.service grenos-sonde-arret.service \
               grenos-splash-arret.service grenos-performances.service; do
    systemctl enable "$service" >/dev/null 2>&1 || true
done

# L'installation automatique des mises à jour suit ce que la personne a choisi :
# on ne l'allume jamais de notre propre initiative.
if [ -e /etc/grenos/maj-automatique ]; then
    systemctl enable grenos-maj-auto.timer >/dev/null 2>&1 || true
else
    systemctl disable grenos-maj-auto.timer >/dev/null 2>&1 || true
fi

# Les signatures de l'antivirus ne se téléchargent pas toutes seules.
#
# Debian **arme** `clamav-freshclam` à l'installation du paquet. Laissé tel
# quel, une machine neuve tirerait plusieurs centaines de mégaoctets dès sa
# première connexion, sans rien demander à personne — et notre page Sécurité
# promet exactement le contraire.
#
# Une promesse écrite dans un commentaire et contredite par le paquet, c'est la
# forme de défaut que ce dépôt passe son temps à trouver. On le désarme donc
# ici, à chaque mise à jour, parce qu'une réinstallation du paquet le
# rearmerait.
#
# `clamav-daemon` n'est pas installé du tout : c'est le scanner résident, il
# garde la base en mémoire — plusieurs centaines de mégaoctets en permanence —
# et Grenofar a demandé l'inverse (« éviter les processus en trop »).
systemctl disable clamav-freshclam.service >/dev/null 2>&1 || true
systemctl stop clamav-freshclam.service >/dev/null 2>&1 || true

# L'écran de chargement reste jusqu'à l'extinction.
#
# CETTE BOUCLE APPELAIT `systemctl enable` ET N'A JAMAIS RIEN FAIT.
#
# Lu dans `plymouth_24.004.60-5_amd64.deb` le 30 septembre : aucune des quatre
# unités n'a de section `[Install]`. Or `systemctl enable` n'a rien à faire
# d'une unité qui n'en a pas — il n'y a aucun `WantedBy=` à honorer — et le
# `|| true` avalait ce qu'il en disait. Pendant des jours on a cru activer
# quelque chose.
#
# Elles sont en réalité câblées par des LIENS livrés dans le paquet :
# `poweroff.target.wants/plymouth-poweroff.service`, et les trois autres de
# même. C'est pour cela qu'elles démarrent quand même — la ligne
# « [ OK ] Started plymouth-poweroff.service » de la capture d'arrêt le
# prouvait, et c'est elle qui aurait dû nous mettre la puce à l'oreille.
#
# On vérifie donc ce qui les câble vraiment, au lieu d'appeler une commande qui
# échoue en silence. Si un jour Debian retire ces liens, on le saura.
for cible in poweroff reboot halt kexec; do
    lien="/usr/lib/systemd/system/${cible}.target.wants/plymouth-${cible}.service"
    if [ ! -e "$lien" ]; then
        echo "grenos: attention : plymouth-${cible} n est pas cable par son paquet"
    fi
done

# ---- Nos choix d'applications par défaut ------------------------------------
if [ -x /usr/bin/xfce4-terminal ]; then
    update-alternatives --set x-terminal-emulator /usr/bin/xfce4-terminal >/dev/null 2>&1 || true
fi
if [ -x /usr/bin/firefox-esr ]; then
    update-alternatives --set x-www-browser /usr/bin/firefox-esr >/dev/null 2>&1 || true
fi

# ---- L'explorateur porte notre nom et notre icône ---------------------------
if [ -f /usr/share/applications/pcmanfm.desktop ]; then
    sed -i 's/^Icon=.*/Icon=grenos-fichiers/' /usr/share/applications/pcmanfm.desktop || true
    sed -i 's/^Name=.*/Name=Fichiers/' /usr/share/applications/pcmanfm.desktop || true
fi

# ---- Ce qu'on ne veut pas voir dans la liste des applications ---------------
# Un seul chemin pour installer, et pas de réglage déguisé en application. Ils
# restent trouvables en tapant leur nom dans la recherche.
# On reconnaît une entrée au **programme qu'elle lance**, pas au nom de son
# fichier. Debian livre `org.pulseaudio.pavucontrol.desktop` et non
# `pavucontrol.desktop` : « Contrôle du volume » restait donc dans la liste, et
# on ne s'en apercevait qu'en ouvrant le menu. Un nom de fichier change de
# version en version ; le programme lancé, non.
A_CACHER="calamares pavucontrol nm-connection-editor galculator vim gvim
xarchiver openbox uxterm xterm display-im6.q16 feh lightdm-gtk-greeter
xfce4-terminal-settings xfce4-about pcmanfm-desktop-pref qv4l2 qvidcap"

for fichier in /usr/share/applications/*.desktop; do
    if [ ! -f "$fichier" ]; then
        continue
    fi
    if grep -q '^NoDisplay=true' "$fichier"; then
        continue
    fi
    base=$(basename "$fichier" .desktop)
    lance=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$fichier" | head -1)
    lance=${lance##*/}
    for nom in $A_CACHER; do
        if [ "$base" = "$nom" ] || [ "$lance" = "$nom" ]; then
            echo "NoDisplay=true" >> "$fichier"
            break
        fi
    done
done

# L'installateur de Debian, qui porte des noms trop variés pour une liste.
for cachee in calamares-install-debian.desktop install-debian.desktop \
              debian-installer-launcher.desktop debian-uxterm.desktop \
              debian-xterm.desktop; do
    fichier="/usr/share/applications/${cachee}"
    if [ -f "$fichier" ] && ! grep -q '^NoDisplay=true' "$fichier"; then
        echo "NoDisplay=true" >> "$fichier"
    fi
done

# ---- Ce qu'on trouve sur le bureau au premier démarrage ---------------------
#
# /etc/skel n'est le dossier de personne : c'est le modèle des comptes à venir,
# y compris celui que crée l'installation sur disque. Le poser ici plutôt que
# pendant la construction permet à une mise à jour d'ajouter le raccourci d'une
# application nouvelle — et c'était tout l'objet. Les bureaux déjà existants ne
# sont pas touchés : ce que quelqu'un a rangé chez lui lui appartient.
mkdir -p /etc/skel/Bureau
for raccourci in grenos-bienvenue grenplace; do
    if [ -f "/usr/share/applications/${raccourci}.desktop" ]; then
        install -m 0755 "/usr/share/applications/${raccourci}.desktop" \
            /etc/skel/Bureau/ || true
    fi
done

# ---- L'installateur porte nos couleurs et prend tout le disque --------------
if [ -d /usr/share/calamares/branding/grenos ] && [ -f /usr/share/grenos/logo.png ]; then
    install -m 0644 /usr/share/grenos/logo.png \
        /usr/share/calamares/branding/grenos/logo.png || true
fi
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/^branding:.*/branding: grenos/' /etc/calamares/settings.conf || true
    grep -q '^branding:' /etc/calamares/settings.conf || \
        echo "branding: grenos" >> /etc/calamares/settings.conf
fi
# Le partitionnement par défaut : tout le disque, le choix manuel restant
# offert.
#
# `calamares-settings-debian` livre le **dossier** /etc/calamares/modules, et
# aucun partition.conf dedans — vérifié dans le paquet lui-même. J'exigeais
# pourtant que le fichier existe déjà avant de le remplacer : la copie était
# donc sautée en silence, et l'installateur ne proposait plus « tout le
# disque ». C'est la vérification restaurée le même jour qui l'a dit, à la
# construction suivante.
if [ -f /usr/share/grenos/partition.conf ]; then
    mkdir -p /etc/calamares/modules
    cp /usr/share/grenos/partition.conf /etc/calamares/modules/partition.conf || true
fi

# ---- Les réglages que nous posons chez les autres ---------------------------
#
# Ces fichiers appartiennent à openbox, à l'explorateur, à la bibliothèque de
# fichiers et à l'écran de connexion. Notre paquet ne peut donc pas les
# posséder — deux paquets ne peuvent pas posséder le même chemin. Il les livre
# comme modèles, et c'est ici qu'ils sont posés. Une mise à jour peut ainsi
# changer l'apparence des fenêtres ou le comportement de l'explorateur, ce qui
# était impossible tant que ces fichiers n'arrivaient qu'avec l'image.
poser () {
    modele="/usr/share/grenos/modeles/$1"
    cible="$2"
    [ -f "$modele" ] || return 0
    mkdir -p "$(dirname "$cible")"
    if ! cmp -s "$modele" "$cible"; then
        cp "$modele" "$cible" || true
    fi
}

poser openbox-rc.xml            /etc/xdg/openbox/rc.xml
poser pcmanfm.conf              /etc/xdg/pcmanfm/default/pcmanfm.conf
poser libfm.conf                /etc/xdg/libfm/libfm.conf
poser lightdm-gtk-greeter.conf  /etc/lightdm/lightdm-gtk-greeter.conf
poser gtk-settings.ini          /etc/gtk-3.0/settings.ini
poser fonts-local.conf          /etc/fonts/local.conf

# ---- Le droit de faire du son sans hoquet -----------------------------------
#
# Les limites de `/etc/security/limits.d/95-grenos-audio.conf` sont données au
# groupe `audio`. Encore faut-il que la personne y soit : sur l'image live
# `live-config` s'en charge, mais un compte créé par l'installateur, ou renommé
# par le premier écran, peut très bien ne pas l'être — et alors PipeWire
# retombe en priorité ordinaire, le tampon se vide, et ça fait « bom bom bom ».
#
# On le fait ici parce que c'est le seul endroit qui s'exécute après chaque
# installation ET après chaque mise à jour.
# ---- Et le droit, pour un jeu, de passer devant le reste -------------------
#
# MÊME DÉFAUT QUE LE SON, TROUVÉ DE LA MÊME FAÇON : EN OUVRANT LE PAQUET.
#
# `gamemode` 1.8.2-2 livre `/etc/security/limits.d/10-gamemode.conf`, qui dit
# exactement « @gamemode - nice -10 » : une règle donnée à un GROUPE. Et
# `gamemode-daemon` livre `/usr/share/polkit-1/rules.d/gamemode.rules`, qui
# autorise `cpugovctl` et `gpuclockctl` sans mot de passe — à la seule
# condition que `subject.isInGroup("gamemode")`.
#
# Personne n'est dans ce groupe. Sa page de manuel le dit elle-même, et c'est
# la phrase qu'il ne faut pas lire en diagonale :
#
#     To use this feature, the user must be added to the gamemode group
#     (and then rebooted): sudo usermod -aG gamemode $(whoami)
#
# Sans cela, GameMode démarre, répond, et échoue en silence sur la seule chose
# qui compte : polkit retombe sur `auth_admin`, et une machine grenOS n'a pas
# de mot de passe. C'est, à la virgule près, la panne de l'installateur du
# 25 septembre — une promesse à l'écran sans rien derrière.
for compte in $(awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' /etc/passwd 2>/dev/null); do
    for groupe in audio gamemode; do
        # Le groupe peut ne pas exister : `gamemode` est créé par
        # systemd-sysusers depuis /usr/lib/sysusers.d/gamemode.conf, et un
        # usermod vers un groupe absent échoue. On regarde avant.
        getent group "$groupe" >/dev/null 2>&1 || continue
        if ! id -nG "$compte" 2>/dev/null | tr ' ' '\n' | grep -qx "$groupe"; then
            usermod -aG "$groupe" "$compte" >/dev/null 2>&1 || true
            echo "grenos: $compte ajoute au groupe $groupe"
        fi
    done
done

# ---- Le dossier au nom abîmé, laissé par l'absence de locale ----------------
#
# Vu sur la capture de l'explorateur : un dossier « TÃ©lÃ©chargements » à côté
# du vrai « Téléchargements ». C'est de l'UTF-8 lu comme du Latin-1 :
# `xdg-user-dirs-update` a tourné alors que la locale fr_FR.UTF-8 n'existait
# pas — le paquet `locales` était absent de l'image.
#
# La cause est corrigée, mais une machine déjà installée garde le dossier. On
# le retire **seulement s'il est vide** : si quelqu'un y a mis un fichier, il
# lui appartient, et un système qui efface des dossiers non vides sans rien
# demander n'est pas un système à soi.
for compte in $(awk -F: '$3 >= 1000 && $3 < 60000 {print $4":"$6}' /etc/passwd 2>/dev/null | cut -d: -f2); do
    abime="$compte/TÃ©lÃ©chargements"
    if [ -d "$abime" ] && [ -z "$(ls -A "$abime" 2>/dev/null)" ]; then
        rmdir "$abime" 2>/dev/null && echo "grenos: dossier au nom abime retire de $compte"
    fi
done

# ---- L'écran de chargement, et celui de la mise à jour ----------------------
#
# `spinner.plymouth` appartient à `plymouth-themes` : on le modifie, on ne le
# livre pas. Une remise à jour de ce paquet remettrait donc l'anglais et
# reprendrait la barre de progression de la mise à jour au redémarrage — celle
# que Grenofar voit. On rejoue l'habillage à chaque passage ici.
[ -x /usr/lib/grenos/habiller-plymouth ] && /usr/lib/grenos/habiller-plymouth

# ---- Les icônes et les menus ------------------------------------------------
gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark >/dev/null 2>&1 || true
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true

echo "grenos: systeme branche"
