    def ecran_applications(self):
        """I12 — proposées, pas imposées.

        Sa phrase : « des applications proposées, pas imposées — grenPerf et
        GrenAI ne s'installent pas tout seuls ». Les cases sont donc **vides**
        au départ, et ce qui est déjà là n'est pas represente comme un choix.
        """
        self.corps.pack_start(
            grenosui.titre("Applications",
                           "Le navigateur, l'explorateur et le lecteur "
                           "multimédia sont déjà là. Voici ce qu'on peut "
                           "ajouter — rien n'est coché."),
            False, False, 0)
        self.cases = {}
        for cle, intitule, note in (
            ("steam", "Steam",
             "Des milliers de jeux, dont beaucoup de jeux Windows."),
            ("vscode", "Visual Studio Code",
             "Un éditeur de code, si cette machine sert à développer."),
            ("libreoffice", "LibreOffice",
             "Traitement de texte, tableur, présentations."),
        ):
            case = Gtk.CheckButton()
            boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            titre = Gtk.Label(label=intitule, xalign=0)
            titre.get_style_context().add_class("choix-titre")
            detail = Gtk.Label(label=note, xalign=0)
            detail.get_style_context().add_class("choix-note")
            detail.set_line_wrap(True)
            boite.pack_start(titre, False, False, 0)
            boite.pack_start(detail, False, False, 0)
            case.add(boite)
            case.set_active(cle in self.reponses.get("applications", ""))
            self.cases[cle] = case
            case.connect("toggled", self.changer_applications)
            self.corps.pack_start(case, False, False, 0)

    def changer_applications(self, _case):
        choisies = [cle for cle, case in self.cases.items() if case.get_active()]
        self.reponses["applications"] = ",".join(sorted(choisies))

    def ecran_final(self):
        self.corps.pack_start(
            grenosui.titre("grenOS est prêt",
                           "On applique tes réponses et on ouvre le bureau."),
            False, False, 0)
        choisies = self.reponses.get("applications", "")
        resume = Gtk.Label(xalign=0, label=(
            "Compte : %s@%s\nClavier : %s\nParcours : %s\n"
            "Apparence : %s\nTélémétrie : %s\nMises à jour : %s\n"
            "Applications à installer : %s"
            % (self.reponses.get("compte", ""), MACHINE,
               self.reponses.get("clavier", "fr"),
               self.reponses.get("parcours", premier.PERSONNALISE),
               self.reponses.get("apparence", "auto"),
               self.reponses.get("telemetrie", "aucune"),
               self.reponses.get("majs", "automatiques"),
               choisies.replace(",", ", ") if choisies else "aucune")))
        resume.get_style_context().add_class("choix-note")
        self.corps.pack_start(grenosui.carte(resume), False, False, 0)

    # ------------------------------------------------------------------ la fin

    def terminer(self):
        login = self.reponses.get("compte", "")
        if probleme(login) is not None:
            self.aller("compte")
            return
        self.suite.set_sensitive(False)
        self.retour.set_sensitive(False)
        self.suite.set_label("Un instant…")
        while Gtk.events_pending():
            Gtk.main_iteration()
        index = self.reponses.get("clavier_index", clavier.DEFAUT)
        _, disposition, variante, fuseau = clavier.PAYS[index]
        retenu = appliquer(login, self.reponses.get("nom_affiche") or login,
                           disposition, variante, fuseau)
        # APRES `appliquer()`, jamais avant : il efface le mot de passe sans
        # condition à chaque passage (la machine reste ouverte tant que
        # personne n'en a demandé un), et un mot de passe posé plus tôt
        # serait donc effacé à son tour.
        mot = self.reponses.get("mot_de_passe", "")
        if mot:
            if poser_mot_de_passe(retenu, mot):
                dire("compte : mot de passe defini, l ouverture automatique est coupee")
            else:
                dire("compte : LE MOT DE PASSE N A PAS PU ETRE DEFINI")
        else:
            dire("compte : aucun mot de passe, ouverture automatique")
        poser_apparence(retenu, self.reponses.get("apparence"))
        garder_choix(self.reponses)
        deposer_les_travaux(self.reponses)
        dire(f"nom choisi, la machine est a {retenu}@{MACHINE}")
        dire("premier : choix gardes — apparence %s, telemetrie %s, majs %s"
             % (self.reponses.get("apparence", "auto"),
                self.reponses.get("telemetrie", "aucune"),
                self.reponses.get("majs", "automatiques")))
        Gtk.main_quit()


def main():
    dire("premier ecran : le programme demarre")
    if os.geteuid() != 0:
        sys.exit("grenos-premier doit être lancé par le système, en root.")
    if os.path.exists(IDENTITE):
        return

    # live-config crée le compte de la session pendant le démarrage, et rien ne
    # garantit qu'il soit déjà là. Renommer un compte inexistant donnerait une
    # machine où personne ne peut entrer : on l'attend, une minute au plus.
    for _ in range(60):
        if compte_actuel():
            break
        time.sleep(1)
    grenosui.habiller(grenosui.NUIT)
    grenosui.ajouter_style(STYLE)
    fenetre = Assistant()
    fenetre.show_all()

    # Aucun gestionnaire de fenêtres ne tourne ici, et c'est lui qui, d'ordinaire,
    # décide quelle fenêtre reçoit le clavier. Sans personne pour le faire, il
    # faut le demander au serveur X nous-mêmes — sinon la personne tape dans le
    # vide, ce que la machine d'intégration a constaté au premier essai.
    surface = fenetre.get_window()
    if surface is not None:
        surface.focus(Gdk.CURRENT_TIME)
    fenetre.present()
    Gtk.main()


if __name__ == "__main__":
    main()
