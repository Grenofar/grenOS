#!/usr/bin/env python3
"""L'assistant de première configuration de grenOS.

Section I de sa liste — le plus détaillé de ses souhaits, et le plus visible :
c'est le premier écran que voit quelqu'un qui installe grenOS.

CE PROGRAMME EST LE SEUL DONT UNE PANNE EMPÊCHE D'ENTRER DANS LA MACHINE. Il
tourne avant le gestionnaire de connexion, seul à l'écran, et tant qu'il n'a
pas retenu un nom, aucun compte n'existe. Trois conséquences, toutes
délibérées :

* l'enchaînement des écrans vit dans `premier.py`, sans une ligne de GTK, et
  il est exercé en 35 cas. Ici il n'y a que du dessin ;
* **on ne dessine que les écrans qu'on sait tenir.** `premier.py` décrit les
  vingt-et-un écrans de sa liste ; cette fenêtre n'en construit que ceux dont
  elle a le code, et saute les autres au lieu d'afficher une page vide. Une
  page vide serait une promesse à l'écran sans rien derrière, sur l'écran où
  elle coûterait le plus cher ;
* le renommage du compte n'a pas bougé d'une ligne. C'est le seul moment sûr
  pour renommer — plus tard, des processus tiennent le compte — et c'est du
  code qui a déjà démarré des centaines de machines.

Renommer ici donne : taper « lea » crée le compte `lea`, la maison
`/home/lea`, et l'adresse `lea@grenos`.
"""
import os
import re
import subprocess
import sys
import threading
import time
import unicodedata

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

import clavier  # noqa: E402
import grenosui  # noqa: E402
import materiel  # noqa: E402
import premier  # noqa: E402
import reseau  # noqa: E402
import sante  # noqa: E402

IDENTITE = "/etc/grenos/identite"
REGLAGES = "/etc/grenos/premier-choix"
MACHINE = "grenos"
# Des noms que le système utilise déjà, ou qui sèmeraient la confusion.
RESERVES = {"root", "daemon", "bin", "sys", "sync", "nobody", "systemd",
            "lightdm", "messagebus", "grenos", "admin", "user", "live"}

STYLE = """
.pas { font-size: 12px; color: @texte-faible; letter-spacing: 0.08em; }
.choix-titre { font-size: 15px; font-weight: 700; color: @texte; }
.choix-note { font-size: 12px; color: @texte-faible; }
.apercu { font-size: 13px; color: @texte-faible; }
.erreur { font-size: 13px; color: #f87171; }
.sous { font-size: 12px; color: @texte-faible; }
"""


def dire(texte):
    """Une ligne sur le port série : c'est par là que la CI nous regarde.

    Sans écran à interroger, une machine d'intégration ne peut pas savoir si
    cet écran s'est affiché. Cette ligne le dit, et elle dit aussi quand le nom
    a été pris en compte.
    """
    try:
        with open("/dev/ttyS0", "w", encoding="utf-8") as port:
            port.write(f"grenos: {texte}\n")
    except OSError:
        pass


def compte_actuel():
    """Le compte créé par le live (uid 1000), celui que l'on va renommer."""
    try:
        sortie = subprocess.run(["getent", "passwd", "1000"], capture_output=True,
                                text=True, check=True).stdout
        return sortie.split(":", 1)[0]
    except (subprocess.CalledProcessError, IndexError):
        return ""


def en_login(texte):
    """« Léa Martin » → « lea ». Un compte Unix n'a ni accent, ni espace."""
    sans_accent = unicodedata.normalize("NFKD", texte)
    sans_accent = "".join(c for c in sans_accent if not unicodedata.combining(c))
    propre = re.sub(r"[^a-z0-9-]", "", sans_accent.lower().replace(" ", "-"))
    propre = propre.strip("-")[:31]
    return propre


def probleme(login):
    """Ce qui empêche ce nom d'être un compte, dit en français, ou None."""
    if not login:
        return "Un nom, avec au moins une lettre."
    if not login[0].isalpha():
        return "Un nom commence par une lettre."
    if login in RESERVES:
        return "Ce nom est déjà pris par le système, choisis-en un autre."
    if subprocess.run(["getent", "passwd", login], capture_output=True).returncode == 0:
        return "Ce compte existe déjà sur cette machine."
    return None


def ouverture(login, automatique=True):
    """Écrit qui ouvre la session, dans le fichier qui a le dernier mot."""
    lignes = ["[Seat:*]\n", "user-session=grenos\n",
              "greeter-session=lightdm-gtk-greeter\n"]
    if automatique:
        lignes += [f"autologin-user={login}\n", "autologin-user-timeout=0\n",
                   "autologin-session=grenos\n"]
    os.makedirs("/etc/lightdm/lightdm.conf.d", exist_ok=True)
    for chemin in ("/etc/lightdm/lightdm.conf",
                   "/etc/lightdm/lightdm.conf.d/60-grenos.conf"):
        with open(chemin, "w", encoding="utf-8") as fichier:
            fichier.write("# Écrit par grenOS. LightDM lit lightdm.conf en dernier.\n")
            fichier.writelines(lignes)


def appliquer(login, affiche, disposition="fr", variante="", fuseau="Europe/Paris"):
    """Renomme le compte, écrit qui habite ici, et rend le nom retenu."""
    # Le clavier et le fuseau, écrits avant tout le reste : ce sont eux qui
    # décident de ce que donne la prochaine touche tapée.
    try:
        clavier.ecrire_systeme(disposition, variante)
    except OSError:
        pass
    subprocess.run(["timedatectl", "set-timezone", fuseau], check=False,
                   capture_output=True)
    ancien = compte_actuel()
    if ancien and ancien != login:
        subprocess.run(["usermod", "-l", login, "-d", f"/home/{login}", "-m", ancien], check=False)
        subprocess.run(["groupmod", "-n", login, ancien], check=False)

    # Si le renommage n'a pas abouti — un processus tenait encore le compte —,
    # on garde le nom d'origine plutôt que d'écrire une ouverture de session
    # vers un compte qui n'existe pas : ce serait une machine où personne ne
    # peut entrer, et c'est la panne qu'on ne se permet plus.
    if subprocess.run(["getent", "passwd", login], capture_output=True).returncode != 0:
        dire(f"le compte n'a pas pu etre renomme, on garde {ancien}")
        login = ancien or "grenos"

    subprocess.run(["usermod", "-c", affiche, login], check=False)

    os.makedirs(os.path.dirname(IDENTITE), exist_ok=True)
    with open(IDENTITE, "w", encoding="utf-8") as fichier:
        fichier.write(
            "# Qui habite cette machine. Écrit une seule fois, au premier démarrage.\n"
            f"login={login}\n"
            f"nom={affiche}\n"
            f"machine={MACHINE}\n"
        )

    # Tant qu'aucun mot de passe n'est choisi, il n'y en a pas à taper : ni pour
    # ouvrir la session, ni pour installer un paquet. `grenos-compte` remplace
    # ces fichiers dès qu'un mot de passe est défini.
    #
    # On écrit /etc/lightdm/lightdm.conf, et pas seulement le dossier
    # lightdm.conf.d : LightDM lit ce fichier en dernier, donc c'est lui qui
    # l'emporte. live-config y a mis le compte du live, qui n'existe plus une
    # fois renommé — et l'écran de connexion réapparaissait.
    ouverture(login)
    with open("/etc/sudoers.d/grenos-identite", "w", encoding="utf-8") as fichier:
        fichier.write(f"{login} ALL=(ALL) NOPASSWD: ALL\n")
    os.chmod("/etc/sudoers.d/grenos-identite", 0o440)
    subprocess.run(["passwd", "-d", login], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # Ce que la personne a choisi, gardé pour les Réglages.
    saut = chr(10)
    with open(IDENTITE, "a", encoding="utf-8") as fichier:
        fichier.write(f"clavier={disposition}{saut}"
                      f"variante={variante}{saut}"
                      f"fuseau={fuseau}{saut}")
    return login


def poser_apparence(login, choix):
    """Le thème choisi, écrit dans le compte de la personne.

    `grenosui.palette()` lit `~/.config/grenos/theme`, donc ce fichier doit
    appartenir a la personne et pas à root — sinon sa session ne pourra plus
    en changer, et le bouton des Réglages échouerait en silence.

    « auto » ne s'écrit pas : c'est l'absence de fichier qui veut dire « laisse
    grenOS décider ». Écrire « auto » dedans ferait lire une valeur inconnue
    à `palette()`, qui retomberait sur la nuit sans le dire.
    """
    if choix not in ("jour", "nuit"):
        return
    try:
        dossier = os.path.join("/home", login, ".config", "grenos")
        os.makedirs(dossier, exist_ok=True)
        chemin = os.path.join(dossier, "theme")
        with open(chemin, "w", encoding="utf-8") as fichier:
            fichier.write(choix + "\n")
        subprocess.run(["chown", "-R", "%s:%s" % (login, login),
                        os.path.join("/home", login, ".config")], check=False)
    except OSError:
        pass


def poser_mot_de_passe(login, mot):
    """I5 — le mot de passe facultatif, par le MÊME chemin que les Réglages.

    `grenos-compte definir` noue ensemble le mot de passe, la fin de
    l'ouverture automatique et sudo : les écrire séparément ici referait, un
    jour, exactement la panne que ce script existe pour éviter — un mot de
    passe posé qui laisserait la session s'ouvrir seule quand même.

    Le mot de passe arrive par l'entrée standard, jamais par un argument : un
    argument de ligne de commande se lit dans `/proc/<pid>/cmdline`, par
    n'importe qui a accès à cette machine au même instant.
    """
    try:
        resultat = subprocess.run(
            ["/usr/lib/grenos/grenos-compte", "definir", login],
            input=mot + "\n", text=True, capture_output=True, timeout=15)
        return resultat.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def garder_choix(reponses):
    """Ce qui a été répondu, pour que les Réglages puissent le relire.

    On écrit **après** le compte, jamais avant : si la machine s'éteint au
    milieu de l'assistant, mieux vaut n'avoir rien gardé que d'avoir gardé des
    réponses sans compte à qui les appliquer.
    """
    try:
        os.makedirs(os.path.dirname(REGLAGES), exist_ok=True)
        with open(REGLAGES, "w", encoding="utf-8") as fichier:
            fichier.write("# Les réponses de l'assistant de première configuration.\n")
            for cle in sorted(reponses):
                fichier.write("%s=%s\n" % (cle, reponses[cle]))
    except OSError:
        pass


FILE_DES_TRAVAUX = "/usr/lib/grenos/grenos-au-prochain-demarrage"


def deposer_les_travaux(reponses):
    """Ce qui a été choisi devient un travail, et non une préférence rangée.

    C'EST LA DIFFÉRENCE ENTRE UN ASSISTANT ET UN FORMULAIRE. Jusqu'ici, tout
    ce que l'assistant demandait finissait dans un fichier que les Réglages
    relisaient ; cocher « Développement » ne faisait rien arriver. Une
    question dont la réponse ne change rien est une question qu'on pose pour
    faire joli — la forme polie de la promesse à l'écran sans rien derrière.

    LA FILE D'AVANT-BUREAU EST LE SEUL ENDROIT OÙ CELA PEUT SE FAIRE, et elle
    est prouvée depuis le 27 septembre : elle rend toujours 0, borne chaque
    travail dans le temps, classe ce qui a échoué au lieu de le rejouer, et
    une machine a vraiment redémarré dessus. Installer pendant que l'assistant
    tourne serait la pire des façons : la personne attendrait devant un écran
    qui ne dit rien, et une coupure au milieu d'un `dpkg` est la manière
    classique de casser une machine.

    ON NE DÉPOSE RIEN QUAND IL N'Y A RIEN À FAIRE. Un travail vide s'exécuterait
    au prochain démarrage, écrirait son verdict et ne servirait à rien, tout en
    faisant croire à la lecture du journal qu'une installation a eu lieu.
    """
    travaux = []

    choisies = [c for c in (reponses.get("applications") or "").split(",") if c]
    for cle in premier.paquets_pour(reponses.get("usage")):
        if cle not in choisies:
            choisies.append(cle)
    if choisies:
        # PAS GrenPlace : la file s'exécute avant lightdm, donc sans serveur
        # X, et GrenPlace est une fenêtre. J'avais écrit `grenplace
        # --installer` — un mode qui n'existe pas, dans un programme qui
        # n'aurait de toute façon rien pu afficher.
        travaux.append(("Installer les applications choisies",
                        ["/usr/lib/grenos/grenos-installer-choix",
                         ",".join(sorted(choisies))]))

    if reponses.get("optimiser") == "oui":
        travaux.append(("Régler la machine pour la performance",
                        ["/usr/lib/grenos/grenos-performances"]))

    if not travaux:
        dire("premier : aucun travail a deposer — rien n a ete demande")
        return

    for intitule, commande in travaux:
        try:
            fin = subprocess.run([FILE_DES_TRAVAUX, intitule] + commande,
                                 capture_output=True, text=True, timeout=20,
                                 check=False)
        except (OSError, subprocess.SubprocessError) as souci:
            dire("premier : travail « %s » PAS depose — %s" % (intitule, souci))
            continue
        if fin.returncode == 0:
            dire("premier : travail depose — %s" % intitule)
        else:
            # On le dit et on continue : un assistant qui s'arrête parce qu'une
            # installation n'a pas pu être mise en file laisserait quelqu'un
            # devant un écran bloqué, pour un travail de confort.
            dire("premier : travail « %s » refuse par la file — %s"
                 % (intitule, (fin.stderr or "").strip()[:80]))


class Assistant(Gtk.Window):
    def __init__(self):
        super().__init__(title="Bienvenue dans grenOS")
        # Aucun gestionnaire de fenêtres ne tourne à ce moment : `fullscreen()`
        # est une demande qu'il n'y a personne pour exaucer. On prend donc nous-
        # mêmes toute la place, sans quoi le quadrillage gris du serveur X
        # apparaîtrait autour de la fenêtre.
        ecran = Gdk.Screen.get_default()
        self.set_default_size(ecran.get_width(), ecran.get_height())
        self.move(0, 0)
        self.fullscreen()
        self.connect("destroy", Gtk.main_quit)

        self.reponses = premier.reponses_par_defaut()
        self.constructeurs = {
            "bienvenue": self.ecran_bienvenue,
            "langue": self.ecran_langue,
            "clavier": self.ecran_clavier,
            "compte": self.ecran_compte,
            "parcours": self.ecran_parcours,
            "reseau": self.ecran_reseau,
            "apparence": self.ecran_apparence,
            "usage": self.ecran_usage,
            "securite": self.ecran_securite,
            "optimisation": self.ecran_optimisation,
            "confidentialite": self.ecran_confidentialite,
            "majs": self.ecran_majs,
            "applications": self.ecran_applications,
            "final": self.ecran_final,
        }
        self.cle = None

        centre = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        centre.set_halign(Gtk.Align.CENTER)
        centre.set_valign(Gtk.Align.CENTER)
        self.add(centre)

        self.colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self.colonne.set_size_request(560, -1)
        centre.pack_start(self.colonne, False, False, 0)

        self.rang = Gtk.Label(label="", xalign=0)
        self.rang.get_style_context().add_class("pas")
        self.colonne.pack_start(self.rang, False, False, 0)

        # Chaque écran vivait dans LA MÊME boîte, vidée puis remplie à chaque
        # pas : un changement d'écran ne se voyait pas, il se remplaçait.
        # `Gtk.Stack` fait le travail inverse — glisser l'ancien hors de vue
        # pendant que le nouveau entre — sans toucher à `premier.py` : la
        # mécanique du parcours (quel écran suit lequel) reste sans une ligne
        # de GTK, comme l'exige l'en-tête de ce fichier. Homogène à faux et
        # la taille interpolée : un écran plus court que le précédent rétrécit
        # la fenêtre au lieu de laisser un vide dessous.
        self.pile = Gtk.Stack()
        self.pile.set_transition_duration(220)
        self.pile.set_homogeneous(False)
        self.pile.set_interpolate_size(True)
        self.colonne.pack_start(self.pile, False, False, 0)
        self.corps = None

        self.note = Gtk.Label(label="", xalign=0)
        self.note.get_style_context().add_class("erreur")
        self.colonne.pack_start(self.note, False, False, 0)

        pied = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.retour = grenosui.bouton("Retour", lambda *_: self.reculer())
        pied.pack_start(self.retour, False, False, 0)
        self.suite = grenosui.bouton("Continuer", lambda *_: self.avancer(),
                                     "principal")
        pied.pack_end(self.suite, False, False, 0)
        self.colonne.pack_start(pied, False, False, 6)

        # ENTRÉE AVANCE, PARTOUT. C'est ce qu'on attend d'un assistant, et
        # c'est surtout ce qui le rend prévisible : sans cela, la touche
        # dépend de la fenêtre qui a le clavier, et sur certains écrans aucun
        # bouton ne l'a. Un champ de saisie garde sa priorité — son propre
        # signal `activate` fait le même travail.
        self.connect("key-press-event", self.touche)

        self.aller("bienvenue")

    def touche(self, _fenetre, evenement):
        if evenement.keyval not in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            return False
        if isinstance(self.get_focus(), Gtk.Entry):
            return False
        self.avancer()
        return True

    # ------------------------------------------------------------ la mécanique

    def liste(self):
        """Les écrans de ce parcours QUE L'ON SAIT DESSINER.

        `premier.py` décrit les vingt-et-un écrans de sa liste ; on saute ceux
        dont le code n'existe pas encore plutôt que d'afficher une page vide.
        """
        parcours = self.reponses.get("parcours", premier.PERSONNALISE)
        return [c for c in premier.ecrans(parcours) if c in self.constructeurs]

    def aller(self, cle):
        # Le sens AVANT de glisser : si on avance dans la liste, le nouvel
        # écran entre par la droite comme une page qui tourne ; en arrière,
        # par la gauche. Le tout premier écran n'a rien à comparer : pas de
        # glissade, un simple fondu suffit à ne pas surprendre.
        liste = self.liste()
        ancien_rang = liste.index(self.cle) + 1 if self.cle in liste else None
        rang = liste.index(cle) + 1 if cle in liste else 1
        if ancien_rang is None:
            sens = Gtk.StackTransitionType.CROSSFADE
        elif rang > ancien_rang:
            sens = Gtk.StackTransitionType.SLIDE_LEFT
        elif rang < ancien_rang:
            sens = Gtk.StackTransitionType.SLIDE_RIGHT
        else:
            sens = Gtk.StackTransitionType.CROSSFADE

        self.cle = cle
        # Un écran déjà visité garde son nom dans la pile ; on le refait à
        # neuf plutôt que de réafficher l'ancien, pour ne rien changer au
        # comportement d'avant (chaque écran relit `self.reponses` à chaque
        # passage — nécessaire pour revenir avec un choix déjà pris).
        ancien = self.pile.get_child_by_name(cle)
        if ancien is not None:
            self.pile.remove(ancien)
            ancien.destroy()
        self.corps = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.pile.add_named(self.corps, cle)

        self.note.set_text("")
        self.rang.set_text("ÉTAPE %d SUR %d" % (rang, len(liste)))
        self.retour.set_sensitive(rang > 1)
        self.suite.set_label("Démarrer" if cle == "final" else "Continuer")
        self.constructeurs[cle]()
        self.corps.show_all()
        self.pile.set_visible_child_full(cle, sens)
        self.relire()
        dire("premier : ecran %s (%d/%d)" % (cle, rang, len(liste)))
        if cle == "compte":
            dire("premier ecran affiche, il demande un nom")

    def avancer(self):
        possible, pourquoi = premier.peut_continuer(self.cle, self.reponses)
        if not possible:
            self.note.set_text(pourquoi)
            return
        if self.cle == "final":
            self.terminer()
            return
        liste = self.liste()
        rang = liste.index(self.cle)
        if rang + 1 < len(liste):
            self.aller(liste[rang + 1])

    def reculer(self):
        liste = self.liste()
        if self.cle in liste:
            rang = liste.index(self.cle)
            if rang > 0:
                self.aller(liste[rang - 1])

    def relire(self):
        possible, pourquoi = premier.peut_continuer(self.cle, self.reponses)
        self.suite.set_sensitive(possible)
        if not possible and self.cle == "compte":
            # On n'écrit la raison que si quelque chose a été tapé : reprocher
            # un champ vide à quelqu'un qui vient d'arriver est désagréable.
            tape = getattr(self, "champ", None)
            self.note.set_text(pourquoi if (tape and tape.get_text().strip()) else "")

    # --------------------------------------------------------------- les écrans

    def ecran_bienvenue(self):
        """« Démarre en anglais », mot pour mot dans sa liste.

        C'est la seule page en anglais, et c'est voulu : quelqu'un qui ne lit
        pas le français doit pouvoir atteindre l'écran où l'on choisit la
        langue. Tout le reste de l'assistant est en français une fois ce choix
        fait.
        """
        self.corps.pack_start(
            grenosui.titre("Welcome to grenOS",
                           "Let's set up your computer in a few steps."),
            False, False, 0)
        self.suite.set_label("Start")

    def ecran_langue(self):
        self.corps.pack_start(
            grenosui.titre("Langue et région",
                           "Elle décide de la langue des menus, du format des "
                           "dates et de l'heure."),
            False, False, 0)
        choix = Gtk.ComboBoxText()
        # Deux langues, et on le dit plutôt que d'en promettre cent : « toutes
        # les langues du monde, ou anglais et français si c'est trop long ».
        self.langues = (("Français (France)", "fr_FR"),
                        ("English (United States)", "en_US"))
        for intitule, _ in self.langues:
            choix.append_text(intitule)
        courante = self.reponses.get("langue", "fr_FR")
        choix.set_active(next((i for i, (_, code) in enumerate(self.langues)
                               if code == courante), 0))
        choix.connect("changed", self.changer_langue)
        self.corps.pack_start(choix, False, False, 0)

    def changer_langue(self, combo):
        rang = max(combo.get_active(), 0)
        self.reponses["langue"] = self.langues[rang][1]

    def ecran_clavier(self):
        """Le clavier, et un champ pour l'essayer — I3 de sa liste.

        Sur un clavier belge ou québécois, une disposition française met les
        accents et les chiffres au mauvais endroit, et l'on ne peut alors plus
        taper son propre mot de passe. Le changer ici, avant qu'il y ait un mot
        de passe, est le bon moment.
        """
        self.corps.pack_start(
            grenosui.titre("Clavier",
                           "Choisis la disposition, puis essaie-la dans le "
                           "champ : ce que tu tapes doit correspondre."),
            False, False, 0)
        self.choix_pays = Gtk.ComboBoxText()
        for nom, _, _, _ in clavier.PAYS:
            self.choix_pays.append_text(nom)
        self.choix_pays.set_active(self.reponses.get("clavier_index",
                                                     clavier.DEFAUT))
        self.choix_pays.connect("changed", self.changer_clavier)
        self.corps.pack_start(self.choix_pays, False, False, 0)

        essai = Gtk.Entry()
        essai.set_placeholder_text("Tape ici pour essayer : é à ç ù 1 2 3")
        self.corps.pack_start(essai, False, False, 0)

    def changer_clavier(self, combo):
        """Le clavier change à l'écran tout de suite : on peut l'essayer."""
        rang = max(combo.get_active(), 0)
        self.reponses["clavier_index"] = rang
        _, disposition, variante, _ = clavier.PAYS[rang]
        self.reponses["clavier"] = disposition
        clavier.appliquer_maintenant(disposition, variante)

    def ecran_compte(self):
        self.corps.pack_start(
            grenosui.titre("Votre compte",
                           "Ton nom devient ton compte, ta maison et ton "
                           "adresse sur cette machine."),
            False, False, 0)
        self.champ = Gtk.Entry()
        self.champ.set_placeholder_text("Ton nom")
        self.champ.connect("changed", lambda _: self.relire_compte())
        self.champ.connect("activate", lambda _: self.avancer())
        self.corps.pack_start(self.champ, False, False, 0)

        self.apercu = Gtk.Label(label="", xalign=0)
        self.apercu.get_style_context().add_class("apercu")
        self.corps.pack_start(self.apercu, False, False, 0)
        self.champ.grab_focus()

        # I5 — « un mot de passe au login s'il le souhaite ». Optionnel, et
        # c'est le mot qui compte : laisser le champ vide garde la machine
        # exactement comme avant, l'ouverture automatique que `appliquer()`
        # met en place. Un mot de passe tape ici passe par `grenos-compte`,
        # le MEME chemin que les Reglages, qui noue ensemble le mot de passe,
        # la fin de l'ouverture automatique et sudo — les separer serait
        # promettre une protection qui n'en est pas une.
        mot_titre = Gtk.Label(label="MOT DE PASSE (FACULTATIF)", xalign=0)
        mot_titre.get_style_context().add_class("section")
        self.corps.pack_start(mot_titre, False, False, 10)
        self.mot_compte = Gtk.Entry(visibility=False)
        self.mot_compte.set_placeholder_text("Laisse vide pour ouvrir sans mot de passe")
        self.mot_compte.connect("changed", self.changer_mot_de_passe)
        self.mot_compte.connect("activate", lambda _: self.avancer())
        self.corps.pack_start(self.mot_compte, False, False, 0)
        montrer = Gtk.CheckButton(label="Afficher le mot de passe")
        montrer.connect(
            "toggled", lambda b: self.mot_compte.set_visibility(b.get_active()))
        self.corps.pack_start(montrer, False, False, 0)
        note_mot = Gtk.Label(
            label="Sans mot de passe, ta session s'ouvre seule au démarrage — "
                  "tu pourras en définir un plus tard dans les Réglages.",
            xalign=0)
        note_mot.get_style_context().add_class("sous")
        note_mot.set_line_wrap(True)
        self.corps.pack_start(note_mot, False, False, 0)

    def relire_compte(self):
        tape = self.champ.get_text()
        login = en_login(tape)
        souci = probleme(login)
        self.apercu.set_text(f"{login}@{MACHINE}" if login else "")
        self.reponses["compte"] = login if souci is None else ""
        self.reponses["nom_affiche"] = tape.strip()
        self.note.set_text(souci if (souci and tape.strip()) else "")
        self.suite.set_sensitive(souci is None)

    def changer_mot_de_passe(self, champ):
        self.reponses["mot_de_passe"] = champ.get_text()

    def ecran_parcours(self):
        """Les trois parcours, choisis après la langue, le clavier et le nom.

        C'est son ordre, et il est juste : demander « quel parcours ? » à
        quelqu'un qui n'a pas encore choisi sa langue, c'est lui demander de
        choisir dans une langue qu'il ne lit peut-être pas.
        """
        self.corps.pack_start(
            grenosui.titre("Comment veux-tu continuer ?",
                           "Tu pourras tout changer plus tard dans les Réglages."),
            False, False, 0)
        propositions = (
            (premier.RAPIDE, "Rapide",
             "Le moins d'écrans possible. On démarre tout de suite."),
            (premier.PERSONNALISE, "Personnalisé (recommandé)",
             "Toutes les questions : réseau, apparence, confidentialité, "
             "sécurité, sauvegardes."),
            (premier.DEV, "Dev",
             "Tout cela, plus le partitionnement, le chiffrement, Secure Boot, "
             "le swap, les services, le pare-feu et les paramètres du noyau."),
        )
        premier_bouton = None
        for cle, intitule, note in propositions:
            bouton = Gtk.RadioButton.new_from_widget(premier_bouton)
            if premier_bouton is None:
                premier_bouton = bouton
            boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            titre = Gtk.Label(label=intitule, xalign=0)
            titre.get_style_context().add_class("choix-titre")
            detail = Gtk.Label(label=note, xalign=0)
            detail.get_style_context().add_class("choix-note")
            detail.set_line_wrap(True)
            boite.pack_start(titre, False, False, 0)
            boite.pack_start(detail, False, False, 0)
            bouton.add(boite)
            bouton.set_active(self.reponses.get("parcours") == cle)
            bouton.connect("toggled", self.changer_parcours, cle)
            self.corps.pack_start(bouton, False, False, 0)

    def changer_parcours(self, bouton, cle):
        if bouton.get_active():
            self.reponses["parcours"] = cle
            self.relire()

    def choix_simple(self, cle, propositions):
        """Une liste de boutons à cocher, un seul actif. Rend le premier.

        Chaque proposition est (valeur, intitulé, explication). L'explication
        n'est pas décorative : un choix sans conséquence écrite est un choix
        qu'on fait au hasard, et c'est alors le défaut qui aurait suffi.
        """
        premier_bouton = None
        for valeur, intitule, note in propositions:
            bouton = Gtk.RadioButton.new_from_widget(premier_bouton)
            if premier_bouton is None:
                premier_bouton = bouton
            boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            titre = Gtk.Label(label=intitule, xalign=0)
            titre.get_style_context().add_class("choix-titre")
            detail = Gtk.Label(label=note, xalign=0)
            detail.get_style_context().add_class("choix-note")
            detail.set_line_wrap(True)
            boite.pack_start(titre, False, False, 0)
            boite.pack_start(detail, False, False, 0)
            bouton.add(boite)
            bouton.set_active(self.reponses.get(cle) == valeur)
            bouton.connect("toggled", self.cocher, cle, valeur)
            self.corps.pack_start(bouton, False, False, 0)

    def cocher(self, bouton, cle, valeur):
        if bouton.get_active():
            self.reponses[cle] = valeur

    # ----------------------------------------------------------------- I4
    def ecran_reseau(self):
        """I4 — une liste des réseaux, le mot de passe au clic, ou rien.

        Tout passe par `reseau.py`, le même module que les Réglages : rien
        n'est réinventé ici, et une connexion établie maintenant est la MÊME
        connexion que la session retrouvera après le premier démarrage.

        La recherche part dans un fil, JAMAIS pendant que cet écran se
        construit — `grenos-connexions` a appris cette leçon à ses dépens :
        un `nmcli` lancé pendant la construction d'une fenêtre l'a déjà
        figée deux minutes.
        """
        self.corps.pack_start(
            grenosui.titre(
                "Connexion à Internet",
                "Choisis un réseau Wi-Fi, ou continue sans te connecter — "
                "tout se règle plus tard dans les Réglages."),
            False, False, 0)

        self.etat_reseau = Gtk.Label(label="Recherche des réseaux…", xalign=0)
        self.etat_reseau.get_style_context().add_class("sous")
        self.corps.pack_start(self.etat_reseau, False, False, 0)

        defilement = Gtk.ScrolledWindow()
        defilement.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        defilement.set_size_request(-1, 230)
        self.liste_reseaux = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                                     spacing=8)
        defilement.add(self.liste_reseaux)
        self.corps.pack_start(defilement, True, True, 0)

        self.corps.pack_start(
            grenosui.bouton("Continuer sans connexion",
                            lambda *_: self.avancer(), "discret"),
            False, False, 0)

        threading.Thread(target=self._chercher_reseaux, daemon=True).start()

    def _chercher_reseaux(self):
        trouves = reseau.reseaux()
        GLib.idle_add(self._poser_reseaux, trouves)

    def _poser_reseaux(self, trouves):
        # L'écran a pu changer pendant les vingt-cinq secondes qu'une
        # recherche peut prendre : les widgets de celui-ci ont alors été
        # détruits, et il ne faut plus y toucher.
        if self.cle != "reseau":
            return False
        for enfant in self.liste_reseaux.get_children():
            self.liste_reseaux.remove(enfant)
        for vu in trouves:
            self.liste_reseaux.pack_start(self._ligne_reseau(vu), False, False, 0)
        self.liste_reseaux.show_all()
        if trouves:
            self.etat_reseau.set_text(
                "%d réseau%s trouvé%s." % (len(trouves),
                                           "x" if len(trouves) > 1 else "",
                                           "s" if len(trouves) > 1 else ""))
        else:
            self.etat_reseau.set_text(
                "Aucun réseau trouvé. Vérifie qu'une carte Wi-Fi existe, "
                "ou continue sans connexion.")
        return False

    def _ligne_reseau(self, vu):
        ligne = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        texte = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        nom = Gtk.Label(label=vu["nom"], xalign=0)
        nom.get_style_context().add_class("entree-titre")
        details = Gtk.Label(
            label=("connecté" if vu["connecte"]
                   else ("protégé par mot de passe" if vu["protege"] else "ouvert")),
            xalign=0)
        details.get_style_context().add_class("sous")
        texte.pack_start(nom, False, False, 0)
        texte.pack_start(details, False, False, 0)
        ligne.pack_start(texte, True, True, 0)
        if not vu["connecte"]:
            ligne.pack_end(grenosui.bouton(
                "Se connecter", lambda v=vu: self._connecter_reseau(v),
                "principal"), False, False, 0)
        return grenosui.carte(ligne)

    def _connecter_reseau(self, vu):
        mot = ""
        if vu["protege"] and not reseau.connu(vu["nom"]):
            mot = self._demander_mot_reseau(vu["nom"])
            if mot is None:
                return
        self.etat_reseau.set_text("Connexion à %s…" % vu["nom"])
        threading.Thread(target=self._connecter_reseau_fil, args=(vu, mot),
                         daemon=True).start()

    def _connecter_reseau_fil(self, vu, mot):
        souci = reseau.connecter(vu["nom"], mot)
        GLib.idle_add(self._apres_connexion_reseau, vu, souci)

    def _apres_connexion_reseau(self, vu, souci):
        if self.cle != "reseau":
            return False
        self.etat_reseau.set_text(souci or "Connecté à %s." % vu["nom"])
        threading.Thread(target=self._chercher_reseaux, daemon=True).start()
        return False

    def _demander_mot_reseau(self, nom):
        """Le mot de passe, demandé au moment où il est demandé."""
        boite = Gtk.Dialog(title="Mot de passe de %s" % nom,
                           transient_for=self, modal=True)
        boite.add_buttons("Annuler", Gtk.ResponseType.CANCEL, "Se connecter",
                          Gtk.ResponseType.OK)
        boite.set_default_response(Gtk.ResponseType.OK)
        champ = Gtk.Entry(visibility=False)
        champ.set_activates_default(True)
        champ.set_placeholder_text("Mot de passe du réseau")
        montrer = Gtk.CheckButton(label="Afficher le mot de passe")
        montrer.connect("toggled", lambda b: champ.set_visibility(b.get_active()))
        contenu = boite.get_content_area()
        contenu.set_border_width(16)
        contenu.set_spacing(10)
        contenu.pack_start(Gtk.Label(label="Réseau : %s" % nom, xalign=0),
                           False, False, 0)
        contenu.pack_start(champ, False, False, 0)
        contenu.pack_start(montrer, False, False, 0)
        boite.show_all()
        reponse = boite.run()
        mot = champ.get_text()
        boite.destroy()
        return mot if reponse == Gtk.ResponseType.OK else None

    def ecran_apparence(self):
        """I6 — sombre, clair ou automatique.

        « Aperçu du bureau à droite » est dans sa liste, et il n'y est pas :
        l'assistant tourne avant qu'un bureau existe, donc l'aperçu serait une
        image dessinée à la main qui ressemble au bureau sans en être un. Le
        jour où elle divergerait, elle mentirait. On dit donc ce que chaque
        choix fait, et on le laisse changer d'avis dans les Réglages.
        """
        self.corps.pack_start(
            grenosui.titre("Apparence",
                           "Tu pourras en changer à tout moment dans "
                           "Réglages → Apparence."),
            False, False, 0)
        self.choix_simple("apparence", (
            ("auto", "Automatique",
             "Sombre le soir, clair le jour."),
            ("nuit", "Sombre",
             "Le thème de grenOS, celui que tu vois en ce moment."),
            ("jour", "Clair",
             "Fond clair, texte sombre."),
        ))

    def ecran_usage(self):
        """I7 — et le seul écran dont le choix INSTALLE quelque chose.

        Les quatre usages et leurs applications sont décrits dans
        `premier.USAGES`, par leur nom court de catalogue. Ce qui est coché ici
        part dans la file de travaux d'avant-bureau à la fin de l'assistant —
        donc ce n'est pas une préférence rangée dans un fichier, c'est un
        travail qui s'exécute au prochain démarrage.
        """
        self.corps.pack_start(
            grenosui.titre("À quoi va servir cet ordinateur ?",
                           "Les applications du profil choisi s'installeront "
                           "au prochain démarrage. Rien n'est définitif : "
                           "GrenPlace sait en ajouter et en retirer."),
            False, False, 0)
        self.choix_simple("usage", [
            (cle, intitule, note) for cle, intitule, note, _ in premier.USAGES])

    def ecran_securite(self):
        """I9 — l'état, et AUCUN interrupteur.

        Son garde-fou, dans ses mots : « il ne faut pas que ça se retourne
        contre nous ». Un chiffrement proposé ici n'aurait rien à chiffrer —
        on tourne sur une image vive — et une case cochée sans effet est
        exactement la faute que ce dépôt attrape depuis des semaines.
        """
        etat = premier.secure_boot()
        self.corps.pack_start(
            grenosui.titre("Protégeons votre ordinateur",
                           premier.mot_sur_secure_boot(etat)),
            False, False, 0)
        lignes = [
            ("Secure Boot", etat),
            ("Mises à jour automatiques",
             "oui" if self.reponses.get("majs") == "automatiques" else "au choix"),
            ("Antivirus", "ClamAV, installé"),
            ("Chiffrement du disque",
             "se décide à l'installation sur disque, pas ici"),
        ]
        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for nom, valeur in lignes:
            ligne = Gtk.Box(spacing=12)
            gauche = Gtk.Label(label=nom, xalign=0)
            gauche.get_style_context().add_class("choix-titre")
            droite = Gtk.Label(label=valeur, xalign=1)
            droite.get_style_context().add_class("choix-note")
            droite.set_line_wrap(True)
            ligne.pack_start(gauche, False, False, 0)
            ligne.pack_end(droite, False, False, 0)
            boite.pack_start(ligne, False, False, 0)
        self.corps.pack_start(grenosui.carte(boite), False, False, 0)
        dire("premier : securite — secure boot %s" % etat)

    def ecran_optimisation(self):
        """I13 — « nous avons détecté votre matériel… », puis un bouton.

        Ce qu'il y a derrière le bouton existe déjà et ne date pas d'ici :
        `grenos-performances` met le gouverneur du processeur en
        « performance ». On ne l'exécute pas maintenant — un assistant qui
        touche au système pendant qu'on y répond ne peut plus revenir en
        arrière. Le travail part dans la file, comme les applications.
        """
        # ON LIT LE CONTRAT DE `materiel.py`, ON NE LE DEVINE PAS : `coeurs()`
        # et `memoire()` rendent chacun un couple, `graphique()` rend (carte,
        # pilote). J'avais d'abord écrit `carte.get("nom")` de mémoire, c'est-
        # à-dire un dictionnaire qui n'existe pas — l'écran aurait planté à
        # l'ouverture, et c'est l'écran sans lequel personne n'entre dans la
        # machine.
        nombre, modele = materiel.coeurs()
        totale, _libre = materiel.memoire()
        carte, pilote = materiel.graphique()
        # Il manquait le Wi-Fi, le Bluetooth et le genre de disque — todo.md
        # I14 le disait en toutes lettres. Les trois se lisent sans lancer
        # personne : `sante.cartes_reseau()` et `materiel.disques()` lisent
        # /sys comme le reste de cet écran, et `materiel.bluetooth_present()`
        # existe exactement pour ne jamais appeler `bluetoothctl` ici — c'est
        # l'appel qui a déjà figé `grenos-connexions` deux minutes en se
        # lançant pendant qu'une fenêtre se dessinait.
        wifi = any(c["genre"] == "sans-fil" for c in sante.cartes_reseau())
        bluetooth = materiel.bluetooth_present()
        disques = materiel.disques()
        genre_disque = materiel.genre_du_disque(disques[0]) if disques else "aucun disque vu"
        self.corps.pack_start(
            grenosui.titre("Optimisation automatique",
                           "Voici ce que grenOS a trouvé sur cette machine."),
            False, False, 0)
        lignes = [
            ("Processeur", "%s cœur(s)%s"
             % (grenosui.nombre(nombre, 0), " — " + modele if modele else "")),
            ("Mémoire", "%s Go" % grenosui.nombre(totale, 1)),
            ("Carte graphique", carte or "inconnue"),
            ("Pilote", pilote or "générique"),
            ("Disque principal", genre_disque),
            ("Wi-Fi", "détecté" if wifi else "aucune carte vue"),
            ("Bluetooth", "détecté" if bluetooth else "aucune puce vue"),
        ]
        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for nom, valeur in lignes:
            ligne = Gtk.Box(spacing=12)
            gauche = Gtk.Label(label=nom, xalign=0)
            gauche.get_style_context().add_class("choix-titre")
            droite = Gtk.Label(label=str(valeur), xalign=1)
            droite.get_style_context().add_class("choix-note")
            ligne.pack_start(gauche, False, False, 0)
            ligne.pack_end(droite, False, False, 0)
            boite.pack_start(ligne, False, False, 0)
        self.corps.pack_start(grenosui.carte(boite), False, False, 0)
        case = Gtk.CheckButton(label="Régler la machine pour la performance "
                                     "au prochain démarrage")
        case.set_active(self.reponses.get("optimiser") == "oui")
        case.connect("toggled", lambda b: self.reponses.__setitem__(
            "optimiser", "oui" if b.get_active() else "non"))
        self.corps.pack_start(case, False, False, 0)
        dire("premier : optimisation — %d coeur(s), %s Go, carte %s, disque %s, "
             "wifi %s, bluetooth %s"
             % (nombre, grenosui.nombre(totale, 1), carte or "inconnue",
                genre_disque, "oui" if wifi else "non", "oui" if bluetooth else "non"))

