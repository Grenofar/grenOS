#!/usr/bin/env python3
"""gren — le système grenOS, depuis le terminal.

Le pendant en ligne de commande des fenêtres : ce que montrent grenPerf, les
Réglages et Mises à jour, en une commande. Chaque sous-commande a aussi sa
forme Verbe-Nom dans grensh (`Afficher-Systeme` = `gren info`).

Rien ici n'importe GTK : une commande de terminal doit répondre en quelques
millisecondes, pas charger une bibliothèque graphique.
"""
import os
import shutil
import subprocess
import sys

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "grenos")
ACCENTS = ("bleu", "violet", "vert", "orange", "rose", "cyan")

COULEUR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


# LA LANGUE (19 novembre) : l'anglais par défaut, le français au choix.
# Le réglage de grenOS d'abord, puis $LANG, puis l'anglais — la même règle
# que grenget, pour que les deux ne se contredisent jamais.
def _langue():
    try:
        with open(os.path.join(CONFIG, "langue"), encoding="utf-8") as f:
            v = f.read().strip()
        if v in ("en", "fr"):
            return v
    except OSError:
        pass
    return "fr" if os.environ.get("LANG", "").startswith("fr") else "en"


FR = _langue() == "fr"


def _(en, fr):
    return fr if FR else en


def c(rvb, texte, gras=False):
    if not COULEUR:
        return texte
    return f"\033[{'1;' if gras else ''}38;2;{rvb}m{texte}\033[0m"


BLEU, VIOLET, GRIS, VERT, ROUGE, BLANC = "96;165;250", "167;139;250", "148;161;186", "43;196;138", "239;77;94", "238;242;250"


def titre(texte):
    print(c(VIOLET, "● ") + c(BLANC, texte, gras=True))


def ligne(etiquette, valeur):
    print(f"  {c(GRIS, etiquette.ljust(13))} {valeur}")


def jauge(part, largeur=24):
    part = max(0.0, min(1.0, part))
    plein = round(part * largeur)
    couleur = ROUGE if part > 0.88 else BLEU
    return c(couleur, "━" * plein) + c("44;61;96", "━" * (largeur - plein))


def lire(chemin, defaut=""):
    try:
        with open(chemin, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return defaut


def reglage(nom, defaut=""):
    return lire(os.path.join(CONFIG, nom)) or defaut


def meminfo():
    valeurs = {}
    for l in lire("/proc/meminfo").splitlines():
        cle, _sep, reste = l.partition(":")
        try:
            valeurs[cle] = int(reste.split()[0]) / 1048576  # Go
        except (IndexError, ValueError):
            pass
    return valeurs


def go(x):
    # « 1,5 Go » en français, « 1.5 GB » en anglais.
    return f"{x:.1f}".replace(".", ",") + " Go" if FR else f"{x:.1f} GB"


# ---- Les sous-commandes --------------------------------------------------------
LOGO = [
    "      ▄▄      ",
    "   ▄████  ▄▄  ",
    "   ██████████ ",
    "    ▀███████▀ ",
    "       ██     ",
    "       ██     ",
]


def info(_args):
    """Ce qu'est cette machine, d'un coup d'œil."""
    os_nom = "grenOS"
    for l in lire("/etc/os-release").splitlines():
        if l.startswith("PRETTY_NAME="):
            os_nom = l.split("=", 1)[1].strip('"')
    construction = lire("/usr/share/grenos/version")
    noyau = os.uname().release
    modele = ""
    for l in lire("/proc/cpuinfo").splitlines():
        if l.startswith("model name"):
            modele = " ".join(l.split(":", 1)[1].split())
            break
    coeurs = os.cpu_count() or 1
    m = meminfo()
    total, dispo = m.get("MemTotal", 0), m.get("MemAvailable", 0)
    disque = shutil.disk_usage(os.path.expanduser("~"))
    secondes = float(lire("/proc/uptime", "0").split()[0])
    heures, minutes = int(secondes // 3600), int(secondes % 3600 // 60)
    identite = {}
    for l in lire("/etc/grenos/identite").splitlines():
        if "=" in l:
            k, v = l.split("=", 1)
            identite[k.strip()] = v.strip()

    lignes = [
        c(BLEU, f"{os.environ.get('USER', '?')}", True) + c(GRIS, "@") + c(VIOLET, identite.get("machine", os.uname().nodename), True),
        c(GRIS, "─" * 30),
        f"{c(GRIS, _('System', 'Système').ljust(11))} {os_nom}{c(GRIS, ' · ' + construction) if construction else ''}",
        f"{c(GRIS, _('Kernel', 'Noyau').ljust(11))} {noyau}",
        f"{c(GRIS, _('CPU', 'Processeur').ljust(11))} {modele or '?'} ({coeurs} {_('cores', 'cœurs')})",
        f"{c(GRIS, _('Memory', 'Mémoire').ljust(11))} {go(total - dispo)} / {go(total)}",
        f"{c(GRIS, _('Disk', 'Disque').ljust(11))} {go(disque.used / 1073741824)} / {go(disque.total / 1073741824)}",
        f"{c(GRIS, _('Uptime', 'Allumé').ljust(11))} {heures} h {minutes:02d}",
        f"{c(GRIS, _('Look', 'Apparence').ljust(11))} {reglage('theme', 'nuit')}, accent {reglage('accent', 'bleu')}",
        f"{c(GRIS, 'Terminal'.ljust(11))} grensh {os.environ.get('GRENSH_VERSION', '1')} (bash {os.environ.get('BASH_VERSION', '').split('(')[0] or '?'})",
    ]
    for i in range(max(len(LOGO), len(lignes))):
        gauche = LOGO[i] if i < len(LOGO) else " " * len(LOGO[0])
        teinte = VERT if i >= 4 else (BLEU if i < 2 else VIOLET)
        print(" " + c(teinte, gauche) + "  " + (lignes[i] if i < len(lignes) else ""))
    return 0


def memoire(_args):
    m = meminfo()
    total, dispo = m.get("MemTotal", 0), m.get("MemAvailable", 0)
    cache = m.get("Cached", 0) + m.get("Buffers", 0)
    titre(_("Memory", "Mémoire"))
    ligne(_("Used", "Utilisée"), f"{jauge((total - dispo) / max(total, 0.01))}  {go(total - dispo)} / {go(total)}")
    ligne("Cache", f"{go(cache)} " + _("(given back as soon as an app needs it)", "(rendu dès qu'une application en a besoin)"))
    et, el = m.get("SwapTotal", 0), m.get("SwapFree", 0)
    if et > 0:
        ligne(_("Swap", "Échange"), f"{jauge((et - el) / et)}  {go(et - el)} / {go(et)}")
    # Les cinq plus gourmands, comme le haut de grenPerf.
    lourds = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        statut = lire(f"/proc/{pid}/status")
        nom, rss = "", 0
        for l in statut.splitlines():
            if l.startswith("Name:"):
                nom = l.split()[1]
            elif l.startswith("VmRSS:"):
                rss = int(l.split()[1])
        if rss:
            lourds.append((rss, nom))
    if lourds:
        print()
        titre(_("The hungriest", "Les plus gourmands"))
        for rss, nom in sorted(lourds, reverse=True)[:5]:
            ligne(nom[:13], f"{rss / 1024:.0f} " + _("MB", "Mo"))
    return 0


def liberer(_args):
    avant = meminfo().get("MemAvailable", 0)
    outil = "/usr/lib/grenos/grenos-perf-liberer"
    lanceur = ["sudo", "-n"] if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0 else ["pkexec"]
    code = subprocess.run(lanceur + [outil]).returncode
    apres = meminfo().get("MemAvailable", 0)
    if code == 0:
        print(c(VERT, "✓ ") + _(f"Memory freed: {go(max(0.0, apres - avant))} given back ({go(apres)} available).",
                                 f"Mémoire libérée : {go(max(0.0, apres - avant))} rendus ({go(apres)} disponibles)."))
    else:
        print(c(ROUGE, "✗ ") + _("Nothing was done (permission refused).", "Rien n'a été fait (autorisation refusée)."))
    return code


def reseau(_args):
    titre(_("Network", "Réseau"))
    sortie = subprocess.run(["ip", "-brief", "address"], capture_output=True, text=True).stdout
    for l in sortie.splitlines():
        champs = l.split()
        if not champs or champs[0] == "lo":
            continue
        etat = champs[1] if len(champs) > 1 else "?"
        adresses = " ".join(a for a in champs[2:] if "." in a) or _("no address", "aucune adresse")
        ligne(champs[0], (c(VERT, _("● connected", "● relié")) if etat == "UP" else c(GRIS, "○ " + etat.lower())) + f"  {adresses}")
    return 0


# Les valeurs écrites dans ~/.config/grenos restent les mots français que
# tout grenOS lit ; on accepte les deux langues à l'entrée.
THEMES = {"night": "nuit", "dark": "nuit", "day": "jour", "light": "jour", "nuit": "nuit", "jour": "jour"}
COULEURS = {"blue": "bleu", "purple": "violet", "violet": "violet", "green": "vert", "orange": "orange",
            "pink": "rose", "cyan": "cyan", "bleu": "bleu", "vert": "vert", "rose": "rose"}


def theme(args):
    if args and args[0] not in THEMES:
        print(_("Usage: gren theme [night|day]", "Usage : gren theme [nuit|jour]"), file=sys.stderr)
        return 2
    code = subprocess.run(["grenos-theme"] + [THEMES[a] for a in args[:1]]).returncode
    if code == 0:
        print(c(VERT, "✓ ") + _("Theme: ", "Thème : ") + f"{reglage('theme', 'nuit')}.")
    return code


def accent(args):
    if not args or args[0] not in COULEURS:
        noms = "blue|purple|green|orange|pink|cyan" if not FR else "|".join(ACCENTS)
        print(_(f"Usage: gren accent [{noms}]  (current: {reglage('accent', 'bleu')})",
                f"Usage : gren accent [{noms}]  (actuel : {reglage('accent', 'bleu')})"), file=sys.stderr)
        return 2
    args = [COULEURS[args[0]]]
    os.makedirs(CONFIG, exist_ok=True)
    with open(os.path.join(CONFIG, "accent"), "w", encoding="utf-8") as f:
        f.write(args[0] + "\n")
    # La barre se repeint au signal ; les fenêtres prennent l'accent à leur
    # prochaine ouverture (c'est ce que font les Réglages).
    subprocess.run(["pkill", "-USR1", "-f", "grenos-shell"], capture_output=True)
    print(c(VERT, "✓ ") + _(f"Accent: {args[0]}. The taskbar follows right away, windows the next time they open.",
                             f"Accent : {args[0]}. La barre suit tout de suite, les fenêtres à leur prochaine ouverture."))
    return 0


def maj(args):
    nombre = lire("/run/grenos/maj")
    date = lire("/run/grenos/maj-date")
    titre(_("Updates", "Mises à jour"))
    if nombre.isdigit():
        n = int(nombre)
        ligne(_("System", "Système"), c(VERT, _("up to date", "à jour")) if n == 0 else c(BLEU, _(f"{n} package(s) ready", f"{n} paquet(s) prêt(s)")))
    else:
        ligne(_("System", "Système"), c(GRIS, _("not checked yet since boot", "pas encore vérifié depuis le démarrage")))
    if date:
        ligne(_("Checked", "Vérifié"), _(f"{date} UTC", f"le {date} UTC"))
    ligne("Mode", reglage("maj-mode") or lire("/etc/grenos/maj-mode", "automatiques"))
    print()
    print(c(GRIS, _("  The system installs at restart, before the desktop; apps", "  Le système s'installe au redémarrage, avant le bureau ; les applications")))
    print(c(GRIS, _("  right away. ", "  tout de suite. ")) + c(BLEU, _("grenget update", "grenget maj")) + c(GRIS, _(" updates the apps, ", " met les applications à jour, "))
          + c(BLEU, _("gren update --window", "gren maj --fenetre")) + c(GRIS, _(" opens the window.", " ouvre la fenêtre.")))
    if "--fenetre" in args or "--window" in args:
        subprocess.Popen(["grenos-maj"], start_new_session=True)
    return 0


def ouvrir(args):
    if not args:
        print(_("Usage: gren open <app>", "Usage : gren ouvrir <application>"), file=sys.stderr)
        return 2
    voulu = " ".join(args).lower()
    trouve = None
    for dossier in ("/usr/share/applications", os.path.expanduser("~/.local/share/applications"),
                    "/var/lib/flatpak/exports/share/applications"):
        if not os.path.isdir(dossier):
            continue
        for nom in sorted(os.listdir(dossier)):
            if not nom.endswith(".desktop"):
                continue
            texte = lire(os.path.join(dossier, nom))
            noms = [l.split("=", 1)[1].lower() for l in texte.splitlines() if l.startswith(("Name=", "Name[fr]=", "Name[en]="))]
            if voulu == nom[:-8].lower() or voulu in noms:
                trouve = nom[:-8]
                break
            if trouve is None and any(voulu in n for n in noms):
                trouve = nom[:-8]
        if trouve:
            break
    if not trouve:
        print(c(ROUGE, "✗ ") + _(f"No app called “{voulu}”. ", f"Aucune application « {voulu} ». ") + c(GRIS, _("Try ", "Essaie "))
              + c(BLEU, _(f"grenget search {voulu}", f"grenget chercher {voulu}")))
        return 1
    subprocess.Popen(["gtk-launch", trouve], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(c(VERT, "✓ ") + _(f"{trouve} is opening.", f"{trouve} s'ouvre."))
    return 0


def sauvegarde(args):
    """Les sauvegardes sur disque externe (grenos-sauvegarde + son minuteur)."""
    action = args[0] if args else "etat"
    action = {"status": "etat", "on": "activer", "enable": "activer", "off": "desactiver",
              "disable": "desactiver", "now": "maintenant"}.get(action, action)
    outil = "/usr/lib/grenos/grenos-sauvegarde"
    if action == "activer":
        code = subprocess.run(["systemctl", "--user", "enable", "--now", "grenos-sauvegarde.timer"]).returncode
        if code == 0:
            print(c(VERT, "✓ ") + _("Backups on: one copy a day as soon as an external disk is plugged in.",
                                     "Sauvegardes activées : une copie par jour dès qu'un disque externe est branché."))
        return code
    if action == "desactiver":
        code = subprocess.run(["systemctl", "--user", "disable", "--now", "grenos-sauvegarde.timer"]).returncode
        if code == 0:
            print(c(VERT, "✓ ") + _("Backups off. The copies already made stay on the disk.",
                                     "Sauvegardes coupées. Les copies déjà faites restent sur le disque."))
        return code
    if action == "maintenant":
        return subprocess.run([outil, "--forcer"]).returncode
    if action == "etat":
        actif = subprocess.run(["systemctl", "--user", "is-enabled", "grenos-sauvegarde.timer"],
                               capture_output=True, text=True).stdout.strip() == "enabled"
        titre(_("Backups", "Sauvegardes"))
        ligne(_("Automatic", "Automatiques"), c(VERT, _("yes, every day", "oui, chaque jour")) if actif
              else c(GRIS, _("no — ", "non — ")) + c(BLEU, _("gren backup on", "gren sauvegarde activer")))
        for l in subprocess.run([outil, "--etat"], capture_output=True, text=True).stdout.splitlines():
            cle, _sep, valeur = l.partition(" : ")
            ligne(cle, valeur or "")
        return 0
    print(_("Usage: gren backup [status|on|off|now]", "Usage : gren sauvegarde [etat|activer|desactiver|maintenant]"), file=sys.stderr)
    return 2


def _grenai(question):
    """La question à GrenAI, par grenos-ui (les mêmes clés que la fenêtre)."""
    if not os.access("/usr/bin/grenos-ui", os.X_OK):
        print(_("GrenAI isn't installed on this machine.", "GrenAI n'est pas installé sur cette machine."), file=sys.stderr)
        return 1
    print(c(GRIS, _("GrenAI is thinking… (the model, and where your words go, are set in the GrenAI window)",
                    "GrenAI réfléchit… (le modèle et l'endroit où partent les mots se règlent dans la fenêtre GrenAI)")))
    fin = subprocess.run(["/usr/bin/grenos-ui", "--grenai"], input=question, text=True,
                         capture_output=True)
    if fin.returncode != 0:
        print(c(ROUGE, "✗ ") + (fin.stderr.strip() or _("GrenAI didn't answer.", "GrenAI n'a pas répondu.")), file=sys.stderr)
        return 1
    print(fin.stdout.rstrip())
    return 0


def ia(args):
    """H4 — une question à GrenAI, depuis le terminal."""
    question = " ".join(args).strip()
    if not question:
        print(_("Usage: gren ai “your question”", "Usage : gren ia « ta question »"), file=sys.stderr)
        return 2
    return _grenai(question)


def corrige(args):
    """H4 — corriger une commande qui a échoué.

    On n'EXÉCUTE rien : on demande la commande corrigée, on l'affiche, et
    c'est la personne qui décide de la lancer. Un assistant qui relance
    lui-même une commande (rm, dd…) serait le pire outil à mettre dans un
    terminal.
    """
    commande = " ".join(args).strip()
    if not commande:
        print(_("Usage: gren fix “the command”   (in grensh: `fix` takes the last one)",
                "Usage : gren corrige « la commande »   (dans grensh : `corrige` reprend la dernière)"), file=sys.stderr)
        return 2
    if not FR:
        return _grenai(
            "This Linux command (bash, Debian) failed or doesn't do what I want:\n\n"
            f"    {commande}\n\n"
            "Answer in English. First line: the corrected command alone, no markup. "
            "Then one or two sentences saying what was wrong. If the command can "
            "erase or break something, say so clearly.")
    return _grenai(
        "Cette commande Linux (bash, Debian) a échoué ou ne fait pas ce qu'on veut :\n\n"
        f"    {commande}\n\n"
        "Réponds en français. Première ligne : la commande corrigée seule, sans balises. "
        "Puis une ou deux phrases qui disent ce qui n'allait pas. Si la commande peut "
        "effacer ou casser quelque chose, dis-le clairement.")


def version(_args):
    print(f"gren 1 · grensh {os.environ.get('GRENSH_VERSION', '1')}")
    return 0


# (nom français, nom anglais, verbe grensh, ce que ça fait EN, FR, fonction).
# Les DEUX noms marchent toujours ; l'aide montre ceux de la langue choisie.
COMMANDES = [
    ("info", "info", "Afficher-Systeme", "what this machine is", "ce qu'est cette machine", info),
    ("memoire", "memory", "Afficher-Memoire", "memory, and who takes it", "la mémoire, et qui la prend", memoire),
    ("liberer", "free", "Liberer-Memoire", "give back the cache and bring swap home", "rendre le cache et rapatrier l'échange", liberer),
    ("reseau", "network", "Afficher-Reseau", "connections and their addresses", "les connexions et leurs adresses", reseau),
    ("theme", "theme", "Changer-Theme", "night or day", "nuit ou jour", theme),
    ("accent", "accent", "Changer-Accent", "the accent color", "la couleur d'accent", accent),
    ("maj", "update", "Mettre-AJour", "update status", "l'état des mises à jour", maj),
    ("ouvrir", "open", "Ouvrir-App", "open an app by its name", "ouvrir une application par son nom", ouvrir),
    ("sauvegarde", "backup", "Sauvegarder-Fichiers", "copies on an external disk: status, on, now", "copies sur disque externe : etat, activer, maintenant", sauvegarde),
    ("ia", "ai", "Demander-IA", "a question for GrenAI", "une question à GrenAI", ia),
    ("corrige", "fix", "Corriger-Commande", "the command fixed by GrenAI (nothing is run)", "la commande corrigée par GrenAI (rien n'est lancé)", corrige),
    ("version", "version", "", "gren's version", "la version de gren", version),
]

APPLIS = [
    ("chercher", "search", "Chercher-App", "find an app", "trouver une application"),
    ("installer", "install", "Installer-App", "install an app", "installer une application"),
    ("enlever", "remove", "Desinstaller-App", "uninstall", "désinstaller"),
    ("liste", "list", "Lister-Apps", "what's installed", "ce qui est installé"),
    ("info", "info", "Afficher-App", "an app's page", "la fiche d'une application"),
    ("maj", "update", "", "update the apps", "mettre les applications à jour"),
    ("proposer", "suggest", "Proposer-App", "suggest an app for the catalog", "proposer une application au catalogue"),
]


def aide(_args):
    titre(_("gren — the system", "gren — le système"))
    for nom_fr, nom_en, verbe, en, fr, _f in COMMANDES:
        print(f"  {c(BLEU, ('gren ' + _(nom_en, nom_fr)).ljust(18))} {c(VIOLET, verbe.ljust(20))} {_(en, fr)}")
    print()
    titre(_("grenget — apps", "grenget — les applications"))
    for nom_fr, nom_en, verbe, en, fr in APPLIS:
        print(f"  {c(BLEU, ('grenget ' + _(nom_en, nom_fr)).ljust(18))} {c(VIOLET, verbe.ljust(20))} {_(en, fr)}")
    print()
    print(c(GRIS, _("  Both forms do the same thing: ", "  Les deux formes font la même chose : ")) + c(BLEU, "gren info") + c(GRIS, " = ")
          + c(VIOLET, "Afficher-Systeme") + c(GRIS, _(". Tab completes.", ". Tab complète.")))
    print(c(GRIS, _("  English and French command names both work.", "  Les noms de commande anglais et français marchent tous les deux.")))
    print(c(GRIS, _("  Everything else is bash: Linux tutorials work here as is.", "  Tout le reste est du bash : les tutoriels Linux marchent ici tels quels.")))
    return 0


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("aide", "-h", "--help", "help"):
        return aide(args[1:])
    for nom_fr, nom_en, _v, _e, _f, fonction in COMMANDES:
        if args[0] in (nom_fr, nom_en):
            return fonction(args[1:])
    print(c(ROUGE, "✗ ") + _(f"“{args[0]}” isn't a gren command. ", f"« {args[0]} » n'est pas une commande de gren. ")
          + c(GRIS, _("Type ", "Tape ")) + c(BLEU, _("gren help", "gren aide")), file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
