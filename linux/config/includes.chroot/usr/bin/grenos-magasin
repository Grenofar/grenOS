#!/usr/bin/env python3
"""Le magasin de grenOS : des applications, en un clic.

Deux sources, un seul bouton. Les paquets Debian viennent du système et se
mettent à jour avec lui ; les Flatpak viennent de Flathub et tournent dans leur
coin, ce qui permet d'installer Steam sans activer l'architecture 32 bits ni
toucher au reste de la machine.

L'installation s'affiche dans un terminal, volontairement : une barre qui
tourne sans rien dire pendant dix minutes inquiète plus qu'elle ne rassure.
"""
import subprocess
import sys

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

import grenosui  # noqa: E402

# nom, description, source, identifiant
CATALOGUE = [
    ("Steam", "Les jeux, et la couche Proton qui fait tourner les jeux Windows.",
     "flatpak", "com.valvesoftware.Steam"),
    ("VLC", "Lit à peu près tout ce qui existe comme vidéo et comme son.",
     "flatpak", "org.videolan.VLC"),
    ("LibreOffice", "Traitement de texte, tableur, présentations.",
     "flatpak", "org.libreoffice.LibreOffice"),
    ("GIMP", "Retouche et dessin, en pixels.",
     "flatpak", "org.gimp.GIMP"),
    ("Inkscape", "Dessin vectoriel : logos, affiches, schémas.",
     "flatpak", "org.inkscape.Inkscape"),
    ("Blender", "Modélisation, animation et rendu 3D.",
     "flatpak", "org.blender.Blender"),
    ("OBS Studio", "Enregistrer son écran, diffuser en direct.",
     "flatpak", "com.obsproject.Studio"),
    ("Visual Studio Code", "L'éditeur de code de Microsoft.",
     "flatpak", "com.visualstudio.code"),
    ("Discord", "Discussion écrite et vocale.",
     "flatpak", "com.discordapp.Discord"),
    ("Chromium", "Le navigateur libre dont Chrome est tiré.",
     "apt", "chromium"),
    ("Thunderbird", "Le courrier électronique.",
     "apt", "thunderbird"),
    ("Git", "Le gestionnaire de versions, en ligne de commande.",
     "apt", "git"),
    ("Pilote NVIDIA", "Le pilote propriétaire, pour les cartes NVIDIA récentes. "
     "Redémarrer après l'installation.", "apt", "nvidia-driver"),
]


def installe(source, identifiant):
    """Cette application est-elle déjà là ?"""
    if source == "flatpak":
        return subprocess.run(["flatpak", "info", identifiant],
                              capture_output=True).returncode == 0
    return subprocess.run(["dpkg-query", "-W", "-f=${Status}", identifiant],
                          capture_output=True, text=True).stdout.startswith("install ok")


def commande(source, identifiant):
    """Ce qui installe vraiment, tel qu'on pourrait le taper soi-même."""
    if source == "flatpak":
        return ("flatpak remote-add --if-not-exists flathub "
                "https://dl.flathub.org/repo/flathub.flatpakrepo && "
                f"flatpak install -y flathub {identifiant}")
    return f"apt-get update && apt-get install -y {identifiant}"


def en_root(ligne):
    """sudo quand il ne demande rien, pkexec sinon : dans les deux cas, ça marche."""
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        return f"sudo -n sh -c {GLib.shell_quote(ligne)}"
    return f"pkexec sh -c {GLib.shell_quote(ligne)}"


class Magasin(Gtk.Window):
    def __init__(self):
        super().__init__(title="Magasin grenOS")
        self.set_default_size(880, 660)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)

        colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        colonne.set_border_width(24)
        self.add(colonne)

        colonne.pack_start(
            grenosui.titre("Magasin", "Les applications s'installent ici, et se mettent "
                                      "ensuite à jour avec le reste du système."),
            False, False, 0)

        self.recherche = Gtk.SearchEntry()
        self.recherche.set_placeholder_text("Chercher une application")
        self.recherche.connect("search-changed", lambda _: self.remplir())
        colonne.pack_start(self.recherche, False, False, 0)

        defilement = Gtk.ScrolledWindow()
        defilement.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        colonne.pack_start(defilement, True, True, 0)
        self.liste = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        defilement.add(self.liste)

        self.remplir()

    def remplir(self):
        filtre = self.recherche.get_text().strip().lower()
        for enfant in self.liste.get_children():
            self.liste.remove(enfant)

        for nom, note, source, identifiant in CATALOGUE:
            if filtre and filtre not in nom.lower() and filtre not in note.lower():
                continue
            ligne = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)

            texte = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            titre = Gtk.Label(label=nom, xalign=0)
            titre.get_style_context().add_class("entree-titre")
            sous = Gtk.Label(label=note, xalign=0)
            sous.get_style_context().add_class("sous")
            sous.set_line_wrap(True)
            origine = Gtk.Label(
                label="paquet Debian" if source == "apt" else "Flatpak, depuis Flathub", xalign=0)
            origine.get_style_context().add_class("section")
            texte.pack_start(titre, False, False, 0)
            texte.pack_start(sous, False, False, 0)
            texte.pack_start(origine, False, False, 0)
            ligne.pack_start(texte, True, True, 0)

            if installe(source, identifiant):
                etat = Gtk.Label(label="Installé")
                etat.get_style_context().add_class("sous")
                ligne.pack_end(etat, False, False, 6)
            else:
                ligne.pack_end(
                    grenosui.bouton("Installer",
                                    lambda s=source, i=identifiant, n=nom: self.installer(s, i, n),
                                    "principal"),
                    False, False, 0)

            self.liste.pack_start(grenosui.carte(ligne), False, False, 0)
        self.liste.show_all()

    def installer(self, source, identifiant, nom):
        ligne = en_root(commande(source, identifiant))
        grenosui.lancer(
            f"x-terminal-emulator --title {GLib.shell_quote('Installation de ' + nom)} "
            f"-e sh -c {GLib.shell_quote(ligne + '; echo; echo Terminé. Entrée pour fermer.; read x')}"
        )


def main():
    grenosui.habiller()
    fenetre = Magasin()
    fenetre.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
