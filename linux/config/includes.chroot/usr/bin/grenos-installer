#!/bin/sh
# « Installer grenOS » : l'installateur, avec des disques LIBRES (21 novembre).
#
# Grenofar, sur son PC : « pour installer il bloque au partitionnement, on ne
# peut plus choisir ». Calamares (lu dans son module partition, ChoicePage) :
# dès qu'une partition d'un disque est MONTÉE, il retire « Effacer le
# disque », « Remplacer » et « Installer à côté » pour ce disque — il ne
# reste que le partitionnement manuel. Or la session de la clé en monte :
#   - grenos-windows ouvre la partition Windows en lecture seule (pour
#     montrer ses dossiers dans l'explorateur) ;
#   - l'explorateur monte un disque dès qu'on clique dessus dans « Ce PC » —
#     son SSD, par exemple, pour voir s'il est vide avant d'installer.
#
# On referme donc tout ce qui est ouvert sur les disques de la machine (la
# clé de grenOS exceptée : le système en tourne) AVANT d'ouvrir l'installateur,
# et on dit ce qui est refermé. Rien n'est effacé ni modifié : refermer un
# disque, c'est ce que fait « Éjecter » dans l'explorateur.
#
# DEPUIS LE 22 NOVEMBRE, tout cela n'est plus que le SECOURS : « Installer
# grenOS » ouvre notre installateur (grenos-ui, page « installation » ; le
# moteur est /usr/lib/grenos/grenos-installation, qui referme lui-même le
# disque choisi et n'accepte jamais la clé). `grenos-installer --secours`
# ouvre encore Calamares, avec ce qui suit.
#
# Le reste ne change pas : `pkexec calamares`, ouvert sans mot de passe par
# la règle polkit 49 (et vérifié à chaque session par grenos-session).

set -u

dire() {
    grenos-dire "$*" 2>/dev/null || true
    echo "grenos-installer: $*" >&2
}

# NOTRE INSTALLATEUR. Rien d'autre ici : pas de disque refermé, pas de clé
# cachée. grenos-ui n'a qu'un processus : un second clic ramène la fenêtre
# devant. Pas de repli automatique sur Calamares si la fenêtre se ferme en
# erreur : deux installateurs ne doivent jamais écrire sur le même disque.
# Le moteur absent (ce lanceur posé par le correctif sur une image d'avant le
# 22 novembre) : la page n'y est pas non plus, Calamares reste.
MOTEUR=${GRENOS_MOTEUR:-/usr/lib/grenos/grenos-installation}
if [ "${1:-}" = --secours ]; then
    shift
elif [ -x "$MOTEUR" ] && command -v grenos-ui >/dev/null 2>&1; then
    exec grenos-ui installation
fi

# UN SEUL INSTALLATEUR À LA FOIS (21 novembre, 20 h 29 chez Grenofar). Un
# second clic sur l'icône (Calamares met quelques secondes à paraître) a
# lancé un second lanceur : son Calamares a vu le premier ouvert et s'est
# refermé aussitôt — et ce second lanceur a RENDU la clé en partant, une
# seconde avant que le premier Calamares ne lise les disques. La clé est
# revenue dans la liste, « Installer à côté » l'a prise pour partition EFI,
# et grub-install a échoué à la fin (clé en lecture seule). Désormais le
# second lancement s'en va sans rien toucher.
#
# mkdir est atomique : de deux lancements simultanés, un seul gagne. Le
# numéro du lanceur dedans : un verrou laissé par une session coupée ne
# bloque personne (/run/user est vidé à chaque démarrage, de toute façon).
VERROU="${GRENOS_VERROU_INSTALLATEUR:-${XDG_RUNTIME_DIR:-/tmp}/grenos-installateur.verrou}"
if ! mkdir "$VERROU" 2>/dev/null; then
    ancien=$(cat "$VERROU/pid" 2>/dev/null)
    if [ -n "$ancien" ] && kill -0 "$ancien" 2>/dev/null; then
        dire "installateur : deja ouvert — un seul a la fois, rien n est touche"
        exit 0
    fi
    rm -rf "$VERROU" 2>/dev/null
    mkdir "$VERROU" 2>/dev/null || { dire "installateur : deja ouvert"; exit 0; }
fi
echo "$$" > "$VERROU/pid"
trap 'rm -rf "$VERROU"' EXIT
trap 'exit 1' HUP INT TERM

# La clé d'où grenOS tourne : son disque reste ouvert.
medium=$(findmnt -rno SOURCE /run/live/medium 2>/dev/null | head -n 1)
cle=""
[ -n "$medium" ] && cle=$(lsblk -rno PKNAME "$medium" 2>/dev/null | head -n 1)

# Windows, ouvert en lecture seule par grenos-windows (son ExecStop referme).
if systemctl is-active --quiet grenos-windows.service 2>/dev/null; then
    systemctl stop grenos-windows.service 2>/dev/null \
        && dire "installateur : partition Windows refermee (lecture seule)"
fi

# Ce que la session a ouvert sur les disques de la machine. MOUNTPOINT en
# dernier : vide pour une partition fermée, il ne décale aucune colonne.
lsblk -rno PATH,PKNAME,TYPE,MOUNTPOINT 2>/dev/null | while read -r dev parent type point; do
    [ "$type" = part ] || continue
    [ -n "$point" ] || continue
    [ -n "$cle" ] && [ "$parent" = "$cle" ] && continue
    case "$point" in
        /run/live/*|/|/boot*|\[SWAP\]) continue ;;
    esac
    if udisksctl unmount -b "$dev" --no-user-interaction >/dev/null 2>&1; then
        dire "installateur : $dev referme avant l installation ($point)"
    else
        dire "installateur : $dev RESTE ouvert ($point) — l installateur ne proposera que le manuel sur ce disque"
    fi
done

# LA CLÉ ELLE-MÊME, cachée à l'installateur (21 novembre) : sinon Calamares la
# prend pour une partition EFI et y pose GRUB — en lecture seule, échec à la
# fin (voir /usr/lib/grenos/grenos-cle-masquee). Rendue dès qu'il se ferme.
if [ -n "$cle" ]; then
    systemctl start grenos-cle-masquee.service 2>/dev/null \
        || dire "installateur : la cle n a pas pu etre cachee — l installateur la verra"
fi

pkexec /usr/bin/calamares "$@"
code=$?
# Et jamais rendue tant qu'un Calamares tourne encore, d'où qu'il vienne
# (le lanceur de Debian, un terminal) : c'est lui qui lit les disques.
if [ -n "$cle" ]; then
    if pgrep -x calamares >/dev/null 2>&1; then
        dire "installateur : un autre installateur tourne encore, la cle reste cachee"
    else
        systemctl stop grenos-cle-masquee.service 2>/dev/null
    fi
fi
exit "$code"
