#!/usr/bin/env python3
"""La barre de grenOS : le menu, les fenêtres ouvertes, l'heure.

Écrite ici, en GTK 3, posée sur un gestionnaire de fenêtres minimal. Pourquoi
pas un bureau tout fait : Plasma et GNOME composent l'écran par le GPU, et dans
une machine virtuelle sans accélération la souris tombe à trois images par
seconde. Ici rien n'est composé — une barre, un menu, des fenêtres — et le
pointeur suit la main.

Le menu s'ouvre sur le bouton grenOS, se referme sur le même bouton, et se
referme aussi dès qu'on clique ailleurs : il attrape le pointeur pendant qu'il
est ouvert, ce qui est la seule façon fiable d'apprendre qu'on a cliqué dehors
quand aucun bureau complet ne s'en charge.
"""
import locale
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Wnck  # noqa: E402

import grenosui  # noqa: E402

HAUTEUR = 52
MENU_LARGEUR = 520
MENU_HAUTEUR = 580

# Ce qu'on ouvre tous les jours, à portée de clic, avec l'icône du système.
# Chaque icône a plusieurs noms possibles : les thèmes ne fournissent pas tous
# les mêmes, et une image manquante laissait un bouton muet.
LANCEURS = [
    ("Fichiers", "pcmanfm", ["system-file-manager", "folder", "inode-directory"]),
    ("Web", "firefox-esr", ["firefox-esr", "web-browser", "internet-web-browser"]),
    ("Terminal", "x-terminal-emulator", ["utilities-terminal", "terminal"]),
    ("GrenPlace", "grenplace", ["system-software-install", "software-store",
                                "package-x-generic"]),
]

# Les boutons de droite : le nom qui s'affiche si aucune icône n'est trouvée.
COTE_DROIT = [
    ("Réglages", "grenos-parametres", ["preferences-system", "preferences-desktop",
                                       "applications-system"]),
    ("Réseau", "nm-connection-editor", ["network-wireless", "network-workgroup",
                                        "network-transmit-receive"]),
    ("Son", "grenos-parametres son", ["audio-volume-high", "audio-speakers",
                                      "multimedia-volume-control"]),
]

STYLE = """
#panneau {
    background-color: @fond;
    border-top: 1px solid @bord;
}

#panneau button {
    color: @texte;
    background-color: transparent;
    background-image: none;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 4px 12px;
    margin: 5px 2px;
    box-shadow: none;
    text-shadow: none;
    transition: background-color 120ms ease, border-color 120ms ease;
}
#panneau button:hover {
    background-color: @survol;
    background-image: none;
    border-color: @bord;
}
#panneau button:active, #panneau button:checked {
    background-color: alpha(@accent, 0.25);
    background-image: none;
    border-color: @accent;
}

#bouton-menu {
    font-weight: 700;
    padding-left: 14px;
    padding-right: 14px;
}
#bouton-menu:checked { background-color: @accent; color: #ffffff; border-color: @accent; }

.tache-active {
    background-color: @fond-creux;
    box-shadow: inset 0 -2px 0 @accent;
}

#horloge { color: @texte-faible; padding: 0 12px; }

#menu {
    background-color: @fond;
    border: 1px solid @bord;
    border-radius: 16px;
}

#entete-menu {
    background-color: @fond-haut;
    border-bottom: 1px solid @bord;
    padding: 14px;
}

.entree {
    background-color: transparent;
    background-image: none;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 8px 12px;
    margin: 2px 10px;
}
.entree:hover { background-color: @survol; border-color: @bord; }
.entree-titre { font-weight: 600; }
"""


def applications():
    """Les applications du système, lues dans les fichiers .desktop."""
    trouvees = {}
    for dossier in ("/usr/share/applications", "/usr/local/share/applications",
                    os.path.expanduser("~/.local/share/applications"),
                    "/var/lib/flatpak/exports/share/applications",
                    os.path.expanduser("~/.local/share/flatpak/exports/share/applications")):
        if not os.path.isdir(dossier):
            continue
        for nom in sorted(os.listdir(dossier)):
            if nom.endswith(".desktop"):
                entree = lire_desktop(os.path.join(dossier, nom))
                if entree:
                    trouvees[nom] = entree
    return sorted(trouvees.values(), key=lambda e: e["nom"].lower())


def lire_desktop(chemin):
    """Le nom, la description, l'icône et la commande d'un fichier .desktop."""
    champs, section = {}, None
    try:
        with open(chemin, encoding="utf-8", errors="replace") as fichier:
            for ligne in fichier:
                ligne = ligne.strip()
                if ligne.startswith("["):
                    section = ligne
                elif section == "[Desktop Entry]" and "=" in ligne:
                    cle, valeur = ligne.split("=", 1)
                    champs[cle] = valeur
    except OSError:
        return None
    if champs.get("Type") != "Application":
        return None
    if champs.get("NoDisplay", "").lower() == "true" or champs.get("Hidden", "").lower() == "true":
        return None
    nom, commande = champs.get("Name[fr]") or champs.get("Name"), champs.get("Exec")
    if not nom or not commande:
        return None
    # %f, %u et consorts servent à passer un fichier : sans fichier à passer,
    # ils n'ont rien à faire dans la commande.
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        commande = commande.replace(code, "")
    return {
        "nom": nom,
        "note": champs.get("Comment[fr]") or champs.get("Comment") or "",
        "commande": commande.strip(),
        "icone": champs.get("Icon", ""),
        "terminal": champs.get("Terminal", "").lower() == "true",
    }


def image_de(noms, taille=28):
    """La première icône trouvée parmi plusieurs noms possibles, ou rien.

    Les thèmes d'icônes ne portent pas tous les mêmes noms, et un nom absent
    laissait un bouton vide au milieu de la barre. On essaie donc les noms
    l'un après l'autre.
    """
    if not noms:
        return None
    if isinstance(noms, str):
        noms = [noms]
    theme = Gtk.IconTheme.get_default()
    for nom in noms:
        if not nom:
            continue
        try:
            if os.path.isabs(nom) and os.path.exists(nom):
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(nom, taille, taille, True)
            else:
                pixbuf = theme.load_icon(nom, taille, Gtk.IconLookupFlags.FORCE_SIZE)
            return Gtk.Image.new_from_pixbuf(pixbuf)
        except GLib.Error:
            continue
    return None


class Menu(Gtk.Window):
    """Le menu des applications : qui on est, une recherche, puis la liste."""

    def __init__(self, panneau):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.panneau = panneau
        self.set_name("menu")
        self.set_size_request(MENU_LARGEUR, MENU_HAUTEUR)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_keep_above(True)
        self.attrape = None

        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(boite)

        # En tête : à qui est cette machine, et les gestes de fin de session.
        entete = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        entete.set_name("entete-menu")
        identite = grenosui.identite()
        entete.pack_start(grenosui.avatar(identite.get("nom") or identite.get("login", "g")),
                          False, False, 0)
        qui = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        nom = Gtk.Label(label=identite.get("nom") or identite.get("login", "grenOS"), xalign=0)
        nom.get_style_context().add_class("entree-titre")
        adresse = Gtk.Label(label=grenosui.adresse(), xalign=0)
        adresse.get_style_context().add_class("sous")
        qui.pack_start(nom, False, False, 0)
        qui.pack_start(adresse, False, False, 0)
        entete.pack_start(qui, True, True, 0)
        entete.pack_end(self.petit("Éteindre", "grenos-arret"), False, False, 0)
        entete.pack_end(self.petit("Réglages", "grenos-parametres"), False, False, 0)
        boite.pack_start(entete, False, False, 0)

        self.recherche = Gtk.SearchEntry()
        self.recherche.set_placeholder_text("Chercher une application")
        self.recherche.set_margin_top(12)
        self.recherche.set_margin_start(12)
        self.recherche.set_margin_end(12)
        self.recherche.connect("search-changed", lambda _: self.remplir())
        self.recherche.connect("activate", lambda _: self.premier())
        self.recherche.connect("key-press-event", self.touche)
        boite.pack_start(self.recherche, False, False, 0)

        defilement = Gtk.ScrolledWindow()
        defilement.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        boite.pack_start(defilement, True, True, 6)
        self.liste = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        defilement.add(self.liste)

        self.applications = applications()
        self.remplir()

        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self.clic)
        self.connect("key-press-event", self.touche)

    def petit(self, texte, commande):
        bouton = grenosui.bouton(texte, lambda: (self.fermer(), grenosui.lancer(commande)))
        bouton.get_style_context().add_class("discret")
        return bouton

    def touche(self, _widget, evenement):
        if Gdk.keyval_name(evenement.keyval) == "Escape":
            self.fermer()
            return True
        return False

    def clic(self, _widget, evenement):
        """Un clic hors du menu le referme : c'est ce qu'attend n'importe qui."""
        largeur, hauteur = self.get_size()
        if not (0 <= evenement.x < largeur and 0 <= evenement.y < hauteur):
            self.fermer()
            return True
        return False

    def visibles(self):
        filtre = self.recherche.get_text().strip().lower()
        if not filtre:
            return self.applications
        return [a for a in self.applications
                if filtre in a["nom"].lower() or filtre in a["note"].lower()]

    def remplir(self):
        for enfant in self.liste.get_children():
            self.liste.remove(enfant)
        for application in self.visibles()[:60]:
            bouton = Gtk.Button()
            bouton.get_style_context().add_class("entree")
            ligne = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            image = image_de(application["icone"])
            if image is not None:
                ligne.pack_start(image, False, False, 0)
            contenu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            titre = Gtk.Label(label=application["nom"], xalign=0)
            titre.get_style_context().add_class("entree-titre")
            contenu.pack_start(titre, False, False, 0)
            if application["note"]:
                note = Gtk.Label(label=application["note"], xalign=0)
                note.get_style_context().add_class("sous")
                note.set_ellipsize(3)
                contenu.pack_start(note, False, False, 0)
            ligne.pack_start(contenu, True, True, 0)
            bouton.add(ligne)
            bouton.connect("clicked", lambda _, a=application: self.choisir(a))
            self.liste.pack_start(bouton, False, False, 0)
        self.liste.show_all()

    def premier(self):
        choix = self.visibles()
        if choix:
            self.choisir(choix[0])

    def choisir(self, application):
        self.fermer()
        grenosui.lancer(application["commande"], application["terminal"])

    def ouvrir(self):
        hauteur = Gdk.Screen.get_default().get_height()
        self.move(12, hauteur - HAUTEUR - MENU_HAUTEUR - 10)
        self.applications = applications()
        self.remplir()
        self.show_all()
        self.present()
        self.recherche.set_text("")
        self.recherche.grab_focus()
        self.panneau.bouton_menu.set_active(True)

        # Attraper le pointeur : sans cela, un clic sur le fond d'écran ou sur
        # une autre fenêtre n'arriverait jamais jusqu'ici, et le menu resterait
        # ouvert derrière ce qu'on vient d'ouvrir.
        siege = Gdk.Display.get_default().get_default_seat()
        if siege is not None and self.get_window() is not None:
            siege.grab(self.get_window(), Gdk.SeatCapabilities.ALL_POINTING, True,
                       None, None, None, None)
            self.attrape = siege

    def fermer(self):
        if self.attrape is not None:
            self.attrape.ungrab()
            self.attrape = None
        self.hide()
        self.panneau.bouton_menu.set_active(False)


class Panneau(Gtk.Window):
    """La barre du bas."""

    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("panneau")
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)

        ecran = Gdk.Screen.get_default()
        self.largeur, self.hauteur = ecran.get_width(), ecran.get_height()
        self.set_default_size(self.largeur, HAUTEUR)
        self.move(0, self.hauteur - HAUTEUR)
        self.connect("realize", lambda *_: self.reserver())

        boite = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(boite)

        self.bouton_menu = Gtk.ToggleButton(label="grenOS")
        self.bouton_menu.set_name("bouton-menu")
        self.bouton_menu.connect("clicked", self.sur_le_bouton)
        boite.pack_start(self.bouton_menu, False, False, 0)

        for nom, commande, icones in LANCEURS:
            bouton = Gtk.Button()
            contenu = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            image = image_de(icones, 20)
            if image is not None:
                contenu.pack_start(image, False, False, 0)
            contenu.pack_start(Gtk.Label(label=nom), False, False, 0)
            bouton.add(contenu)
            bouton.set_tooltip_text(nom)
            bouton.connect("clicked", lambda _, c=commande: grenosui.lancer(c))
            boite.pack_start(bouton, False, False, 0)

        self.taches = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        boite.pack_start(self.taches, True, True, 8)

        boite.pack_end(self.action("Éteindre", "grenos-arret",
                                   ["system-shutdown", "system-log-out"]), False, False, 0)
        self.horloge = Gtk.Label()
        self.horloge.set_name("horloge")
        boite.pack_end(self.horloge, False, False, 0)
        for nom, commande, icones in COTE_DROIT:
            boite.pack_end(self.action(nom, commande, icones), False, False, 0)

        self.menu = Menu(self)
        self.ecran_wnck = Wnck.Screen.get_default()
        self.ecran_wnck.force_update()
        for signalement in ("window-opened", "window-closed", "active-window-changed",
                            "window-stacking-changed"):
            self.ecran_wnck.connect(signalement, lambda *_: self.fenetres())
        self.fenetres()

        GLib.timeout_add_seconds(1, self.tic)
        self.tic()

    def action(self, texte, commande, icones):
        """Un bouton de la droite : son icône si elle existe, son nom sinon.

        Jamais d'étiquette vague : un bouton qui disait « Ouvrir » parce que
        son icône manquait n'apprenait rien à personne.
        """
        bouton = Gtk.Button()
        contenu = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        image = image_de(icones, 20)
        if image is not None:
            contenu.pack_start(image, False, False, 0)
        else:
            contenu.pack_start(Gtk.Label(label=texte), False, False, 0)
        bouton.add(contenu)
        bouton.set_tooltip_text(texte)
        bouton.connect("clicked", lambda _: grenosui.lancer(commande))
        return bouton

    def sur_le_bouton(self, bouton):
        """Le bouton est un interrupteur : il ouvre, puis il referme."""
        if bouton.get_active():
            self.menu.ouvrir()
        else:
            self.menu.fermer()

    def reserver(self):
        """Réserve la bande du bas : une fenêtre agrandie s'arrête au-dessus.

        C'est la propriété `_NET_WM_STRUT` du protocole des bureaux X11. GTK ne
        l'écrit pas pour nous, et sans elle une fenêtre plein écran passerait
        sous la barre, qui deviendrait inutilisable.
        """
        fenetre = self.get_window()
        if fenetre is None:
            return
        identifiant = str(fenetre.get_xid())
        subprocess.run(["xprop", "-id", identifiant, "-f", "_NET_WM_STRUT", "32c",
                        "-set", "_NET_WM_STRUT", f"0, 0, 0, {HAUTEUR}"], check=False)
        subprocess.run(["xprop", "-id", identifiant, "-f", "_NET_WM_STRUT_PARTIAL", "32c",
                        "-set", "_NET_WM_STRUT_PARTIAL",
                        f"0, 0, 0, {HAUTEUR}, 0, 0, 0, 0, 0, 0, 0, {self.largeur - 1}"],
                       check=False)

    def tic(self):
        self.horloge.set_text(time.strftime("%H:%M  ·  %a %d %b"))
        return True

    def fenetres(self):
        for enfant in self.taches.get_children():
            self.taches.remove(enfant)
        active = self.ecran_wnck.get_active_window()
        for fenetre in self.ecran_wnck.get_windows():
            if fenetre.is_skip_tasklist():
                continue
            titre = fenetre.get_name() or "Fenêtre"
            bouton = Gtk.Button()
            ligne = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            icone = fenetre.get_mini_icon()
            if icone is not None:
                ligne.pack_start(Gtk.Image.new_from_pixbuf(icone), False, False, 0)
            ligne.pack_start(Gtk.Label(label=titre[:26]), False, False, 0)
            bouton.add(ligne)
            bouton.set_tooltip_text(titre)
            if active is not None and fenetre.get_xid() == active.get_xid():
                bouton.get_style_context().add_class("tache-active")
            bouton.connect("clicked", lambda _, f=fenetre: self.basculer(f))
            self.taches.pack_start(bouton, False, False, 0)
        self.taches.show_all()

    def basculer(self, fenetre):
        maintenant = Gtk.get_current_event_time()
        if fenetre.is_active():
            fenetre.minimize()
        else:
            fenetre.unminimize(maintenant)
            fenetre.activate(maintenant)


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)

    # Sans cette ligne, l'horloge affiche « Wed 23 Sep » : Python garde la
    # locale « C » tant qu'on ne lui dit pas d'écouter l'environnement, même
    # quand tout le reste du système est en français.
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    style = grenosui.habiller()
    propre = Gtk.CssProvider()

    def repeindre(*_):
        """Relit la palette : c'est ce que déclenche le passage jour/nuit."""
        couleurs = grenosui.palette()
        entete = "".join(f"@define-color {n} {v};\n" for n, v in couleurs.items())
        style.load_from_data(grenosui.feuille(couleurs))
        propre.load_from_data((entete + STYLE).encode("utf-8"))
        return True

    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), propre, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    repeindre()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, repeindre)

    panneau = Panneau()
    panneau.show_all()

    # Le clic droit sur le fond d'écran : `grenos-menu` envoie ce signal.
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2,
                         lambda: (panneau.menu.ouvrir(), True)[1])
    Gtk.main()


if __name__ == "__main__":
    main()
