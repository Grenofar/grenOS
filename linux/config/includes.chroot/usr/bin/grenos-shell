# ---- Les applications du système -------------------------------------------
def lire_desktop(chemin):
    """Ce qu'un fichier .desktop dit d'une application."""
    champs, section = {}, None
    try:
        with open(chemin, encoding="utf-8", errors="replace") as fichier:
            for ligne in fichier:
                ligne = ligne.strip()
                if ligne.startswith("["):
                    section = ligne
                elif section == "[Desktop Entry]" and "=" in ligne:
                    cle, valeur = ligne.split("=", 1)
                    champs[cle] = valeur
    except OSError:
        return None
    if champs.get("Type") != "Application":
        return None
    if champs.get("NoDisplay", "").lower() == "true" or champs.get("Hidden", "").lower() == "true":
        return None
    nom, commande = champs.get("Name[fr]") or champs.get("Name"), champs.get("Exec")
    if not nom or not commande:
        return None
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        commande = commande.replace(code, "")
    commande = commande.strip()
    # On reconnaît une entrée à cacher par son nom de fichier ou par le
    # programme qu'elle lance — le second survit aux changements du premier.
    programme = os.path.basename(commande.split()[0]) if commande else ""
    cache = (os.path.splitext(os.path.basename(chemin))[0] in HORS_LISTE
             or programme in HORS_LISTE)

    return {
        "nom": nom,
        "note": champs.get("Comment[fr]") or champs.get("Comment") or "",
        "commande": commande,
        "icone": champs.get("Icon", ""),
        "classe": (champs.get("StartupWMClass", "")
                   or os.path.basename(commande.split()[0] if commande else "")),
        "fichier": chemin,
        "cache": cache,
        "terminal": champs.get("Terminal", "").lower() == "true",
    }


def applications():
    """Toutes les applications du système, celles qu'on montre en premier."""
    trouvees = {}
    for dossier in ("/usr/share/applications", "/usr/local/share/applications",
                    os.path.expanduser("~/.local/share/applications"),
                    "/var/lib/flatpak/exports/share/applications",
                    os.path.expanduser("~/.local/share/flatpak/exports/share/applications")):
        if not os.path.isdir(dossier):
            continue
        for nom in sorted(os.listdir(dossier)):
            if nom.endswith(".desktop"):
                entree = lire_desktop(os.path.join(dossier, nom))
                if entree:
                    trouvees[nom] = entree
    return sorted(trouvees.values(), key=lambda e: e["nom"].lower())


def image_de(noms, taille=26):
    """La première icône trouvée parmi plusieurs noms possibles.

    Le dernier mot revient toujours à notre marque. Une ligne de menu sans
    icône est un trou que l'œil voit tout de suite — « Gestionnaire de
    tâches » en avait un, parce que le thème ne connaissait pas le nom
    demandé. Mieux vaut une icône générique qu'un vide.
    """
    if isinstance(noms, str):
        noms = [noms]
    noms = list(noms or []) + ["application-x-executable", "grenos"]
    theme = Gtk.IconTheme.get_default()
    for nom in noms:
        if not nom:
            continue
        try:
            if os.path.isabs(nom) and os.path.exists(nom):
                return Gtk.Image.new_from_pixbuf(
                    GdkPixbuf.Pixbuf.new_from_file_at_scale(nom, taille, taille, True))
            return Gtk.Image.new_from_pixbuf(
                theme.load_icon(nom, taille, Gtk.IconLookupFlags.FORCE_SIZE))
        except GLib.Error:
            continue
    return None


def lire_epingles():
    try:
        with open(BARRE, encoding="utf-8") as fichier:
            epingles = json.load(fichier)
        if isinstance(epingles, list):
            return epingles
    except (OSError, ValueError):
        pass
    return list(EPINGLES_PAR_DEFAUT)


def ecrire_epingles(epingles):
    os.makedirs(grenosui.REGLAGES, exist_ok=True)
    with open(BARRE, "w", encoding="utf-8") as fichier:
        json.dump(epingles, fichier, ensure_ascii=False, indent=1)


def vrai_programme(nom):
    """Derrière « x-terminal-emulator », le programme qui s'ouvre vraiment.

    La tuile Terminal est épinglée sous `x-terminal-emulator`, et la fenêtre
    qui s'ouvre s'annonce `xfce4-terminal` : elles ne se reconnaissaient donc
    jamais, et le terminal ouvert restait à côté de son icône au lieu de la
    rejoindre. Le système sait déjà qui est derrière le lien ; on le lui
    demande plutôt que d'écrire une table qui vieillirait.
    """
    if not nom.startswith("x-"):
        return nom
    try:
        return os.path.basename(os.path.realpath(f"/usr/bin/{nom}")) or nom
    except OSError:
        return nom


def meme_application(fenetre, commande, applications_connues):
    """Cette fenêtre appartient-elle à cette application ?

    On compare la classe de la fenêtre au nom du programme lancé. C'est
    imparfait — Firefox se présente parfois sous « Navigator » — mais c'est ce
    dont on dispose, et les fichiers .desktop donnent la correspondance quand
    ils la déclarent (StartupWMClass).
    """
    programme = os.path.basename((commande or "").split()[0]) if commande else ""
    if not programme:
        return False
    groupe = (fenetre.get_class_group_name() or "").lower()
    instance = (fenetre.get_name() or "").lower()
    candidats = {programme.lower(), vrai_programme(programme).lower()}
    for application in applications_connues:
        if application["commande"] == commande and application["classe"]:
            candidats.add(application["classe"].lower())
    for candidat in candidats:
        if not candidat:
            continue
        if candidat in groupe or groupe in candidat:
            return True
        if candidat in instance:
            return True
    return False


class Menu(Gtk.Window):
    """Le menu grenOS : les épinglées en grand, puis tout le reste."""

    def __init__(self, panneau):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.panneau = panneau
        self.set_name("menu")
        self.set_size_request(MENU_LARGEUR, MENU_HAUTEUR)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_keep_above(True)
        self.attrape = None

        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(boite)

        self.recherche = Gtk.SearchEntry()
        self.recherche.set_name("recherche-menu")
        self.recherche.set_placeholder_text("Chercher une application")
        self.recherche.connect("search-changed", lambda _: self.remplir())
        self.recherche.connect("activate", lambda _: self.premier())
        self.recherche.connect("key-press-event", self.touche)
        boite.pack_start(self.recherche, False, False, 0)

        defilement = Gtk.ScrolledWindow()
        defilement.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        boite.pack_start(defilement, True, True, 0)
        self.contenu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        defilement.add(self.contenu)

        pied = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        pied.set_name("pied-menu")
        identite = grenosui.identite()
        pied.pack_start(grenosui.avatar(identite.get("nom") or identite.get("login", "g"), 16),
                        False, False, 0)
        qui = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        nom = Gtk.Label(label=identite.get("nom") or identite.get("login", "grenOS"), xalign=0)
        nom.get_style_context().add_class("entree-titre")
        adresse = Gtk.Label(label=grenosui.adresse(), xalign=0)
        adresse.get_style_context().add_class("sous")
        qui.pack_start(nom, False, False, 0)
        qui.pack_start(adresse, False, False, 0)
        pied.pack_start(qui, True, True, 0)
        pied.pack_end(self.petit("Éteindre", "grenos-arret",
                                 ["system-shutdown", "system-log-out"]), False, False, 0)
        pied.pack_end(self.petit("Réglages", "grenos-parametres",
                                 ["preferences-system", "applications-system"]),
                      False, False, 0)
        boite.pack_start(pied, False, False, 0)

        self.applications = applications()
        self.remplir()

        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self.clic)
        self.connect("key-press-event", self.touche)

    def petit(self, texte, commande, icones):
        bouton = Gtk.Button()
        contenu = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        image = image_de(icones, 18)
        if image is not None:
            contenu.pack_start(image, False, False, 0)
        contenu.pack_start(Gtk.Label(label=texte), False, False, 0)
        bouton.add(contenu)
        bouton.get_style_context().add_class("discret")
        bouton.connect("clicked", lambda _: (self.fermer(), grenosui.lancer(commande)))
        return bouton

    def touche(self, _widget, evenement):
        if Gdk.keyval_name(evenement.keyval) == "Escape":
            self.fermer()
            return True
        return False

    def clic(self, _widget, evenement):
        largeur, hauteur = self.get_size()
        if not (0 <= evenement.x < largeur and 0 <= evenement.y < hauteur):
            self.fermer()
            return True
        return False

    def section(self, texte):
        etiquette = Gtk.Label(label=texte, xalign=0)
        etiquette.get_style_context().add_class("titre-section")
        return etiquette

    def visibles(self):
        filtre = self.recherche.get_text().strip().lower()
        if not filtre:
            # Sans recherche, on ne montre pas les réglages déguisés en
            # applications : ils encombrent la liste et ont leur place ailleurs.
            return [a for a in self.applications if not a["cache"]]
        return [a for a in self.applications
                if filtre in a["nom"].lower() or filtre in a["note"].lower()]

    def remplir(self):
        for enfant in self.contenu.get_children():
            self.contenu.remove(enfant)
        cherche = bool(self.recherche.get_text().strip())

        if not cherche:
            self.contenu.pack_start(self.section("ÉPINGLÉES"), False, False, 0)
            grille = Gtk.FlowBox()
            grille.set_selection_mode(Gtk.SelectionMode.NONE)
            grille.set_max_children_per_line(6)
            grille.set_min_children_per_line(4)
            grille.set_homogeneous(True)
            grille.set_margin_start(10)
            grille.set_margin_end(10)
            for epingle in self.panneau.epingles:
                grille.add(self.carreau(epingle))
            self.contenu.pack_start(grille, False, False, 0)

        self.contenu.pack_start(
            self.section("TOUTES LES APPLICATIONS" if not cherche else "RÉSULTATS"),
            False, False, 0)
        for application in self.visibles()[:80]:
            self.contenu.pack_start(self.ligne(application), False, False, 0)
        self.contenu.show_all()

    def carreau(self, epingle):
        bouton = Gtk.Button()
        bouton.get_style_context().add_class("epingle")
        colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        image = image_de(epingle.get("icone"), 36)
        if image is not None:
            colonne.pack_start(image, False, False, 0)
        etiquette = Gtk.Label(label=epingle["nom"])
        etiquette.set_max_width_chars(11)
        etiquette.set_ellipsize(3)
        colonne.pack_start(etiquette, False, False, 0)
        bouton.add(colonne)
        bouton.connect("clicked", lambda _: (self.fermer(),
                                             grenosui.lancer(epingle["commande"])))
        return bouton

    def ligne(self, application):
        bouton = Gtk.Button()
        bouton.get_style_context().add_class("entree")
        ligne = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        image = image_de(application["icone"], 24)
        if image is not None:
            ligne.pack_start(image, False, False, 0)
        ligne.pack_start(Gtk.Label(label=application["nom"], xalign=0), True, True, 0)
        bouton.add(ligne)
        bouton.connect("clicked", lambda _: self.choisir(application))
        bouton.connect("button-press-event", self.menu_application, application)

        # Glisser une application vers le bureau l'y pose : c'est le geste
        # qu'on essaie d'instinct, et il ne marchait pas.
        bouton.drag_source_set(Gdk.ModifierType.BUTTON1_MASK, [],
                               Gdk.DragAction.COPY)
        bouton.drag_source_add_uri_targets()
        bouton.connect("drag-data-get", self.donner_uri, application)
        bouton.connect("drag-begin", lambda w, c: self.fermer())
        return bouton

    def donner_uri(self, _widget, _contexte, donnees, _info, _temps, application):
        """Ce qu'on dépose : le fichier .desktop de l'application."""
        chemin = application.get("fichier", "")
        if chemin:
            donnees.set_uris([GLib.filename_to_uri(chemin, None)])

    def menu_application(self, _widget, evenement, application):
        if evenement.button != 3:
            return False
        menu = Gtk.Menu()
        for texte, action in (
                ("Épingler à la barre des tâches", lambda: self.epingler(application)),
                ("Ajouter au bureau", lambda: poser_sur_le_bureau(application))):
            element = Gtk.MenuItem(label=texte)
            element.connect("activate", lambda _, a=action: a())
            menu.append(element)
        menu.show_all()
        menu.popup_at_pointer(evenement)
        return True

    def epingler(self, application):
        self.panneau.epingler(application["nom"], application["commande"],
                              application["icone"])
        self.remplir()

    def premier(self):
        choix = self.visibles()
        if choix:
            self.choisir(choix[0])

    def choisir(self, application):
        self.fermer()
        grenosui.lancer(application["commande"], application["terminal"])

    def ouvrir(self):
        ecran = Gdk.Screen.get_default()
        x = max(12, (ecran.get_width() - MENU_LARGEUR) // 2)
        self.move(x, ecran.get_height() - HAUTEUR - MENU_HAUTEUR - 8)
        self.applications = applications()
        self.remplir()
        self.show_all()
        self.present()
        self.recherche.set_text("")
        self.recherche.grab_focus()
        self.panneau.enfoncer(True)

        siege = Gdk.Display.get_default().get_default_seat()
        if siege is not None and self.get_window() is not None:
            siege.grab(self.get_window(), Gdk.SeatCapabilities.ALL_POINTING, True,
                       None, None, None, None)
            self.attrape = siege
        grenosui.dire(f"menu ouvert, {len(self.applications)} applications")

    def fermer(self):
        if self.attrape is not None:
            self.attrape.ungrab()
            self.attrape = None
        self.hide()
        self.panneau.enfoncer(False)
        grenosui.dire("menu ferme")


def poser_sur_le_bureau(application):
    """Un raccourci sur le bureau : une copie du fichier .desktop."""
    bureau = os.path.expanduser("~/Bureau")
    if not os.path.isdir(bureau):
        bureau = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP) or bureau
    os.makedirs(bureau, exist_ok=True)
    source = application.get("fichier", "")
    if not source or not os.path.exists(source):
        return
    cible = os.path.join(bureau, os.path.basename(source))
    try:
        with open(source, encoding="utf-8") as entree:
            contenu = entree.read()
        with open(cible, "w", encoding="utf-8") as sortie:
            sortie.write(contenu)
        os.chmod(cible, 0o755)
    except OSError:
        pass


class Tuile(Gtk.Box):
    """Une case de la barre : l'icône d'une application, et son trait."""

    def __init__(self, panneau, nom, commande, icone, epinglee):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.panneau = panneau
        self.nom = nom
        self.commande = commande
        self.icone = icone
        self.epinglee = epinglee
        self.fenetres = []

        self.bouton = Gtk.Button()
        image = image_de([icone, "application-x-executable"], 26)
        if image is not None:
            self.bouton.add(image)
        else:
            self.bouton.add(Gtk.Label(label=nom[:8]))
        self.bouton.set_tooltip_text(nom)
        self.bouton.connect("clicked", lambda _: self.activer())
        self.bouton.connect("button-press-event", self.menu)
        self.pack_start(self.bouton, True, True, 0)

        self.trait = Gtk.Box()
        self.trait.get_style_context().add_class("trait")
        self.pack_start(self.trait, False, False, 0)

    def marquer(self, fenetres, active):
        """Le trait dit l'état : ouverte, au premier plan, réduite, fermée."""
        self.fenetres = fenetres
        style = self.trait.get_style_context()
        for classe in ("trait-ouverte", "trait-active", "trait-reduite"):
            style.remove_class(classe)
        if not fenetres:
            return
        if active is not None and any(f.get_xid() == active.get_xid() for f in fenetres):
            style.add_class("trait-active")
        elif all(f.is_minimized() for f in fenetres):
            style.add_class("trait-reduite")
        else:
            style.add_class("trait-ouverte")
        self.bouton.set_tooltip_text(
            f"{self.nom} — {len(fenetres)} fenêtre{'s' if len(fenetres) > 1 else ''}")

    def activer(self):
        maintenant = Gtk.get_current_event_time()
        if not self.fenetres:
            grenosui.lancer(self.commande)
            return
        active = self.panneau.ecran_wnck.get_active_window()
        if active is not None and any(f.get_xid() == active.get_xid() for f in self.fenetres):
            for fenetre in self.fenetres:
                fenetre.minimize()
            return
        cible = self.fenetres[0]
        cible.unminimize(maintenant)
        cible.activate(maintenant)

    def menu(self, _widget, evenement):
        if evenement.button != 3:
            return False
        maintenant = Gtk.get_current_event_time()
        gestes = []
        if self.fenetres:
            gestes.append(("Afficher", lambda: (self.fenetres[0].unminimize(maintenant),
                                                self.fenetres[0].activate(maintenant))))
            gestes.append(("Réduire", lambda: [f.minimize() for f in self.fenetres]))
        else:
            gestes.append(("Ouvrir", lambda: grenosui.lancer(self.commande)))
        if self.epinglee:
            gestes.append(("Retirer de la barre", lambda: self.panneau.retirer(self.commande)))
        else:
            gestes.append(("Épingler à la barre",
                           lambda: self.panneau.epingler(self.nom, self.commande, self.icone)))
        if self.fenetres:
            gestes.append(("Fermer", lambda: [f.close(maintenant) for f in self.fenetres]))

        menu = Gtk.Menu()
        for texte, action in gestes:
            element = Gtk.MenuItem(label=texte)
            element.connect("activate", lambda _, a=action: a())
            menu.append(element)
        menu.show_all()
        menu.popup_at_pointer(evenement)
        return True


class Panneau(Gtk.Window):
    """La barre du bas : le bouton grenOS, les icônes au centre, l'heure."""

    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("panneau")
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)

        ecran = Gdk.Screen.get_default()
        self.largeur, self.hauteur = ecran.get_width(), ecran.get_height()
        self.set_default_size(self.largeur, HAUTEUR)
        self.move(0, self.hauteur - HAUTEUR)
        self.connect("realize", lambda *_: self.reserver())

        self.epingles = lire_epingles()
        self.applications = applications()

        boite = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(boite)

        # Le son, en bas a gauche : le volume, la sortie et le melangeur
        # s'ouvrent au-dessus de cette icone. Elle est dessinee par nous, pas
        # empruntee a un emoji — un emoji depend de la police installee et ne
        # se teinte pas.
        self.bouton_son = Gtk.Button()
        self.image_son = Gtk.Image()
        self.bouton_son.add(self.image_son)
        self.bouton_son.set_tooltip_text("Son : volume, sortie, applications")
        self.bouton_son.connect("clicked", lambda _: grenosui.lancer("grenos-son"))
        boite.pack_start(self.bouton_son, False, False, 0)

        boite.pack_start(Gtk.Box(), True, True, 0)

        self.centre = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        boite.pack_start(self.centre, False, False, 0)

        # Le bouton porte la marque, puisqu'elle existe enfin : c'est « le logo
        # grenOS » qu'on cherche en bas de l'écran. On ne la met que si le thème
        # la connaît vraiment — un repli générique à côté du mot « grenOS »
        # serait pire que le mot seul.
        self.bouton_menu = Gtk.ToggleButton()
        etiquette = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        if Gtk.IconTheme.get_default().has_icon("grenos"):
            etiquette.pack_start(
                Gtk.Image.new_from_icon_name("grenos", Gtk.IconSize.LARGE_TOOLBAR),
                False, False, 0)
        etiquette.pack_start(Gtk.Label(label="grenOS"), False, False, 0)
        self.bouton_menu.add(etiquette)
        self.bouton_menu.set_name("bouton-menu")
        self.bouton_menu.set_tooltip_text("Menu grenOS")
        self.poignee = self.bouton_menu.connect("clicked", self.sur_le_bouton)
        self.centre.pack_start(self.bouton_menu, False, False, 0)

        self.tuiles = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.centre.pack_start(self.tuiles, False, False, 6)

        boite.pack_start(Gtk.Box(), True, True, 0)

        self.horloge = Gtk.Label()
        self.horloge.set_name("horloge")
        boite.pack_end(self.horloge, False, False, 0)

        # Les connexions, a portee de clic : c'est le geste qu'on cherche en
        # premier sur une machine neuve. Le reste des reglages est dans le menu.
        self.bouton_reseau = Gtk.Button()
        image = image_de(["network-wireless", "network-workgroup",
                          "network-transmit-receive"], 20)
        if image is not None:
            self.bouton_reseau.add(image)
        else:
            self.bouton_reseau.add(Gtk.Label(label="Réseau"))
        self.bouton_reseau.set_tooltip_text("Connexions : Wi-Fi et Bluetooth")
        self.bouton_reseau.connect("clicked",
                                   lambda _: grenosui.lancer("grenos-connexions"))
        boite.pack_end(self.bouton_reseau, False, False, 0)

        # Une mise a jour qui attend se voit, sans rien interrompre. Le bouton
        # n'apparait que lorsqu'il y a quelque chose a dire : une pastille
        # permanente qui ne veut rien dire, on cesse de la lire.
        self.bouton_maj = Gtk.Button(label="")
        self.bouton_maj.set_no_show_all(True)
        self.bouton_maj.connect("clicked", lambda _: grenosui.lancer("grenos-maj"))
        boite.pack_end(self.bouton_maj, False, False, 0)

        self.menu = Menu(self)
        self.ecran_wnck = Wnck.Screen.get_default()
        self.ecran_wnck.force_update()
        for signalement in ("window-opened", "window-closed", "active-window-changed",
                            "window-stacking-changed"):
            self.ecran_wnck.connect(signalement, lambda *_: self.refaire())
        self.refaire()

        GLib.timeout_add_seconds(1, self.tic)
        self.tic()
        GLib.timeout_add_seconds(3, self.relire_son)
        self.relire_son()
        GLib.timeout_add_seconds(60, self.relire_maj)
        self.relire_maj()

    # ---- Les tuiles --------------------------------------------------------
    def refaire(self):
        """Une icône par application : l'épinglée porte son propre indicateur."""
        for enfant in self.tuiles.get_children():
            self.tuiles.remove(enfant)

        ouvertes = [f for f in self.ecran_wnck.get_windows() if not f.is_skip_tasklist()]
        active = self.ecran_wnck.get_active_window()
        prises = set()
        rejointes = []

        for epingle in self.epingles:
            miennes = [f for f in ouvertes
                       if meme_application(f, epingle["commande"], self.applications)]
            prises.update(f.get_xid() for f in miennes)
            if miennes:
                rejointes.append(epingle["nom"])
            tuile = Tuile(self, epingle["nom"], epingle["commande"],
                          epingle.get("icone", ""), True)
            tuile.marquer(miennes, active)
            self.tuiles.pack_start(tuile, False, False, 0)

        # Ce qui tourne sans être épinglé : son icône, retrouvée par sa classe
        # de fenêtre — sinon GTK affiche un cahier blanc pour tout le monde.
        restantes = {}
        for fenetre in ouvertes:
            if fenetre.get_xid() in prises:
                continue
            groupe = (fenetre.get_class_group_name() or fenetre.get_name() or "?")
            restantes.setdefault(groupe, []).append(fenetre)

        # Qui a rejoint son icône, et qui a sa propre tuile. On ne le dit que
        # lorsque cela change, sinon la barre parlerait toutes les secondes.
        #
        # Sans cette ligne, il fallait compter les tuiles sur une capture pour
        # s'apercevoir que nos trois fenêtres n'en formaient qu'une — toutes
        # annoncées sous la classe « python3 ». C'est ainsi qu'on l'a trouvé,
        # et c'est trop fragile pour le laisser à l'œil.
        etat = (tuple(rejointes), tuple(sorted(restantes)))
        if etat != getattr(self, "dernier_etat_tuiles", None):
            self.dernier_etat_tuiles = etat
            grenosui.dire("tuiles : rejointes [%s], a part [%s]"
                          % (", ".join(rejointes) or "aucune",
                             ", ".join(sorted(restantes)) or "aucune"))

        for groupe, fenetres in restantes.items():
            application = self.application_de(groupe)
            nom = application["nom"] if application else groupe
            commande = application["commande"] if application else ""
            icone = application["icone"] if application else ""
            tuile = Tuile(self, nom, commande, icone, False)
            if icone == "" :
                icone_wnck = fenetres[0].get_icon()
                if icone_wnck is not None:
                    for enfant in tuile.bouton.get_children():
                        tuile.bouton.remove(enfant)
                    tuile.bouton.add(Gtk.Image.new_from_pixbuf(
                        icone_wnck.scale_simple(26, 26, GdkPixbuf.InterpType.BILINEAR)))
            tuile.marquer(fenetres, active)
            self.tuiles.pack_start(tuile, False, False, 0)

        self.tuiles.show_all()

    def application_de(self, groupe):
        """L'application du système qui correspond à cette classe de fenêtre."""
        groupe = (groupe or "").lower()
        for application in self.applications:
            classe = (application.get("classe") or "").lower()
            if classe and (classe in groupe or groupe in classe):
                return application
        return None

    def epingler(self, nom, commande, icone):
        if not commande:
            return
        if any(e["commande"] == commande for e in self.epingles):
            return
        self.epingles.append({"nom": nom, "commande": commande, "icone": icone})
        ecrire_epingles(self.epingles)
        self.refaire()

    def retirer(self, commande):
        self.epingles = [e for e in self.epingles if e["commande"] != commande]
        ecrire_epingles(self.epingles)
        self.refaire()

    # ---- Le reste ----------------------------------------------------------
    def sur_le_bouton(self, bouton):
        if bouton.get_active():
            self.menu.ouvrir()
        else:
            self.menu.fermer()

    def enfoncer(self, etat):
        """Enfonce le bouton sans déclencher son action (GTK émet « clicked »)."""
        self.bouton_menu.handler_block(self.poignee)
        self.bouton_menu.set_active(etat)
        self.bouton_menu.handler_unblock(self.poignee)

    def reserver(self):
        """Réserve la bande du bas : une fenêtre agrandie s'arrête au-dessus."""
        fenetre = self.get_window()
        if fenetre is None:
            return
        identifiant = str(fenetre.get_xid())
        subprocess.run(["xprop", "-id", identifiant, "-f", "_NET_WM_STRUT", "32c",
                        "-set", "_NET_WM_STRUT", f"0, 0, 0, {HAUTEUR}"], check=False)
        subprocess.run(["xprop", "-id", identifiant, "-f", "_NET_WM_STRUT_PARTIAL", "32c",
                        "-set", "_NET_WM_STRUT_PARTIAL",
                        f"0, 0, 0, {HAUTEUR}, 0, 0, 0, 0, 0, 0, 0, {self.largeur - 1}"],
                       check=False)

    def relire_maj(self):
        """Ce que la verification quotidienne a trouve, s'il y a lieu."""
        try:
            nombre = maj.disponibles()
        except Exception:
            return True
        if nombre:
            self.bouton_maj.set_label(
                f"{nombre} mise{'s' if nombre > 1 else ''} a jour")
            self.bouton_maj.set_tooltip_text(
                "Cliquer pour installer les mises a jour de grenOS et de Debian")
            self.bouton_maj.show()
        else:
            self.bouton_maj.hide()
        return True

    def relire_son(self):
        """L'icone dit l'etat du son sans qu'on ait a ouvrir quoi que ce soit."""
        try:
            volume = son.volume()
            muet = son.muet()
        except Exception:
            return True
        nom = ("grenos-son-muet" if muet
               else ("grenos-son-faible" if volume < 45 else "grenos-son"))
        self.image_son.set_from_icon_name(nom, Gtk.IconSize.LARGE_TOOLBAR)
        self.bouton_son.set_tooltip_text(
            "Son coupé" if muet else f"Son : {volume} %")
        return True

    def tic(self):
        maintenant = time.localtime()
        self.horloge.set_text(
            f"{maintenant.tm_hour:02d}:{maintenant.tm_min:02d}  ·  "
            f"{JOURS[maintenant.tm_wday]} {maintenant.tm_mday} {MOIS[maintenant.tm_mon - 1]}")
        return True


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    style = grenosui.habiller()
    propre = Gtk.CssProvider()

    def repeindre(*_):
        couleurs = grenosui.palette()
        entete = "".join(f"@define-color {n} {v};\n" for n, v in couleurs.items())
        grenosui.charger(style, grenosui.feuille(couleurs))
        grenosui.charger(propre, entete + STYLE)
        return True

    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), propre, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    repeindre()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, repeindre)

    panneau = Panneau()
    panneau.show_all()
    grenosui.dire(f"barre prete, {len(panneau.epingles)} epinglees")

    def dire_le_bouton():
        # Deux boutons, deux positions. Le menu, pour que la machine
        # d'integration puisse cliquer dessus au lieu de viser au juge — la
        # barre est centree, donc sa position depend du nombre d'icones. Et le
        # son, parce que c'est le seul reproche de Grenofar qu'on n'ait pas
        # encore pu prouver autrement qu'en comptant les sorties.
        for nom, bouton in (("grenos", panneau.bouton_menu),
                            ("son", panneau.bouton_son)):
            zone = bouton.get_allocation()
            x = zone.x + zone.width // 2
            y = panneau.hauteur - HAUTEUR + zone.y + zone.height // 2
            grenosui.dire(f"bouton {nom} en {x},{y}")
        return False

    GLib.timeout_add_seconds(3, dire_le_bouton)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2,
                         lambda: (panneau.menu.ouvrir(), True)[1])
    Gtk.main()


if __name__ == "__main__":
    main()
