    background-color: transparent;
    background-image: none;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 7px 12px;
    margin: 1px 10px;
}
.entree:hover { background-color: @survol; border-color: @bord; }
"""


# ---- Les applications du système -------------------------------------------
def applications():
    """Les applications du système, lues dans les fichiers .desktop."""
    trouvees = {}
    for dossier in ("/usr/share/applications", "/usr/local/share/applications",
                    os.path.expanduser("~/.local/share/applications"),
                    "/var/lib/flatpak/exports/share/applications",
                    os.path.expanduser("~/.local/share/flatpak/exports/share/applications")):
        if not os.path.isdir(dossier):
            continue
        for nom in sorted(os.listdir(dossier)):
            if nom.endswith(".desktop"):
                entree = lire_desktop(os.path.join(dossier, nom))
                if entree:
                    trouvees[nom] = entree
    return sorted(trouvees.values(), key=lambda e: e["nom"].lower())


def lire_desktop(chemin):
    """Le nom, la description, l'icône et la commande d'un fichier .desktop."""
    champs, section = {}, None
    try:
        with open(chemin, encoding="utf-8", errors="replace") as fichier:
            for ligne in fichier:
                ligne = ligne.strip()
                if ligne.startswith("["):
                    section = ligne
                elif section == "[Desktop Entry]" and "=" in ligne:
                    cle, valeur = ligne.split("=", 1)
                    champs[cle] = valeur
    except OSError:
        return None
    if champs.get("Type") != "Application":
        return None
    if champs.get("NoDisplay", "").lower() == "true" or champs.get("Hidden", "").lower() == "true":
        return None
    nom, commande = champs.get("Name[fr]") or champs.get("Name"), champs.get("Exec")
    if not nom or not commande:
        return None
    # %f, %u et consorts servent à passer un fichier : sans fichier à passer,
    # ils n'ont rien à faire dans la commande.
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        commande = commande.replace(code, "")
    return {
        "nom": nom,
        "note": champs.get("Comment[fr]") or champs.get("Comment") or "",
        "commande": commande.strip(),
        "icone": champs.get("Icon", ""),
        "fichier": chemin,
        "terminal": champs.get("Terminal", "").lower() == "true",
    }


def image_de(noms, taille=26):
    """La première icône trouvée parmi plusieurs noms possibles, ou rien.

    Les thèmes ne portent pas tous les mêmes noms, et un nom absent laissait un
    bouton vide au milieu de la barre.
    """
    if not noms:
        return None
    if isinstance(noms, str):
        noms = [noms]
    theme = Gtk.IconTheme.get_default()
    for nom in noms:
        if not nom:
            continue
        try:
            if os.path.isabs(nom) and os.path.exists(nom):
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(nom, taille, taille, True)
            else:
                pixbuf = theme.load_icon(nom, taille, Gtk.IconLookupFlags.FORCE_SIZE)
            return Gtk.Image.new_from_pixbuf(pixbuf)
        except GLib.Error:
            continue
    try:
        return Gtk.Image.new_from_pixbuf(
            theme.load_icon("application-x-executable", taille, Gtk.IconLookupFlags.FORCE_SIZE))
    except GLib.Error:
        return None


# ---- Ce que la personne a épinglé ------------------------------------------
def lire_epingles():
    try:
        with open(BARRE, encoding="utf-8") as fichier:
            epingles = json.load(fichier)
        if isinstance(epingles, list):
            return epingles
    except (OSError, ValueError):
        pass
    return list(EPINGLES_PAR_DEFAUT)


def ecrire_epingles(epingles):
    os.makedirs(grenosui.REGLAGES, exist_ok=True)
    with open(BARRE, "w", encoding="utf-8") as fichier:
        json.dump(epingles, fichier, ensure_ascii=False, indent=1)


class Menu(Gtk.Window):
    """Le menu grenOS : les épinglées en grand, puis tout le reste."""

    def __init__(self, panneau):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.panneau = panneau
        self.set_name("menu")
        self.set_size_request(MENU_LARGEUR, MENU_HAUTEUR)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_keep_above(True)
        self.attrape = None

        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(boite)

        self.recherche = Gtk.SearchEntry()
        self.recherche.set_name("recherche-menu")
        self.recherche.set_placeholder_text("Chercher une application")
        self.recherche.connect("search-changed", lambda _: self.remplir())
        self.recherche.connect("activate", lambda _: self.premier())
        self.recherche.connect("key-press-event", self.touche)
        boite.pack_start(self.recherche, False, False, 0)

        defilement = Gtk.ScrolledWindow()
        defilement.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        boite.pack_start(defilement, True, True, 0)
        self.contenu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        defilement.add(self.contenu)

        # En bas : qui utilise la machine, et de quoi la régler ou l'éteindre.
        pied = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        pied.set_name("pied-menu")
        identite = grenosui.identite()
        pied.pack_start(grenosui.avatar(identite.get("nom") or identite.get("login", "g"), 16),
                        False, False, 0)
        qui = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        nom = Gtk.Label(label=identite.get("nom") or identite.get("login", "grenOS"), xalign=0)
        nom.get_style_context().add_class("entree-titre")
        adresse = Gtk.Label(label=grenosui.adresse(), xalign=0)
        adresse.get_style_context().add_class("sous")
        qui.pack_start(nom, False, False, 0)
        qui.pack_start(adresse, False, False, 0)
        pied.pack_start(qui, True, True, 0)
        pied.pack_end(self.petit("Éteindre", "grenos-arret",
                                 ["system-shutdown", "system-log-out"]), False, False, 0)
        pied.pack_end(self.petit("Réglages", "grenos-parametres",
                                 ["preferences-system", "applications-system"]),
                      False, False, 0)
        boite.pack_start(pied, False, False, 0)

        self.applications = applications()
        self.remplir()

        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self.clic)
        self.connect("key-press-event", self.touche)

    def petit(self, texte, commande, icones):
        bouton = Gtk.Button()
        image = image_de(icones, 18)
        contenu = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        if image is not None:
            contenu.pack_start(image, False, False, 0)
        contenu.pack_start(Gtk.Label(label=texte), False, False, 0)
        bouton.add(contenu)
        bouton.get_style_context().add_class("discret")
        bouton.set_tooltip_text(texte)
        bouton.connect("clicked", lambda _: (self.fermer(), grenosui.lancer(commande)))
        return bouton

    def touche(self, _widget, evenement):
        if Gdk.keyval_name(evenement.keyval) == "Escape":
            self.fermer()
            return True
        return False

    def clic(self, _widget, evenement):
        """Un clic hors du menu le referme : c'est ce qu'attend n'importe qui."""
        largeur, hauteur = self.get_size()
        if not (0 <= evenement.x < largeur and 0 <= evenement.y < hauteur):
            self.fermer()
            return True
        return False

    def section(self, texte):
        etiquette = Gtk.Label(label=texte, xalign=0)
        etiquette.get_style_context().add_class("titre-section")
        return etiquette

    def visibles(self):
        filtre = self.recherche.get_text().strip().lower()
        if not filtre:
            return self.applications
        return [a for a in self.applications
                if filtre in a["nom"].lower() or filtre in a["note"].lower()]

    def remplir(self):
        for enfant in self.contenu.get_children():
            self.contenu.remove(enfant)

        cherche = bool(self.recherche.get_text().strip())

        if not cherche:
            self.contenu.pack_start(self.section("ÉPINGLÉES"), False, False, 0)
            grille = Gtk.FlowBox()
            grille.set_selection_mode(Gtk.SelectionMode.NONE)
            grille.set_max_children_per_line(6)
            grille.set_min_children_per_line(4)
            grille.set_homogeneous(True)
            grille.set_margin_start(10)
            grille.set_margin_end(10)
            for epingle in self.panneau.epingles:
                grille.add(self.carreau(epingle))
            self.contenu.pack_start(grille, False, False, 0)

        self.contenu.pack_start(
            self.section("TOUTES LES APPLICATIONS" if not cherche else "RÉSULTATS"),
            False, False, 0)
        for application in self.visibles()[:80]:
            self.contenu.pack_start(self.ligne(application), False, False, 0)
        self.contenu.show_all()

    def carreau(self, epingle):
        """Une application épinglée : une grande icône et son nom dessous."""
        bouton = Gtk.Button()
        bouton.get_style_context().add_class("epingle")
        colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        image = image_de(epingle.get("icone"), 36)
        if image is not None:
            colonne.pack_start(image, False, False, 0)
        etiquette = Gtk.Label(label=epingle["nom"])
        etiquette.set_max_width_chars(11)
        etiquette.set_ellipsize(3)
        colonne.pack_start(etiquette, False, False, 0)
        bouton.add(colonne)
        bouton.connect("clicked", lambda _: (self.fermer(),
                                             grenosui.lancer(epingle["commande"])))
        return bouton

    def ligne(self, application):
        bouton = Gtk.Button()
        bouton.get_style_context().add_class("entree")
        ligne = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        image = image_de(application["icone"], 24)
        if image is not None:
            ligne.pack_start(image, False, False, 0)
        titre = Gtk.Label(label=application["nom"], xalign=0)
        ligne.pack_start(titre, True, True, 0)
        bouton.add(ligne)
        bouton.connect("clicked", lambda _: self.choisir(application))
        bouton.connect("button-press-event", self.menu_application, application)
        return bouton

    def menu_application(self, _widget, evenement, application):
        """Clic droit : épingler à la barre, ou poser sur le bureau."""
        if evenement.button != 3:
            return False
        menu = Gtk.Menu()
        gestes = [
            ("Épingler à la barre des tâches", lambda: self.epingler(application)),
            ("Ajouter au bureau", lambda: self.poser_sur_le_bureau(application)),
        ]
        for texte, action in gestes:
            element = Gtk.MenuItem(label=texte)
            element.connect("activate", lambda _, a=action: a())
            menu.append(element)
        menu.show_all()
        menu.popup_at_pointer(evenement)
        return True

    def epingler(self, application):
        epingles = self.panneau.epingles
        if any(e["commande"] == application["commande"] for e in epingles):
            return
        epingles.append({"nom": application["nom"], "commande": application["commande"],
                         "icone": application["icone"]})
        ecrire_epingles(epingles)
        self.panneau.refaire_epingles()
        self.remplir()

    def poser_sur_le_bureau(self, application):
        """Un raccourci sur le bureau : une copie du fichier .desktop."""
        bureau = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP) \
            or os.path.expanduser("~/Bureau")
        os.makedirs(bureau, exist_ok=True)
        source = application.get("fichier", "")
        if not source or not os.path.exists(source):
            return
        cible = os.path.join(bureau, os.path.basename(source))
        try:
            with open(source, encoding="utf-8") as entree:
                contenu = entree.read()
            with open(cible, "w", encoding="utf-8") as sortie:
                sortie.write(contenu)
            os.chmod(cible, 0o755)
        except OSError:
            pass

    def premier(self):
        choix = self.visibles()
        if choix:
            self.choisir(choix[0])

    def choisir(self, application):
        self.fermer()
        grenosui.lancer(application["commande"], application["terminal"])

    def ouvrir(self):
        ecran = Gdk.Screen.get_default()
        x = max(12, (ecran.get_width() - MENU_LARGEUR) // 2)
        self.move(x, ecran.get_height() - HAUTEUR - MENU_HAUTEUR - 8)
        self.applications = applications()
        self.remplir()
        self.show_all()
        self.present()
        self.recherche.set_text("")
        self.recherche.grab_focus()
        self.panneau.enfoncer(True)

        # Attraper le pointeur : sans cela, un clic sur le fond d'écran ou sur
        # une autre fenêtre n'arriverait jamais jusqu'ici, et le menu resterait
        # ouvert derrière ce qu'on vient d'ouvrir.
        siege = Gdk.Display.get_default().get_default_seat()
        if siege is not None and self.get_window() is not None:
            siege.grab(self.get_window(), Gdk.SeatCapabilities.ALL_POINTING, True,
                       None, None, None, None)
            self.attrape = siege

    def fermer(self):
        if self.attrape is not None:
            self.attrape.ungrab()
            self.attrape = None
        self.hide()
        self.panneau.enfoncer(False)


class Panneau(Gtk.Window):
    """La barre du bas : le bouton grenOS, les icônes au centre, l'heure."""

    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("panneau")
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)

        ecran = Gdk.Screen.get_default()
        self.largeur, self.hauteur = ecran.get_width(), ecran.get_height()
        self.set_default_size(self.largeur, HAUTEUR)
        self.move(0, self.hauteur - HAUTEUR)
        self.connect("realize", lambda *_: self.reserver())

        self.epingles = lire_epingles()

        boite = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(boite)

        # Le centre est vraiment au centre : deux espaces qui poussent de part
        # et d'autre, comme le fait Windows depuis sa onzième version.
        boite.pack_start(Gtk.Box(), True, True, 0)

        self.centre = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        boite.pack_start(self.centre, False, False, 0)

        self.bouton_menu = Gtk.ToggleButton(label="grenOS")
        self.bouton_menu.set_name("bouton-menu")
        self.bouton_menu.set_tooltip_text("Menu grenOS")
        # On garde le numéro de la liaison : le menu doit pouvoir enfoncer ou
        # relâcher ce bouton sans que cela ne relance l'ouverture. Sans cette
        # précaution, ouvrir le menu s'appellerait lui-même sans fin.
        self.poignee = self.bouton_menu.connect("clicked", self.sur_le_bouton)
        self.centre.pack_start(self.bouton_menu, False, False, 0)

        self.boite_epingles = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.centre.pack_start(self.boite_epingles, False, False, 4)

        self.taches = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.centre.pack_start(self.taches, False, False, 0)

        boite.pack_start(Gtk.Box(), True, True, 0)

        # À droite, ce qui ne se cherche pas : l'heure, et de quoi éteindre.
        self.horloge = Gtk.Label()
        self.horloge.set_name("horloge")
        boite.pack_end(self.horloge, False, False, 0)

        self.refaire_epingles()
        self.menu = Menu(self)

        self.ecran_wnck = Wnck.Screen.get_default()
        self.ecran_wnck.force_update()
        for signalement in ("window-opened", "window-closed", "active-window-changed",
                            "window-stacking-changed"):
            self.ecran_wnck.connect(signalement, lambda *_: self.fenetres())
        self.fenetres()

        GLib.timeout_add_seconds(1, self.tic)
        self.tic()

    # ---- Les épinglées -----------------------------------------------------
    def refaire_epingles(self):
        for enfant in self.boite_epingles.get_children():
            self.boite_epingles.remove(enfant)
        for epingle in self.epingles:
            bouton = Gtk.Button()
            image = image_de(epingle.get("icone"), 26)
            if image is not None:
                bouton.add(image)
            else:
                bouton.add(Gtk.Label(label=epingle["nom"][:8]))
            bouton.set_tooltip_text(epingle["nom"])
            bouton.connect("clicked", lambda _, c=epingle["commande"]: grenosui.lancer(c))
            bouton.connect("button-press-event", self.menu_epingle, epingle)
            self.boite_epingles.pack_start(bouton, False, False, 0)
        self.boite_epingles.show_all()

    def menu_epingle(self, _widget, evenement, epingle):
        """Clic droit sur une icône de la barre : l'ouvrir, ou la retirer."""
        if evenement.button != 3:
            return False
        menu = Gtk.Menu()
        gestes = [
            ("Ouvrir", lambda: grenosui.lancer(epingle["commande"])),
            ("Retirer de la barre", lambda: self.retirer(epingle)),
        ]
        for texte, action in gestes:
            element = Gtk.MenuItem(label=texte)
            element.connect("activate", lambda _, a=action: a())
            menu.append(element)
        menu.show_all()
        menu.popup_at_pointer(evenement)
        return True

    def retirer(self, epingle):
        self.epingles = [e for e in self.epingles if e["commande"] != epingle["commande"]]
        ecrire_epingles(self.epingles)
        self.refaire_epingles()

    # ---- Le reste ----------------------------------------------------------
    def sur_le_bouton(self, bouton):
        """Le bouton est un interrupteur : il ouvre, puis il referme."""
        if bouton.get_active():
            self.menu.ouvrir()
        else:
            self.menu.fermer()

    def enfoncer(self, etat):
        """Met le bouton dans l'état voulu sans déclencher son action.

        GTK émet « clicked » même quand le programme enfonce le bouton
        lui-même : le menu rouvrirait le menu, indéfiniment. On coupe la
        liaison le temps du geste.
        """
        self.bouton_menu.handler_block(self.poignee)
        self.bouton_menu.set_active(etat)
        self.bouton_menu.handler_unblock(self.poignee)

    def reserver(self):
        """Réserve la bande du bas : une fenêtre agrandie s'arrête au-dessus.

        C'est la propriété `_NET_WM_STRUT` du protocole des bureaux X11. GTK ne
        l'écrit pas pour nous, et sans elle une fenêtre plein écran passerait
        sous la barre, qui deviendrait inutilisable.
        """
        fenetre = self.get_window()
        if fenetre is None:
            return
        identifiant = str(fenetre.get_xid())
        subprocess.run(["xprop", "-id", identifiant, "-f", "_NET_WM_STRUT", "32c",
                        "-set", "_NET_WM_STRUT", f"0, 0, 0, {HAUTEUR}"], check=False)
        subprocess.run(["xprop", "-id", identifiant, "-f", "_NET_WM_STRUT_PARTIAL", "32c",
                        "-set", "_NET_WM_STRUT_PARTIAL",
                        f"0, 0, 0, {HAUTEUR}, 0, 0, 0, 0, 0, 0, 0, {self.largeur - 1}"],
                       check=False)

    def tic(self):
        maintenant = time.localtime()
        self.horloge.set_text(
            f"{maintenant.tm_hour:02d}:{maintenant.tm_min:02d}  ·  "
            f"{JOURS[maintenant.tm_wday]} {maintenant.tm_mday} {MOIS[maintenant.tm_mon - 1]}")
        return True

    def fenetres(self):
        """Les fenêtres ouvertes, en icônes : un mot par fenêtre remplit la barre."""
        for enfant in self.taches.get_children():
            self.taches.remove(enfant)
        active = self.ecran_wnck.get_active_window()
        for fenetre in self.ecran_wnck.get_windows():
            if fenetre.is_skip_tasklist():
                continue
            titre = fenetre.get_name() or "Fenêtre"
            bouton = Gtk.Button()
            icone = fenetre.get_icon()
            if icone is not None:
                bouton.add(Gtk.Image.new_from_pixbuf(
                    icone.scale_simple(26, 26, GdkPixbuf.InterpType.BILINEAR)))
            else:
                bouton.add(Gtk.Label(label=titre[:10]))
            bouton.set_tooltip_text(titre)
            style = bouton.get_style_context()
            style.add_class("tache")
            if active is not None and fenetre.get_xid() == active.get_xid():
                style.add_class("tache-active")
            bouton.connect("clicked", lambda _, f=fenetre: self.basculer(f))
            bouton.connect("button-press-event", self.menu_fenetre, fenetre)
            self.taches.pack_start(bouton, False, False, 0)
        self.taches.show_all()

    def menu_fenetre(self, _widget, evenement, fenetre):
        """Clic droit sur une fenêtre de la barre : la ranger ou la fermer."""
        if evenement.button != 3:
            return False
        maintenant = Gtk.get_current_event_time()
        menu = Gtk.Menu()
        gestes = [
            ("Afficher", lambda: (fenetre.unminimize(maintenant), fenetre.activate(maintenant))),
            ("Réduire", fenetre.minimize),
            ("Fermer", lambda: fenetre.close(maintenant)),
        ]
        for texte, action in gestes:
            element = Gtk.MenuItem(label=texte)
            element.connect("activate", lambda _, a=action: a())
            menu.append(element)
        menu.show_all()
        menu.popup_at_pointer(evenement)
        return True

    def basculer(self, fenetre):
        maintenant = Gtk.get_current_event_time()
        if fenetre.is_active():
            fenetre.minimize()
        else:
            fenetre.unminimize(maintenant)
            fenetre.activate(maintenant)


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    style = grenosui.habiller()
    propre = Gtk.CssProvider()

    def repeindre(*_):
        """Relit la palette : c'est ce que déclenche le passage jour/nuit."""
        couleurs = grenosui.palette()
        entete = "".join(f"@define-color {n} {v};\n" for n, v in couleurs.items())
        grenosui.charger(style, grenosui.feuille(couleurs))
        grenosui.charger(propre, entete + STYLE)
        return True

    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), propre, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    repeindre()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, repeindre)

    panneau = Panneau()
    panneau.show_all()

    # Le clic droit sur le fond d'écran : `grenos-menu` envoie ce signal.
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2,
                         lambda: (panneau.menu.ouvrir(), True)[1])
    Gtk.main()


if __name__ == "__main__":
    main()
