#!/usr/bin/env python3
"""La barre des tâches de grenOS, et son menu.

Une icône par application, et une seule : si une application épinglée est
ouverte, c'est son icône qui porte l'indicateur — pas un second bouton à côté.
Un trait arrondi apparaît sous elle, vif quand la fenêtre est au premier plan,
éteint quand elle est réduite, absent quand elle est fermée. C'est ce que fait
Windows, et cela se lit sans y penser.

Les icônes sont celles des applications elles-mêmes, retrouvées par leur classe
de fenêtre dans les fichiers .desktop du système : sans cela, chaque fenêtre
affiche le cahier blanc générique de GTK.

Ce qui se trouve dans la barre appartient à la personne : clic droit pour
épingler ou retirer, glisser une application du menu vers le bureau pour l'y
poser. Ces choix vivent dans `~/.config/grenos/barre.json`.
"""
import json
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Wnck  # noqa: E402

import grenosui  # noqa: E402
import maj  # noqa: E402
import son  # noqa: E402

HAUTEUR = 52
MENU_LARGEUR = 640
MENU_HAUTEUR = 640
BARRE = os.path.join(grenosui.REGLAGES, "barre.json")

EPINGLES_PAR_DEFAUT = [
    {"nom": "Fichiers", "commande": "pcmanfm", "icone": "grenos-fichiers"},
    {"nom": "Web", "commande": "firefox-esr", "icone": "firefox-esr"},
    {"nom": "Terminal", "commande": "x-terminal-emulator", "icone": "utilities-terminal"},
    {"nom": "GrenPlace", "commande": "grenplace", "icone": "grenplace"},
]

# Ce que personne ne cherche dans une liste d'applications : des réglages qui
# ont leur place dans les Réglages, et des outils qu'on ouvre par un autre
# chemin. Ils restent accessibles en tapant leur nom dans la recherche.
#
# On compare au **programme lancé**, pas au nom du fichier. Debian livre
# `org.pulseaudio.pavucontrol.desktop`, pas `pavucontrol.desktop` : la liste
# ratait donc « Contrôle du volume », et on ne s'en apercevait qu'en regardant
# le menu. Un nom de fichier change de version en version ; `Exec=pavucontrol`
# ne change pas.
HORS_LISTE = {
    "pavucontrol", "nm-connection-editor", "galculator", "calamares",
    "grenos-installer", "grenos-theme", "grenos-maj", "xfce4-terminal-settings",
    "xfce4-settings-manager", "vim", "gvim", "xarchiver", "debian-installer",
    "qvidcap", "qdbusviewer", "lstopo", "assistant", "designer", "linguist",
    "xfce4-about", "openbox", "uxterm", "xterm", "display-im6.q16", "feh",
    "lightdm-gtk-greeter", "qv4l2", "pcmanfm-desktop-pref",
}

JOURS = ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."]
MOIS = ["janv.", "févr.", "mars", "avr.", "mai", "juin",
        "juil.", "août", "sept.", "oct.", "nov.", "déc."]

