#!/usr/bin/env python3
"""La barre des tâches de grenOS, et son menu.

La disposition est celle que tout le monde connaît : les icônes au centre, le
bouton grenOS devant, l'heure à droite. Des icônes, pas des mots — une barre
pleine de texte se lit mal et se remplit vite.

Ce qui s'y trouve appartient à la personne : clic droit sur une icône pour la
retirer, clic droit dans le menu pour l'épingler ou la poser sur le bureau. Ces
choix vivent dans `~/.config/grenos/barre.json` et survivent au redémarrage.

Rien n'est composé par la carte graphique : une barre, un menu, des fenêtres.
C'est ce qui garde le pointeur fluide sur une machine sans accélération 3D.
"""
import json
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Wnck  # noqa: E402

import grenosui  # noqa: E402

HAUTEUR = 52
MENU_LARGEUR = 640
MENU_HAUTEUR = 640
BARRE = os.path.join(grenosui.REGLAGES, "barre.json")

# Ce qui est épinglé quand personne n'a encore rien choisi.
EPINGLES_PAR_DEFAUT = [
    {"nom": "Fichiers", "commande": "pcmanfm",
     "icone": ["system-file-manager", "folder", "inode-directory"]},
    {"nom": "Web", "commande": "firefox-esr",
     "icone": ["firefox-esr", "firefox", "web-browser"]},
    {"nom": "Terminal", "commande": "x-terminal-emulator",
     "icone": ["utilities-terminal", "terminal"]},
    {"nom": "GrenPlace", "commande": "grenplace",
     "icone": ["system-software-install", "software-store"]},
]

# Les jours et les mois, écrits ici. `strftime` suit la locale du système, et
# une locale absente ou mal chargée donnait « Wed 23 Sep » sur un bureau
# entièrement en français. Une horloge n'a pas à dépendre de cela.
JOURS = ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."]
MOIS = ["janv.", "févr.", "mars", "avr.", "mai", "juin",
        "juil.", "août", "sept.", "oct.", "nov.", "déc."]

STYLE = """
