    background-color: transparent;
    background-image: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 7px 18px;
    margin: 2px;
    font-weight: 600;
}
.rayon:hover { background-color: @survol; border-color: @bord; }
.rayon:checked {
    background-image: linear-gradient(to bottom, @accent-clair, @accent);
    color: #ffffff;
    border-color: @accent-sombre;
}

.etat-installe {
    color: @reussi;
    font-weight: 600;
}

/* LA BARRE LATÉRALE, COMME LE MAGASIN DE WINDOWS
 *
 * Grenofar : « redesign-le pour que ça ressemble aussi à Windows ». Le Microsoft
 * Store range ses rayons en colonne à gauche, pas en pastilles sur une ligne :
 * la liste peut s'allonger sans repousser le contenu, et le rayon courant reste
 * visible pendant qu'on fait défiler.
 *
 * Le trait vertical à gauche de l'entrée courante est le marqueur de Windows.
 * On le dessine avec une bordure, pas une image : il suit la couleur du thème
 * quand on passe du jour à la nuit. */
.cote {
    background-color: transparent;
    background-image: none;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0 7px 7px 0;
    padding: 9px 14px;
    font-weight: 600;
}
.cote:hover { background-color: @survol; }
.cote:checked {
    background-color: @survol;
    border-left-color: @accent;
    color: @texte;
}
.volet {
    background-color: @fond-creux;
    border-radius: 10px;
    padding: 8px 0;
}
.pastille {
    background-image: linear-gradient(to bottom, @accent-clair, @accent);
    color: #ffffff;
    border-radius: 999px;
    padding: 1px 9px;
    font-size: 11px;
    font-weight: 700;
}
"""


# ---- Le catalogue ----------------------------------------------------------
def lire_fichier(chemin):
    try:
        with open(chemin, encoding="utf-8") as fichier:
            return json.load(fichier)
    except (OSError, ValueError):
        return None


# Un identifiant sain, et rien d'autre. Le catalogue vient du réseau : il dit
# *quoi* installer, jamais *comment*. La commande est construite ici, et cette
# expression empêche qu'un identifiant trafiqué se glisse en option d'apt ou de
# flatpak. C'est la raison pour laquelle la fiche ne contient pas de commande.
IDENTIFIANT_SAIN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")


def fiche_valable(application):
    """Une fiche qu'on accepte d'afficher et d'installer."""
    if application.get("source") not in ("flatpak", "apt"):
        return False
    if not IDENTIFIANT_SAIN.match(application.get("identifiant", "")):
        return False
    return bool(application.get("slug") and application.get("nom"))


def catalogue():
    """Le catalogue, demandé au backend ; à défaut, le dernier connu.

    Rendu : (liste d'applications, d'où elle vient).
    """
    try:
        requete = urllib.request.Request(CATALOGUE_EN_LIGNE,
                                         headers={"User-Agent": "GrenPlace"})
        with urllib.request.urlopen(requete, timeout=8) as reponse:
            donnees = json.loads(reponse.read().decode("utf-8"))
        applications = [a for a in donnees.get("applications", []) if fiche_valable(a)]
        if applications:
            os.makedirs(CACHE, exist_ok=True)
            with open(CATALOGUE_GARDE, "w", encoding="utf-8") as fichier:
                json.dump(donnees, fichier, ensure_ascii=False)
            return applications, "en ligne"
    except (urllib.error.URLError, OSError, ValueError, TimeoutError):
        pass

    for chemin, origine in ((CATALOGUE_GARDE, "dernier connu"),
                            (CATALOGUE_LIVRE, "livré avec l'image")):
        donnees = lire_fichier(chemin)
        if donnees:
            applications = [a for a in donnees.get("applications", []) if fiche_valable(a)]
            if applications:
                return applications, origine
    return [], "introuvable"


def logo(application, taille=48):
    """Le logo de l'application, gardé une fois téléchargé.

    On ne stocke pas les logos : la fiche donne une adresse, la machine va la
    chercher elle-même, et le résultat reste dans son propre cache.
    """
    adresse = application.get("logo") or ""
    if adresse:
        os.makedirs(LOGOS, exist_ok=True)
        fichier = os.path.join(LOGOS, f"{application['slug']}.png")
        if not os.path.exists(fichier):
            try:
                requete = urllib.request.Request(adresse, headers={"User-Agent": "GrenPlace"})
                with urllib.request.urlopen(requete, timeout=8) as reponse:
                    contenu = reponse.read()
                if contenu[:8] == b"\x89PNG\r\n\x1a\n" or contenu[:2] == b"\xff\xd8":
                    with open(fichier, "wb") as sortie:
                        sortie.write(contenu)
            except (urllib.error.URLError, OSError, TimeoutError):
                pass
        if os.path.exists(fichier):
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_scale(fichier, taille, taille, True)
            except GLib.Error:
                pass

    # Le theme d'icones installe connait la plupart des paquets Debian
    # (gparted, timeshift, python, node...). Le demander par son nom donne la
    # vraie icone de l'application, sans rien telecharger.
    theme = Gtk.IconTheme.get_default()
    identifiant = application.get("identifiant", "")
    propres = [identifiant, identifiant.split(".")[-1].lower(), application["slug"]]
    for nom in propres:
        if nom:
            try:
                return theme.load_icon(nom, taille, Gtk.IconLookupFlags.FORCE_SIZE)
            except GLib.Error:
                continue

    for nom in ICONES_RAYON.get(application.get("rayon", ""), []):
        try:
            return theme.load_icon(nom, taille, Gtk.IconLookupFlags.FORCE_SIZE)
        except GLib.Error:
            continue

    return tuile(application, taille)


def tuile(application, taille):
    """Faute de mieux, une tuile dessinee avec l'initiale.

    C'est ce que font les telephones quand un contact n'a pas de photo, et
    pour la meme raison : une lettre distingue une application d'une autre,
    alors que la meme icone generique repetee dix fois n'apprend rien.
    """
    couleurs = grenosui.palette()
    fond = COULEURS_RAYON.get(application.get("rayon", ""), couleurs["accent"])
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, taille, taille)
    dessin = cairo.Context(surface)

    rayon = taille * 0.24
    dessin.new_sub_path()
    dessin.arc(taille - rayon, rayon, rayon, -1.5708, 0)
    dessin.arc(taille - rayon, taille - rayon, rayon, 0, 1.5708)
    dessin.arc(rayon, taille - rayon, rayon, 1.5708, 3.1416)
    dessin.arc(rayon, rayon, rayon, 3.1416, 4.7124)
    dessin.close_path()
    dessin.set_source_rgb(*_rvb(fond))
    dessin.fill()

    lettre = (application.get("nom") or "?").strip()[:1].upper()
    dessin.select_font_face("Inter", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    dessin.set_font_size(taille * 0.52)
    _, _, largeur, hauteur, _, _ = dessin.text_extents(lettre)
    dessin.move_to((taille - largeur) / 2 - 1, (taille + hauteur) / 2)
    dessin.set_source_rgb(1, 1, 1)
    dessin.show_text(lettre)

    return Gdk.pixbuf_get_from_surface(surface, 0, 0, taille, taille)


def _rvb(couleur):
    """« #3b82f6 » en trois nombres entre 0 et 1."""
    couleur = couleur.lstrip("#")
    return tuple(int(couleur[i:i + 2], 16) / 255 for i in (0, 2, 4))


# ---- L'installation --------------------------------------------------------
def lanceur():
    """sudo quand il ne demande rien, pkexec sinon."""
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        return ["sudo", "-n"]
    return ["pkexec"]


def installe(application):
    """Cette application est-elle déjà là ?"""
    if application["source"] == "flatpak":
        return subprocess.run(["flatpak", "info", application["identifiant"]],
                              capture_output=True).returncode == 0
    return subprocess.run(["dpkg-query", "-W", "-f=${Status}", application["identifiant"]],
                          capture_output=True, text=True).stdout.startswith("install ok")


class Installation(Gtk.Window):
    """La fenêtre qui installe : une barre, une phrase, le détail au besoin."""

    def __init__(self, parent, application, fini, mise_a_jour=False):
        verbe = "Mise à jour" if mise_a_jour else "Installation"
        super().__init__(title=f"{verbe} de {application['nom']}")
        grenosui.poser_taille(self, 640, 380)
        self.set_transient_for(parent)
        self.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        self.application = application
        self.fini = fini
        self.mise_a_jour = mise_a_jour

        colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        colonne.set_border_width(24)
        self.add(colonne)

        depuis = ("Flathub" if application["source"] == "flatpak" else "les dépôts Debian")
        colonne.pack_start(
            grenosui.titre(application["nom"], f"Téléchargement depuis {depuis}."),
            False, False, 0)

        self.etat = Gtk.Label(label="Préparation…", xalign=0)
        self.barre = Gtk.ProgressBar()
        colonne.pack_start(grenosui.carte(self.etat, self.barre), False, False, 0)

        self.details = Gtk.Expander(label="Voir le détail")
        vue = Gtk.ScrolledWindow()
        vue.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        vue.set_size_request(-1, 170)
        self.texte = Gtk.TextView()
        self.texte.set_editable(False)
        self.texte.set_monospace(True)
        vue.add(self.texte)
        self.details.add(vue)
        colonne.pack_start(self.details, True, True, 0)

        self.fermer = grenosui.bouton("Fermer", self.destroy)
        self.fermer.set_sensitive(False)
        colonne.pack_start(self.fermer, False, False, 0)

        threading.Thread(target=self.travailler, daemon=True).start()

    def journal(self, ligne):
        def ajouter():
            tampon = self.texte.get_buffer()
            tampon.insert(tampon.get_end_iter(), ligne + "\n")
            return False
        GLib.idle_add(ajouter)

    def courir(self, commande, avancer=None):
        processus = subprocess.Popen(
            commande, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
            bufsize=1, env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"})
        for ligne in processus.stdout:
            ligne = ligne.rstrip()
            if ligne:
                self.journal(ligne)
                if avancer is not None:
                    avancer(ligne)
        processus.wait()
        return processus.returncode

    def travailler(self):
        faits = [0]

        def suivre(ligne):
            trouve = re.search(r"(\d+)%", ligne)
            if trouve:
                GLib.idle_add(self.barre.set_fraction, int(trouve.group(1)) / 100)
            elif re.match(r"^(Unpacking|Dépaquetage|Setting up|Paramétrage|Installing)", ligne):
                faits[0] += 1
                GLib.idle_add(self.barre.set_fraction, min(0.15 + faits[0] / 30, 0.95))

        GLib.idle_add(self.etat.set_text,
                      "Téléchargement et mise à jour…" if self.mise_a_jour
                      else "Téléchargement et installation…")
        identifiant = self.application["identifiant"]
        if self.application["source"] == "flatpak":
            self.courir(["flatpak", "remote-add", "--if-not-exists", "flathub",
                         "https://dl.flathub.org/repo/flathub.flatpakrepo"])
            if self.mise_a_jour:
                # `update` nommément, et pas `install` : `install` sur une
                # application déjà là répond « already installed » et rend 0.
                # On aurait donc un bouton vert qui ne fait rien — la forme de
                # défaut que ce dépôt passe son temps à trouver.
                code = self.courir(["flatpak", "update", "-y", "--noninteractive",
                                    identifiant], suivre)
            else:
                code = self.courir(["flatpak", "install", "-y", "--noninteractive",
                                    "flathub", identifiant], suivre)
        else:
            self.courir(lanceur() + ["apt-get", "update"])
            if self.mise_a_jour:
                # `install` sur un paquet déjà posé le met bien à jour : c'est
                # le comportement documenté d'apt, et `--only-upgrade` ajoute
                # la garantie qu'on n'installe rien qui ne soit pas déjà là.
                code = self.courir(lanceur() + ["apt-get", "install", "-y",
                                                "--only-upgrade", identifiant],
                                   suivre)
            else:
                code = self.courir(lanceur() + ["apt-get", "install", "-y",
                                                identifiant], suivre)

        GLib.idle_add(self.barre.set_fraction, 1.0)
        if code == 0:
            GLib.idle_add(self.etat.set_text,
                          f"{self.application['nom']} est à jour."
                          if self.mise_a_jour
                          else f"{self.application['nom']} est installé. "
                               "Il est dans le menu.")
        else:
            GLib.idle_add(self.etat.set_text,
                          "La mise à jour s'est arrêtée. Le détail est ci-dessous."
                          if self.mise_a_jour
                          else "L'installation s'est arrêtée. Le détail est "
                               "ci-dessous.")
            GLib.idle_add(self.details.set_expanded, True)
        GLib.idle_add(self.fermer.set_sensitive, True)
        GLib.idle_add(self.fini)


class GrenPlace(Gtk.Window):
    def __init__(self):
        super().__init__(title="GrenPlace")
        grenosui.chronometrer(self)
        grenosui.poser_taille(self, 980, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)
        self.rayon = "Tout"
        self.applications = []
        self.origine = ""
        # Les mises à jour arrivent plus tard que le catalogue : elles
        # demandent le réseau une seconde fois. `None` veut dire « on ne sait
        # pas encore », et ce n'est pas la même chose qu'une liste vide — qui
        # voudrait dire « tout est à jour ». Confondre les deux ferait écrire
        # « tout est à jour » avant d'avoir regardé.
        self.retard = None

        # LA DISPOSITION DU MAGASIN DE WINDOWS : UN VOLET, PUIS LE CONTENU.
        tout = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        tout.set_border_width(20)
        self.add(tout)

        self.volet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.volet.get_style_context().add_class("volet")
        self.volet.set_size_request(196, -1)
        tout.pack_start(self.volet, False, False, 0)

        colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        tout.pack_start(colonne, True, True, 0)

        self.entete = grenosui.titre("GrenPlace", "Chargement du catalogue…")
        colonne.pack_start(self.entete, False, False, 0)

        self.recherche = Gtk.SearchEntry()
        self.recherche.set_placeholder_text("Chercher une application")
        self.recherche.connect("search-changed", lambda _: self.remplir())
        colonne.pack_start(self.recherche, False, False, 0)

        defilement = Gtk.ScrolledWindow()
        defilement.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        colonne.pack_start(defilement, True, True, 0)
        self.liste = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        defilement.add(self.liste)

        # Le catalogue arrive du réseau : on ne fige pas la fenêtre en
        # l'attendant.
        threading.Thread(target=self.charger, daemon=True).start()

    def charger(self):
        applications, origine = catalogue()
        def poser():
            self.applications = applications
            self.origine = origine
            self.faire_rayons()
            self.remplir()
            # Le magasin dit ce qu'il a trouvé, et d'où. La machine
            # d'intégration ne l'ouvrait jamais : il aurait pu ne plus démarrer
            # du tout sans que rien ne rougisse — et c'est la vitrine.
            grenosui.dire(
                "grenplace ouvert, %d applications (%s)" % (len(applications), origine))
            # Et seulement ENSUITE on va demander ce qui a changé : c'est un
            # second aller-retour sur le réseau, et la fenêtre doit être
            # affichée avant, pas après.
            self.chercher_les_retards()
            return False
        GLib.idle_add(poser)

    def faire_rayons(self):
        """Le volet de gauche. Les rayons viennent du catalogue, jamais d'une
        liste écrite d'avance : ajouter un rayon au catalogue doit suffire."""
        for enfant in self.volet.get_children():
            self.volet.remove(enfant)
        vus = []
        for application in self.applications:
            if application.get("rayon") and application["rayon"] not in vus:
                vus.append(application["rayon"])

        self.boutons_volet = {}
        premier = None
        for nom in ["Tout"] + vus:
            etiquette = "Accueil" if nom == "Tout" else nom
            bouton = Gtk.RadioButton.new_with_label_from_widget(premier, etiquette)
            bouton.set_mode(False)
            bouton.get_style_context().add_class("cote")
            # xalign ne suffit pas : c'est l'étiquette DANS le bouton qu'il faut
            # aligner, sans quoi tout le volet est centré et ne ressemble à rien.
            for enfant in bouton.get_children():
                if isinstance(enfant, Gtk.Label):
                    enfant.set_xalign(0.0)
            if premier is None:
                premier = bouton
            bouton.connect("toggled", self.changer_rayon, nom)
            self.volet.pack_start(bouton, False, False, 0)
            self.boutons_volet[nom] = bouton

        self.volet.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL),
                              False, False, 8)

        # « Mises à jour » est en bas et à part, comme dans le magasin de
        # Windows : ce n'est pas un rayon du catalogue, c'est l'état de cette
        # machine-ci.
        boite = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bouton = Gtk.RadioButton.new_with_label_from_widget(premier, "Mises à jour")
        bouton.set_mode(False)
        bouton.get_style_context().add_class("cote")
        for enfant in bouton.get_children():
            if isinstance(enfant, Gtk.Label):
                enfant.set_xalign(0.0)
        bouton.connect("toggled", self.changer_rayon, "Mises à jour")
        boite.pack_start(bouton, True, True, 0)
        self.compteur = Gtk.Label(label="")
        self.compteur.get_style_context().add_class("pastille")
        self.compteur.set_no_show_all(True)
        boite.pack_end(self.compteur, False, False, 10)
        self.volet.pack_start(boite, False, False, 0)
        self.boutons_volet["Mises à jour"] = bouton

        self.volet.show_all()

    def changer_rayon(self, bouton, nom):
        if bouton.get_active():
            self.rayon = nom
            self.remplir()

    def remplir(self):
        filtre = self.recherche.get_text().strip().lower()
        for enfant in self.liste.get_children():
            self.liste.remove(enfant)

        for etiquette in self.entete.get_children()[1:]:
            self.entete.remove(etiquette)
        sous = Gtk.Label(
            label=f"{len(self.applications)} applications · catalogue {self.origine} · "
                  "rien n'est stocké chez nous, tout vient de Flathub ou de Debian",
            xalign=0)
        sous.get_style_context().add_class("sous")
        sous.set_line_wrap(True)
        self.entete.pack_start(sous, False, False, 0)
        self.entete.show_all()

        if self.rayon == "Mises à jour":
            self.remplir_mises_a_jour(filtre)
            self.liste.show_all()
            return

        montrees = 0
        for application in self.applications:
            if self.rayon != "Tout" and application.get("rayon") != self.rayon:
                continue
            cherche = (application["nom"] + " " + application.get("description", "")).lower()
            if filtre and filtre not in cherche:
                continue
            self.liste.pack_start(self.fiche(application), False, False, 0)
            montrees += 1

        if montrees == 0:
            vide = Gtk.Label(label="Rien ne correspond." if self.applications
                             else "Le catalogue n'a pas pu être lu.", xalign=0)
            vide.get_style_context().add_class("sous")
            self.liste.pack_start(grenosui.carte(vide), False, False, 0)
        self.liste.show_all()

    def remplir_mises_a_jour(self, filtre):
        """La page « Mises à jour ».

        TROIS ÉTATS, ET LE PREMIER EST CELUI QU'ON OUBLIE

        « on ne sait pas encore » n'est pas « tout est à jour ». Les confondre
        ferait écrire « tout est à jour » avant même d'avoir regardé — c'est la
        faute exacte de la photo d'extinction noire du 1er octobre, où zéro
        pixel voulait dire « on n'a pas regardé assez longtemps » et non
        « rien ne s'affiche ».
        """
        if self.retard is None:
            attente = Gtk.Label(
                label="Lecture… On demande à Flathub et à Debian ce qui a changé "
                      "depuis la dernière fois.", xalign=0)
            attente.set_line_wrap(True)
            attente.get_style_context().add_class("sous")
            self.liste.pack_start(grenosui.carte(attente), False, False, 0)
            return

        if not self.retard:
            rien = Gtk.Label(
                label="Tout est à jour. Les applications installées sont à leur "
                      "dernière version.", xalign=0)
            rien.set_line_wrap(True)
            rien.get_style_context().add_class("sous")
            self.liste.pack_start(grenosui.carte(rien), False, False, 0)
            return

        tete = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        combien = Gtk.Label(
            label="%d application%s à mettre à jour"
                  % (len(self.retard), "s" if len(self.retard) > 1 else ""),
            xalign=0)
        combien.get_style_context().add_class("entree-titre")
        tete.pack_start(combien, True, True, 0)
        tete.pack_end(grenosui.bouton("Tout mettre à jour",
                                      self.tout_mettre_a_jour, "principal"),
                      False, False, 0)
        self.liste.pack_start(grenosui.carte(tete), False, False, 0)

        for application in self.retard:
            cherche = (application["nom"] + " "
                       + application.get("description", "")).lower()
            if filtre and filtre not in cherche:
                continue
            self.liste.pack_start(self.fiche(application, mise_a_jour=True),
                                  False, False, 0)

    def fiche(self, application, mise_a_jour=False):
        ligne = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)

        image = logo(application)
        if image is not None:
            ligne.pack_start(Gtk.Image.new_from_pixbuf(image), False, False, 0)

        texte = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        titre = Gtk.Label(label=application["nom"], xalign=0)
        titre.get_style_context().add_class("entree-titre")
        sous = Gtk.Label(label=application.get("description", ""), xalign=0)
        sous.get_style_context().add_class("sous")
        sous.set_line_wrap(True)
        depuis = "paquet Debian" if application["source"] == "apt" else "Flatpak, depuis Flathub"
        editeur = application.get("editeur", "")
        origine = Gtk.Label(
            label=f"{application.get('rayon', '')} · {depuis}"
                  + (f" · {editeur}" if editeur else ""), xalign=0)
        origine.get_style_context().add_class("section")
        texte.pack_start(titre, False, False, 0)
        texte.pack_start(sous, False, False, 0)
        texte.pack_start(origine, False, False, 0)
        ligne.pack_start(texte, True, True, 0)

        if mise_a_jour:
            ligne.pack_end(
                grenosui.bouton("Mettre à jour",
                                lambda a=application: self.installer(a, True),
                                "principal"),
                False, False, 0)
        elif installe(application):
            etat = Gtk.Label(label="Installé")
            etat.get_style_context().add_class("etat-installe")
            ligne.pack_end(etat, False, False, 8)
        else:
            ligne.pack_end(
                grenosui.bouton("Installer", lambda a=application: self.installer(a),
                                "principal"),
                False, False, 0)
        return grenosui.carte(ligne)

    def installer(self, application, mise_a_jour=False):
        fenetre = Installation(self, application, self.remplir,
                               mise_a_jour=mise_a_jour)
        fenetre.show_all()

    def tout_mettre_a_jour(self):
        """Les met à jour l'une après l'autre, dans la même fenêtre.

        POURQUOI PAS `flatpak update -y` TOUT SEUL

        Parce que cela mettrait aussi à jour ce qui ne vient pas de notre
        catalogue, sans le dire. Le bouton promet « ces applications-là », et
        c'est exactement celles-là qu'il faut toucher — la promesse à l'écran
        doit correspondre à ce qui se passe derrière.
        """
        restantes = list(self.retard)
        if not restantes:
            return

        def suivante(_=None):
            if not restantes:
                self.chercher_les_retards()
                return
            application = restantes.pop(0)
            fenetre = Installation(self, application, suivante, mise_a_jour=True)
            fenetre.show_all()

        suivante()

    def chercher_les_retards(self):
        """Redemande ce qui a changé, sans figer la fenêtre."""
        self.retard = None
        self.remplir()

        def travailler():
            trouve = magasin.a_mettre_a_jour(self.applications)

            def poser():
                self.retard = trouve
                if trouve:
                    self.compteur.set_text(str(len(trouve)))
                    self.compteur.show()
                else:
                    self.compteur.hide()
                self.remplir()
                grenosui.dire("grenplace : %d application(s) a mettre a jour"
                              % len(trouve))
                return False
            GLib.idle_add(poser)

        threading.Thread(target=travailler, daemon=True).start()


def main():
    style = grenosui.habiller()
    propre = Gtk.CssProvider()
    couleurs = grenosui.palette()
    entete = "".join(f"@define-color {n} {v};\n" for n, v in couleurs.items())
    grenosui.charger(propre, entete + STYLE)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), propre, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    _ = style

    fenetre = GrenPlace()
    fenetre.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
