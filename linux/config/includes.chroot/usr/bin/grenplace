#!/usr/bin/env python3
"""GrenPlace : les applications de grenOS, demandées à grenOS.

Le magasin ne connaît aucune application. Au lancement, il demande le
catalogue à notre backend et affiche ce qu'on lui répond : nom, description,
logo et rayon. Changer le catalogue — ajouter Discord, retirer une
application, corriger une description — ne demande donc ni nouvelle image ni
mise à jour du système.

Ce qui vit chez nous n'est qu'une fiche. **Aucune application n'est stockée
dans notre backend, et aucun logo non plus** : la fiche dit seulement d'où
l'application s'installe vraiment — Flathub pour les Flatpak, les dépôts
Debian pour les paquets —, et où trouver son logo. Le téléchargement se fait
entre la machine et la source, sans passer par nous.

Trois sources, dans cet ordre, pour que le magasin s'ouvre toujours :
  1. le catalogue en ligne ;
  2. la copie gardée du dernier lancement réussi ;
  3. celle livrée avec l'image.
"""
import json
import os
import re
import subprocess
import sys
import threading
import urllib.error
import urllib.request

sys.path.insert(0, "/usr/lib/grenos")

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

import grenosui  # noqa: E402
import magasin  # noqa: E402

CATALOGUE_EN_LIGNE = (
    "https://tpqzhzuoyqpfairatdrw.supabase.co/storage/v1/object/public/catalogue/magasin.json"
)
CATALOGUE_LIVRE = "/usr/share/grenos/catalogue.json"
CACHE = os.path.expanduser("~/.cache/grenos")
CATALOGUE_GARDE = os.path.join(CACHE, "catalogue.json")
LOGOS = os.path.join(CACHE, "logos")

# À défaut de logo, l'icône du rayon : un carré vide est pire qu'une icône
# générique.
ICONES_RAYON = {
    "Jeux": ["applications-games", "input-gaming"],
    "Bureautique": ["x-office-document", "applications-office"],
    "Création": ["applications-graphics", "image-x-generic"],
    "Internet": ["applications-internet", "web-browser"],
    "Développement": ["applications-development", "text-x-script"],
    "Système": ["preferences-system", "applications-system"],
    # Le rayon neuf du 2 octobre. Papirus n'a pas d'icône « intelligence
    # artificielle » ; « applications-science » est ce qui s'en approche le
    # plus, et le repli de dessin prend la suite si le thème ne l'a pas.
    "Intelligence artificielle": ["applications-science", "system-run"],
}

# Quand meme le theme ne connait pas l'application, sa tuile prend la couleur
# de son rayon : deux applications voisines restent distinguables.
COULEURS_RAYON = {
    "Jeux": "#7c4df0",
    "Bureautique": "#2563eb",
    "Création": "#d9488a",
    "Internet": "#0ea5a3",
    "Développement": "#f2820c",
    "Système": "#5a6880",
    "Intelligence artificielle": "#16a34a",
}

STYLE = """
