#!/usr/bin/env python3
"""GrenPlace : les applications de grenOS, en un clic.

Deux sources, un seul bouton. Les paquets Debian viennent du système et se
mettent à jour avec lui ; les Flatpak viennent de Flathub et tournent dans leur
coin, ce qui permet d'installer Steam sans activer l'architecture 32 bits ni
toucher au reste de la machine.

L'installation se regarde dans une fenêtre — une barre qui avance et une phrase
qui dit où l'on en est — et jamais dans un terminal noir. Le détail complet
reste disponible pour qui veut le lire.
"""
import os
import re
import subprocess
import sys
import threading

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

import grenosui  # noqa: E402

# rayon, nom, description, source, identifiant, icône
CATALOGUE = [
