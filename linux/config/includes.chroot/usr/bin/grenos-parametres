#!/usr/bin/env python3
"""Les Réglages de grenOS : tout ce qui se règle, au même endroit.

Sept pages, et rien qui demande de connaître Linux : l'apparence, l'écran, le
son, le réseau, le compte, les mises à jour, et ce que la machine a dans le
ventre. Ce que cette fenêtre change, elle le change pour de vrai — la
définition de l'écran passe par RandR, le son par PipeWire, le mot de passe par
le système de comptes.

    grenos-parametres [apparence|ecran|son|reseau|compte|maj|materiel]
"""
import os
import subprocess
import sys
import threading

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

import ecran as module_ecran  # noqa: E402
import grenosui  # noqa: E402
import heure as module_heure  # noqa: E402
import maj as module_maj  # noqa: E402
import materiel  # noqa: E402
import son as module_son
import composants as module_composants
import securite as module_securite  # noqa: E402

COMPTE = "/usr/lib/grenos/grenos-compte"


def a_un_mot_de_passe(login):
    """Le compte est-il protégé ? Lu dans la base des mots de passe, en root."""
    resultat = subprocess.run(["sudo", "-n", "passwd", "-S", login],
                              capture_output=True, text=True)
    if resultat.returncode != 0:
        # Sans le droit de lire, c'est qu'il y a un mot de passe à donner.
        return True
    champs = resultat.stdout.split()
    return len(champs) > 1 and champs[1] == "P"


def en_root(arguments, entree=""):
    """Lance l'aide en root : sans mot de passe s'il n'y en a pas, sinon pkexec."""
    sans_mot_de_passe = subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0
    lanceur = ["sudo", "-n"] if sans_mot_de_passe else ["pkexec"]
    return subprocess.run(lanceur + [COMPTE] + arguments, input=entree,
                          capture_output=True, text=True)


class Reglages(Gtk.Window):
    def __init__(self, page=""):
        super().__init__(title="Réglages de grenOS")
        grenosui.chronometrer(self)
        grenosui.poser_taille(self, 960, 660)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)
        self.identite = grenosui.identite()
        self.login = self.identite.get("login", os.environ.get("USER", "grenos"))

        cadre = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(cadre)

        # À gauche les pages, à droite celle qu'on a choisie : la disposition
        # que tout le monde connaît, et qu'on ne cherche pas.
        self.pages = Gtk.Stack()
        self.pages.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.pages.set_transition_duration(130)

        cote = Gtk.StackSidebar()
        cote.set_stack(self.pages)
        cote.set_size_request(210, -1)
        cadre.pack_start(cote, False, False, 0)

        defilement = Gtk.ScrolledWindow()
        defilement.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        defilement.add(self.pages)
        cadre.pack_start(defilement, True, True, 0)

        # Les huit pages sont annoncées tout de suite, et remplies ensuite.
        #
        # Le chronomètre a mesuré 479 ms de construction de fenêtre ici, contre
        # 40 à 139 ms pour les autres applications : les huit pages étaient
        # bâties au démarrage alors qu'une seule est visible. Plusieurs
        # appellent des programmes extérieurs — `pactl` pour le son, `xrandr`
        # pour l'écran — et on payait les huit pour en montrer une.
        #
        # Le volet de gauche a besoin que les enfants existent pour afficher
        # leurs titres : on pose donc des boîtes vides, et on les garnit.
        self.constructeurs = {
            "apparence": self.page_apparence,
            "ecran": self.page_ecran,
            "son": self.page_son,
            "reseau": self.page_reseau,
            "compte": self.page_compte,
            "heure": self.page_heure,
            "maj": self.page_maj,
            "composants": self.page_composants,
            "securite": self.page_securite,
            "materiel": self.page_materiel,
        }
        self.garnies = set()
        for nom, titre in (("apparence", "Apparence"), ("ecran", "Écran"),
                           ("son", "Son"), ("reseau", "Réseau"),
                           ("compte", "Compte"), ("heure", "Heure et date"),
                           ("maj", "Mises à jour"),
                           ("composants", "Mise à jour composant"),
                           ("securite", "Sécurité"),
                           ("materiel", "Matériel")):
            self.pages.add_titled(
                Gtk.Box(orientation=Gtk.Orientation.VERTICAL), nom, titre)
        self.pages.connect("notify::visible-child-name", self.garnir)

        if page:
            self.pages.set_visible_child_name(page)
        # Celle qu'on voit, maintenant. Les sept autres attendent le temps mort.
        self.garnir()
        GLib.idle_add(self.garnir_le_reste)

    def garnir(self, *_):
        """Construit la page visible, si ce n'est pas déjà fait."""
        nom = self.pages.get_visible_child_name()
        if not nom or nom in self.garnies:
            return
        self.garnies.add(nom)
        boite = self.pages.get_child_by_name(nom)
        boite.pack_start(self.constructeurs[nom](), True, True, 0)
        boite.show_all()

    def garnir_le_reste(self):
        """Les sept autres pages, une par tour de boucle, quand rien ne presse.

        Elles ne sont pas abandonnées : les construire au premier temps mort
        les rend prêtes avant le premier clic, et **garde les lignes qu'elles
        écrivent sur le port série**. Celle du Son en particulier — « reglages
        son : melangeur … » — est une preuve exigée par la construction ; la
        rendre paresseuse sans cela l'aurait fait disparaître, et une image
        muette serait passée pour bonne.

        Une page par tour, et non les sept d'un coup : la fenêtre reste
        maniable pendant qu'elles se remplissent.
        """
        for nom in self.constructeurs:
            if nom not in self.garnies:
                self.garnies.add(nom)
                boite = self.pages.get_child_by_name(nom)
                boite.pack_start(self.constructeurs[nom](), True, True, 0)
                boite.show_all()
                return True
        return False

    def enveloppe(self, *blocs):
        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        boite.set_border_width(26)
        for bloc in blocs:
            boite.pack_start(bloc, False, False, 0)
        return boite

    def ligne(self, texte, widget):
        """Un réglage : son nom à gauche, ce qui le change à droite."""
        boite = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        etiquette = Gtk.Label(label=texte, xalign=0)
        boite.pack_start(etiquette, False, False, 0)
        boite.pack_end(widget, False, False, 0)
        return boite

    def note(self, texte):
        etiquette = Gtk.Label(label=texte, xalign=0)
        etiquette.get_style_context().add_class("sous")
        etiquette.set_line_wrap(True)
        return etiquette

    # ---- L'apparence -------------------------------------------------------
    def page_apparence(self):
        moment = "nuit"
        try:
            with open(os.path.join(grenosui.REGLAGES, "theme"), encoding="utf-8") as f:
                moment = f.read().strip() or "nuit"
        except OSError:
            pass

        choix = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        nuit = grenosui.bouton("Nuit", lambda: self.theme("nuit"),
                               "principal" if moment == "nuit" else "")
        jour = grenosui.bouton("Jour", lambda: self.theme("jour"),
                               "principal" if moment == "jour" else "")
        choix.pack_start(nuit, False, False, 0)
        choix.pack_start(jour, False, False, 0)

        return self.enveloppe(
            grenosui.titre("Apparence", "Le même bureau, deux lumières."),
            grenosui.carte(
                self.ligne("Thème", choix),
                self.note("Meta+T fait la bascule sans ouvrir cette fenêtre. "
                          "Le fond d'écran, la barre, les menus et les applications "
                          "suivent ensemble."),
            ),
            grenosui.carte(
                self.ligne("Fond d'écran",
                           grenosui.bouton("Choisir une image", self.choisir_fond)),
                self.note("Une image à toi, posée sur le bureau. Sans choix, grenOS "
                          "garde le sien, calculé à la construction de l'image."),
            ),
        )

    def theme(self, moment):
        grenosui.lancer(f"grenos-theme {moment}")
        GLib.timeout_add(600, lambda: (self.rafraichir_apparence(), False)[1])

    def rafraichir_apparence(self):
        grenosui.habiller()

    def choisir_fond(self):
        boite = Gtk.FileChooserDialog(title="Choisir un fond d'écran", transient_for=self,
                                      action=Gtk.FileChooserAction.OPEN)
        boite.add_buttons("Annuler", Gtk.ResponseType.CANCEL, "Choisir", Gtk.ResponseType.OK)
        filtre = Gtk.FileFilter()
        filtre.set_name("Images")
        for motif in ("*.png", "*.jpg", "*.jpeg", "*.webp", "*.bmp"):
            filtre.add_pattern(motif)
        boite.add_filter(filtre)
        boite.set_current_folder(os.path.expanduser("~"))
        if boite.run() == Gtk.ResponseType.OK:
            chemin = boite.get_filename()
            os.makedirs(grenosui.REGLAGES, exist_ok=True)
            with open(os.path.join(grenosui.REGLAGES, "fond"), "w", encoding="utf-8") as f:
                f.write(chemin + "\n")
            grenosui.lancer("grenos-fond")
        boite.destroy()

    # ---- L'écran -----------------------------------------------------------
    def page_ecran(self):
        self.ecrans = module_ecran.sorties()
        self.dire_ecran = Gtk.Label(label="", xalign=0)
        self.dire_ecran.get_style_context().add_class("sous")

        if not self.ecrans:
            return self.enveloppe(
                grenosui.titre("Écran"),
                grenosui.carte(self.note("Aucun écran interrogeable ici.")))

        premier = self.ecrans[0]
        self.modes = sorted(premier["modes"], key=lambda m: module_ecran.surface(m["taille"]),
                            reverse=True)

        # ---- Deux menus, et rien a taper ------------------------------------
        #
        # Grenofar, le 1er octobre : « comme Windows, genre il analyse l'ecran
        # et on peut choisir avec un menu deroulant 120 240 fps etc, pas a
        # taper ».
        #
        # La definition et la frequence etaient DEJA des menus. Ce qui se tapait
        # etait la troisieme case, « Aller plus haut » : un compteur de 24 a 360
        # dans une seconde carte, avec son propre bouton « Essayer cette
        # frequence ». Deux cartes, deux boutons, et un nombre a composer pour
        # obtenir ce que Windows donne en un clic.
        #
        # Les deux sont fondues en UN menu. Ce que le pilote annonce y figure,
        # et les frequences usuelles qu'il n'annonce pas y figurent aussi, dites
        # comme telles — parce qu'une machine virtuelle en annonce presque
        # toujours une seule, et que c'etait tout l'interet de la case libre.
        self.choix_taille = Gtk.ComboBoxText()
        for index, mode in enumerate(self.modes):
            largeur, hauteur = mode["taille"].split("x")
            self.choix_taille.append_text("%s × %s" % (largeur, hauteur))
            if mode["taille"] == premier["actuelle"]:
                self.choix_taille.set_active(index)
        if self.choix_taille.get_active() < 0:
            self.choix_taille.set_active(0)

        self.choix_taux = Gtk.ComboBoxText()
        self.choix_taille.connect("changed", lambda _: self.relire_taux())
        self.relire_taux()

        # Ce que le menu offre VRAIMENT, sur le port série.
        #
        # Un menu déroulant qui s'ouvre vide ou qui n'offre qu'une ligne ne fait
        # rougir aucune étape : c'est exactement l'angle mort de la page Son, à
        # l'échelle d'un menu. La ligne dit combien de fréquences sont offertes
        # et combien le pilote en annonce — si un jour la seconde tombe à zéro,
        # c'est que `xrandr` ne répond plus.
        annoncees = sum(1 for _a, _b, ann in self.taux_proposes if ann)
        grenosui.dire(
            "reglages ecran : %s, %d definitions, %d frequences offertes dont %d annoncees"
            % (premier["actuelle"] or "inconnue", len(self.modes),
               len(self.taux_proposes), annoncees))

        return self.enveloppe(
            grenosui.titre(
                "Écran",
                f"Écran {premier['nom']}, actuellement "
                f"{premier['actuelle'].replace('x', ' × ') or 'inconnu'} "
                f"à {premier['taux'] or '?'} images par seconde."),
            grenosui.carte(
                self.ligne("Définition", self.choix_taille),
                self.ligne("Images par seconde", self.choix_taux),
                grenosui.bouton("Appliquer", self.appliquer_ecran, "principal"),
                self.dire_ecran,
                self.note("Les fréquences marquées « à essayer » ne sont pas "
                          "annoncées par le pilote : elles sont calculées puis "
                          "proposées à l'écran. S'il refuse, rien ne change — et "
                          "s'il accepte mais que l'image reste noire, attends dix "
                          "secondes, rien n'est enregistré tant que l'essai n'a "
                          "pas réussi."),
            ),
        )

    def relire_taux(self):
        """Remplit le menu des fréquences pour la définition choisie.

        Chaque entrée garde SA valeur et SON origine — annoncée par le pilote,
        ou proposée par nous. Sans cela il faudrait relire le texte affiché pour
        décider quoi faire, et une phrase qu'on relit pour décider d'une action
        est un drapeau déguisé.
        """
        index = max(self.choix_taille.get_active(), 0)
        self.choix_taux.remove_all()
        self.taux_proposes = []

        annonces = self.modes[index]["taux"] if self.modes else []
        # La fusion vit dans le module, pas ici : c'est la seule facon de
        # l'exercer avec LA fonction qui tourne, et non avec une copie.
        self.taux_proposes = module_ecran.frequences_proposees(annonces)
        for arrondi, _brut, annoncee in self.taux_proposes:
            self.choix_taux.append_text(
                "%d Hz" % arrondi if annoncee else "%d Hz — à essayer" % arrondi)

        # On se place sur ce qui tourne en ce moment, pas sur le premier de la
        # liste : ouvrir une page de réglages ne doit jamais donner l'impression
        # qu'on va changer quelque chose.
        courant = self.ecrans[0]["taux"] if self.ecrans else ""
        choisi = 0
        if courant:
            try:
                vise = round(float(courant))
                for n, (arrondi, _b, _a) in enumerate(self.taux_proposes):
                    if arrondi == vise:
                        choisi = n
                        break
            except ValueError:
                pass
        self.choix_taux.set_active(choisi)

    def appliquer_ecran(self):
        index = max(self.choix_taille.get_active(), 0)
        taille = self.modes[index]["taille"]
        choix = self.choix_taux.get_active()
        if choix < 0 or choix >= len(self.taux_proposes):
            return self.dire_ecran.set_text("Choisis une fréquence.")
        arrondi, brut, annoncee = self.taux_proposes[choix]

        if annoncee:
            souci = module_ecran.appliquer(self.ecrans[0]["nom"], taille, brut)
        else:
            # Au-delà de ce que le pilote propose : on calcule la définition
            # nous-mêmes. Sans cela, impossible de dépasser 60 images par
            # seconde quand la liste annoncée s'arrête là — ce qui est le cas de
            # presque toutes les machines virtuelles.
            largeur, hauteur = taille.split("x")
            souci = module_ecran.ajouter_mode(self.ecrans[0]["nom"], largeur,
                                              hauteur, float(brut))
        self.dire_ecran.set_text(
            souci or "Appliqué : %s à %d images par seconde."
            % (taille.replace("x", " × "), arrondi))

    # ---- Mise à jour composant ----------------------------------------------
    def page_composants(self):
        """Les micrologiciels de la machine, par fwupd.

        RIEN N'EST LU PENDANT QUE LA FENÊTRE SE CONSTRUIT. `fwupdmgr` interroge
        le matériel et peut prendre plusieurs secondes ; `vulkaninfo` a déjà
        laissé la page Jeux vide vingt-cinq secondes, et la règle qu'on en a
        tirée vaut pour toute lecture : la page s'affiche d'abord, elle se
        remplit ensuite.
        """
        self.liste_composants = Gtk.Label(label="Lecture des composants…", xalign=0)
        self.liste_composants.set_line_wrap(True)
        self.dire_composants = Gtk.Label(label="", xalign=0)
        self.dire_composants.get_style_context().add_class("sous")

        threading.Thread(target=self._lire_composants, daemon=True).start()

        return self.enveloppe(
            grenosui.titre("Mise à jour composant",
                           "Les micrologiciels de la machine : carte mère, "
                           "contrôleurs, disques, cartes graphiques."),
            grenosui.carte(
                self.liste_composants,
                grenosui.bouton("Chercher des mises à jour",
                                self.chercher_composants, "principal"),
                self.dire_composants,
            ),
            # Ce que fwupd ne fait PAS. Le dire ici évite de laisser croire que
            # cette page couvre tout le matériel — c'est la même honnêteté que
            # la page Jeux sur Fortnite.
            grenosui.carte(
                self.note("Le microcode du processeur Intel ou AMD ne passe pas "
                          "par ici : il arrive avec « Mettre à jour grenOS », "
                          "comme le reste du système."),
                self.note("Le pilote NVIDIA non plus : la page Jeux le propose "
                          "quand la machine a une carte NVIDIA."),
            ),
        )

    def _lire_composants(self):
        if not module_composants.present():
            return GLib.idle_add(
                self.liste_composants.set_text,
                "fwupd n'est pas installé : aucun composant n'est interrogeable.")
        trouves = module_composants.composants()
        if not trouves:
            texte = ("Aucun composant interrogeable sur cette machine. C'est le "
                     "cas ordinaire d'une machine virtuelle : elle n'a pas de "
                     "micrologiciel à mettre à jour.")
        else:
            texte = chr(10).join(
                "%s — version %s%s"
                % (c["nom"], c["version"],
                   "" if c["peut_etre_mis_a_jour"] else "  (non modifiable)")
                for c in trouves)
        GLib.idle_add(self.liste_composants.set_text, texte)
        grenosui.dire("reglages composants : %d composant(s) lus par fwupd"
                      % len(trouves))

    def chercher_composants(self):
        self.dire_composants.set_text("Lecture chez les constructeurs…")
        threading.Thread(target=self._chercher_composants, daemon=True).start()

    def _chercher_composants(self):
        reussi, _dit = module_composants.rafraichir()
        if not reussi:
            return GLib.idle_add(
                self.dire_composants.set_text,
                "La liste des constructeurs n'a pas pu être relue. Vérifie le réseau.")
        attendues = module_composants.mises_a_jour()
        if not attendues:
            return GLib.idle_add(self.dire_composants.set_text,
                                 "Tous les composants sont à jour.")
        GLib.idle_add(
            self.dire_composants.set_text,
            chr(10).join("%s : %s vers %s" % (m["nom"], m["de"], m["vers"])
                         for m in attendues))

    # ---- Sécurité ------------------------------------------------------------
    def page_securite(self):
        """L'antivirus, et ce qu'il peut vraiment dire."""
        self.etat_securite = Gtk.Label(label=module_securite.resume(), xalign=0)
        self.etat_securite.set_line_wrap(True)
        self.dire_securite = Gtk.Label(label="", xalign=0)
        self.dire_securite.get_style_context().add_class("sous")

        grenosui.dire("reglages securite : clamav %s, signatures %s"
                      % ("present" if module_securite.present() else "absent",
                         "presentes" if module_securite.signatures()["presentes"]
                         else "absentes"))

        return self.enveloppe(
            grenosui.titre("Sécurité",
                           "ClamAV, l'antivirus libre, et sa base de signatures."),
            grenosui.carte(
                self.etat_securite,
                grenosui.bouton("Télécharger les signatures",
                                self.telecharger_signatures, "principal"),
                self.dire_securite,
                self.note("La base pèse plusieurs centaines de mégaoctets et "
                          "change tous les jours : elle n'est pas dans l'image, "
                          "elle se télécharge ici."),
            ),
            # Ce qu'un antivirus sous Linux fait, et ce qu'il ne fait pas. Un
            # antivirus qui laisse croire qu'il protège de tout est pire
            # qu'aucun.
            grenosui.carte(
                self.note("Les logiciels malveillants qui visent un bureau Linux "
                          "sont rares. ClamAV sert surtout à ne pas faire suivre "
                          "un fichier infecté à une machine Windows — une clé "
                          "USB, une pièce jointe, un fichier partagé."),
                self.note("Ni Malwarebytes ni Avast n'ont de produit Linux de "
                          "bureau : Avast a retiré le sien en 2021, Malwarebytes "
                          "n'en a jamais publié."),
            ),
        )

    def telecharger_signatures(self):
        self.dire_securite.set_text("Téléchargement en cours, cela peut durer…")
        threading.Thread(target=self._telecharger_signatures, daemon=True).start()

    def _telecharger_signatures(self):
        try:
            fin = subprocess.run(module_maj.lanceur() + ["freshclam"],
                                 capture_output=True, text=True, timeout=900)
            reussi = fin.returncode == 0
        except (OSError, subprocess.SubprocessError) as souci:
            reussi, fin = False, None
            GLib.idle_add(self.dire_securite.set_text, str(souci))
        if fin is not None:
            GLib.idle_add(self.dire_securite.set_text,
                          module_securite.resume() if reussi
                          else "Le téléchargement n'a pas abouti.")
        GLib.idle_add(self.etat_securite.set_text, module_securite.resume())

    # ---- Le son ------------------------------------------------------------
    def page_son(self):
        self.sorties_son = module_son.sorties()
        courante = module_son.sortie_actuelle()

        self.choix_sortie = Gtk.ComboBoxText()
        for index, (nom, description) in enumerate(self.sorties_son):
            self.choix_sortie.append_text(description)
            if nom == courante:
                self.choix_sortie.set_active(index)
        if self.sorties_son and self.choix_sortie.get_active() < 0:
            self.choix_sortie.set_active(0)
        self.choix_sortie.connect("changed", self.changer_sortie)

        self.curseur = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.curseur.set_size_request(320, -1)
        self.curseur.set_value(module_son.volume())
        self.curseur.set_draw_value(True)
        self.curseur.connect("value-changed",
                             lambda c: module_son.regler_volume(c.get_value()))

        silence = Gtk.Switch()
        silence.set_active(module_son.muet())
        silence.connect("notify::active", lambda *_: module_son.basculer_muet())

        contenu = [self.ligne("Sortie", self.choix_sortie),
                   self.ligne("Volume", self.curseur),
                   self.ligne("Silence", silence)]
        if not self.sorties_son:
            contenu = [self.note("Aucune sortie audio détectée. Dans une machine "
                                 "virtuelle, vérifie que le son est activé côté hôte.")]

        # Ce que la machine lit vraiment pour le son et la video. La lecture
        # se fait derriere, dans un fil a part : la page se dessine d'abord
        # avec « Lecture… », et la reponse la remplace quand elle arrive.
        self.dire_diag_son = self.note("Lecture…")
        threading.Thread(target=self.lire_son_et_video, daemon=True).start()

        return self.enveloppe(
            grenosui.titre("Son", "Par où le son sort, et à quel volume."),
            grenosui.carte(*contenu),
            grenosui.carte(
                self.ligne("Réglages détaillés",
                           grenosui.bouton("Ouvrir le mélangeur",
                                           lambda: grenosui.lancer("pavucontrol"))),
                self.note("Le mélangeur règle le volume application par application."),
            ),
            grenosui.carte(
                self.dire_diag_son,
                self.note("Ce que grenOS lit sur la machine, sans lancer aucun "
                          "programme : c'est ce qui est là, pas ce qui devrait l'être."),
            ),
        )

    def lire_son_et_video(self):
        """Lit le diagnostic son et video derriere, puis l'affiche au premier plan."""
        lu = materiel.son_et_video()
        GLib.idle_add(self.montrer_son_et_video, lu)

    def montrer_son_et_video(self, lu):
        """La reponse, en phrases que tout le monde comprend."""
        if lu["profils_alsa"]:
            profils = f"{lu['profils_alsa']} profils ALSA trouvés."
        else:
            profils = ("Aucun profil ALSA trouvé : sur un portable récent, "
                       "le son peut rester muet sans eux.")

        if lu["carte"]:
            carte = f"Carte son : {lu['carte']}"
            if lu["module"]:
                carte += f", pilotée par {lu['module']}"
            carte += "."
        else:
            carte = "Aucune carte son détectée."

        if lu["decodeur"]:
            decodeur = "Le décodeur vidéo est installé."
        else:
            decodeur = "Aucun décodeur vidéo installé."

        if lu["pilotes_video"]:
            pilotes = (f"{lu['pilotes_video']} pilote"
                       f"{'s' if lu['pilotes_video'] > 1 else ''} de décodage "
                       "vidéo sur la carte graphique.")
        else:
            pilotes = ("Aucun pilote de décodage vidéo sur la carte graphique : "
                       "les vidéos seront décodées par le processeur.")

        # Le mélangeur, et c'est la ligne la plus utile de la page.
        #
        # Grenofar : « le son fonctionne toujours pas », après une mise à jour
        # qui portait cinq corrections sur la priorité et le tampon. Aucune ne
        # peut faire sortir un son d'un canal coupé. Cette ligne répond enfin
        # à « pourquoi » au lieu de me laisser deviner une septième fois.
        coupes = [c for c in lu.get("melangeur", []) if c["coupe"]]
        bas = [c for c in lu.get("melangeur", [])
               if not c["coupe"] and c["niveau"] is not None and c["niveau"] < 10]
        if coupes:
            melangeur = ("LE SON EST COUPÉ dans le mélangeur de la carte : "
                         + ", ".join(c["nom"] for c in coupes)
                         + ". C'est la cause la plus probable d'un silence "
                           "complet. Ouvre le mélangeur ci-dessus et remonte-les.")
        elif bas:
            melangeur = ("Le mélangeur de la carte est très bas : "
                         + ", ".join("%s à %d %%" % (c["nom"], c["niveau"]) for c in bas)
                         + ".")
        elif lu.get("melangeur"):
            melangeur = ("Le mélangeur de la carte est ouvert ("
                         + ", ".join("%s %d %%" % (c["nom"], c["niveau"])
                                     for c in lu["melangeur"]
                                     if c["niveau"] is not None)
                         + ").")
        else:
            melangeur = "Aucun canal de mélangeur lisible sur cette carte."

        temps_reel = lu.get("temps_reel")
        if temps_reel is True:
            priorite = ("PipeWire tourne en temps réel : le son tiendra quand "
                        "la machine peine.")
        elif temps_reel is False:
            priorite = ("PipeWire ne tourne PAS en temps réel : le son hachera "
                        "dès que la machine peine.")
        else:
            priorite = "PipeWire ne tourne pas."

        # PAR OÙ LE SON SORT, ET C'EST LA LIGNE QUI MANQUAIT.
        #
        # La page savait dire que le mélangeur était ouvert et que PipeWire
        # tournait en temps réel. Elle ne disait pas **où va le son**. Sur une
        # machine avec une carte graphique, PipeWire choisit couramment la
        # sortie HDMI de cette carte : le son part vers l'écran pendant que les
        # enceintes restent muettes, avec un mélangeur ouvert et un volume à
        # 80 %. C'est le seul scénario compatible avec tout ce qu'on a mesuré
        # chez Grenofar — et la CI ne peut pas le voir, puisqu'elle n'a qu'une
        # seule sortie.
        #
        # Elle est posée EN PREMIER parce qu'elle rend les suivantes inutiles :
        # un mélangeur impeccable n'apprend rien quand le son part ailleurs.
        try:
            verdict_sortie, _soucis = module_son.diagnostic()
        except Exception:                                   # noqa: BLE001
            verdict_sortie = "Impossible de lire la sortie audio."

        self.dire_diag_son.set_text("\n".join(
            [verdict_sortie, melangeur, priorite, carte, profils, decodeur,
             pilotes]))

        # Et on le dit sur le port série.
        #
        # Sans cette ligne, ce diagnostic n'était prouvé nulle part : la CI
        # ouvre bien les Réglages, mais la fenêtre s'ouvre sur « Apparence » —
        # vu sur la capture — et personne ne clique jamais sur « Son ». Une
        # page qu'on n'ouvre pas peut cesser de s'afficher sans qu'une seule
        # étape ne rougisse, exactement comme une application qu'on n'ouvre
        # pas. La page est construite au démarrage, donc cette lecture a lieu
        # même quand on ne la regarde pas : autant qu'elle parle.
        grenosui.dire(
            "reglages son : %d profils ALSA, carte %s, decodeur %s, %d pilotes video"
            % (lu["profils_alsa"], lu["carte"] or "aucune",
               "present" if lu["decodeur"] else "absent", lu["pilotes_video"]))
        # Le mélangeur sur sa propre ligne : c'est celle qu'on ira chercher le
        # jour où quelqu'un dira « pas de son », et elle doit se lire seule.
        grenosui.dire(
            "reglages son : melangeur %s"
            % (", ".join("%s %s %s" % (c["nom"],
                                       "?" if c["niveau"] is None else "%d%%" % c["niveau"],
                                       "COUPE" if c["coupe"] else "ouvert")
                         for c in lu.get("melangeur", [])) or "illisible"))
        # Et la sortie, sur sa propre ligne elle aussi. Celle-ci est nouvelle,
        # et c'est la seule qui puisse trancher entre « la carte est muette »
        # et « le son va ailleurs » — deux pannes qui donnent exactement le
        # même silence et qui n'ont rien à voir.
        grenosui.dire("reglages son : sortie — %s" % verdict_sortie)
        return False

    def changer_sortie(self, combo):
        index = combo.get_active()
        if 0 <= index < len(self.sorties_son):
            module_son.choisir_sortie(self.sorties_son[index][0])

    # ---- Le réseau ---------------------------------------------------------
    def page_reseau(self):
        etat = "inconnu"
        try:
            etat = subprocess.run(["nmcli", "-t", "-f", "STATE", "general"],
                                  capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
        lisible = {"connected": "connecté", "disconnected": "déconnecté",
                   "connecting": "connexion en cours"}.get(etat, etat or "inconnu")

        return self.enveloppe(
            grenosui.titre("Réseau", f"État : {lisible}."),
            grenosui.carte(
                self.ligne("Connexions",
                           grenosui.bouton("Gérer les connexions",
                                           lambda: grenosui.lancer("nm-connection-editor"),
                                           "principal")),
                self.note("Wi-Fi, câble, partage de connexion : tout se règle là. "
                          "Dans une machine virtuelle, le réseau passe par l'hôte et "
                          "fonctionne sans rien configurer."),
            ),
        )

    # ---- Le compte ---------------------------------------------------------
    def page_compte(self):
        self.protege = a_un_mot_de_passe(self.login)
        etat = ("Cette machine demande un mot de passe pour ouvrir la session."
                if self.protege else
                "Cette machine s'ouvre sans mot de passe : un clic suffit.")

        self.mot1 = Gtk.Entry(visibility=False)
        self.mot1.set_placeholder_text("Nouveau mot de passe")
        self.mot2 = Gtk.Entry(visibility=False)
        self.mot2.set_placeholder_text("Le même, pour être sûr")
        self.dire_compte = Gtk.Label(label="", xalign=0)
        self.dire_compte.get_style_context().add_class("sous")

        boutons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        boutons.pack_start(grenosui.bouton("Enregistrer", self.definir_mot, "principal"),
                           False, False, 0)
        if self.protege:
            boutons.pack_start(grenosui.bouton("Retirer le mot de passe", self.effacer_mot,
                                               "discret"), False, False, 0)

        return self.enveloppe(
            grenosui.titre("Compte",
                           f"{grenosui.adresse()} — "
                           f"{self.identite.get('nom') or 'sans nom affiché'}"),
            grenosui.carte(
                self.note(etat),
                self.mot1, self.mot2, boutons, self.dire_compte,
                self.note("Un mot de passe protège aussi l'installation de logiciels "
                          "et les réglages du système."),
            ),
        )

    def definir_mot(self):
        premier, second = self.mot1.get_text(), self.mot2.get_text()
        if len(premier) < 4:
            self.dire_compte.set_text("Quatre caractères au minimum.")
            return
        if premier != second:
            self.dire_compte.set_text("Les deux ne sont pas identiques.")
            return
        resultat = en_root(["definir", self.login], entree=premier + "\n")
        if resultat.returncode == 0:
            self.protege = True
            self.mot1.set_text("")
            self.mot2.set_text("")
            self.dire_compte.set_text("C'est fait. Il sera demandé à la prochaine ouverture.")
        else:
            self.dire_compte.set_text(resultat.stderr.strip() or "Le système a refusé.")

    def effacer_mot(self):
        resultat = en_root(["effacer", self.login])
        if resultat.returncode == 0:
            self.protege = False
            self.dire_compte.set_text("Retiré : la session s'ouvrira toute seule.")
        else:
            self.dire_compte.set_text(resultat.stderr.strip() or "Le système a refusé.")

    # ---- Les mises à jour --------------------------------------------------
    def page_maj(self):
        version = "grenOS"
        try:
            with open("/etc/os-release", encoding="utf-8") as fichier:
                for ligne in fichier:
                    if ligne.startswith("PRETTY_NAME="):
                        version = ligne.split("=", 1)[1].strip().strip(chr(34))
        except OSError:
            pass

        # Tout se passe dans cette page : ni autre fenêtre, ni terminal. Le
        # travail tourne derrière, et cette page raconte ce qu'il fait.
        self.etat_maj = Gtk.Label(label="Prêt.", xalign=0)
        self.barre_maj = Gtk.ProgressBar()
        self.bouton_maj = grenosui.bouton("Vérifier et préparer",
                                          self.lancer_maj, "principal")

        self.details_maj = Gtk.Expander(label="Voir le détail")
        vue = Gtk.ScrolledWindow()
        vue.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        vue.set_size_request(-1, 180)
        self.texte_maj = Gtk.TextView()
        self.texte_maj.set_editable(False)
        self.texte_maj.set_monospace(True)
        vue.add(self.texte_maj)
        self.details_maj.add(vue)

        self.travail_maj = module_maj.Travail(
            lambda t: GLib.idle_add(self.etat_maj.set_text, t),
            lambda p: GLib.idle_add(self.barre_maj.set_fraction, min(max(p, 0.0), 1.0)),
            self.journal_maj, self.fin_maj)

        # Ce que la verification quotidienne a trouve, et le reglage qui decide
        # si la machine se met a jour toute seule.
        attendus = module_maj.disponibles()
        quand = module_maj.derniere_verification()
        if attendus is None:
            resume = "Aucune vérification depuis le démarrage, ou pas de réseau."
        elif attendus == 0:
            resume = f"Rien à installer. Dernière vérification : {quand} UTC."
        else:
            resume = (f"{attendus} paquet{'s' if attendus > 1 else ''} à installer. "
                      f"Vérifié le {quand} UTC.")

        self.auto_maj = Gtk.Switch()
        self.auto_maj.set_active(module_maj.automatique())
        self.auto_maj.connect("notify::active", self.changer_auto_maj)
        self.dire_auto = Gtk.Label(label="", xalign=0)
        self.dire_auto.get_style_context().add_class("sous")

        return self.enveloppe(
            grenosui.titre("Mises à jour", version),
            grenosui.carte(
                self.note(resume),
                self.ligne("Installer automatiquement, chaque jour", self.auto_maj),
                grenosui.bouton("Vérifier maintenant", self.verifier_maj, "discret"),
                self.dire_auto,
                self.note("La vérification quotidienne ne fait que regarder : rien ne "
                          "s'installe sans que tu le demandes, sauf si tu actives "
                          "l'installation automatique ci-dessus."),
            ),
            grenosui.carte(
                self.etat_maj, self.barre_maj, self.bouton_maj, self.details_maj,
                self.note("Les nouveautés de grenOS et les correctifs de sécurité de "
                          "Debian arrivent ensemble, sans jamais retélécharger l'image. "
                          "Les nouveaux paquets dont le système a besoin sont installés "
                          "aussi — un pilote de son, par exemple."),
            ),
            grenosui.carte(
                self.ligne("Applications",
                           grenosui.bouton("Ouvrir GrenPlace",
                                           lambda: grenosui.lancer("grenplace"))),
                self.note("Les applications installées depuis GrenPlace se mettent à "
                          "jour avec le reste du système."),
            ),
        )

    def changer_auto_maj(self, interrupteur, _param):
        souci = module_maj.regler_automatique(interrupteur.get_active())
        self.dire_auto.set_text(
            souci or ("Les mises à jour s'installeront toutes seules, chaque jour."
                      if interrupteur.get_active()
                      else "Les mises à jour ne s'installeront plus toutes seules."))

    def verifier_maj(self):
        self.dire_auto.set_text("Vérification en cours…")
        souci = module_maj.verifier_maintenant()
        nombre = module_maj.disponibles()
        if souci:
            self.dire_auto.set_text(souci)
        elif nombre:
            self.dire_auto.set_text(
                f"{nombre} paquet{'s' if nombre > 1 else ''} à installer.")
        else:
            self.dire_auto.set_text("Rien à installer : tout est à jour.")

    def journal_maj(self, ligne):
        def ajouter():
            tampon = self.texte_maj.get_buffer()
            tampon.insert(tampon.get_end_iter(), ligne + chr(10))
            return False
        GLib.idle_add(ajouter)

    def lancer_maj(self):
        # Les deux fenêtres qui mettent à jour — celle-ci et `grenos-maj` —
        # suivent la même suite : préparer, puis redémarrer. Elles partagent le
        # même `Travail` et le même service d'avant-bureau ; seul l'habillage
        # diffère.
        if getattr(self, "redemarrer_ensuite", False):
            grenosui.lancer("systemctl reboot")
            return
        if self.travail_maj.demarrer():
            self.bouton_maj.set_sensitive(False)
            self.bouton_maj.get_child().get_children()[-1].set_text("En cours…")

    def fin_maj(self, message, bien):
        def remettre():
            self.etat_maj.set_text(message)
            self.bouton_maj.set_sensitive(True)
            etiquette = self.bouton_maj.get_child().get_children()[-1]
            # On demande à systemd, pas au texte du message : une phrase qu'on
            # relit pour décider d'une action est un drapeau déguisé.
            if bien and module_maj.redemarrage_arme():
                etiquette.set_text("Redémarrer maintenant")
                self.redemarrer_ensuite = True
            else:
                etiquette.set_text("Vérifier et préparer")
                self.redemarrer_ensuite = False
            if not bien:
                self.details_maj.set_expanded(True)
            return False
        GLib.idle_add(remettre)

    # ---- L'heure -------------------------------------------------------------
    def page_heure(self):
        etat = module_heure.etat()
        self.dire_heure = Gtk.Label(label="", xalign=0)
        self.dire_heure.get_style_context().add_class("sous")

        self.choix_fuseau = Gtk.ComboBoxText()
        self.liste_fuseaux = module_heure.fuseaux()
        for index, nom in enumerate(self.liste_fuseaux):
            self.choix_fuseau.append_text(nom)
            if nom == etat["fuseau"]:
                self.choix_fuseau.set_active(index)
        if self.choix_fuseau.get_active() < 0 and self.liste_fuseaux:
            self.choix_fuseau.set_active(0)
        self.choix_fuseau.connect("changed", self.changer_fuseau)

        self.auto_heure = Gtk.Switch()
        self.auto_heure.set_active(etat["automatique"])
        self.auto_heure.connect("notify::active", self.changer_auto)

        self.champ_heure = Gtk.Entry()
        self.champ_heure.set_placeholder_text("2026-09-23 18:30:00")

        return self.enveloppe(
            grenosui.titre("Heure et date",
                           "Réglée par le réseau, ou à la main."),
            grenosui.carte(
                self.ligne("Fuseau horaire", self.choix_fuseau),
                self.ligne("Mise à l'heure automatique", self.auto_heure),
                self.dire_heure,
                self.note("Avec la mise à l'heure automatique, la machine demande "
                          "l'heure au réseau et n'en dévie jamais. Sans réseau, "
                          "désactive-la et règle-la toi-même."),
            ),
            grenosui.carte(
                self.ligne("Régler à la main", self.champ_heure),
                grenosui.bouton("Appliquer cette heure", self.regler_heure),
                self.note("Format : année-mois-jour heures:minutes:secondes."),
            ),
        )

    def changer_fuseau(self, combo):
        nom = combo.get_active_text()
        if not nom:
            return
        souci = module_heure.choisir_fuseau(nom)
        self.dire_heure.set_text(souci or f"Fuseau : {nom}.")

    def changer_auto(self, interrupteur, _param):
        souci = module_heure.horloge_automatique(interrupteur.get_active())
        self.dire_heure.set_text(
            souci or ("L'heure se règle toute seule." if interrupteur.get_active()
                      else "L'heure ne se règle plus toute seule."))

    def regler_heure(self):
        texte = self.champ_heure.get_text().strip()
        if not texte:
            self.dire_heure.set_text("Écris une date et une heure.")
            return
        souci = module_heure.regler(texte)
        self.dire_heure.set_text(souci or f"Heure réglée sur {texte}.")

    # ---- Le matériel -------------------------------------------------------
    def page_materiel(self):
        infos = materiel.resume()
        virtuelle = infos["virtuelle"]

        lignes = [
            self.ligne("Processeur", Gtk.Label(label=f"{infos['coeurs']} cœurs")),
            self.ligne("Modèle", Gtk.Label(label=infos["processeur"][:52])),
            self.ligne("Mémoire vive",
                       Gtk.Label(label=f"{grenosui.nombre(infos['memoire'])} Go "
                                       f"({grenosui.nombre(infos['memoire_libre'])}"
                                       " Go libres)")),
            self.ligne("Carte graphique", Gtk.Label(label=infos["carte"][:52])),
            self.ligne("Pilote", Gtk.Label(label=infos["pilote"][:52])),
            self.ligne("Système sur",
                       Gtk.Label(label=f"{infos['disque']:.0f} Go "
                                       f"({infos['disque_libre']:.0f} Go libres)")),
        ]

        # Tous les disques, un par ligne.
        #
        # La page n'en montrait qu'un : celui qui porte la racine. Quelqu'un
        # avec deux disques en voyait donc un seul ici, alors que
        # l'installateur, lui, lui en proposait deux — de quoi douter de l'un
        # ou de l'autre au pire moment, juste avant d'effacer quelque chose.
        vus = infos.get("disques") or []
        for index, disque_vu in enumerate(vus):
            nom = disque_vu["modele"] or disque_vu["nom"]
            lignes.append(self.ligne(
                "Disque" if index == 0 and len(vus) == 1 else f"Disque {index + 1}",
                Gtk.Label(label=f"{nom[:34]} — "
                                f"{materiel.genre_du_disque(disque_vu)} "
                                f"({disque_vu['nom']})")))
        if not vus:
            lignes.append(self.ligne(
                "Disques",
                Gtk.Label(label="aucun disque vu : rien à installer dessus")))

        explication = ("grenOS utilise d'office tout ce que la machine lui donne : "
                       "tous les cœurs, toute la mémoire, toute la mémoire vidéo. "
                       "Il n'y a rien à débloquer.")
        if len(vus) > 1:
            explication += ("\n\nCette machine a plusieurs disques. L'installateur "
                            "les propose tous et demande lequel prendre : il "
                            "n'efface jamais avant que tu aies choisi.")
        if virtuelle:
            explication += (f"\n\nCette machine est virtuelle ({virtuelle}) : c'est l'hôte "
                            "qui décide de ce qu'elle voit. Pour lui en donner plus, "
                            "éteins-la et augmente la mémoire, les processeurs et la "
                            "mémoire vidéo dans les réglages de la machine.")

        return self.enveloppe(
            grenosui.titre("Matériel", "Ce que la machine a, et ce que grenOS en voit."),
            grenosui.carte(*lignes),
            grenosui.carte(self.note(explication)),
        )


def main():
    # La session appelle cette forme au démarrage : elle ne montre rien, elle
    # remet seulement l'écran dans la définition choisie la dernière fois.
    if len(sys.argv) > 1 and sys.argv[1] == "--restaurer-ecran":
        module_ecran.restaurer()
        return

    page = sys.argv[1] if len(sys.argv) > 1 else ""
    grenosui.habiller()
    fenetre = Reglages(page)
    fenetre.show_all()
    # Les Réglages sont la porte des mises à jour et du son, et la machine
    # d'intégration ne les avait jamais ouverts : ils auraient pu ne plus
    # démarrer du tout sans qu'une seule étape ne rougisse. Huit pages
    # construites, c'est huit occasions qu'une exception passe inaperçue.
    grenosui.dire("reglages ouvert, %d pages" % len(fenetre.pages.get_children()))
    Gtk.main()


if __name__ == "__main__":
    main()
