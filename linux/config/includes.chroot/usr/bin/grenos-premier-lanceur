#!/bin/sh
# Le premier écran : la nouvelle interface, et l'ancienne en filet.
#
# Lancé par `grenos-premier-x`, à l'intérieur du serveur X éphémère.
#
# grenos-ui (Rust/Tauri) est l'assistant qu'on montre. Mais c'est le SEUL
# programme dont une panne empêche d'entrer dans la machine, et un moteur web
# a des façons de tomber qu'un programme GTK n'a pas : une carte graphique qui
# laisse une fenêtre blanche, une bibliothèque absente sur une machine mise à
# jour. Deux filets, donc :
#
#   1. grenos-ui doit dire qu'il est affiché (/run/grenos/premier-ui-pret) en
#      moins de deux minutes, sinon on l'arrête ;
#   2. s'il se termine sans que la machine ait de nom (/etc/grenos/identite),
#      l'assistant Python prend le relais.
#
# Dans les deux cas, la personne finit devant un assistant qui marche.

set -u

PRET=/run/grenos/premier-ui-pret

dire() {
    echo "grenos: $1" > /dev/ttyS0 2>/dev/null || true
    echo "grenos-premier: $1" >&2
}

# L'ÉCRAN EST-IL LISIBLE ? (20 novembre) — la moitié « confirmer » du filet
# des RTX 50 (voir grenos-affichage-garde et grenos-nouveau-ou-pas). Quand un
# essai est armé, quitter l'écran de bienvenue prouve qu'on le voit : on
# garde « nouveau » et le service de garde n'aura rien à faire. Sans essai
# armé, ce bloc ne fait rien.
ETAT=/usr/lib/grenos/grenos-affichage-etat

ecran_confirme() {
    "$ETAT" existe affichage-essai 2>/dev/null || return 0
    "$ETAT" effacer affichage-essai 2>/dev/null
    "$ETAT" ecrire affichage nouveau 2>/dev/null
    dire "ecran : lisible, la personne a passe le premier ecran — nouveau garde sur cette machine"
}

GARDE=""
if [ -x "$ETAT" ] && "$ETAT" existe affichage-essai 2>/dev/null; then
    (
        while sleep 3; do
            if journalctl -b -q -o cat -u grenos-premier.service 2>/dev/null | grep -q 'premier : ecran .*(2/'; then
                ecran_confirme
                exit 0
            fi
        done
    ) &
    GARDE=$!
fi

if [ -x /usr/bin/grenos-ui ]; then
    rm -f "$PRET"
    mkdir -p /run/grenos /run/user/0
    chmod 0700 /run/user/0
    # Root sous systemd n'a ni dossier d'exécution ni bus d'accessibilité :
    # WebKit attendrait l'un et chercherait l'autre.
    export XDG_RUNTIME_DIR=/run/user/0 HOME=/root NO_AT_BRIDGE=1
    # Le curseur du bureau, dès l'assistant (21 novembre : « utiliser la
    # souris dans l'OOBE ») — root n'a pas de thème à lui. grenos-ui le pose
    # au milieu de sa fenêtre une fois affiché (premier_pret).
    export XCURSOR_THEME=Breeze_Light XCURSOR_SIZE=24
    xsetroot -cursor_name left_ptr 2>/dev/null || true

    dire "premier ecran : le programme demarre (grenos-ui)"
    /usr/bin/grenos-ui premier &
    UI=$!

    ATTENTE=0
    while kill -0 "$UI" 2>/dev/null && [ ! -e "$PRET" ] && [ "$ATTENTE" -lt 120 ]; do
        sleep 1
        ATTENTE=$((ATTENTE + 1))
    done

    if [ -e "$PRET" ]; then
        dire "premier : grenos-ui affiche en ${ATTENTE}s"
        # Second filet (le premier est dans premier.rs) : une fois la machine
        # nommée, l'interface a trente secondes pour se fermer. Sans cela, une
        # page figée après « choix gardes » laissait le bureau ne jamais venir
        # (vu deux fois en CI le 18 novembre).
        APRES=0
        while kill -0 "$UI" 2>/dev/null; do
            if [ -e /etc/grenos/identite ]; then
                APRES=$((APRES + 1))
                if [ "$APRES" -ge 30 ]; then
                    dire "premier : grenos-ui toujours ouvert 30 s apres le nom — on le ferme"
                    kill "$UI" 2>/dev/null; sleep 1; kill -9 "$UI" 2>/dev/null
                    break
                fi
            fi
            sleep 1
        done
        wait "$UI" 2>/dev/null
    else
        dire "premier : grenos-ui ne s est pas affiche en ${ATTENTE}s — secours python"
        kill "$UI" 2>/dev/null
        sleep 1
        kill -9 "$UI" 2>/dev/null
    fi

    if [ -e /etc/grenos/identite ]; then
        # L'assistant est allé au bout : l'écran se lisait.
        [ -n "$GARDE" ] && kill "$GARDE" 2>/dev/null
        ecran_confirme
        exit 0
    fi
    dire "premier : grenos-ui s est termine sans nommer la machine — secours python"
fi

# INSTALLÉ PAR NOTRE INSTALLATEUR (22 novembre) : compte, clavier et mot de
# passe sont déjà posés. Le secours Python les redemanderait, et il finit par
# `passwd -d` : il EFFACERAIT le mot de passe choisi. La machine est nommée
# avec ce qui a été choisi ; le reste se règle dans les Réglages.
CHOISI=/etc/grenos/preinstallation
if [ -r "$CHOISI" ]; then
    LOGIN=$(sed -n 's/^login=//p' "$CHOISI" | head -n 1)
    if [ -n "$LOGIN" ] && getent passwd "$LOGIN" >/dev/null 2>&1; then
        [ -n "$GARDE" ] && kill "$GARDE" 2>/dev/null
        cp "$CHOISI" /etc/grenos/identite
        dire "premier : assistant non termine — compte de l installation repris, sans toucher au mot de passe"
        exit 0
    fi
fi

# Le secours Python n'écrit rien au journal : seul son aboutissement (la
# machine nommée) confirme l'écran. Le service de garde est SUSPENDU — il ne
# redémarrera pas la machine au milieu de l'assistant — et le témoin d'essai
# reste : une coupure au bouton fera prendre l'image du firmware au
# démarrage suivant.
[ -n "$GARDE" ] && kill "$GARDE" 2>/dev/null
mkdir -p /run/grenos && : > /run/grenos/affichage-garde-suspendu
/usr/bin/grenos-premier
code=$?
[ -e /etc/grenos/identite ] && ecran_confirme
exit "$code"
