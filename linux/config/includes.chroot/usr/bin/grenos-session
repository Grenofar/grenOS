#!/bin/sh
# La session grenOS : ce qui démarre quand on ouvre le bureau.
#
# L'ordre compte. D'abord la langue et l'écran (pas d'économiseur, pas de mise
# en veille : dans une machine virtuelle, un écran qui s'éteint passe pour un
# plantage), puis le bureau et ses icônes, puis les services discrets, puis
# notre barre, et enfin le gestionnaire de fenêtres au premier plan — c'est lui
# qui tient la session : quand il s'arrête, la session se ferme.
#
# Rien ici ne compose l'écran. Pas d'ombres calculées par le GPU, pas de
# transparence : c'est ce qui rend le pointeur fluide sur une machine sans
# accélération 3D.

export XDG_CURRENT_DESKTOP=grenOS
export XDG_SESSION_DESKTOP=grenos
export XDG_MENU_PREFIX=grenos-
# Les applications GTK suivent le thème du système, pas leurs propres couleurs.
export GTK_OVERLAY_SCROLLING=0

# La langue du système. lightdm ne la transmet pas à la session : sans ces
# lignes, l'horloge de la barre affiche « Fri 18 Sep » au lieu de
# « ven. 18 sept. », et les applications s'ouvrent en anglais.
if [ -r /etc/default/locale ]; then
    . /etc/default/locale
    export LANG LANGUAGE LC_ALL LC_TIME 2>/dev/null || true
fi

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/grenos"
mkdir -p "$CONFIG" "$HOME/Bureau"

# Les dossiers en français, écrits avant que quoi que ce soit ne les demande.
# Sans cela, les applications cherchent ~/Desktop — vide — pendant que les
# raccourcis attendent dans ~/Bureau.
# La langue est FORCÉE sur cet appel, et pas seulement héritée.
#
# Le dossier « TÃ©lÃ©chargements » vu sur la capture vient de là : l'outil lit
# un fichier de référence en UTF-8 et le convertit depuis le jeu de caractères
# de la locale courante. Dans la locale C, chaque octet accentué en devient
# deux. L'appel de Debian, au démarrage de session, est neutralisé par
# `/etc/xdg/autostart/xdg-user-dirs.desktop` ; celui-ci est le seul qui reste,
# et il ne dépend plus de ce que l'environnement a bien voulu transmettre.
command -v xdg-user-dirs-update >/dev/null 2>&1 \
    && LANG=fr_FR.UTF-8 LC_ALL=fr_FR.UTF-8 xdg-user-dirs-update 2>/dev/null

# Et on retire le dossier abîmé s'il en reste un, mais seulement s'il est vide.
# Ce qu'on y aurait mis appartient à la personne.
if [ -d "$HOME/TÃ©lÃ©chargements" ] && [ -z "$(ls -A "$HOME/TÃ©lÃ©chargements" 2>/dev/null)" ]; then
    rmdir "$HOME/TÃ©lÃ©chargements" 2>/dev/null \
        && grenos-dire "dossier au nom abime retire"
fi

# Et on DIT ce que le compte contient : un nom abîmé se voit sur une capture,
# mais seulement si quelqu'un la regarde. Sur le port série, il se cherche.
grenos-dire "dossiers du compte : $(ls -1 "$HOME" 2>/dev/null | tr '\n' ' ')"

# Le témoin de la persistance : une ligne, écrite dans le dossier de la
# personne, relue au démarrage suivant par `grenos-preuve`.
#
# « Tout ce que tu fais est gardé sur le disque de la machine » est écrit sur
# la page de téléchargement. On prouvait que live-boot avait trouvé sa
# partition — pas qu'un fichier écrit un jour soit encore là le lendemain. Une
# machine d'essai qui ne démarre qu'une fois ne peut pas répondre ; celle-ci
# démarre une seconde fois pour l'essai UEFI, et c'est là qu'on lira.
#
# `sync` n'est pas une précaution de style : la machine d'essai est tuée, pas
# éteinte proprement, et un cache non vidé donnerait « rien n'a été gardé »
# alors que la persistance marche.
# Le témoin porte l'identifiant du DÉMARRAGE, pas seulement une heure.
#
# Première version : une date. Elle a donné une preuve qui se trompait dans le
# bon sens — le premier démarrage annonçait lui aussi « un fichier du démarrage
# précédent est revenu ». Il ne le pouvait pas : `grenos-preuve` attend jusqu'à
# quatre-vingt-dix secondes sur Flathub avant d'arriver à ce contrôle, et la
# session a écrit le témoin entre-temps. Chaque démarrage relisait le sien.
#
# C'est la quatrième mesure de la semaine à répondre parfaitement à une
# question qu'on ne lui avait pas posée. `boot_id` la rend indiscutable : le
# noyau en tire un neuf à chaque démarrage, donc un témoin qui en porte un
# autre vient forcément d'avant.
printf '%s %s\n' "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" \
    "$(date -u '+%Y-%m-%d %H:%M:%S UTC')" \
    > "$CONFIG/temoin-persistance" 2>/dev/null || true
sync 2>/dev/null || true
export XDG_DESKTOP_DIR="$HOME/Bureau"

# Les dossiers usuels dans « Emplacements », comme le volet de gauche de
# Windows.
#
# Grenofar : « que l'explorateur soit encore plus proche de celui de Windows
# (ce PC, documents, vidéos etc) ». « Poste de travail », le bureau et la
# corbeille viennent de `libfm.conf` ; Documents, Images, Musique, Vidéos et
# Téléchargements, non — libfm ne connaît pas ces dossiers, il n'affiche que
# les **marque-pages** de GTK.
#
# Ils ne peuvent pas être livrés dans `/etc/skel` : un marque-page porte un
# chemin ABSOLU, donc il faut connaître le nom du compte, qui n'existe qu'ici.
# Écrit une seule fois : après, cette liste appartient à la personne, et un
# système qui la réécrit à chaque ouverture lui reprend ce qu'elle a rangé.
MARQUES="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/bookmarks"
if [ ! -e "$MARQUES" ]; then
    mkdir -p "$(dirname "$MARQUES")"
    # L'ordre est celui de Windows, pas l'alphabétique : Téléchargements en
    # tête, parce que c'est le dossier qu'on ouvre le plus souvent, puis
    # Documents, Images, Musique, Vidéos. C'est la seule partie de ce volet
    # dont nous décidons — le reste appartient à libfm.
    for DOSSIER in Téléchargements Documents Images Musique Vidéos; do
        [ -d "$HOME/$DOSSIER" ] || continue
        printf 'file://%s %s\n' "$HOME/$DOSSIER" "$DOSSIER" >> "$MARQUES"
    done
    grenos-dire "emplacements : $(wc -l < "$MARQUES" 2>/dev/null) marque-pages poses"
fi

# L'écran reste allumé, et le pointeur est une flèche dès la première seconde.
xset s off -dpms s noblank 2>/dev/null || true
xsetroot -cursor_name left_ptr 2>/dev/null || true

# La définition choisie dans les Réglages est réappliquée.
grenos-parametres --restaurer-ecran 2>/dev/null || true

# L'installation sur le disque n'a de sens que sur une vraie machine. Dans une
# machine virtuelle, le disque garde déjà tout, et proposer d'installer
# par-dessus ne ferait qu'inquiéter : on retire l'entrée du menu pour ce
# compte, sans toucher au système.
VIRTUELLE=$(systemd-detect-virt 2>/dev/null || echo none)
mkdir -p "$HOME/.local/share/applications"
if [ "$VIRTUELLE" = "none" ]; then
    rm -f "$HOME/.local/share/applications/grenos-installer.desktop"
    if [ ! -e "$HOME/Bureau/grenos-installer.desktop" ] && \
       [ ! -e "$CONFIG/installer-pose" ]; then
        cp /usr/share/applications/grenos-installer.desktop "$HOME/Bureau/" 2>/dev/null || true
        chmod +x "$HOME/Bureau/grenos-installer.desktop" 2>/dev/null || true
        touch "$CONFIG/installer-pose"
    fi
else
    rm -f "$HOME/Bureau/grenos-installer.desktop"
    printf '[Desktop Entry]\nType=Application\nName=Installer grenOS\nNoDisplay=true\nExec=pkexec calamares\n' \
        > "$HOME/.local/share/applications/grenos-installer.desktop"
fi

# Le pointeur des machines virtuelles : sans ce petit service, il colle au bord
# de la fenêtre et il faut « libérer » le clavier pour en sortir.
command -v spice-vdagent >/dev/null 2>&1 && spice-vdagent 2>/dev/null &
command -v vmware-user-suid-wrapper >/dev/null 2>&1 && vmware-user-suid-wrapper 2>/dev/null &

# Les autorisations : installer un paquet ouvre une fenêtre qui demande.
for agent in /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 \
             /usr/libexec/polkit-mate-authentication-agent-1; do
    if [ -x "$agent" ]; then
        "$agent" &
        break
    fi
done

# La touche Windows ouvre le menu grenOS, comme sur Windows.
#
# Pourquoi un programme a part plutot qu'une ligne dans openbox : openbox ne
# declenche une action que sur une **combinaison**. Lier « Super_L » tout seul
# ferait ouvrir le menu aussi pour Super+T, Super+E et les six autres raccourcis
# qui commencent par Super — la touche partirait avant la seconde.
#
# `xcape` sait faire la difference : il n'emet quelque chose que si la touche
# est relachee SANS qu'aucune autre n'ait ete pressee entre-temps. On lui fait
# emettre Ctrl+Echap, qui ouvre deja le menu et que la CI verifie a chaque
# construction — autant reutiliser le chemin qui est prouve plutot que d'en
# ouvrir un second.
if command -v xcape >/dev/null 2>&1; then
    xcape -e 'Super_L=Control_L|Escape' 2>/dev/null &
    grenos-dire "touche windows branchee sur le menu"
else
    grenos-dire "touche windows : xcape absent, la touche ne fera rien"
fi

# Le bureau : le fond d'écran et ce qu'on pose dessus.
grenos-veilleur grenos-bureau &

# La preuve, pour la CI et pour les journaux : un bureau s'est vraiment ouvert.
echo "$(date -u +%H:%M:%S) $USER" > /tmp/grenos-session 2>/dev/null || true

# Notre barre. Si elle tombe, elle revient : un bureau sans barre est un bureau
# perdu, et une session qui se ferme ferait perdre le travail en cours.
grenos-veilleur grenos-shell &

# Le son, une fois PipeWire debout : combien de sorties, et laquelle. Sans
# cette ligne, « aucune sortie détectée » dans les Réglages ne permet pas de
# distinguer une panne d'un ordinateur sans carte son.
(
    # --- D'ABORD : le mélangeur ALSA n'est-il pas simplement COUPÉ ? --------
    #
    # Grenofar, le 27 au matin, après avoir installé la mise à jour : « le son
    # fonctionne toujours pas ». Les cinq corrections de la nuit — rtkit, les
    # limites aux deux étages, module-rt, le tampon à 2048, memlock — visaient
    # un son qui *hache*. Aucune ne peut faire sortir un son d'une carte dont
    # le canal Master est coupé.
    #
    # Et rien, nulle part, ne le démontait. `grenos-preuve` disait même
    # « alsactl présent, le mélangeur sera restauré au démarrage » : c'est une
    # promesse sans rien derrière, exactement comme la règle polkit qui nommait
    # une action inexistante et comme `partition.conf` qui offrait btrfs sans
    # `mkfs.btrfs`. `alsactl restore` restaure un état **enregistré**, et une
    # image live n'en a aucun. Une carte HDA — celle que VirtualBox donne —
    # démarre couramment avec Master à zéro et coupé : silence total, sous une
    # pile logicielle impeccable.
    #
    # La CI ne pouvait pas le voir : le mélangeur d'`intel-hda` sous QEMU sort
    # ouvert, donc elle entendait un son et disait vrai. C'est le maillon exact
    # qui reste invisible ici et qu'il fallait aller chercher.
    #
    # On ne le fait qu'UNE fois. Après, le volume appartient à la personne :
    # un système qui remonte le son à chaque ouverture de session est
    # insupportable, et le sien est gardé par la persistance.
    if [ ! -e "$CONFIG/melangeur-ouvert" ] && command -v amixer >/dev/null 2>&1; then
        OUVERTS=""
        for CARTE in $(sed -n 's/^ *\([0-9]\+\) \[.*/\1/p' /proc/asound/cards 2>/dev/null); do
            for CANAL in Master PCM Speaker Headphone Front "Analog Output"; do
                ETAT=$(amixer -c "$CARTE" sget "$CANAL" 2>/dev/null) || continue
                [ -n "$ETAT" ] || continue
                # On ne touche QUE ce qui est coupé ou à zéro.
                #
                # La première version posait tous les canaux à 80 %, coupés ou
                # non. La machine d'intégration l'a dit tout de suite, mais
                # dans un chiffre et non dans une étape rouge : la crête du son
                # enregistré est tombée de 10 584 à 2 215 sur 32 767. Un
                # amplificateur HDA est gradué en décibels — 100 % à 80 %, ce
                # sont une douzaine de dB, donc un son cinq fois plus faible.
                #
                # Autrement dit, en réparant le silence de Grenofar j'aurais
                # baissé le son de tous ceux chez qui il marchait. Un système
                # qui touche à un réglage correct « pour aider » est un système
                # qui ment sur ce qu'il fait.
                COUPE=$(printf '%s' "$ETAT" | grep -c '\[off\]' || true)
                NIVEAU=$(printf '%s' "$ETAT" | sed -n 's/.*\[\([0-9]\+\)%\].*/\1/p' | head -1)
                if [ "$COUPE" -gt 0 ]; then
                    amixer -q -c "$CARTE" sset "$CANAL" unmute >/dev/null 2>&1 || true
                    OUVERTS="$OUVERTS $CANAL(rallume)"
                fi
                if [ -n "$NIVEAU" ] && [ "$NIVEAU" -lt 5 ]; then
                    amixer -q -c "$CARTE" sset "$CANAL" 80% >/dev/null 2>&1 || true
                    OUVERTS="$OUVERTS $CANAL(remonte)"
                fi
            done
        done
        touch "$CONFIG/melangeur-ouvert"
        if [ -n "$OUVERTS" ]; then
            grenos-dire "son : melangeur corrige au premier demarrage —$OUVERTS"
            # Et on l'enregistre, pour que le prochain démarrage le retrouve :
            # c'est ce que la ligne de `grenos-preuve` promettait sans que rien
            # n'ait jamais écrit l'état qu'elle prétendait restaurer.
            alsactl store >/dev/null 2>&1 || true
        else
            grenos-dire "son : melangeur deja ouvert, rien touche"
        fi
    fi

    # PipeWire demarre par socket, a la demande : on le reveille plutot que
    # d'esperer que quelqu'un d'autre le fasse.
    systemctl --user start pipewire.socket pipewire-pulse.socket 2>/dev/null
    systemctl --user start wireplumber.service 2>/dev/null
    sleep 12
    SORTIES=$(pactl list short sinks 2>/dev/null | wc -l)
    COURANTE=$(pactl info 2>/dev/null | sed -n 's/^Default Sink: //p')
    grenos-dire "son, $SORTIES sorties, courante ${COURANTE:-aucune}"

    # PipeWire tourne-t-il en TEMPS REEL ? C'est la mesure qui manquait.
    #
    # Grenofar : « on entend des bom bom bom quand y'a la video ». Le son
    # sortait ; il hachait. Un son qui hache sous charge veut dire que PipeWire
    # n'est pas servi a temps et que son tampon se vide. Or `rtkit`, qui lui
    # donne le droit de passer devant, n'est que RECOMMANDE par pipewire-bin :
    # il etait absent, et rien ne le disait.
    #
    # `chrt` lit la politique d'ordonnancement du noyau. FIFO ou RR : PipeWire
    # est prioritaire, il tiendra sous charge. OTHER : il fait la queue comme
    # le decodeur video, et ca hoquettera des que la machine peine.

    # Et maintenant on JOUE. Compter les sorties prouve que PipeWire repond ;
    # cela ne prouve pas qu'un son sort, et c'est toute la difference entre ce
    # qu'on croyait savoir et ce que Grenofar a entendu — rien.
    #
    # Le fichier vient d'alsa-utils (verifie dans le .deb), et paplay de
    # pulseaudio-utils : les deux sont sur l'image. On passe par paplay, donc
    # par PipeWire, pour exercer la chaine entiere plutot qu'ALSA seul.
    # Notre son a nous, et pourquoi il a remplace celui d'alsa-utils.
    #
    # On jouait `Front_Center.wav` : une voix qui dit « Front Centre ». Deux
    # defauts, et le second a coute une mesure entiere.
    #
    #   1. c'est une phrase en anglais qui sort des enceintes a chaque
    #      ouverture de session, ce que personne n'a demande ;
    #   2. une voix SE TAIT entre les syllabes. La machine d'integration compte
    #      les trous dans le son enregistre pour reperer un hoquet, et elle a
    #      rapporte « 6 trous, le plus long 366 ms » — exactement les 6 silences
    #      du fichier source, verifies en l'ouvrant. Elle mesurait la diction.
    #
    # `essai-son.wav` est une sinusoide continue de 0,8 s, fabriquee a la
    # construction. Court, discret, et sans un seul silence : tout trou qu'on y
    # trouvera aura ete creuse par la machine.
    ESSAI=/usr/share/grenos/essai-son.wav
    [ -r "$ESSAI" ] || ESSAI=/usr/share/sounds/alsa/Front_Center.wav
    if [ -r "$ESSAI" ] && command -v paplay >/dev/null 2>&1; then
        if paplay "$ESSAI" 2>/dev/null; then
            grenos-dire "son : un son a ete joue par PipeWire"
        else
            grenos-dire "son : paplay a refuse de jouer"
        fi

        # --- Et le MÊME son, une seconde fois, pendant que la machine peine ---
        #
        # C'est la seule mesure qui ressemble à ce que Grenofar entend.
        #
        # « On entend des bom bom bom **quand y'a la vidéo** » : c'est la
        # charge qui déclenche son hoquet. Or notre preuve jouait sur une
        # machine oisive, où PipeWire a tout le temps du monde — elle disait
        # « 0 trou » et aurait continué à le dire même si le défaut était
        # entier. Un son propre au repos ne prouve rien d'un son sous charge.
        #
        # Deux lectures séparées par un vrai silence, et la machine
        # d'intégration compare les deux : au repos, puis les cœurs saturés.
        # C'est la différence entre les deux qui est le diagnostic, pas le
        # chiffre isolé.
        #
        # **Uniquement sur la machine d'intégration.** Le marqueur est posé
        # par la CI dans le disque de persistance qu'elle fabrique elle-même
        # (`make-disk.sh`), et n'existe sur aucune machine réelle. Brûler les
        # cœurs une seconde au démarrage serait insupportable sur un portable
        # de 2012 — c'est-à-dire exactement la machine qu'on essaie de servir.
        # Deux chemins pour se faire reconnaître, et le second existe parce que
        # le premier a échoué.
        #
        # Le fichier posé dans le disque de persistance **n'est pas arrivé** au
        # système démarré : la construction disait bien « marqueur
        # etc/grenos/essai-charge pose dans le volume », et la session ne l'a
        # pas trouvé. Je ne sais pas encore pourquoi — d'où la ligne de
        # diagnostic ci-dessous, qui le dira au lieu de me laisser deviner.
        #
        # Le second chemin ne dépend de rien : QEMU écrit
        # `version=grenos-essai-charge` dans la table SMBIOS, et le noyau
        # l'expose en lecture libre. Ni VirtualBox ni un vrai PC n'y mettront
        # jamais cette chaîne.
        MARQUE=""
        [ -e /etc/grenos/essai-charge ] && MARQUE="fichier"
        if grep -qs grenos-essai-charge /sys/class/dmi/id/product_version; then
            MARQUE="${MARQUE:+$MARQUE et }smbios"
        fi
        grenos-dire "son : marqueur de charge = ${MARQUE:-aucun}"
        if [ -n "$MARQUE" ]; then
            sleep 2
            COEURS=$(nproc 2>/dev/null || echo 2)
            CHARGE=""
            i=0
            while [ "$i" -lt "$COEURS" ]; do
                sh -c 'while : ; do : ; done' &
                CHARGE="$CHARGE $!"
                i=$((i + 1))
            done
            sleep 1
            paplay "$ESSAI" 2>/dev/null || true
            # shellcheck disable=SC2086
            kill $CHARGE 2>/dev/null || true
            wait 2>/dev/null || true
            grenos-dire "son : second essai joue avec $COEURS coeur(s) satures"
        fi
    else
        grenos-dire "son : pas de quoi essayer (fichier ou paplay absent)"
    fi

    # --- Et MAINTENANT la priorite, une fois qu'un son a joue ---
    #
    # L'ordre etait faux, et c'est tout ce qui manquait.
    #
    # Ce bloc se trouvait AVANT `paplay`. Or PipeWire ne bascule son fil
    # `data-loop` en temps reel que lorsqu'un flux existe : au repos, il
    # n'a aucune raison de demander quoi que ce soit. Je mesurais donc un
    # orchestre avant l'entree des musiciens, et j'en concluais qu'il ne
    # jouait pas.
    #
    # Six tentatives sont parties de cette lecture : rtkit, les limites
    # PAM, celles de systemd, le plafond systeme, la configuration du
    # module. Chacune etait un vrai manque — le plafond est passe de zero
    # a 95, et rien de tout cela n'est a defaire — mais aucune n'etait LA
    # cause du chiffre que je lisais.
    #
    # A retenir : *une mesure prise au mauvais moment n'est pas une mesure
    # fausse, c'est une mesure d'autre chose.* Elle repond parfaitement a
    # une question qu'on n'a pas posee.
    # La priorite des fils, lue par `ps`, et par rien d'autre.
    #
    # SEPT tentatives ont porte sur « aucun fil de pipewire en temps
    # reel ». La huitieme mesure a montre que ce chiffre etait faux depuis
    # le debut :
    #
    #     son : fils de pipewire = pipewire/TS/- data-loop.0/FF/88
    #
    # `data-loop.0` est en classe FF — SCHED_FIFO — a la priorite 88.
    # **PipeWire tournait en temps reel.** C'est ma boucle `chrt` qui
    # comptait faux, et elle a tenu sept tours en disant le contraire de
    # la verite, sans jamais se contredire.
    #
    # Elle est supprimee. Une seule source desormais : `ps -L`, qui rend
    # le nom, la classe et la priorite de chaque fil tels que le noyau les
    # voit. Le verdict se deduit de cette meme ligne, donc il ne peut plus
    # dire autre chose qu'elle.
    #
    # La lecon de la nuit, et elle vaut pour tout : *deux mesures d'une
    # meme chose finissent toujours par diverger ; celle qui reste doit
    # etre celle qu'on peut lire a l'oeil nu.*
    PW=$(pgrep -x pipewire 2>/dev/null | head -1)
    if [ -n "$PW" ] && [ -d "/proc/$PW/task" ] && command -v chrt >/dev/null 2>&1; then

        # QUI sont ces fils, au juste ?
        #
        # « Deux fils, aucun en temps reel » ne veut rien dire tant qu'on ne
        # sait pas lesquels. Si le fil `data-loop` n'existe pas, la question
        # n'est plus « pourquoi n'est-il pas prioritaire » mais « pourquoi
        # n'est-il pas la » — et ce ne sont pas les memes causes.
        #
        # `ps` rend la classe d'ordonnancement (TS pour ordinaire, FF pour
        # FIFO) et la priorite, telles que le noyau les voit, sans prose a
        # interpreter. Six mesures se sont trompees cette nuit en lisant la
        # sortie d'un outil plutot que la valeur elle-meme.
        FILS_PS=$(ps -L -o comm=,cls=,rtprio= -p "$PW" 2>/dev/null)
        QUI=$(printf '%s\n' "$FILS_PS" \
              | awk '{printf "%s/%s/%s ", $1, $2, $3}' | cut -c1-120)
        TEMPS_REEL=$(printf '%s\n' "$FILS_PS" | awk '$2=="FF" || $2=="RR"' | wc -l)
        grenos-dire "son : fils de pipewire = ${QUI:-illisibles}"
        # La LIMITE, et pas seulement le résultat.
        #
        # Quatre tentatives ont échoué sur ce point, chacune corrigeant un
        # étage plausible sans jamais vérifier lequel bloquait. « Aucun fil en
        # temps réel » dit qu'on a échoué ; il ne dit pas pourquoi. Le noyau,
        # lui, écrit le plafond réel du processus dans /proc, et cette valeur
        # départage tout : à zéro, PipeWire n'a pas le DROIT de demander, et
        # c'est une histoire de limites ; au-dessus de zéro, il a le droit et
        # ne s'en sert pas, et c'est une histoire de module.
        PLAFOND=$(sed -n 's/^Max realtime priority *\([0-9a-z]*\) .*/\1/p' \
                  "/proc/$PW/limits" 2>/dev/null | head -1)
        grenos-dire "son : plafond temps reel de pipewire = ${PLAFOND:-illisible}"

        # Ce que le module a REELLEMENT fait, dit par PipeWire lui-meme.
        #
        # Le plafond a 95 et aucun fil en temps reel : PipeWire a le droit et
        # ne s'en sert pas. La cause est donc dans `module-rt`, qui est charge
        # avec `nofail` — son echec ne se voit nulle part, sauf dans son propre
        # journal. On va l'y chercher, au lieu de deviner une cinquieme fois.
        # LE MODULE EST-IL SEULEMENT CHARGE ? On demande au demon, pas au
        # journal.
        #
        # La mesure precedente passait par `journalctl --user`, et elle a
        # repondu « pipewire ne dit rien ». Reponse ambigue, donc inutile :
        # soit le module n'est pas la, soit le journal de session est
        # volatil et ne rend rien — ce qui est courant sur une image live.
        # Une mesure qui a deux explications n'en est pas une.
        #
        # `pw-cli` interroge le demon qui tourne. S'il repond, sa reponse est
        # la verite du moment ; s'il ne repond pas, c'est que PipeWire est
        # mort, ce qui serait une autre information et tout aussi utile.
        if command -v pw-cli >/dev/null 2>&1; then
            MODULES=$(pw-cli ls Module 2>/dev/null | grep -c 'module-rt')
            case "${MODULES:-0}" in
                0) grenos-dire "son : module-rt N EST PAS charge — personne ne demande la priorite" ;;
                *) grenos-dire "son : module-rt charge, c est lui qui obtient la priorite" ;;
            esac
        else
            grenos-dire "son : pw-cli absent, impossible de savoir si module-rt est la"
        fi

        FILS=$(printf '%s\n' "$FILS_PS" | awk 'NF' | wc -l)
        if [ "$TEMPS_REEL" -gt 0 ]; then
            grenos-dire "son : pipewire a $TEMPS_REEL fil(s) en temps reel sur $FILS, il tiendra sous charge"
        else
            grenos-dire "son : aucun fil de pipewire en temps reel sur $FILS — le son hoquettera sous charge"
        fi
    else
        grenos-dire "son : pipewire introuvable, priorite non mesuree"
    fi
) &

# Le clavier vraiment en place, et pas celui qu'on croit avoir choisi.
#
# Le premier écran écrit /etc/default/keyboard, mais le service qui le lit a
# peut-être déjà tourné au démarrage : la session pourrait garder un clavier
# américain alors que la personne a choisi la France. Elle s'en apercevrait à
# la première apostrophe. On compare donc ce que X utilise à ce qui a été
# demandé, au lieu de le supposer.
(
    VOULU=$(sed -n 's/^clavier=//p' /etc/grenos/identite 2>/dev/null | head -1)
    # `xprop` plutot que `setxkbmap` : il est deja dans l'image (la barre s'en
    # sert pour reserver sa bande), alors que x11-xkb-utils n'y est pas. La
    # troisieme valeur de _XKB_RULES_NAMES est la disposition.
    EN_PLACE=$(xprop -root _XKB_RULES_NAMES 2>/dev/null | sed 's/.*= //' | cut -d'"' -f6)
    if [ -n "$VOULU" ] && [ -n "$EN_PLACE" ] && [ "$VOULU" != "$EN_PLACE" ]; then
        grenos-dire "clavier : ${EN_PLACE} en place alors que ${VOULU} a ete choisi"
    else
        grenos-dire "clavier : ${EN_PLACE:-inconnu} en place, ${VOULU:-aucun} choisi"
    fi
) &

# Ce que le panneau « Emplacements » de l'explorateur a sous les yeux.
#
# Grenofar : « est-ce qu'on peut les voir sur l'explorateur ? » La capture
# disait non — et deux causes très différentes donnent exactement la même
# image vide, ce qui est la définition d'une mesure inutile :
#
#   1. gvfs ne propose pas les disques internes du tout ;
#   2. gvfs les propose, et c'est libfm qui les cache
#      (`show_internal_volumes`, à 0 par défaut).
#
# On interroge donc le MÊME objet que l'explorateur, `Gio.VolumeMonitor`, dans
# la MÊME session — pas `lsblk`, qui répond toujours oui et ne prouve rien du
# chemin emprunté. Le compte des disques et celui des volumes sont dits
# séparément : un disque sans système de fichiers n'a aucun volume, et son
# absence des « Emplacements » est alors normale, pas un défaut.
(
    sleep 12
    VOL=$(python3 -c "
from gi.repository import Gio, GLib
vm = Gio.VolumeMonitor.get()
ctx = GLib.MainContext.default()
for _ in range(200):
    if not ctx.pending():
        break
    ctx.iteration(False)
volumes = vm.get_volumes()
disques = vm.get_connected_drives()
def dire(v):
    d = v.get_drive()
    genre = 'amovible' if (d is not None and d.is_removable()) else 'interne'
    return '%s (%s)' % (v.get_name(), genre)
print('%d disque(s), %d volume(s) : %s' % (
    len(disques), len(volumes),
    ', '.join(dire(v) for v in volumes) or 'aucun'))
" 2>/dev/null)
    if [ -n "$VOL" ]; then
        grenos-dire "emplacements : $VOL"
    else
        grenos-dire "emplacements : GVolumeMonitor n a rien repondu"
    fi
) &

# L'installateur pourrait-il seulement demarrer ?
#
# « Installer grenOS » lance `pkexec calamares`, et pkexec demande a polkit
# l'action que le paquet declare. Notre regle a longtemps nomme
# « io.calamares.calamares. », qui ne correspond a rien : polkit demandait donc
# un mot de passe, et sur une machine grenOS par defaut il n'y en a pas.
# L'installateur etait injoignable, et personne ne s'en etait apercu parce que
# l'icone est cachee dans les machines virtuelles — donc dans la machine
# d'essai.
#
# `pkcheck` pose la question sans rien lancer : sans
# `--allow-user-interaction`, il sort en erreur des qu'une authentification
# serait demandee. Repondre « autorise » ici, c'est repondre « le bouton
# marchera » — la seule preuve possible tant que personne n'a de vrai disque a
# installer.
(
    ACTION=com.github.calamares.calamares.pkexec.run
    if ! command -v pkcheck >/dev/null 2>&1; then
        grenos-dire "installateur : pkcheck absent, impossible de verifier"
    elif pkcheck --action-id "$ACTION" --process $$ >/dev/null 2>&1; then
        grenos-dire "installateur : autorise sans mot de passe"
    else
        grenos-dire "installateur : polkit demande une authentification impossible"
    fi
) &

# LA MÊME QUESTION, POUR LES DISQUES — et c'était la même panne.
#
# Grenofar, le 7 octobre : « que l'os detecte plusieur disques de stockage ».
# Ils étaient *vus* depuis le 27 septembre : la ligne « emplacements : » plus
# haut le prouve. Ils n'étaient pas *ouvrables*. Lu dans le paquet udisks2
# 2.10.1-12.1+deb13u2 :
#
#     filesystem-mount          allow_active = yes             (clé USB)
#     filesystem-mount-system   allow_active = auth_admin_keep (disque interne)
#
# Un disque interne est un « périphérique système » pour udisks2. Cliquer
# dessus ouvrait donc une demande de mot de passe — sur une machine qui n'en a
# pas. Exactement l'installateur de septembre, deux semaines plus tard.
#
# LES DEUX actions sont interrogées, et c'est le point de la mesure : si
# l'amovible et l'interne répondaient la même chose, ce contrôle ne
# distinguerait rien et serait une assertion morte. L'amovible doit dire oui
# tout seul (c'est le défaut du paquet) ; l'interne ne dit oui que grâce à
# notre règle. Les voir différer serait le signe que la règle ne s'applique
# pas.
(
    AMOVIBLE=org.freedesktop.udisks2.filesystem-mount
    INTERNE=org.freedesktop.udisks2.filesystem-mount-system
    if ! command -v pkcheck >/dev/null 2>&1; then
        grenos-dire "montage : pkcheck absent, impossible de verifier"
    else
        if pkcheck --action-id "$AMOVIBLE" --process $$ >/dev/null 2>&1; then
            A=oui
        else
            A=non
        fi
        if pkcheck --action-id "$INTERNE" --process $$ >/dev/null 2>&1; then
            I=oui
        else
            I=non
        fi
        grenos-dire "montage : sans mot de passe — amovible $A, interne $I"
    fi
) &

# L'accueil, une seule fois, à la première ouverture.
if [ ! -e "$CONFIG/accueil-vu" ]; then
    touch "$CONFIG/accueil-vu"
    (sleep 2; grenos-bienvenue) &
fi

exec openbox
