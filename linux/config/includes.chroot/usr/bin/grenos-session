#!/bin/sh
# La session grenOS : ce qui démarre quand on ouvre le bureau.
#
# L'ordre compte. D'abord la langue et l'écran (pas d'économiseur, pas de mise
# en veille : dans une machine virtuelle, un écran qui s'éteint passe pour un
# plantage), puis le bureau et ses icônes, puis les services discrets, puis
# notre barre, et enfin le gestionnaire de fenêtres au premier plan — c'est lui
# qui tient la session : quand il s'arrête, la session se ferme.
#
# Rien ici ne compose l'écran. Pas d'ombres calculées par le GPU, pas de
# transparence : c'est ce qui rend le pointeur fluide sur une machine sans
# accélération 3D.

export XDG_CURRENT_DESKTOP=grenOS
export XDG_SESSION_DESKTOP=grenos
export XDG_MENU_PREFIX=grenos-
# Les applications GTK suivent le thème du système, pas leurs propres couleurs.
export GTK_OVERLAY_SCROLLING=0

# La langue du système. lightdm ne la transmet pas à la session : sans ces
# lignes, l'horloge de la barre affiche « Fri 18 Sep » au lieu de
# « ven. 18 sept. », et les applications s'ouvrent en anglais.
if [ -r /etc/default/locale ]; then
    . /etc/default/locale
    export LANG LANGUAGE LC_ALL LC_TIME 2>/dev/null || true
fi

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/grenos"
mkdir -p "$CONFIG" "$HOME/Bureau"

# Les dossiers en français, écrits avant que quoi que ce soit ne les demande.
# Sans cela, les applications cherchent ~/Desktop — vide — pendant que les
# raccourcis attendent dans ~/Bureau.
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update 2>/dev/null
export XDG_DESKTOP_DIR="$HOME/Bureau"

# L'écran reste allumé, et le pointeur est une flèche dès la première seconde.
xset s off -dpms s noblank 2>/dev/null || true
xsetroot -cursor_name left_ptr 2>/dev/null || true

# La définition choisie dans les Réglages est réappliquée.
grenos-parametres --restaurer-ecran 2>/dev/null || true

# L'installation sur le disque n'a de sens que sur une vraie machine. Dans une
# machine virtuelle, le disque garde déjà tout, et proposer d'installer
# par-dessus ne ferait qu'inquiéter : on retire l'entrée du menu pour ce
# compte, sans toucher au système.
VIRTUELLE=$(systemd-detect-virt 2>/dev/null || echo none)
mkdir -p "$HOME/.local/share/applications"
if [ "$VIRTUELLE" = "none" ]; then
    rm -f "$HOME/.local/share/applications/grenos-installer.desktop"
    if [ ! -e "$HOME/Bureau/grenos-installer.desktop" ] && \
       [ ! -e "$CONFIG/installer-pose" ]; then
        cp /usr/share/applications/grenos-installer.desktop "$HOME/Bureau/" 2>/dev/null || true
        chmod +x "$HOME/Bureau/grenos-installer.desktop" 2>/dev/null || true
        touch "$CONFIG/installer-pose"
    fi
else
    rm -f "$HOME/Bureau/grenos-installer.desktop"
    printf '[Desktop Entry]\nType=Application\nName=Installer grenOS\nNoDisplay=true\nExec=pkexec calamares\n' \
        > "$HOME/.local/share/applications/grenos-installer.desktop"
fi

# Le pointeur des machines virtuelles : sans ce petit service, il colle au bord
# de la fenêtre et il faut « libérer » le clavier pour en sortir.
command -v spice-vdagent >/dev/null 2>&1 && spice-vdagent 2>/dev/null &
command -v vmware-user-suid-wrapper >/dev/null 2>&1 && vmware-user-suid-wrapper 2>/dev/null &

# Les autorisations : installer un paquet ouvre une fenêtre qui demande.
for agent in /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 \
             /usr/libexec/polkit-mate-authentication-agent-1; do
    if [ -x "$agent" ]; then
        "$agent" &
        break
    fi
done

# La touche Windows ouvre le menu grenOS, comme sur Windows.
#
# Pourquoi un programme a part plutot qu'une ligne dans openbox : openbox ne
# declenche une action que sur une **combinaison**. Lier « Super_L » tout seul
# ferait ouvrir le menu aussi pour Super+T, Super+E et les six autres raccourcis
# qui commencent par Super — la touche partirait avant la seconde.
#
# `xcape` sait faire la difference : il n'emet quelque chose que si la touche
# est relachee SANS qu'aucune autre n'ait ete pressee entre-temps. On lui fait
# emettre Ctrl+Echap, qui ouvre deja le menu et que la CI verifie a chaque
# construction — autant reutiliser le chemin qui est prouve plutot que d'en
# ouvrir un second.
if command -v xcape >/dev/null 2>&1; then
    xcape -e 'Super_L=Control_L|Escape' 2>/dev/null &
    grenos-dire "touche windows branchee sur le menu"
else
    grenos-dire "touche windows : xcape absent, la touche ne fera rien"
fi

# Le bureau : le fond d'écran et ce qu'on pose dessus.
grenos-veilleur grenos-bureau &

# La preuve, pour la CI et pour les journaux : un bureau s'est vraiment ouvert.
echo "$(date -u +%H:%M:%S) $USER" > /tmp/grenos-session 2>/dev/null || true

# Notre barre. Si elle tombe, elle revient : un bureau sans barre est un bureau
# perdu, et une session qui se ferme ferait perdre le travail en cours.
grenos-veilleur grenos-shell &

# Le son, une fois PipeWire debout : combien de sorties, et laquelle. Sans
# cette ligne, « aucune sortie détectée » dans les Réglages ne permet pas de
# distinguer une panne d'un ordinateur sans carte son.
(
    # PipeWire demarre par socket, a la demande : on le reveille plutot que
    # d'esperer que quelqu'un d'autre le fasse.
    systemctl --user start pipewire.socket pipewire-pulse.socket 2>/dev/null
    systemctl --user start wireplumber.service 2>/dev/null
    sleep 12
    SORTIES=$(pactl list short sinks 2>/dev/null | wc -l)
    COURANTE=$(pactl info 2>/dev/null | sed -n 's/^Default Sink: //p')
    grenos-dire "son, $SORTIES sorties, courante ${COURANTE:-aucune}"

    # PipeWire tourne-t-il en TEMPS REEL ? C'est la mesure qui manquait.
    #
    # Grenofar : « on entend des bom bom bom quand y'a la video ». Le son
    # sortait ; il hachait. Un son qui hache sous charge veut dire que PipeWire
    # n'est pas servi a temps et que son tampon se vide. Or `rtkit`, qui lui
    # donne le droit de passer devant, n'est que RECOMMANDE par pipewire-bin :
    # il etait absent, et rien ne le disait.
    #
    # `chrt` lit la politique d'ordonnancement du noyau. FIFO ou RR : PipeWire
    # est prioritaire, il tiendra sous charge. OTHER : il fait la queue comme
    # le decodeur video, et ca hoquettera des que la machine peine.
    # On regarde TOUS LES FILS, pas seulement le principal.
    #
    # Premiere version de cette mesure : `chrt -p` sur le processus. Elle a
    # repondu « SCHED_OTHER, PAS prioritaire » — et elle avait tort. PipeWire
    # ne met pas son fil principal en temps reel : il cree un fil a part,
    # `data-loop`, qui est le seul a porter le son, et c'est CELUI-LA qui
    # demande SCHED_FIFO. Mesurer le processus revenait a juger un orchestre
    # sur le silence du chef.
    #
    # Corrige avant d'avoir cru le resultat — la lecon du 25 septembre, ou la
    # CI affirmait que le panneau de son ne se fermait pas alors que la capture
    # montrait qu'il etait parti : *un test qui echoue peut se tromper.*
    PW=$(pgrep -x pipewire 2>/dev/null | head -1)
    if [ -n "$PW" ] && [ -d "/proc/$PW/task" ] && command -v chrt >/dev/null 2>&1; then
        TEMPS_REEL=0
        for fil in /proc/"$PW"/task/*; do
            [ -d "$fil" ] || continue
            case "$(chrt -p "$(basename "$fil")" 2>/dev/null | sed -n 's/.*policy: //p' | head -1)" in
                SCHED_FIFO|SCHED_RR) TEMPS_REEL=$((TEMPS_REEL + 1)) ;;
            esac
        done
        # La LIMITE, et pas seulement le résultat.
        #
        # Quatre tentatives ont échoué sur ce point, chacune corrigeant un
        # étage plausible sans jamais vérifier lequel bloquait. « Aucun fil en
        # temps réel » dit qu'on a échoué ; il ne dit pas pourquoi. Le noyau,
        # lui, écrit le plafond réel du processus dans /proc, et cette valeur
        # départage tout : à zéro, PipeWire n'a pas le DROIT de demander, et
        # c'est une histoire de limites ; au-dessus de zéro, il a le droit et
        # ne s'en sert pas, et c'est une histoire de module.
        PLAFOND=$(sed -n 's/^Max realtime priority *\([0-9a-z]*\) .*/\1/p' \
                  "/proc/$PW/limits" 2>/dev/null | head -1)
        grenos-dire "son : plafond temps reel de pipewire = ${PLAFOND:-illisible}"

        # Ce que le module a REELLEMENT fait, dit par PipeWire lui-meme.
        #
        # Le plafond a 95 et aucun fil en temps reel : PipeWire a le droit et
        # ne s'en sert pas. La cause est donc dans `module-rt`, qui est charge
        # avec `nofail` — son echec ne se voit nulle part, sauf dans son propre
        # journal. On va l'y chercher, au lieu de deviner une cinquieme fois.
        # Le motif compte : « rt » tout court attrapait « Sta-rt-ed », la ligne
        # de systemd qui n'apprend rien. On vise les messages du module — il
        # prefixe les siens par `mod.rt` — et ce que rtkit repond.
        RAISON=$(journalctl --user -u pipewire --no-pager -n 300 2>/dev/null \
                 | grep -v 'systemd\[' \
                 | grep -i -m2 -E 'mod\.rt|rtkit|realtime|RLIMIT|sched' \
                 | sed 's/.*pipewire\[[0-9]*\]: //' | cut -c1-110 | tr '\n' ';')
        if [ -n "$RAISON" ]; then
            grenos-dire "son : pipewire dit « $RAISON »"
        else
            grenos-dire "son : pipewire ne dit rien de la priorite (module-rt muet ou absent)"
        fi

        FILS=$(ls -1 /proc/"$PW"/task 2>/dev/null | wc -l)
        if [ "$TEMPS_REEL" -gt 0 ]; then
            grenos-dire "son : pipewire a $TEMPS_REEL fil(s) en temps reel sur $FILS, il tiendra sous charge"
        else
            grenos-dire "son : aucun fil de pipewire en temps reel sur $FILS — le son hoquettera sous charge"
        fi
    else
        grenos-dire "son : pipewire introuvable, priorite non mesuree"
    fi

    # Et maintenant on JOUE. Compter les sorties prouve que PipeWire repond ;
    # cela ne prouve pas qu'un son sort, et c'est toute la difference entre ce
    # qu'on croyait savoir et ce que Grenofar a entendu — rien.
    #
    # Le fichier vient d'alsa-utils (verifie dans le .deb), et paplay de
    # pulseaudio-utils : les deux sont sur l'image. On passe par paplay, donc
    # par PipeWire, pour exercer la chaine entiere plutot qu'ALSA seul.
    ESSAI=/usr/share/sounds/alsa/Front_Center.wav
    if [ -r "$ESSAI" ] && command -v paplay >/dev/null 2>&1; then
        if paplay "$ESSAI" 2>/dev/null; then
            grenos-dire "son : un son a ete joue par PipeWire"
        else
            grenos-dire "son : paplay a refuse de jouer"
        fi
    else
        grenos-dire "son : pas de quoi essayer (fichier ou paplay absent)"
    fi
) &

# Le clavier vraiment en place, et pas celui qu'on croit avoir choisi.
#
# Le premier écran écrit /etc/default/keyboard, mais le service qui le lit a
# peut-être déjà tourné au démarrage : la session pourrait garder un clavier
# américain alors que la personne a choisi la France. Elle s'en apercevrait à
# la première apostrophe. On compare donc ce que X utilise à ce qui a été
# demandé, au lieu de le supposer.
(
    VOULU=$(sed -n 's/^clavier=//p' /etc/grenos/identite 2>/dev/null | head -1)
    # `xprop` plutot que `setxkbmap` : il est deja dans l'image (la barre s'en
    # sert pour reserver sa bande), alors que x11-xkb-utils n'y est pas. La
    # troisieme valeur de _XKB_RULES_NAMES est la disposition.
    EN_PLACE=$(xprop -root _XKB_RULES_NAMES 2>/dev/null | sed 's/.*= //' | cut -d'"' -f6)
    if [ -n "$VOULU" ] && [ -n "$EN_PLACE" ] && [ "$VOULU" != "$EN_PLACE" ]; then
        grenos-dire "clavier : ${EN_PLACE} en place alors que ${VOULU} a ete choisi"
    else
        grenos-dire "clavier : ${EN_PLACE:-inconnu} en place, ${VOULU:-aucun} choisi"
    fi
) &

# L'installateur pourrait-il seulement demarrer ?
#
# « Installer grenOS » lance `pkexec calamares`, et pkexec demande a polkit
# l'action que le paquet declare. Notre regle a longtemps nomme
# « io.calamares.calamares. », qui ne correspond a rien : polkit demandait donc
# un mot de passe, et sur une machine grenOS par defaut il n'y en a pas.
# L'installateur etait injoignable, et personne ne s'en etait apercu parce que
# l'icone est cachee dans les machines virtuelles — donc dans la machine
# d'essai.
#
# `pkcheck` pose la question sans rien lancer : sans
# `--allow-user-interaction`, il sort en erreur des qu'une authentification
# serait demandee. Repondre « autorise » ici, c'est repondre « le bouton
# marchera » — la seule preuve possible tant que personne n'a de vrai disque a
# installer.
(
    ACTION=com.github.calamares.calamares.pkexec.run
    if ! command -v pkcheck >/dev/null 2>&1; then
        grenos-dire "installateur : pkcheck absent, impossible de verifier"
    elif pkcheck --action-id "$ACTION" --process $$ >/dev/null 2>&1; then
        grenos-dire "installateur : autorise sans mot de passe"
    else
        grenos-dire "installateur : polkit demande une authentification impossible"
    fi
) &

# L'accueil, une seule fois, à la première ouverture.
if [ ! -e "$CONFIG/accueil-vu" ]; then
    touch "$CONFIG/accueil-vu"
    (sleep 2; grenos-bienvenue) &
fi

exec openbox
