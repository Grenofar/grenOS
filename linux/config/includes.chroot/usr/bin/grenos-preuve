#!/bin/sh
# Ce que le bureau a fait, ecrit sur le port serie.
#
# Pourquoi passer par un service systeme : le compte de la session n'appartient
# pas au groupe dialout, donc il ne peut pas ecrire sur /dev/ttyS0 lui-meme, et
# l'y mettre lui donnerait bien plus que ce dont il a besoin. Le bureau depose
# donc des billets dans /tmp/grenos-billets (que tout le monde peut ecrire), et
# ce service — qui tourne en root — les relaie un par un.
#
# La machine d'integration lit ces lignes. C'est ainsi qu'elle sait qu'un menu
# s'est ouvert ou qu'une fenetre a repondu : une capture d'ecran montre un
# bureau, elle ne prouve pas qu'il obeit.

set -u

BOITE=/tmp/grenos-billets
MARQUE=/tmp/grenos-session
mkdir -p "$BOITE" 2>/dev/null || true
chmod 1777 "$BOITE" 2>/dev/null || true

dire () {
    echo "grenos: $1" > /dev/ttyS0 2>/dev/null || true
}

# ---- Cette image peut-elle se mettre a jour ? -------------------------------
#
# Le depot grenOS arrive par config/archives/grenos.list.binary, et rien n'a
# jamais verifie qu'il atteignait l'image demarree. C'est pourtant le maillon
# qui decide de tout : sans lui, « Mettre a jour grenOS » ne trouve rien de
# grenOS a mettre a jour et n'apporte que les correctifs Debian. L'essai en
# conteneur prouve que le depot marche ; il ne prouve pas que l'image le
# connait.
depot=""
for fichier in /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
    if [ -f "$fichier" ] && grep -q 'public/apt' "$fichier" 2>/dev/null; then
        depot="$fichier"
        break
    fi
done
if [ -n "$depot" ]; then
    dire "maj: depot grenOS configure dans $depot"
else
    dire "maj: aucun depot grenOS, cette image ne pourra pas se mettre a jour"
fi

if [ -f /usr/share/keyrings/grenos-apt.gpg ]; then
    dire "maj: trousseau du depot present"
else
    dire "maj: trousseau du depot absent"
fi

# Le depot est-il JOIGNABLE, et pas seulement configure ?
#
# C'est la question qui manquait, et elle a coute une semaine. Notre depot est
# en https ; sans certificats racines, apt ne peut pas verifier le serveur et
# l'abandonne en silence — « Mettre a jour grenOS » n'apporte alors que les
# correctifs Debian, qui eux passent en http. La meme cause empeche flatpak
# d'installer quoi que ce soit depuis Flathub.
#
# `essai-maj.sh` ne pouvait pas le voir : il installe ca-certificates dans son
# conteneur avant de commencer. Il prouvait un depot que l'image n'atteignait
# pas. On pose donc la question a l'image, sur l'image.
racines=$(ls /etc/ssl/certs/*.pem 2>/dev/null | wc -l)
if [ "${racines:-0}" -lt 10 ]; then
    dire "maj: AUCUN certificat racine : ni Flathub ni notre depot ne repondront"
else
    dire "maj: $racines certificats racines"
fi
# On interroge le depot avec apt, pas avec curl : curl n'est pas dans l'image,
# et un controle garde derriere `command -v` serait reste muet — c'est-a-dire
# inutile precisement le jour ou il aurait servi.
#
# `Dir::Etc::sourceparts=/dev/null` ne garde que notre fichier : on veut savoir
# si NOTRE depot repond, pas si Debian repond. C'est exactement l'operation que
# fait « Mettre a jour grenOS », signature comprise.
if [ -n "$depot" ]; then
    if apt-get update -qq \
            -o Dir::Etc::sourcelist="$depot" \
            -o Dir::Etc::sourceparts=/dev/null \
            -o APT::Get::List-Cleanup=0 > /tmp/grenos-apt 2>&1; then
        dire "maj: depot joignable et signature acceptee"
    else
        dire "maj: depot INJOIGNABLE : $(tr -d "\n" < /tmp/grenos-apt | cut -c1-110)"
    fi
    rm -f /tmp/grenos-apt
fi

# Et dpkg connait-il nos paquets ? Sans entree dans dpkg, apt n'a rien a
# comparer, donc rien a mettre a jour — c'est exactement ce qui manquait.
version=$(dpkg-query -W -f='${Version}' grenos-desktop 2>/dev/null || true)
if [ -n "$version" ]; then
    dire "maj: grenos-desktop $version est installe"
else
    dire "maj: grenos-desktop n'est pas installe, apt n'aura rien a mettre a jour"
fi

# ---- Le magasin peut-il vraiment installer ? --------------------------------
#
# La machine d'integration ouvrait GrenPlace et comptait ses applications. Elle
# n'a jamais appuye sur « Installer ». C'est exactement par la que le defaut du
# 25 septembre est passe : sans `ca-certificates`, flatpak ne pouvait pas
# verifier le certificat de Flathub, et **aucune application ne s'installait**.
# Grenofar l'a trouve en une minute d'usage ; la CI ne pouvait pas le voir,
# parce qu'elle regardait une vitrine sans jamais entrer dans le magasin.
#
# On n'installe rien pour de vrai — ce serait des centaines de megaoctets et
# plusieurs minutes. On demande a Flathub les metadonnees d'une application du
# catalogue : cela exerce le reseau, le TLS et le depot, c'est-a-dire tout ce
# qui cassait.
if command -v flatpak >/dev/null 2>&1; then
    if timeout 90 flatpak remote-info flathub com.valvesoftware.Steam \
            > /tmp/grenos-flathub 2>&1; then
        dire "magasin : Flathub repond, une application peut s'installer"
    else
        dire "magasin : FLATHUB INJOIGNABLE : $(tr -d "\n" < /tmp/grenos-flathub | cut -c1-110)"
    fi
    rm -f /tmp/grenos-flathub
else
    dire "magasin : flatpak absent, le magasin ne pourra rien installer"
fi

# ---- Y a-t-il un disque ou s'installer ? ------------------------------------
#
# L'installateur ne peut rien proposer si le systeme ne voit aucun disque, et
# c'est une panne qu'on decouvrirait au pire moment : devant l'ecran de
# Calamares, sur la machine de quelqu'un. Le dire ici coute une ligne.
disques=$(lsblk -dn -o NAME,SIZE,TYPE 2>/dev/null \
          | awk '$3 == "disk" { printf "%s %s ", $1, $2 }')
if [ -n "$disques" ]; then
    dire "disques : $disques"
else
    dire "disques : aucun, l'installateur n'aurait rien a proposer"
fi

# Et ce que la page Materiel montre vraiment.
#
# `lsblk` ci-dessus compte tout, y compris le lecteur de disquette que QEMU
# invente : il dit « 3 disques » la ou la personne en voit deux. Ce n'est donc
# pas une preuve de ce qu'elle lit. On appelle la MEME fonction que les
# Reglages — une preuve qui passe par un autre chemin que le produit ne prouve
# pas le produit. C'est la lecon de `ca-certificates`, que l'essai en conteneur
# installait lui-meme.
vus=$(python3 -c "
import sys
sys.path.insert(0, '/usr/lib/grenos')
import materiel
d = materiel.disques()
print('%d|%s' % (len(d), ', '.join(
    '%s %s' % (x['nom'], materiel.genre_du_disque(x)) for x in d)))
" 2>/dev/null)
if [ -n "$vus" ]; then
    dire "disques vus par les Reglages : ${vus%%|*} — ${vus#*|}"
else
    dire "disques vus par les Reglages : la lecture a echoue"
fi

# ---- Ce que la personne ecrit est-il garde ? --------------------------------
#
# C'est la promesse de la machine VirtualBox, ecrite sur la page de
# telechargement : « tout ce que tu fais est garde sur le disque de la
# machine ». Elle tient a une partition ext4 etiquetee « persistence » que
# live-boot doit trouver au demarrage. Si elle ne la trouve pas, rien ne le
# dit : le bureau s'ouvre normalement, et tout disparait a l'extinction.
# `xargs echo` met tout sur une ligne sans qu'on ait à écrire une séquence
# d'échappement : celles-ci ne survivent pas toujours à une réécriture, et
# c'est la quatrième fois aujourd'hui que j'en perds une.
garde=$(ls /run/live/persistence 2>/dev/null | head -2 | xargs echo)
if [ -n "$garde" ]; then
    dire "persistance : active sur $garde"
else
    dire "persistance : aucune, ce qui sera ecrit disparaitra a l'extinction"
fi

vu_session=0
i=0
# Un quart d'heure, et pas davantage. La machine d'integration a rendu son
# verdict bien avant, et sur la machine de quelqu'un ce service n'a plus rien
# a dire : le laisser veiller une heure, c'est un processus qui se reveille
# trois mille six cents fois pour rien.
while [ "$i" -lt 450 ]; do
    # Les billets deposes par le bureau, dans l'ordre ou ils sont arrives.
    for billet in "$BOITE"/*; do
        [ -f "$billet" ] || continue
        while IFS= read -r ligne; do
            [ -n "$ligne" ] && dire "$ligne"
        done < "$billet"
        rm -f "$billet"
    done

    if [ "$vu_session" -eq 0 ]; then
        if [ -e "$MARQUE" ]; then
            dire "session de bureau ouverte"
            vu_session=1
        elif command -v loginctl >/dev/null 2>&1 && \
             loginctl list-sessions --no-legend 2>/dev/null | \
             awk '$3 != "lightdm" && $3 != "" { trouve = 1 } END { exit !trouve }'; then
            # Deuxieme chemin, au cas ou le bureau n'aurait pas pu ecrire son
            # fichier : une session graphique ouverte par quelqu'un d'autre que
            # le gestionnaire de connexion lui-meme.
            dire "session de bureau ouverte"
            vu_session=1
        fi
    fi

    sleep 2
    i=$((i + 1))
done
