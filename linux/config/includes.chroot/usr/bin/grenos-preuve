#!/bin/sh
# Ce que le bureau a fait, ecrit sur le port serie.
#
# Pourquoi passer par un service systeme : le compte de la session n'appartient
# pas au groupe dialout, donc il ne peut pas ecrire sur /dev/ttyS0 lui-meme, et
# l'y mettre lui donnerait bien plus que ce dont il a besoin. Le bureau depose
# donc des billets dans /tmp/grenos-billets (que tout le monde peut ecrire), et
# ce service — qui tourne en root — les relaie un par un.
#
# La machine d'integration lit ces lignes. C'est ainsi qu'elle sait qu'un menu
# s'est ouvert ou qu'une fenetre a repondu : une capture d'ecran montre un
# bureau, elle ne prouve pas qu'il obeit.

set -u

BOITE=/tmp/grenos-billets
MARQUE=/tmp/grenos-session
mkdir -p "$BOITE" 2>/dev/null || true
chmod 1777 "$BOITE" 2>/dev/null || true

dire () {
    echo "grenos: $1" > /dev/ttyS0 2>/dev/null || true
}

# ---- Cette image peut-elle se mettre a jour ? -------------------------------
#
# Le depot grenOS arrive par config/archives/grenos.list.binary, et rien n'a
# jamais verifie qu'il atteignait l'image demarree. C'est pourtant le maillon
# qui decide de tout : sans lui, « Mettre a jour grenOS » ne trouve rien de
# grenOS a mettre a jour et n'apporte que les correctifs Debian. L'essai en
# conteneur prouve que le depot marche ; il ne prouve pas que l'image le
# connait.
depot=""
for fichier in /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
    if [ -f "$fichier" ] && grep -q 'public/apt' "$fichier" 2>/dev/null; then
        depot="$fichier"
        break
    fi
done
if [ -n "$depot" ]; then
    dire "maj: depot grenOS configure dans $depot"
else
    dire "maj: aucun depot grenOS, cette image ne pourra pas se mettre a jour"
fi

if [ -f /usr/share/keyrings/grenos-apt.gpg ]; then
    dire "maj: trousseau du depot present"
else
    dire "maj: trousseau du depot absent"
fi

# Et dpkg connait-il nos paquets ? Sans entree dans dpkg, apt n'a rien a
# comparer, donc rien a mettre a jour — c'est exactement ce qui manquait.
version=$(dpkg-query -W -f='${Version}' grenos-desktop 2>/dev/null || true)
if [ -n "$version" ]; then
    dire "maj: grenos-desktop $version est installe"
else
    dire "maj: grenos-desktop n'est pas installe, apt n'aura rien a mettre a jour"
fi

# ---- Y a-t-il un disque ou s'installer ? ------------------------------------
#
# L'installateur ne peut rien proposer si le systeme ne voit aucun disque, et
# c'est une panne qu'on decouvrirait au pire moment : devant l'ecran de
# Calamares, sur la machine de quelqu'un. Le dire ici coute une ligne.
disques=$(lsblk -dn -o NAME,SIZE,TYPE 2>/dev/null \
          | awk '$3 == "disk" { printf "%s %s ", $1, $2 }')
if [ -n "$disques" ]; then
    dire "disques : $disques"
else
    dire "disques : aucun, l'installateur n'aurait rien a proposer"
fi

vu_session=0
i=0
# Un quart d'heure, et pas davantage. La machine d'integration a rendu son
# verdict bien avant, et sur la machine de quelqu'un ce service n'a plus rien
# a dire : le laisser veiller une heure, c'est un processus qui se reveille
# trois mille six cents fois pour rien.
while [ "$i" -lt 450 ]; do
    # Les billets deposes par le bureau, dans l'ordre ou ils sont arrives.
    for billet in "$BOITE"/*; do
        [ -f "$billet" ] || continue
        while IFS= read -r ligne; do
            [ -n "$ligne" ] && dire "$ligne"
        done < "$billet"
        rm -f "$billet"
    done

    if [ "$vu_session" -eq 0 ]; then
        if [ -e "$MARQUE" ]; then
            dire "session de bureau ouverte"
            vu_session=1
        elif command -v loginctl >/dev/null 2>&1 && \
             loginctl list-sessions --no-legend 2>/dev/null | \
             awk '$3 != "lightdm" && $3 != "" { trouve = 1 } END { exit !trouve }'; then
            # Deuxieme chemin, au cas ou le bureau n'aurait pas pu ecrire son
            # fichier : une session graphique ouverte par quelqu'un d'autre que
            # le gestionnaire de connexion lui-meme.
            dire "session de bureau ouverte"
            vu_session=1
        fi
    fi

    sleep 2
    i=$((i + 1))
done
