#!/bin/sh
# Ce que le bureau a fait, ecrit sur le port serie.
#
# Pourquoi passer par un service systeme : le compte de la session n'appartient
# pas au groupe dialout, donc il ne peut pas ecrire sur /dev/ttyS0 lui-meme, et
# l'y mettre lui donnerait bien plus que ce dont il a besoin. Le bureau depose
# donc des billets dans /tmp/grenos-billets (que tout le monde peut ecrire), et
# ce service — qui tourne en root — les relaie un par un.
#
# La machine d'integration lit ces lignes. C'est ainsi qu'elle sait qu'un menu
# s'est ouvert ou qu'une fenetre a repondu : une capture d'ecran montre un
# bureau, elle ne prouve pas qu'il obeit.

set -u

BOITE=/tmp/grenos-billets
MARQUE=/tmp/grenos-session

# Le temoin de persistance est lu ICI, a la premiere ligne utile, et pas la ou
# il est rapporte.
#
# Il etait lu deux cents lignes plus bas, apres un `flatpak remote-info` qui
# peut prendre quatre-vingt-dix secondes. La session avait tout le temps
# d'ecrire le sien entre-temps, et les DEUX demarrages repondaient « le temoin
# est de ce demarrage » : la mesure etait devenue honnete, elle ne prouvait
# toujours rien.
#
# C'est la cinquieme fois cette semaine : *une mesure prise au mauvais moment
# n'est pas fausse, elle mesure autre chose.* Ce service demarre avec le
# systeme, bien avant lightdm ; lire a la premiere ligne, c'est lire ce que le
# disque contenait AVANT que quiconque y touche.
TEMOIN_AU_DEMARRAGE=$(cat /home/*/.config/grenos/temoin-persistance 2>/dev/null | head -1)
mkdir -p "$BOITE" 2>/dev/null || true
chmod 1777 "$BOITE" 2>/dev/null || true

dire () {
    echo "grenos: $1" > /dev/ttyS0 2>/dev/null || true
}

# ---- SANS PORT SERIE, TOUT CE QUI SUIT EST DU TRAVAIL POUR RIEN ------------
#
# Grenofar, le 1er octobre : « fais que ça soit rapide, que ça reste fluide,
# éviter les processus en trop ».
#
# Des seize services en marche, quinze sont à Debian et chacun sert à quelque
# chose — journald, udevd, logind, dbus, polkit, NetworkManager, lightdm,
# udisks2 (c'est lui qui montre les disques dans l'explorateur)… Le seizième
# est celui-ci, et c'est le NÔTRE.
#
# Il n'existe que pour écrire sur le port série, que la machine d'intégration
# lit. Or le fichier `.vbox` que nous livrons ne déclare AUCUN port série
# (`scripts/make-vbox.py` : `serial = ""` pour Linux), et un PC d'aujourd'hui
# n'en a pas non plus. Chez Grenofar, chaque `dire` part donc dans le vide.
#
# CE QUE CELA COÛTE VRAIMENT — ET J'AVAIS ÉCRIT N'IMPORTE QUOI
#
# J'avais écrit ici que la sonde interrogeait le dépôt APT par le réseau et
# Flathub « jusqu'à quatre-vingt-dix secondes ». La ligne de mesure que
# j'ajoutais dans le même commit a répondu au passage suivant :
#
#     perf : la sonde a pris 1s — autant d epargne
#
# **Une seconde.** Le chiffre de quatre-vingt-dix était un pire cas théorique,
# jamais observé, et je l'ai présenté comme le coût réel. *Affirmer un coût
# qu'on n'a pas mesuré, c'est exactement ce que ce fichier passe son temps à
# attraper chez les autres.*
#
# LE VRAI COÛT EST AILLEURS, ET IL EST RÉEL : après ces préparatifs, ce
# programme entre dans une boucle d'attente de **quinze minutes** (450 tours de
# 2 s), pendant laquelle il se réveille toutes les deux secondes pour balayer
# /tmp. Sur un portable, c'est quinze minutes de réveils qui empêchent le
# processeur de descendre dans ses états de repos profonds — à chaque
# démarrage, pour relayer des messages que personne ne lit.
#
# On ne retire donc aucun service : on arrête d'en faire tourner un qui ne sert
# à personne. Et cela ne coûte rien à la CI, où le port existe.
#
# `-c` et pas `-e` : /dev/ttyS0 doit être un périphérique en mode caractère. Un
# fichier ordinaire du même nom ne serait pas un port série, et le test
# passerait quand même.
if [ ! -c /dev/ttyS0 ]; then
    echo "grenos-preuve : aucun port serie, rien a rapporter — on s arrete" >&2
    exit 0
fi

# Combien coûte cette sonde, pour qu'on sache ce qu'on épargne à sa machine.
DEBUT_SONDE=$(date +%s 2>/dev/null || echo 0)

# ---- Cette image peut-elle se mettre a jour ? -------------------------------
#
# Le depot grenOS arrive par config/archives/grenos.list.binary, et rien n'a
# jamais verifie qu'il atteignait l'image demarree. C'est pourtant le maillon
# qui decide de tout : sans lui, « Mettre a jour grenOS » ne trouve rien de
# grenOS a mettre a jour et n'apporte que les correctifs Debian. L'essai en
# conteneur prouve que le depot marche ; il ne prouve pas que l'image le
# connait.
depot=""
for fichier in /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
    if [ -f "$fichier" ] && grep -q 'public/apt' "$fichier" 2>/dev/null; then
        depot="$fichier"
        break
    fi
done
if [ -n "$depot" ]; then
    dire "maj: depot grenOS configure dans $depot"
else
    dire "maj: aucun depot grenOS, cette image ne pourra pas se mettre a jour"
fi

if [ -f /usr/share/keyrings/grenos-apt.gpg ]; then
    dire "maj: trousseau du depot present"
else
    dire "maj: trousseau du depot absent"
fi

# Le depot est-il JOIGNABLE, et pas seulement configure ?
#
# C'est la question qui manquait, et elle a coute une semaine. Notre depot est
# en https ; sans certificats racines, apt ne peut pas verifier le serveur et
# l'abandonne en silence — « Mettre a jour grenOS » n'apporte alors que les
# correctifs Debian, qui eux passent en http. La meme cause empeche flatpak
# d'installer quoi que ce soit depuis Flathub.
#
# `essai-maj.sh` ne pouvait pas le voir : il installe ca-certificates dans son
# conteneur avant de commencer. Il prouvait un depot que l'image n'atteignait
# pas. On pose donc la question a l'image, sur l'image.
racines=$(ls /etc/ssl/certs/*.pem 2>/dev/null | wc -l)
if [ "${racines:-0}" -lt 10 ]; then
    dire "maj: AUCUN certificat racine : ni Flathub ni notre depot ne repondront"
else
    dire "maj: $racines certificats racines"
fi
# On interroge le depot avec apt, pas avec curl : curl n'est pas dans l'image,
# et un controle garde derriere `command -v` serait reste muet — c'est-a-dire
# inutile precisement le jour ou il aurait servi.
#
# `Dir::Etc::sourceparts=/dev/null` ne garde que notre fichier : on veut savoir
# si NOTRE depot repond, pas si Debian repond. C'est exactement l'operation que
# fait « Mettre a jour grenOS », signature comprise.
if [ -n "$depot" ]; then
    if apt-get update -qq \
            -o Dir::Etc::sourcelist="$depot" \
            -o Dir::Etc::sourceparts=/dev/null \
            -o APT::Get::List-Cleanup=0 > /tmp/grenos-apt 2>&1; then
        dire "maj: depot joignable et signature acceptee"
    else
        dire "maj: depot INJOIGNABLE : $(tr -d "\n" < /tmp/grenos-apt | cut -c1-110)"
    fi
    rm -f /tmp/grenos-apt
fi

# Et dpkg connait-il nos paquets ? Sans entree dans dpkg, apt n'a rien a
# comparer, donc rien a mettre a jour — c'est exactement ce qui manquait.
version=$(dpkg-query -W -f='${Version}' grenos-desktop 2>/dev/null || true)
if [ -n "$version" ]; then
    dire "maj: grenos-desktop $version est installe"
else
    dire "maj: grenos-desktop n'est pas installe, apt n'aura rien a mettre a jour"
fi

# ---- Le son peut-il seulement sortir ? --------------------------------------
#
# « son ouvert, 1 sorties, volume 40%, actif » ne prouve pas qu'on entend
# quelque chose : cela prouve que PipeWire repond. Sur une carte moderne — SOF
# chez Intel, ACP chez AMD, donc presque tous les portables depuis 2019 — ALSA
# a besoin des profils UCM pour savoir par ou sortir le son. Sans eux, la carte
# est vue, annoncee, reglable... et muette.
#
# Ils manquaient : `alsa-ucm-conf` n'est que RECOMMANDE par `libasound2-data`,
# et on construit sans les recommandes. La machine d'essai ne pouvait pas le
# voir — QEMU emule une carte ancienne qui n'en a pas besoin. C'est le meme
# angle mort que `ca-certificates`.
# On compte par `materiel.son_et_video()`, et non par un `find` a nous.
#
# Ce fichier disait « 682 profils ALSA » pendant que la page Son des Reglages
# en affichait 687 : deux comptages du meme chose, l'un par `find`, l'autre par
# `glob(**)`. Aucun des deux n'etait faux, et c'est bien le probleme — deux
# chiffres pour une seule realite finissent par faire douter des DEUX. La
# personne qui lit l'ecran et celle qui lit le journal doivent voir le meme.
profils=$(python3 -c "
import sys
sys.path.insert(0, '/usr/lib/grenos')
import materiel
print(materiel.son_et_video()['profils_alsa'])
" 2>/dev/null || echo "")
if [ -n "$profils" ] && [ "$profils" -gt 0 ] 2>/dev/null; then
    dire "son : $profils profils ALSA, une carte moderne saura par ou sortir"
elif [ -n "$profils" ]; then
    dire "son : AUCUN profil ALSA (alsa-ucm-conf absent) — muet sur une carte recente"
else
    dire "son : impossible de compter les profils ALSA (materiel.py muet)"
fi
if command -v alsactl >/dev/null 2>&1; then
    dire "son : alsactl present, le melangeur sera restaure au demarrage"
else
    dire "son : alsactl absent, une sortie coupee le restera"
fi

# ---- La video se decodera-t-elle, et par quoi ? -----------------------------
#
# « les videos buggent » avec 200 Mbit dans les deux sens : le reseau n'y etait
# pour rien. Il manquait les pilotes VA-API — ajoutes le matin — ET libavcodec,
# sans lequel Firefox ne sait ni lire du H.264 ni atteindre ces pilotes. On le
# dit donc ici, une fois pour toutes, plutot que de l'apprendre par un rapport.
decodeur=$(ls /usr/lib/x86_64-linux-gnu/libavcodec.so.* 2>/dev/null | head -n 1)
if [ -n "$decodeur" ]; then
    dire "video : decodeur $(basename "$decodeur"), le navigateur lira du H.264"
else
    dire "video : AUCUN libavcodec, le navigateur ne lira pas de H.264"
fi
pilotes=$(ls /usr/lib/x86_64-linux-gnu/dri/*_drv_video.so 2>/dev/null | wc -l)
dire "video : $pilotes pilotes VA-API installes"

# ---- La mise a jour au demarrage est-elle en place, et desarmee ? -----------
#
# Demandé : « qu'on doive par exemple redémarrer le PC pour mettre à jour comme
# Windows ». La pièce qui le permet ne doit exister qu'à l'état dormant : si
# elle était active, chaque démarrage installerait des paquets sans qu'on l'ait
# demandé. Le hook le vérifie à la construction ; on le redit ici sur l'image
# démarrée, parce que ce sont deux moments différents et que seul le second est
# celui que vit la personne.
if [ -f /etc/systemd/system/grenos-maj-demarrage.service ]; then
    etat=$(systemctl is-enabled grenos-maj-demarrage.service 2>/dev/null || echo inconnu)
    dire "maj: installation au demarrage presente, etat $etat"
else
    dire "maj: installation au demarrage ABSENTE"
fi
if [ -s /run/grenos/maj-telechargee ]; then
    dire "maj: paquets deja telecharges, l installation sera courte"
fi

# ---- Combien de choses tournent, et lesquelles coûtent le plus ? ------------
#
# Grenofar, le 1er octobre : « fais que ça soit rapide, que ça reste fluide,
# éviter les processus en trop ».
#
# ON MESURE D'ABORD. On ne retire rien dans ce passage, et c'est délibéré.
#
# Retirer un service parce qu'il « a l'air inutile » est la façon la plus sûre
# de casser quelque chose qu'on ne verra que chez lui, des semaines plus tard —
# et ce dépôt a déjà payé cinq fois le prix d'un paquet absent dont l'absence
# ne fait aucun bruit. Il faut donc un chiffre AVANT, puis un chiffre APRÈS,
# sans quoi on ne saura même pas si le ménage a servi.
#
# Et il y a une raison supplémentaire d'être honnête ici : le 2 octobre j'ai
# AJOUTÉ deux démons — irqbalance et earlyoom — en travaillant sur les
# performances, c'est-à-dire l'inverse exact de ce qu'il demandait dans la même
# phrase. Les deux se défendent (l'un répartit les interruptions sur les
# cœurs, l'autre évite le gel total quand la mémoire manque), mais ils comptent
# dans ce chiffre et il ne faut pas les cacher.
services=$(systemctl list-units --type=service --state=running --no-legend \
           --no-pager 2>/dev/null | wc -l)
processus=$(ps -e --no-headers 2>/dev/null | wc -l)
dire "perf : $services service(s) en marche, $processus processus"

# ET LEURS NOMS, PARCE QU'UN COMPTE NE DÉSIGNE PERSONNE.
#
# « 16 services » ne dit pas lequel est de trop. Pour retirer quoi que ce soit
# il faut pouvoir lire la liste — et pour la lire sans ouvrir une capture, il
# faut qu'elle tienne sur le port série.
#
# On enlève le suffixe `.service`, qui est le même seize fois et ne porte
# aucune information : il doublerait la longueur de la ligne pour rien.
noms=$(systemctl list-units --type=service --state=running --no-legend \
       --no-pager 2>/dev/null | awk '{print $1}' | sed 's/\.service$//' \
       | sort | tr '\n' ' ')
dire "perf : en marche = ${noms:-inconnus}"

# Les trois qui prennent le plus de mémoire résidente, avec leur taille. C'est
# la seule liste qui désigne un coupable plutôt qu'un soupçon : un service qui
# tourne sans rien consommer ne coûte rien à personne.
gourmands=$(ps -eo rss=,comm= --sort=-rss 2>/dev/null | head -n 3 \
            | awk '{printf "%s %dMio ", $2, $1/1024}')
dire "perf : les plus gourmands = ${gourmands:-inconnus}"

# ---- Le magasin peut-il vraiment installer ? --------------------------------
#
# La machine d'integration ouvrait GrenPlace et comptait ses applications. Elle
# n'a jamais appuye sur « Installer ». C'est exactement par la que le defaut du
# 25 septembre est passe : sans `ca-certificates`, flatpak ne pouvait pas
# verifier le certificat de Flathub, et **aucune application ne s'installait**.
# Grenofar l'a trouve en une minute d'usage ; la CI ne pouvait pas le voir,
# parce qu'elle regardait une vitrine sans jamais entrer dans le magasin.
#
# On n'installe rien pour de vrai — ce serait des centaines de megaoctets et
# plusieurs minutes. On demande a Flathub les metadonnees d'une application du
# catalogue : cela exerce le reseau, le TLS et le depot, c'est-a-dire tout ce
# qui cassait.
if command -v flatpak >/dev/null 2>&1; then
    if timeout 90 flatpak remote-info flathub com.valvesoftware.Steam \
            > /tmp/grenos-flathub 2>&1; then
        dire "magasin : Flathub repond, une application peut s'installer"
    else
        dire "magasin : FLATHUB INJOIGNABLE : $(tr -d "\n" < /tmp/grenos-flathub | cut -c1-110)"
    fi
    rm -f /tmp/grenos-flathub
else
    dire "magasin : flatpak absent, le magasin ne pourra rien installer"
fi

# ---- Y a-t-il un disque ou s'installer ? ------------------------------------
#
# L'installateur ne peut rien proposer si le systeme ne voit aucun disque, et
# c'est une panne qu'on decouvrirait au pire moment : devant l'ecran de
# Calamares, sur la machine de quelqu'un. Le dire ici coute une ligne.
disques=$(lsblk -dn -o NAME,SIZE,TYPE 2>/dev/null \
          | awk '$3 == "disk" { printf "%s %s ", $1, $2 }')
if [ -n "$disques" ]; then
    dire "disques : $disques"
else
    dire "disques : aucun, l'installateur n'aurait rien a proposer"
fi

# Et ce que la page Materiel montre vraiment.
#
# `lsblk` ci-dessus compte tout, y compris le lecteur de disquette que QEMU
# invente : il dit « 3 disques » la ou la personne en voit deux. Ce n'est donc
# pas une preuve de ce qu'elle lit. On appelle la MEME fonction que les
# Reglages — une preuve qui passe par un autre chemin que le produit ne prouve
# pas le produit. C'est la lecon de `ca-certificates`, que l'essai en conteneur
# installait lui-meme.
vus=$(python3 -c "
import sys
sys.path.insert(0, '/usr/lib/grenos')
import materiel
d = materiel.disques()
print('%d|%s' % (len(d), ', '.join(
    '%s %s' % (x['nom'], materiel.genre_du_disque(x)) for x in d)))
" 2>/dev/null)
if [ -n "$vus" ]; then
    dire "disques vus par les Reglages : ${vus%%|*} — ${vus#*|}"
else
    dire "disques vus par les Reglages : la lecture a echoue"
fi

# ---- Ce que la personne ecrit est-il garde ? --------------------------------
#
# C'est la promesse de la machine VirtualBox, ecrite sur la page de
# telechargement : « tout ce que tu fais est garde sur le disque de la
# machine ». Elle tient a une partition ext4 etiquetee « persistence » que
# live-boot doit trouver au demarrage. Si elle ne la trouve pas, rien ne le
# dit : le bureau s'ouvre normalement, et tout disparait a l'extinction.
# `xargs echo` met tout sur une ligne sans qu'on ait à écrire une séquence
# d'échappement : celles-ci ne survivent pas toujours à une réécriture, et
# c'est la quatrième fois aujourd'hui que j'en perds une.
garde=$(ls /run/live/persistence 2>/dev/null | head -2 | xargs echo)
if [ -n "$garde" ]; then
    dire "persistance : active sur $garde"
else
    dire "persistance : aucune, ce qui sera ecrit disparaitra a l'extinction"
fi

# ---- OU vont les fichiers de la partition, exactement ? ---------------------
#
# Question restee sans reponse le 27 septembre au matin, et elle n'est pas
# academique : un fichier POSE dans la partition avant le demarrage
# (`etc/grenos/essai-charge`) n'est jamais arrive jusqu'au systeme. La
# construction disait « marqueur pose dans le volume », la session ne le
# trouvait pas, et j'ai contourne par SMBIOS sans comprendre.
#
# Ce que cela empeche, au-dela de l'essai : preparer une machine avant de la
# livrer, et — le jour ou on voudra le prouver — armer « Mettre a jour et
# redemarrer » depuis l'exterieur pour voir un vrai redemarrage.
#
# Deux hypotheses donnent la meme absence, et c'est pour cela qu'il faut
# regarder au lieu de deviner : ou bien live-boot n'utilise pas la racine de la
# partition comme couche superieure, ou bien il l'utilise et quelque chose
# efface. La reponse tient en deux listes cote a cote.
for point in /run/live/persistence/*; do
    [ -d "$point" ] || continue
    dedans=$(ls -A "$point" 2>/dev/null | head -6 | xargs echo)
    dire "persistance : $point contient [${dedans:-rien}]"
done
# Et ce que la racine montre de ces memes noms. `persistence.conf` est le
# temoin ideal : live-boot l'exige a la racine de la partition, donc il EXISTE
# a coup sur. S'il se voit aussi a la racine du systeme, la couche superieure
# est bien la partition entiere, et l'absence du marqueur vient d'ailleurs.
if [ -e /persistence.conf ]; then
    dire "persistance : /persistence.conf se voit depuis la racine — la couche est la partition"
else
    dire "persistance : /persistence.conf ne se voit PAS — la couche n'est pas la racine de la partition"
fi

# ---- Qui ecrit le journal d'arret sur tty1 ? --------------------------------
#
# « Enleve les logs quand on eteint le PC » est demande depuis le 23 septembre.
# Deux tiers sont faits : les messages du DEMARRAGE restes sur tty1 sont
# effaces, et la sonde de disquette a disparu. Le tiers restant est le vrai
# journal d'arret de systemd — les lignes « Stopped ... » — et il resiste a
# `systemd.show_status=false` sur la ligne de commande comme a `ShowStatus=no`
# dans la configuration : mesure le 30 septembre, 10481 pixels d'encre avant,
# 10745 apres. Aucun effet.
#
# ET LA PISTE QUE J'AVAIS NOMMEE ETAIT FAUSSE. J'avais ecrit que la reponse
# etait de faire apparaitre la splash Plymouth d'arret. Lu dans le paquet
# (plymouth 24.004.60-5, unite plymouth-poweroff.service) :
#
#     Before=systemd-poweroff.service
#
# C'est-a-dire a l'instant FINAL, une fois que toute la transaction d'arret a
# deja imprime ses lignes. Meme affichee, elle n'aurait jamais couvert ce
# journal — et la photo le confirme : les deux premieres captures sont noires,
# le texte n'arrive qu'a la troisieme. J'aurais repare cela et annonce que
# c'etait fait.
#
# Donc on mesure, au lieu de deviner une neuvieme fois, et on mesure la seule
# chose qui decide : ce que PID 1 croit. S'il dit que l'affichage est eteint et
# que le texte sort quand meme, ce n'est pas lui qui ecrit, et tout reglage de
# son affichage est perdu d'avance. S'il dit qu'il est allume, notre reglage ne
# le rejoint pas, et c'est une reparation toute differente. Les deux reponses
# sont utiles ; l'absence de reponse l'est aussi, et elle est dite telle quelle
# plutot que rendue en vert.
verdict=$(systemctl show --property=ShowStatus 2>/dev/null | sed 's/^ShowStatus=//')
case "$verdict" in
    "") dire "extinction : PID 1 n'expose pas ShowStatus — la question reste ouverte" ;;
    *)  dire "extinction : PID 1 dit ShowStatus=$verdict" ;;
esac

# Et notre option atteint-elle seulement le noyau ? La poser dans un fichier ne
# prouve pas qu'elle arrive : c'est exactement la faute de la regle polkit, qui
# nommait une action inexistante, et des sept cles libfm posees dans la
# mauvaise section.
case "$(cat /proc/cmdline 2>/dev/null)" in
    *systemd.show_status=false*)
        dire "extinction : la ligne de commande porte bien systemd.show_status=false" ;;
    *)
        dire "extinction : systemd.show_status=false n'est PAS sur la ligne de commande" ;;
esac

# ---- Et ce qu'elle a ecrit HIER est-il revenu ? -----------------------------
#
# « Active » n'est pas « ca marche ». On prouvait que live-boot avait trouve sa
# partition ; on n'a JAMAIS prouve qu'un fichier ecrit a un demarrage soit
# encore la au suivant — et c'est pourtant la phrase exacte de la page de
# telechargement, « tout ce que tu fais est garde sur le disque de la machine ».
# Une machine d'essai qui ne demarre qu'une fois ne peut pas repondre.
#
# Le doute est venu d'un fait precis : un fichier POSE dans la partition de
# persistance avant le demarrage n'est pas arrive jusqu'au systeme (le marqueur
# de charge du 27 septembre). Deposer et garder sont deux mecanismes
# differents, et l'echec du premier ne condamne pas le second — mais il
# interdit de continuer a le supposer.
#
# Le temoin est ecrit par la session, dans le dossier de la personne, parce que
# c'est exactement ce que la promesse designe. On le lit ici, au demarrage
# suivant, avant que la session ne le reecrive.
# On compare l'identifiant de demarrage, pas l'heure. Ce controle a d'abord
# lu une date, et il a annonce « revenu » des le PREMIER demarrage : il attend
# jusqu'a quatre-vingt-dix secondes sur Flathub avant d'arriver ici, et la
# session a ecrit le temoin entre-temps. Il relisait le sien.
#
# Une mesure fausse ne se contredit pas : celle-la etait verte, coherente, et
# elle ne prouvait rien. Le noyau tire un `boot_id` neuf a chaque demarrage,
# donc un temoin qui en porte un autre vient forcement d'avant — et aucune
# course ne peut plus s'y glisser.
temoin="$TEMOIN_AU_DEMARRAGE"
demarrage=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
if [ -z "$temoin" ]; then
    dire "persistance : aucun temoin — premier demarrage, ou rien n'a ete garde"
elif [ "${temoin%% *}" = "$demarrage" ]; then
    dire "persistance : le temoin est de CE demarrage, il ne prouve rien"
else
    dire "persistance : un fichier d'un demarrage PRECEDENT est revenu (${temoin#* })"
fi

# CE QUE TOUT CE QUI PRECEDE A COUTE.
#
# Mesuré : **1 seconde** (run 36970232858). J'avais écrit plus haut que cela
# pouvait prendre quatre-vingt-dix secondes ; c'était un pire cas théorique que
# je donnais pour le coût réel, et cette ligne-ci m'a démenti au premier
# passage. Elle a payé sa place le jour même.
#
# Ce qui suit est la boucle d'attente : quinze minutes de réveils toutes les
# deux secondes. Elle ne figure pas dans ce chiffre, et c'est pourtant elle qui
# pèse — mais elle ne peut pas se mesurer ici, puisqu'on est dedans.
FIN_SONDE=$(date +%s 2>/dev/null || echo 0)
if [ "$DEBUT_SONDE" -gt 0 ] && [ "$FIN_SONDE" -ge "$DEBUT_SONDE" ]; then
    dire "perf : la sonde a pris $((FIN_SONDE - DEBUT_SONDE))s — autant d epargne"
fi

vu_session=0
i=0
# Un quart d'heure, et pas davantage. La machine d'integration a rendu son
# verdict bien avant, et sur la machine de quelqu'un ce service n'a plus rien
# a dire : le laisser veiller une heure, c'est un processus qui se reveille
# trois mille six cents fois pour rien.
while [ "$i" -lt 450 ]; do
    # Les billets deposes par le bureau, dans l'ordre ou ils sont arrives.
    for billet in "$BOITE"/*; do
        [ -f "$billet" ] || continue
        while IFS= read -r ligne; do
            [ -n "$ligne" ] && dire "$ligne"
        done < "$billet"
        rm -f "$billet"
    done

    if [ "$vu_session" -eq 0 ]; then
        if [ -e "$MARQUE" ]; then
            dire "session de bureau ouverte"
            vu_session=1
        elif command -v loginctl >/dev/null 2>&1 && \
             loginctl list-sessions --no-legend 2>/dev/null | \
             awk '$3 != "lightdm" && $3 != "" { trouve = 1 } END { exit !trouve }'; then
            # Deuxieme chemin, au cas ou le bureau n'aurait pas pu ecrire son
            # fichier : une session graphique ouverte par quelqu'un d'autre que
            # le gestionnaire de connexion lui-meme.
            dire "session de bureau ouverte"
            vu_session=1
        fi
    fi

    sleep 2
    i=$((i + 1))
done
