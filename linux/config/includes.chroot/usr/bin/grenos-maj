#!/bin/sh
# La mise à jour de grenOS, depuis grenOS : les paquets du système et les
# nôtres, dans une fenêtre, avec ce qui se passe sous les yeux.
#
# Deux scripts plutôt qu'une longue ligne : celui du travail, qui tourne en
# root, et celui de la fenêtre, qui l'appelle et attend une touche avant de se
# fermer. `x-terminal-emulator -e <script>` est la seule forme que tous les
# terminaux comprennent de la même façon — `-e sh -c "..."` est redécoupé
# différemment par chacun.

set -e

TITRE="Mise à jour de grenOS"
DOSSIER="${XDG_CACHE_HOME:-$HOME/.cache}/grenos"
mkdir -p "$DOSSIER"
TRAVAIL="$DOSSIER/maj.sh"
FENETRE="$DOSSIER/maj-fenetre.sh"

cat > "$TRAVAIL" <<'EOF'
#!/bin/sh
set -e
echo "Lecture des dépôts..."
apt-get update
echo
echo "Ce qui va être installé :"
apt-get -s upgrade | grep -E '^Inst' | sed 's/^Inst /  - /' || echo "  (rien : le système est à jour)"
echo
echo "Installation..."
DEBIAN_FRONTEND=noninteractive apt-get -y upgrade
echo
echo "Terminé. Les applications ouvertes utiliseront la nouvelle version après leur redémarrage."
EOF
chmod +x "$TRAVAIL"

# En root, il n'y a ni autorisation à demander ni fenêtre à ouvrir.
if [ "$(id -u)" = 0 ]; then
    "$TRAVAIL"
    exit 0
fi

# Tant qu'aucun mot de passe n'est défini, sudo passe sans rien demander ;
# sinon pkexec ouvre la fenêtre qui le demande.
if sudo -n true 2>/dev/null; then
    LANCEUR="sudo -n"
else
    LANCEUR="pkexec"
fi

if ! command -v x-terminal-emulator >/dev/null 2>&1; then
    $LANCEUR "$TRAVAIL"
    exit 0
fi

cat > "$FENETRE" <<EOF
#!/bin/sh
echo "$TITRE"
echo
$LANCEUR "$TRAVAIL"
echo
echo "Entrée pour fermer."
read x
EOF
chmod +x "$FENETRE"

exec x-terminal-emulator -T "$TITRE" -e "$FENETRE"
