#!/usr/bin/env python3
"""Mettre à jour grenOS : une fenêtre, pas un terminal.

Ce que ça fait est simple — lire les dépôts, dire ce qui va changer, installer.
Ce que ça ne fait pas, volontairement : afficher un mur de texte noir. Une
barre qui avance, une phrase qui dit où l'on en est, et le détail complet
derrière un bouton pour qui veut le lire.

Le travail lui-même est dans `/usr/lib/grenos/maj.py`, partagé avec la page
Mises à jour des Réglages : une seule façon de mettre à jour la machine.
"""
import sys

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

import grenosui  # noqa: E402
import maj  # noqa: E402


class Maj(Gtk.Window):
    def __init__(self):
        super().__init__(title="Mise à jour de grenOS")
        self.set_default_size(680, 430)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)

        colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        colonne.set_border_width(26)
        self.add(colonne)

        colonne.pack_start(
            grenosui.titre("Mise à jour",
                           "Les nouveautés de grenOS et les correctifs de sécurité de "
                           "Debian, sans retélécharger l'image."),
            False, False, 0)

        self.etat = Gtk.Label(label="Prêt.", xalign=0)
        self.barre = Gtk.ProgressBar()
        self.bouton = grenosui.bouton("Vérifier et installer", self.demarrer, "principal")

        self.details = Gtk.Expander(label="Voir le détail")
        vue = Gtk.ScrolledWindow()
        vue.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        vue.set_size_request(-1, 190)
        self.texte = Gtk.TextView()
        self.texte.set_editable(False)
        self.texte.set_monospace(True)
        vue.add(self.texte)
        self.details.add(vue)

        colonne.pack_start(grenosui.carte(self.etat, self.barre, self.bouton), False, False, 0)
        colonne.pack_start(self.details, True, True, 0)

        self.travail = maj.Travail(
            lambda t: GLib.idle_add(self.etat.set_text, t),
            lambda p: GLib.idle_add(self.barre.set_fraction, min(max(p, 0.0), 1.0)),
            self.journal, self.fini)

    def journal(self, ligne):
        def ajouter():
            tampon = self.texte.get_buffer()
            tampon.insert(tampon.get_end_iter(), ligne + "\n")
            return False
        GLib.idle_add(ajouter)

    def demarrer(self):
        if self.travail.demarrer():
            self.bouton.set_sensitive(False)
            self.bouton.get_child().get_children()[-1].set_text("En cours…")

    def fini(self, message, bien):
        def remettre():
            self.etat.set_text(message)
            self.bouton.set_sensitive(True)
            self.bouton.get_child().get_children()[-1].set_text("Vérifier et installer")
            if not bien:
                self.details.set_expanded(True)
            return False
        GLib.idle_add(remettre)


def main():
    grenosui.habiller()
    fenetre = Maj()
    fenetre.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
