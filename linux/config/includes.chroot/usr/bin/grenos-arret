#!/usr/bin/env python3
"""Fermer la session, redémarrer, éteindre.

Trois gestes qu'on ne veut jamais déclencher par erreur : la fenêtre demande,
Échap annule, et le bouton d'extinction est le seul en rouge.
"""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/grenos")

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gtk  # noqa: E402

import grenosui  # noqa: E402

GESTES = [
    ("Fermer la session", "Revenir à l'écran de connexion.", ["openbox", "--exit"], ""),
    ("Redémarrer", "Éteindre puis rallumer la machine.", ["systemctl", "reboot"], ""),
    ("Éteindre", "Arrêter complètement la machine.", ["systemctl", "poweroff"], "danger"),
]

ATTENTE = "/run/grenos/maj"
TRAVAUX = "/var/lib/grenos/au-prochain-demarrage"


def combien_attendent():
    """Combien de paquets attendent d'être installés, ou zéro."""
    try:
        with open(ATTENTE, encoding="utf-8") as fichier:
            return int(fichier.read().strip())
    except (OSError, ValueError):
        return 0


def gestes():
    """Les gestes offerts, avec la mise à jour en tête s'il y en a une.

    Demandé mot pour mot : « qu'on doive par exemple redémarrer le PC pour
    mettre à jour comme Windows ». Le bouton n'apparaît que lorsqu'il y a
    vraiment quelque chose à installer — une option permanente qui ne fait
    jamais rien, on cesse de la lire.

    Ce qu'il fait tient en deux gestes : armer le service qui installe avant
    l'ouverture du bureau, puis redémarrer. Le service se désarme lui-même au
    premier démarrage, donc il n'y a pas d'état à nettoyer, et une machine
    éteinte brutalement entre les deux redémarre simplement sans rien
    installer.
    """
    combien = combien_attendent()
    travaux = combien_de_travaux()
    if combien <= 0 and travaux <= 0:
        return GESTES

    # Deux choses peuvent attendre le redémarrage, et le bouton doit dire
    # laquelle : des paquets à installer, ou des changements de système mis en
    # attente. « Mettre à jour » pour trois réglages système serait un
    # mensonge, et un bouton qui ment est un bouton qu'on n'ose plus presser.
    morceaux = []
    if combien > 0:
        morceaux.append("%d %s" % (
            combien, "mise à jour" if combien == 1 else "mises à jour"))
    if travaux > 0:
        morceaux.append("%d %s" % (
            travaux, "changement" if travaux == 1 else "changements"))
    titre = "Mettre à jour et redémarrer" if combien > 0 else "Appliquer et redémarrer"
    return [(
        titre,
        "Poser %s avant d'ouvrir le bureau, puis redémarrer."
        % " et ".join(morceaux),
        ["sh", "-c",
         "systemctl enable grenos-maj-demarrage.service && systemctl reboot"],
        "accent",
    )] + GESTES


def combien_de_travaux():
    """Combien de changements de système attendent le prochain démarrage.

    Ils vivent dans `/var/lib`, pas dans `/run` : `/run` est vidé à
    l'extinction, ce qui est exactement ce qu'une file censée traverser un
    redémarrage ne doit pas faire. Le sous-dossier `faits/` garde ce qui a déjà
    été appliqué et ne compte pas.
    """
    try:
        return len([n for n in os.listdir(TRAVAUX) if n[:1].isdigit()])
    except OSError:
        return 0


def faire(commande):
    Gtk.main_quit()
    subprocess.Popen(commande, start_new_session=True)


class Arret(Gtk.Window):
    def __init__(self):
        super().__init__(title="Éteindre grenOS")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.touche)

        colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        colonne.set_border_width(24)
        colonne.set_size_request(380, -1)
        self.add(colonne)

        colonne.pack_start(grenosui.titre("Fin de session", grenosui.adresse()), False, False, 0)

        for nom, note, commande, genre in gestes():
            bouton = Gtk.Button()
            for classe in genre.split():
                bouton.get_style_context().add_class(classe)
            contenu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            titre = Gtk.Label(label=nom, xalign=0)
            titre.get_style_context().add_class("entree-titre")
            sous = Gtk.Label(label=note, xalign=0)
            sous.get_style_context().add_class("sous")
            contenu.pack_start(titre, False, False, 0)
            contenu.pack_start(sous, False, False, 0)
            bouton.add(contenu)
            bouton.connect("clicked", lambda _, c=commande: faire(c))
            colonne.pack_start(bouton, False, False, 0)

        colonne.pack_start(grenosui.bouton("Annuler", Gtk.main_quit, "discret"), False, False, 6)

    def touche(self, _widget, evenement):
        if Gdk.keyval_name(evenement.keyval) == "Escape":
            Gtk.main_quit()
            return True
        return False


def main():
    grenosui.habiller()
    fenetre = Arret()
    fenetre.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
