"""

# Les dossiers de « Accès rapide », dans l'ordre de Windows.
#
# On demande leur chemin à GLib plutôt que de coller « ~/Téléchargements » :
# le 23 septembre, le bureau cherchait ses icônes dans `~/Desktop` alors que
# le dossier s'appelle `Bureau`, et il est resté vide sans que rien ne le
# dise. GLib lit `user-dirs.dirs`, qui est la vérité.
ACCES_RAPIDE = (
    ("Bureau", GLib.UserDirectory.DIRECTORY_DESKTOP, "user-desktop"),
    ("Téléchargements", GLib.UserDirectory.DIRECTORY_DOWNLOAD, "folder-download"),
    ("Documents", GLib.UserDirectory.DIRECTORY_DOCUMENTS, "folder-documents"),
    ("Images", GLib.UserDirectory.DIRECTORY_PICTURES, "folder-pictures"),
    ("Musique", GLib.UserDirectory.DIRECTORY_MUSIC, "folder-music"),
    ("Vidéos", GLib.UserDirectory.DIRECTORY_VIDEOS, "folder-videos"),
)


def taille_lisible(octets):
    """Une taille en français : « 1,5 Go », jamais « 1.5 GB ».

    Le point décimal anglais s'est affiché pendant des jours dans Jeux et dans
    le gestionnaire de tâches sans que personne ne le voie, parce qu'une phrase
    sans accent et un nombre à l'anglaise se lisent encore. `grenosui.nombre()`
    est la seule façon d'écrire un nombre ici.
    """
    if octets is None:
        return ""
    if octets < 1024:
        return "%d o" % octets
    for seuil, unite in ((1024 ** 3, "Go"), (1024 ** 2, "Mo"), (1024, "Ko")):
        if octets >= seuil:
            return "%s %s" % (grenosui.nombre(octets / seuil), unite)
    return "%d o" % octets


def nom_personnel():
    """Le nom à afficher pour le dossier de la personne.

    POURQUOI CETTE FONCTION EXISTE : j'écrivais `grenosui.identite()` tel quel.
    Elle rend un **dictionnaire**, pas une chaîne — et GTK a affiché, dans le
    fil d'Ariane et dans « Ce PC », tout le dictionnaire Python :

        {'login': 'ci', 'nom': 'ci', 'machine': 'grenos', 'clavier': 'fr', …}

    Aucune ligne du port série ne pouvait le dire : la session a annoncé
    « fichiers ouvert, 6 element(s) », ce qui est vrai et parfaitement inutile
    ici. Il a fallu ouvrir la capture et la regarder — la leçon du 24 septembre,
    qui vaut encore : *une capture qu'on ne regarde pas ne prouve que l'absence
    d'écran noir.*

    Les quatre autres programmes qui appellent `identite()` l'indexent tous
    (`grenos-shell`, `grenos-parametres`, `grenos-bienvenue`). J'étais le seul
    à l'afficher brut.
    """
    try:
        valeurs = grenosui.identite()
    except Exception:                                       # noqa: BLE001
        return "Dossier personnel"
    if not isinstance(valeurs, dict):
        return str(valeurs) or "Dossier personnel"
    return valeurs.get("nom") or valeurs.get("login") or "Dossier personnel"


def genre_du_fichier(info):
    """Le mot de la colonne « Type », en français.

    GIO sait le dire, et c'est ce qu'il faut utiliser : le 2 octobre, la vue
    Détails de pcmanfm affichait « folder » sur chaque ligne, et la cause
    n'était pas notre locale mais `shared-mime-info`, dont le fichier français
    ne traduit pas `inode/directory`. Nous avons comblé ce trou par un XML
    dans `<MIME>/packages/`, donc GIO répond « Dossier » ici aussi.
    """
    try:
        genre = info.get_content_type()
        if genre:
            return Gio.content_type_get_description(genre) or ""
    except Exception:                                       # noqa: BLE001
        pass
    return ""


class Explorateur(Gtk.Window):
    def __init__(self, depart=None):
        super().__init__(title="Explorateur de fichiers")
        grenosui.poser_taille(self, 1000, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("grenos-fichiers")
        self.connect("destroy", Gtk.main_quit)
        grenosui.chronometrer(self, "Explorateur de fichiers")

        self.histoire = []
        self.rang = -1
        # Le presse-papier est a NOUS, pas celui de X : on colle des fichiers,
        # pas du texte, et deux explorateurs ouverts ne doivent pas se marcher
        # dessus. `couper` dit si le collage deplace ou duplique.
        self.presse_papier = []
        self.couper = False
        # LA BARRE D ETAT DISAIT « 10 masques » ET RIEN NE PERMETTAIT DE LES
        # VOIR. C est ma propre faute, et c est la forme que ce depot attrape
        # depuis des semaines : une promesse a l ecran sans rien derriere.
        # Windows a la meme bascule, au meme raccourci.
        self.montrer_caches = False
        self.dossier = depart or os.path.expanduser("~")

        corps = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(corps)
        corps.pack_start(self._barre_outils(), False, False, 0)

        milieu = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        corps.pack_start(milieu, True, True, 0)
        milieu.pack_start(self._volet(), False, False, 0)
        milieu.pack_start(self._liste(), True, True, 0)

        self.etat = Gtk.Label(xalign=0.0)
        self.etat.set_name("barre-etat")
        corps.pack_start(self.etat, False, False, 0)

        self.connect("key-press-event", self.au_clavier)

    # ---- La barre du haut ---------------------------------------------------
    def _barre_outils(self):
        barre = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        barre.set_name("barre-outils")

        def outil(nom_icone, infobulle, action):
            bouton = Gtk.Button()
            bouton.set_image(grenosui.icone(nom_icone, 18))
            bouton.set_tooltip_text(infobulle)
            bouton.get_style_context().add_class("bouton-outil")
            bouton.set_relief(Gtk.ReliefStyle.NONE)
            bouton.connect("clicked", action)
            barre.pack_start(bouton, False, False, 0)
            return bouton

        self.bouton_precedent = outil("go-previous", "Précédent", self.au_precedent)
        self.bouton_suivant = outil("go-next", "Suivant", self.au_suivant)
        self.bouton_parent = outil("go-up", "Dossier parent", self.au_parent)
        outil("view-refresh", "Actualiser", lambda _b: self.peupler())
        outil("folder-new", "Nouveau dossier",
              lambda _b: self.action_nouveau_dossier())

        # LA BARRE D'ADRESSE DE WINDOWS A DEUX VISAGES, et c'est le second
        # qu'on n'avait pas : des boutons cliquables, et — sur Ctrl+L, F4 ou
        # un clic dans le vide à droite du chemin — un champ où l'on TAPE un
        # chemin. Les deux se relaient dans la même place, comme là-bas.
        self.fil = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.fil.set_name("fil-chemin")

        clic_vide = Gtk.EventBox()
        clic_vide.add(self.fil)
        clic_vide.connect("button-press-event", self._clic_dans_le_fil)

        self.champ_chemin = Gtk.Entry()
        self.champ_chemin.set_name("champ-chemin")
        self.champ_chemin.connect("activate", self._chemin_tape)

        self.adresse = Gtk.Stack()
        self.adresse.set_transition_type(Gtk.StackTransitionType.NONE)
        self.adresse.add_named(clic_vide, "miettes")
        self.adresse.add_named(self.champ_chemin, "champ")
        barre.pack_start(self.adresse, True, True, 6)

        self.cherche = Gtk.SearchEntry()
        self.cherche.set_placeholder_text("Rechercher")
        self.cherche.set_width_chars(18)
        self.cherche.connect("search-changed", lambda _e: self.filtrer())
        barre.pack_end(self.cherche, False, False, 0)
        return barre

    # ---- Le volet de gauche -------------------------------------------------
    def _volet(self):
        """« Accès rapide » puis « Ce PC » — l'ordre et les mots de Windows.

        C'est exactement ce que libfm ne pouvait pas faire, et c'est toute la
        raison d'être de ce fichier.
        """
        volet = Gtk.ScrolledWindow()
        volet.set_name("volet-fichiers")
        volet.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        volet.set_size_request(200, -1)

        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        volet.add(boite)

        boite.pack_start(self._titre_section("ACCÈS RAPIDE"), False, False, 0)
        rapide = Gtk.ListBox()
        rapide.set_selection_mode(Gtk.SelectionMode.SINGLE)
        boite.pack_start(rapide, False, False, 0)
        for nom, cle, nom_icone in ACCES_RAPIDE:
            chemin = GLib.get_user_special_dir(cle)
            if chemin and os.path.isdir(chemin):
                rapide.add(self._ligne_volet(nom, nom_icone, chemin))
        rapide.connect("row-activated", self._volet_choisi)
        rapide.connect("button-press-event", self._volet_clique)

        boite.pack_start(self._titre_section("CE PC"), False, False, 0)
        self.liste_pc = Gtk.ListBox()
        self.liste_pc.set_selection_mode(Gtk.SelectionMode.SINGLE)
        boite.pack_start(self.liste_pc, False, False, 0)
        self.liste_pc.connect("row-activated", self._volet_choisi)
        self.liste_pc.connect("button-press-event", self._volet_clique)

        # Les disques sont demandés au même objet que tout le reste du bureau,
        # `Gio.VolumeMonitor` — celui que la session interroge déjà pour écrire
        # la ligne « emplacements : » sur le port série. Une seule source,
        # sinon les deux finissent par diverger.
        self.moniteur = Gio.VolumeMonitor.get()
        for signal_ in ("volume-added", "volume-removed", "mount-added",
                        "mount-removed"):
            self.moniteur.connect(signal_, lambda *_a: self.peupler_disques())
        return volet

    def _titre_section(self, texte):
        etiquette = Gtk.Label(label=texte, xalign=0.0)
        etiquette.get_style_context().add_class("section-volet")
        return etiquette

    def _ligne_volet(self, nom, nom_icone, chemin, volume=None):
        ligne = Gtk.ListBoxRow()
        ligne.chemin = chemin
        ligne.volume = volume
        boite = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        boite.pack_start(grenosui.icone(nom_icone, 18), False, False, 0)
        # Coupee par des points de suspension, et jamais plus large que le
        # volet. Sans cela, UN SEUL nom long repousse la liste des fichiers
        # hors de l ecran — c est exactement ce qu a fait le dictionnaire
        # affiche en entier, et la mise en page entiere en dependait.
        etiquette = Gtk.Label(label=nom, xalign=0.0)
        etiquette.set_ellipsize(Pango.EllipsizeMode.END)
        etiquette.set_max_width_chars(18)
        boite.pack_start(etiquette, True, True, 0)
        ligne.add(boite)
        return ligne

    def peupler_disques(self):
        """« Ce PC » : le dossier personnel, puis les disques de la machine."""
        for vieux in self.liste_pc.get_children():
            self.liste_pc.remove(vieux)

        maison = os.path.expanduser("~")
        self.liste_pc.add(self._ligne_volet(nom_personnel(), "user-home", maison))
        self.liste_pc.add(self._ligne_volet("Système de fichiers", "drive-harddisk", "/"))

        for volume in self.moniteur.get_volumes():
            nom = volume.get_name() or "Disque"
            monte = volume.get_mount()
            chemin = None
            if monte is not None:
                racine = monte.get_root()
                chemin = racine.get_path() if racine else None
            # UN VOLUME NON MONTÉ EST QUAND MÊME MONTRÉ, et c'est le point :
            # jusqu'au 7 octobre, cliquer dessus ne faisait RIEN. udisks2
            # demande `filesystem-mount-system` pour un disque interne, qui
            # vaut `auth_admin_keep` — un mot de passe, sur une machine qui
            # n'en a pas. Notre règle polkit l'autorise désormais, et la
            # session le prouve à chaque démarrage (« montage : … interne
            # oui »). Sans cette règle, cette ligne serait une promesse à
            # l'écran sans rien derrière.
            self.liste_pc.add(self._ligne_volet(nom, "drive-harddisk", chemin,
                                                volume=volume))
        self.liste_pc.show_all()

    def _volet_choisi(self, _liste, ligne):
        if getattr(ligne, "chemin", None):
            self.aller(ligne.chemin)
        elif getattr(ligne, "volume", None) is not None:
            self.monter_puis_ouvrir(ligne.volume)

    def _volet_clique(self, liste, evenement):
        """Un seul clic suffit dans le volet, comme dans Windows."""
        if evenement.button == 1 and evenement.type == Gdk.EventType.BUTTON_PRESS:
            ligne = liste.get_row_at_y(int(evenement.y))
            if ligne is not None:
                liste.select_row(ligne)
                self._volet_choisi(liste, ligne)
                return True
        return False

    def monter_puis_ouvrir(self, volume):
        """Monter un disque, puis entrer dedans — sans figer la fenêtre."""
        def fini(source, resultat):
            try:
                source.mount_finish(resultat)
            except GLib.Error as souci:
                self.etat.set_text("Ce disque n'a pas pu être ouvert : %s"
                                   % souci.message)
                return
            monte = source.get_mount()
            racine = monte.get_root() if monte else None
            chemin = racine.get_path() if racine else None
            if chemin:
                self.aller(chemin)
            self.peupler_disques()

        self.etat.set_text("Ouverture du disque…")
        volume.mount(Gio.MountMountFlags.NONE, Gtk.MountOperation(parent=self),
                     None, fini)

    # ---- La liste ----------------------------------------------------------
    def _liste(self):
        cadre = Gtk.ScrolledWindow()
        cadre.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)

        # icône, nom, modifié, type, taille affichée, chemin, est un dossier,
        # taille pour le tri, date pour le tri
        self.modele = Gtk.ListStore(str, str, str, str, str, str, bool, "gint64",
                                    "gint64")
        self.filtre = self.modele.filter_new()
        self.filtre.set_visible_func(self._visible)
        self.tri = Gtk.TreeModelSort(model=self.filtre)

        self.vue = Gtk.TreeView(model=self.tri)
        self.vue.set_name("liste-fichiers")
        self.vue.set_rules_hint(False)
        self.vue.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        self.vue.connect("row-activated", self.au_double_clic)
        self.vue.connect("button-press-event", self.au_clic_droit)
        self.vue.get_selection().connect("changed", lambda _s: self.dire_le_compte())

        # La colonne Nom porte l'icône, comme dans Windows.
        colonne = Gtk.TreeViewColumn("Nom")
        dessin = Gtk.CellRendererPixbuf()
        colonne.pack_start(dessin, False)
        colonne.add_attribute(dessin, "icon-name", 0)
        texte = Gtk.CellRendererText()
        texte.set_property("ellipsize", 3)  # PANGO_ELLIPSIZE_END
        colonne.pack_start(texte, True)
        colonne.add_attribute(texte, "text", 1)
        colonne.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
        colonne.set_fixed_width(320)
        colonne.set_resizable(True)
        colonne.set_sort_column_id(1)
        self.vue.append_column(colonne)

        for titre, rang, tri, large in (("Modifié le", 2, 8, 160),
                                        ("Type", 3, 3, 150),
                                        ("Taille", 4, 7, 100)):
            cellule = Gtk.CellRendererText()
            if titre == "Taille":
                cellule.set_property("xalign", 1.0)
            col = Gtk.TreeViewColumn(titre, cellule, text=rang)
            col.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
            col.set_fixed_width(large)
            col.set_resizable(True)
            col.set_sort_column_id(tri)
            self.vue.append_column(col)

        # Les dossiers d'abord, puis l'ordre alphabétique — c'est l'ordre de
        # Windows, et le seul auquel on s'attend en ouvrant un dossier.
        self.tri.set_sort_column_id(1, Gtk.SortType.ASCENDING)
        self.tri.set_sort_func(1, self._comparer_noms, None)

        cadre.add(self.vue)
        return cadre

    def _comparer_noms(self, modele, a, b, _donnee):
        dossier_a, dossier_b = modele[a][6], modele[b][6]
        if dossier_a != dossier_b:
            return -1 if dossier_a else 1
        return ((modele[a][1].lower() > modele[b][1].lower())
                - (modele[a][1].lower() < modele[b][1].lower()))

    def _visible(self, modele, iteration, _donnee):
        cherche = self.cherche.get_text().strip().lower()
        if not cherche:
            return True
        return cherche in (modele[iteration][1] or "").lower()

    def filtrer(self):
        self.filtre.refilter()
        self.dire_le_compte()

    # ---- Naviguer -----------------------------------------------------------
    def aller(self, chemin, memoriser=True):
        chemin = os.path.abspath(chemin)
        if not os.path.isdir(chemin):
            return
        self.dossier = chemin
        if memoriser:
            del self.histoire[self.rang + 1:]
            self.histoire.append(chemin)
            self.rang = len(self.histoire) - 1
        self.peupler()

    def au_precedent(self, _bouton=None):
        if self.rang > 0:
            self.rang -= 1
            self.aller(self.histoire[self.rang], memoriser=False)

    def au_suivant(self, _bouton=None):
        if self.rang + 1 < len(self.histoire):
            self.rang += 1
            self.aller(self.histoire[self.rang], memoriser=False)

    def au_parent(self, _bouton=None):
        parent = os.path.dirname(self.dossier.rstrip("/")) or "/"
        if parent != self.dossier:
            self.aller(parent)

    def au_double_clic(self, vue, chemin_vue, _colonne):
        ligne = vue.get_model()[chemin_vue]
        if ligne[6]:
            self.aller(ligne[5])
        else:
            self.ouvrir_avec_le_systeme(ligne[5])

    def ouvrir_avec_le_systeme(self, chemin):
        """Ouvrir un fichier avec l'application que le système lui associe.

        `xdg-open` est dans l'image (`xdg-utils`, ligne 41 de la liste des
        paquets) — vérifié, pas supposé : un bouton qui appelle un programme
        absent est une promesse à l'écran sans rien derrière, et c'est la faute
        que ce dépôt attrape le plus souvent.
        """
        try:
            subprocess.Popen(["xdg-open", chemin],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as souci:
            self.etat.set_text("Impossible d'ouvrir ce fichier : %s" % souci)

    def au_clavier(self, _cadre, evenement):
        """Les raccourcis de l'Explorateur, aux touches que Microsoft publie.

        Relus sur sa page « Keyboard shortcuts in Windows » plutôt que de
        mémoire, et la relecture a servi : **Retour arrière y veut dire
        « Navigate to the previous folder »**, c'est-à-dire PRÉCÉDENT, pas
        « dossier parent » comme nous le faisions. Le parent, c'est Alt+Flèche
        haut. Trois raccourcis de navigation manquaient entièrement
        (Alt+Gauche, Alt+Droite, Alt+Haut).
        """
        touche = Gdk.keyval_name(evenement.keyval)
        controle = evenement.state & Gdk.ModifierType.CONTROL_MASK
        alt = evenement.state & Gdk.ModifierType.MOD1_MASK
        majuscule = evenement.state & Gdk.ModifierType.SHIFT_MASK

        # Navigation : jamais confondue avec de la frappe, donc en premier.
        if alt and touche == "Left":
            self.au_precedent()
            return True
        if alt and touche == "Right":
            self.au_suivant()
            return True
        if alt and touche == "Up":
            self.au_parent()
            return True
        if touche == "F5":
            self.peupler()
            return True
        if controle and touche in ("f", "F"):
            self.cherche.grab_focus()
            return True
        if touche == "F4" or (controle and touche in ("l", "L")):
            self.ouvrir_la_barre_d_adresse()
            return True
        if touche == "Escape":
            if self.barre_d_adresse_ouverte():
                self.fermer_la_barre_d_adresse()
                return True
            if self.cherche.get_text():
                self.cherche.set_text("")
                return True
        if controle and majuscule and touche in ("n", "N"):
            self.action_nouveau_dossier()
            return True
        if controle and touche in ("n", "N"):
            self.action_nouvelle_fenetre()
            return True

        # LES RACCOURCIS QUI AGISSENT SUR DES FICHIERS s'arrêtent net dès
        # qu'on est en train d'écrire. Sans cette barrière, Suppr frappé au
        # milieu d'un chemin enverrait la sélection à la corbeille, et Retour
        # arrière quitterait le dossier au lieu d'effacer une lettre — ce
        # dernier défaut était là, dans le champ de recherche, depuis le
        # premier jour.
        if self.cherche.has_focus() or self.champ_chemin.has_focus():
            return False
        if touche == "BackSpace":
            self.au_precedent()
            return True
        if controle and touche in ("h", "H"):
            self.action_basculer_caches()
            return True
        if touche == "F2":
            self.action_renommer()
            return True
        if touche == "Delete":
            self.action_corbeille()
            return True
        if controle and touche in ("c", "C"):
            self.action_copier()
            return True
        if controle and touche in ("x", "X"):
            self.action_couper()
            return True
        if controle and touche in ("v", "V"):
            self.action_coller()
            return True
        if controle and touche in ("a", "A"):
            self.vue.get_selection().select_all()
            return True
        return False

    # ---- Remplir ------------------------------------------------------------
    def peupler(self):
        self.modele.clear()
        caches = 0
        try:
            noms = os.listdir(self.dossier)
        except OSError as souci:
            self.etat.set_text("Ce dossier ne peut pas être lu : %s" % souci)
            self.refaire_le_fil()
            return

        for nom in noms:
            if nom.startswith("."):
                caches += 1
                if not self.montrer_caches:
                    continue
            complet = os.path.join(self.dossier, nom)
            fichier = Gio.File.new_for_path(complet)
            try:
                info = fichier.query_info(
                    "standard::content-type,standard::size,standard::icon,"
                    "standard::is-symlink,time::modified",
                    Gio.FileQueryInfoFlags.NONE, None)
            except GLib.Error:
                continue
            est_dossier = os.path.isdir(complet)
            try:
                mtime = int(os.path.getmtime(complet))
            except OSError:
                mtime = 0
            octets = 0 if est_dossier else (info.get_size() or 0)
            nom_icone = "folder" if est_dossier else "text-x-generic"
            icone = info.get_icon()
            if icone is not None and hasattr(icone, "get_names"):
                noms_possibles = icone.get_names()
                if noms_possibles:
                    nom_icone = noms_possibles[0]
            self.modele.append([
                nom_icone, nom,
                time.strftime("%d/%m/%Y %H:%M", time.localtime(mtime)) if mtime else "",
                "Dossier de fichiers" if est_dossier else genre_du_fichier(info),
                "" if est_dossier else taille_lisible(octets),
                complet, est_dossier, octets, mtime,
            ])

        self.caches = caches
        self.refaire_le_fil()
        self.dire_le_compte()
        self.bouton_precedent.set_sensitive(self.rang > 0)
        self.bouton_suivant.set_sensitive(self.rang + 1 < len(self.histoire))
        self.bouton_parent.set_sensitive(self.dossier != "/")
        self.set_title("%s — Explorateur de fichiers"
                       % (os.path.basename(self.dossier) or "Système de fichiers"))

    def refaire_le_fil(self):
        """Le chemin en boutons cliquables, comme la barre d'adresse Windows."""
        for vieux in self.fil.get_children():
            self.fil.remove(vieux)
        maison = os.path.expanduser("~")
        if self.dossier == maison or self.dossier.startswith(maison + os.sep):
            morceaux = [(nom_personnel(), maison)]
            reste = self.dossier[len(maison):].strip(os.sep)
            courant = maison
        else:
            morceaux = [("Système de fichiers", "/")]
            reste = self.dossier.strip(os.sep)
            courant = "/"
        for morceau in [m for m in reste.split(os.sep) if m]:
            courant = os.path.join(courant, morceau)
            morceaux.append((morceau, courant))

        for index, (texte, cible) in enumerate(morceaux):
            if index:
                fleche = Gtk.Label(label="›")
                fleche.get_style_context().add_class("separateur-miette")
                self.fil.pack_start(fleche, False, False, 0)
            bouton = Gtk.Button(label=texte)
            interieur = bouton.get_child()
            if isinstance(interieur, Gtk.Label):
                interieur.set_ellipsize(Pango.EllipsizeMode.END)
                interieur.set_max_width_chars(24)
            bouton.get_style_context().add_class("miette")
            bouton.set_relief(Gtk.ReliefStyle.NONE)
            bouton.connect("clicked", lambda _b, c=cible: self.aller(c))
            self.fil.pack_start(bouton, False, False, 0)
        self.fil.show_all()

    # ---- La barre d'adresse qu'on peut taper --------------------------------
    def barre_d_adresse_ouverte(self):
        return self.adresse.get_visible_child_name() == "champ"

    def ouvrir_la_barre_d_adresse(self):
        """Ctrl+L, F4, ou un clic dans le vide : le chemin devient un champ."""
        self.champ_chemin.set_text(self.dossier)
        self.adresse.set_visible_child_name("champ")
        self.champ_chemin.grab_focus()
        self.champ_chemin.select_region(0, -1)

    def fermer_la_barre_d_adresse(self):
        self.adresse.set_visible_child_name("miettes")
        self.vue.grab_focus()

    def _clic_dans_le_fil(self, _boite, _evenement):
        # Les boutons du chemin mangent leur propre clic : on n'arrive ici que
        # pour le vide à leur droite, exactement comme dans Windows.
        self.ouvrir_la_barre_d_adresse()
        return True

    def _chemin_tape(self, champ):
        """Entrée dans le champ : y aller, ou DIRE pourquoi on n'y va pas.

        Un champ qui avale un chemin faux sans rien dire ferait croire qu'il a
        obéi. On garde donc le champ ouvert avec le texte fautif, et la barre
        d'état nomme la raison.
        """
        vise = os.path.abspath(os.path.expanduser(champ.get_text().strip()))
        if os.path.isdir(vise):
            self.fermer_la_barre_d_adresse()
            self.aller(vise)
            return
        if os.path.isfile(vise):
            self.fermer_la_barre_d_adresse()
            self.aller(os.path.dirname(vise))
            self.ouvrir_avec_le_systeme(vise)
            return
        self._dire("Ce dossier n'existe pas : %s" % vise)

    # ---- Le clic droit, et ce qu'on peut faire d'un fichier ----------------
    #
    # C'était le plus gros écart restant avec Windows. On pouvait regarder, pas
    # agir : ni renommer, ni copier, ni supprimer, ni créer un dossier.
    #
    # SUPPRIMER VEUT DIRE METTRE À LA CORBEILLE, JAMAIS EFFACER.
    #
    # `Gio.File.trash()` et rien d'autre. C'est ce que fait Windows avec la
    # touche Suppr, et c'est réversible — or ce programme tourne sur les
    # fichiers de quelqu'un. Si la corbeille n'est pas disponible (cela arrive
    # sur un disque externe sans dossier .Trash), on le DIT et on ne fait
    # rien : se rabattre en silence sur un effacement définitif serait une
    # surprise destructrice, c'est-à-dire la pire version de « une promesse à
    # l'écran sans rien derrière ».

    def chemins_choisis(self):
        """Les chemins des lignes sélectionnées, dans l'ordre affiché."""
        modele, lignes = self.vue.get_selection().get_selected_rows()
        return [modele[chemin][5] for chemin in lignes]

    def au_clic_droit(self, vue, evenement):
        if evenement.button != 3:
            return False
        trouve = vue.get_path_at_pos(int(evenement.x), int(evenement.y))
        if trouve is not None:
            chemin_vue = trouve[0]
            selection = vue.get_selection()
            # Clic droit sur une ligne non sélectionnée : Windows la
            # sélectionne d'abord. Sur une ligne déjà dans la sélection, il
            # garde la sélection entière — sans quoi un clic droit sur dix
            # fichiers choisis n'en viserait qu'un.
            if not selection.path_is_selected(chemin_vue):
                selection.unselect_all()
                selection.select_path(chemin_vue)
        else:
            vue.get_selection().unselect_all()
        self.menu_contextuel().popup_at_pointer(evenement)
        return True

    def menu_contextuel(self):
        choisis = self.chemins_choisis()
        menu = Gtk.Menu()

        def entree(texte, action, actif=True, raccourci=""):
            element = Gtk.MenuItem()
            boite = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=24)
            boite.pack_start(Gtk.Label(label=texte, xalign=0.0), True, True, 0)
            if raccourci:
                rappel = Gtk.Label(label=raccourci, xalign=1.0)
                rappel.get_style_context().add_class("raccourci-menu")
                boite.pack_end(rappel, False, False, 0)
            element.add(boite)
            element.set_sensitive(actif)
            element.connect("activate", lambda _e: action())
            menu.append(element)

        if choisis:
            entree("Ouvrir", self.action_ouvrir)
            entree("Renommer", self.action_renommer, len(choisis) == 1, "F2")
            menu.append(Gtk.SeparatorMenuItem())
            entree("Copier", self.action_copier, raccourci="Ctrl+C")
            entree("Couper", self.action_couper, raccourci="Ctrl+X")
            entree("Coller", self.action_coller, bool(self.presse_papier),
                   "Ctrl+V")
            menu.append(Gtk.SeparatorMenuItem())
            entree("Mettre à la corbeille", self.action_corbeille,
                   raccourci="Suppr")
            menu.append(Gtk.SeparatorMenuItem())
            entree("Propriétés", self.action_proprietes, len(choisis) == 1)
        else:
            entree("Nouveau dossier", self.action_nouveau_dossier,
                   raccourci="Ctrl+Maj+N")
            entree("Nouvelle fenêtre", self.action_nouvelle_fenetre,
                   raccourci="Ctrl+N")
            entree("Coller", self.action_coller, bool(self.presse_papier),
                   "Ctrl+V")
            menu.append(Gtk.SeparatorMenuItem())
            menu.append(Gtk.SeparatorMenuItem())
            entree("Masquer les fichiers cachés" if self.montrer_caches
                   else "Afficher les fichiers cachés",
                   self.action_basculer_caches, raccourci="Ctrl+H")
            entree("Actualiser", self.peupler, raccourci="F5")

        menu.show_all()
        return menu

    # ---- Ce que chaque entrée fait -----------------------------------------
    def action_ouvrir(self):
        for chemin in self.chemins_choisis():
            if os.path.isdir(chemin):
                self.aller(chemin)
                return
            self.ouvrir_avec_le_systeme(chemin)

    def _demander(self, titre, question, defaut=""):
        """Une petite boîte à une seule question. Rend None si on annule."""
        boite = Gtk.Dialog(title=titre, transient_for=self, modal=True)
        boite.add_button("Annuler", Gtk.ResponseType.CANCEL)
        valider = boite.add_button("Valider", Gtk.ResponseType.OK)
        valider.get_style_context().add_class("suggested-action")
        boite.set_default_response(Gtk.ResponseType.OK)
        champ = Gtk.Entry(text=defaut, activates_default=True)
        champ.set_width_chars(34)
        corps = boite.get_content_area()
        corps.set_spacing(10)
        corps.set_border_width(14)
        corps.pack_start(Gtk.Label(label=question, xalign=0.0), False, False, 0)
        corps.pack_start(champ, False, False, 0)
        boite.show_all()
        # Le nom sans son extension est présélectionné, comme dans Windows :
        # renommer « photo.jpg » en « vacances.jpg » ne doit pas obliger à
        # retaper l'extension.
        base, extension = os.path.splitext(defaut)
        champ.select_region(0, len(base) if extension else -1)
        reponse = boite.run()
        texte = champ.get_text().strip()
        boite.destroy()
        return texte if reponse == Gtk.ResponseType.OK and texte else None

    def _dire(self, texte):
        self.etat.set_text(texte)

    def action_renommer(self):
        choisis = self.chemins_choisis()
        if len(choisis) != 1:
            return
        ancien = choisis[0]
        nom = self._demander("Renommer", "Nouveau nom :",
                             os.path.basename(ancien))
        if not nom:
            return
        if "/" in nom:
            self._dire("Un nom de fichier ne peut pas contenir « / ».")
            return
        neuf = os.path.join(os.path.dirname(ancien), nom)
        if os.path.exists(neuf):
            self._dire("« %s » existe déjà ici." % nom)
            return
        try:
            os.rename(ancien, neuf)
        except OSError as souci:
            self._dire("Renommage impossible : %s" % souci.strerror)
            return
        self.peupler()

    def action_copier(self):
        self.presse_papier = list(self.chemins_choisis())
        self.couper = False
        self._dire("%d élément(s) copié(s)." % len(self.presse_papier))

    def action_couper(self):
        self.presse_papier = list(self.chemins_choisis())
        self.couper = True
        self._dire("%d élément(s) prêt(s) à être déplacé(s)."
                   % len(self.presse_papier))

    def _nom_libre(self, dossier, nom):
        """« photo.jpg » → « photo (copie).jpg », puis « (copie 2) », etc.

        Windows ajoute « - Copie ». On ne l'écrase jamais en silence : un
        fichier remplacé sans le dire est la seule faute de ce programme qui
        ne se rattrape pas.
        """
        cible = os.path.join(dossier, nom)
        if not os.path.exists(cible):
            return cible
        base, extension = os.path.splitext(nom)
        for numero in range(1, 100):
            suffixe = " (copie)" if numero == 1 else " (copie %d)" % numero
            cible = os.path.join(dossier, base + suffixe + extension)
            if not os.path.exists(cible):
                return cible
        return None

    def action_coller(self):
        if not self.presse_papier:
            return
        faits, soucis = 0, []
        for source in self.presse_papier:
            if not os.path.exists(source):
                soucis.append(os.path.basename(source) + " a disparu")
                continue
            # UN DOSSIER NE SE COLLE NI DANS LUI-MEME NI PLUS BAS DANS SA
            # PROPRE DESCENDANCE. Le premier cas etait vu ; le second non, et
            # il est bien pire : mesure ici, `copytree` recopie sa cible dans
            # sa cible — 99 niveaux en moins de huit secondes, jusqu a remplir
            # le disque de quelqu un. Windows refuse ce geste, nous aussi.
            racine = os.path.abspath(source)
            ici = os.path.abspath(self.dossier)
            if ici == racine or (os.path.isdir(source)
                                 and ici.startswith(racine + os.sep)):
                soucis.append("on ne colle pas un dossier dans lui-même")
                continue
            cible = self._nom_libre(self.dossier, os.path.basename(source))
            if cible is None:
                soucis.append("trop de copies de " + os.path.basename(source))
                continue
            try:
                if self.couper:
                    shutil.move(source, cible)
                elif os.path.isdir(source):
                    shutil.copytree(source, cible)
                else:
                    shutil.copy2(source, cible)
                faits += 1
            except (OSError, shutil.Error) as souci:
                soucis.append("%s : %s" % (os.path.basename(source), souci))
        if self.couper:
            self.presse_papier = []
            self.couper = False
        self.peupler()
        if soucis:
            self._dire("%d fait(s), %s" % (faits, " ; ".join(soucis[:2])))
        else:
            self._dire("%d élément(s) collé(s)." % faits)

    def action_corbeille(self):
        """À la corbeille, et seulement à la corbeille."""
        choisis = self.chemins_choisis()
        if not choisis:
            return
        faits, refus = 0, []
        for chemin in choisis:
            try:
                Gio.File.new_for_path(chemin).trash(None)
                faits += 1
            except GLib.Error as souci:
                refus.append("%s : %s" % (os.path.basename(chemin),
                                          souci.message))
        self.peupler()
        if refus:
            # On ne propose PAS d'effacer définitivement à la place. Si la
            # corbeille ne veut pas, la personne décide, pas nous.
            self._dire("Corbeille impossible pour %d élément(s) — %s"
                       % (len(refus), refus[0]))
        else:
            self._dire("%d élément(s) mis à la corbeille." % faits)

    def action_basculer_caches(self):
        """Ctrl+H, et LA SEULE ACTION QUE LA MACHINE PEUT VERIFIER.

        Jusqu'ici la CI prouvait que cette fenêtre s'affiche, jamais qu'elle
        obéit — c'est mot pour mot l'angle mort du 23 septembre sur la barre,
        celui qui aurait laissé passer un bureau sourd. Ctrl+H est le seul
        geste sans danger : il ne touche aucun fichier, il est réversible, et
        son effet est un NOMBRE qui doit changer. La ligne ci-dessous est donc
        la preuve, et elle peut échouer de trois façons : la touche n'est pas
        liée (aucune ligne), elle est liée à autre chose (le nombre ne bouge
        pas), ou le comptage est faux (il bouge du mauvais côté).
        """
        self.montrer_caches = not self.montrer_caches
        self.peupler()
        grenosui.dire("fichiers : Ctrl+H -> %s, %d element(s) affiche(s)"
                      % ("caches montres" if self.montrer_caches
                         else "caches remasques", len(self.filtre)))

    def action_nouveau_dossier(self):
        """Ctrl+Maj+N, et LA PREMIERE ACTION QUI ECRIT QUE LA MACHINE EXERCE.

        Ctrl+H prouvait qu'on écoute ; il ne touche aucun fichier. Créer un
        dossier est le plus petit geste qui *change quelque chose*, et c'est
        le seul qu'on puisse demander au clavier sans rien taper : la boîte
        arrive avec « Nouveau dossier » déjà écrit et Entrée valide. Deux
        touches, aucune lettre, donc aucun piège AZERTY.

        Les trois sorties parlent sur le port série, et c'est délibéré :
        refrapper le même raccourci doit **refuser**, et un garde qu'on n'a
        pas vu refuser n'est pas un garde. La machine exerce donc les deux
        sens d'affilée.
        """
        nom = self._demander("Nouveau dossier", "Nom du dossier :",
                             "Nouveau dossier")
        if not nom:
            return
        if "/" in nom:
            self._dire("Un nom de dossier ne peut pas contenir « / ».")
            grenosui.dire("fichiers : Ctrl+Maj+N refuse — un nom porte un /")
            return
        cible = os.path.join(self.dossier, nom)
        if os.path.exists(cible):
            self._dire("« %s » existe déjà ici." % nom)
            grenosui.dire("fichiers : Ctrl+Maj+N refuse — « %s » existe deja"
                          % nom)
            return
        try:
            os.mkdir(cible)
        except OSError as souci:
            self._dire("Création impossible : %s" % souci.strerror)
            grenosui.dire("fichiers : Ctrl+Maj+N a echoue — %s"
                          % souci.strerror)
            return
        self.peupler()
        grenosui.dire("fichiers : Ctrl+Maj+N -> dossier cree, "
                      "%d element(s) affiche(s)" % len(self.filtre))

    def action_nouvelle_fenetre(self):
        """Ctrl+N : une seconde fenêtre sur le même dossier.

        On relance le programme qui tourne (`sys.argv[0]`) plutôt qu'un nom
        deviné : s'il s'exécute, celui-là existe forcément.
        """
        programme = os.path.abspath(sys.argv[0])
        if not os.path.exists(programme):
            programme = "grenos-fichiers"
        try:
            subprocess.Popen([programme, self.dossier],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except OSError as souci:
            self._dire("Nouvelle fenêtre impossible : %s" % souci)

    def action_proprietes(self):
        choisis = self.chemins_choisis()
        if len(choisis) != 1:
            return
        chemin = choisis[0]
        try:
            etat = os.stat(chemin)
        except OSError as souci:
            self._dire("Lecture impossible : %s" % souci.strerror)
            return
        if os.path.isdir(chemin):
            genre, taille = "Dossier de fichiers", ""
        else:
            fichier = Gio.File.new_for_path(chemin)
            try:
                info = fichier.query_info("standard::content-type",
                                          Gio.FileQueryInfoFlags.NONE, None)
                genre = genre_du_fichier(info) or "Fichier"
            except GLib.Error:
                genre = "Fichier"
            taille = "%s (%s octets)" % (taille_lisible(etat.st_size),
                                         grenosui.nombre(etat.st_size, 0))

        boite = Gtk.Dialog(title="Propriétés", transient_for=self, modal=True)
        boite.add_button("Fermer", Gtk.ResponseType.CLOSE)
        grille = Gtk.Grid(row_spacing=8, column_spacing=18)
        grille.set_border_width(16)
        lignes = [
            ("Nom", os.path.basename(chemin)),
            ("Type", genre),
            ("Emplacement", os.path.dirname(chemin)),
            ("Taille", taille),
            ("Modifié le", time.strftime("%d/%m/%Y %H:%M",
                                         time.localtime(etat.st_mtime))),
        ]
        for rang, (etiquette, valeur) in enumerate(l for l in lignes if l[1]):
            titre = Gtk.Label(label=etiquette, xalign=0.0)
            titre.get_style_context().add_class("titre-propriete")
            grille.attach(titre, 0, rang, 1, 1)
            texte = Gtk.Label(label=valeur, xalign=0.0)
            texte.set_selectable(True)
            texte.set_max_width_chars(48)
            texte.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
            grille.attach(texte, 1, rang, 1, 1)
        boite.get_content_area().add(grille)
        boite.show_all()
        boite.run()
        boite.destroy()

    def dire_le_compte(self):
        """La barre d'état de Windows : combien d'éléments, combien choisis."""
        total = len(self.filtre)
        mot = "élément" if total <= 1 else "éléments"
        texte = "%d %s" % (total, mot)
        choisis = self.vue.get_selection().count_selected_rows()
        if choisis > 1:
            texte += "   ·   %d sélectionnés" % choisis
        elif choisis == 1:
            texte += "   ·   1 sélectionné"
        if getattr(self, "caches", 0):
            # Quand ils sont montres, ils sont DEJA dans le total : les
            # recompter comme « masques » serait mentir deux fois.
            texte += "   ·   %d masqué%s%s" % (
                self.caches, "s" if self.caches > 1 else "",
                " (affichés)" if self.montrer_caches else "")
        self.etat.set_text(texte)


def main():
    grenosui.nommer()
    grenosui.habiller()
    grenosui.ajouter_style(STYLE)
    depart = sys.argv[1] if len(sys.argv) > 1 else None
    fenetre = Explorateur(depart)
    fenetre.peupler_disques()
    fenetre.aller(fenetre.dossier)
    fenetre.show_all()
    # Ce que la machine d'intégration lira : une fenêtre qui s'ouvre ne prouve
    # rien si personne ne dit ce qu'elle contient. C'est la leçon du
    # 24 septembre, où `bureau pret, 0 icones` passait au vert depuis des
    # jours.
    grenosui.dire("fichiers ouvert, %d element(s) dans %s, %d entree(s) dans Ce PC"
                  % (len(fenetre.modele), os.path.basename(fenetre.dossier) or "/",
                     len(fenetre.liste_pc.get_children())))
    Gtk.main()


if __name__ == "__main__":
    main()
