#!/usr/bin/env python3
"""grenget — installer des applications depuis le terminal (en anglais par
défaut, en français si grenOS l'est : voir _langue).

Le GrenPlace de la ligne de commande : le MÊME catalogue (en ligne, puis le
dernier connu, puis celui livré avec l'image), les mêmes règles de sûreté, la
même façon d'installer. Une application qu'on voit dans GrenPlace s'installe
par `grenget installer <nom>`, et inversement.

    grenget chercher discord
    grenget installer discord
    grenget enlever discord
    grenget liste
    grenget info obs
    grenget maj
    grenget proposer          → https://grenos.vercel.app/grenget
    grenget temprep ouvrir    → des commandes envoyées d'un autre PC (voir /usr/lib/grenos/temprep)

LA RÈGLE DE SÛRETÉ, reprise telle quelle de GrenPlace : le catalogue vient du
réseau, il dit QUOI installer, jamais COMMENT. La commande est construite ici,
et un identifiant qui ne ressemble pas à un identifiant est refusé — sans
cela, une fiche trafiquée pourrait glisser une option à apt ou à flatpak.

Hors catalogue, `grenget installer` accepte aussi un identifiant Flathub
complet (`org.exemple.App`) : c'est ce que fait déjà `flatpak install`, avec
la même vérification de forme.
"""
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

CATALOGUE_EN_LIGNE = "https://tpqzhzuoyqpfairatdrw.supabase.co/storage/v1/object/public/catalogue/magasin.json"
CATALOGUE_LIVRE = "/usr/share/grenos/catalogue.json"
CACHE = os.path.expanduser("~/.cache/grenos")
CATALOGUE_GARDE = os.path.join(CACHE, "catalogue.json")
PAGE = "https://grenos.vercel.app/grenget"

IDENTIFIANT_SAIN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")
ID_FLATHUB = re.compile(r"^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+){2,}$")

# LA LANGUE (19 novembre) : l'anglais par défaut, le français au choix —
# celui de grenOS (Réglages › Langue, écrit dans ~/.config/grenos/langue),
# sinon celui de la session ($LANG), sinon l'anglais.
def _langue():
    try:
        with open(os.path.expanduser("~/.config/grenos/langue"), encoding="utf-8") as f:
            v = f.read().strip()
        if v in ("en", "fr"):
            return v
    except OSError:
        pass
    return "fr" if os.environ.get("LANG", "").startswith("fr") else "en"


FR = _langue() == "fr"


def _(en, fr):
    """Le texte de la langue choisie : _("Installing", "Installation")."""
    return fr if FR else en


# Les verbes, dans la langue choisie : c'est eux que les messages conseillent.
V = {
    "chercher": _("search", "chercher"), "installer": _("install", "installer"),
    "enlever": _("remove", "enlever"), "liste": _("list", "liste"), "info": "info",
    "maj": _("update", "maj"), "proposer": _("suggest", "proposer"), "aide": _("help", "aide"),
    "temprep": "temprep",
}

COULEUR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
BLEU, VIOLET, GRIS, VERT, ROUGE, BLANC = "96;165;250", "167;139;250", "148;161;186", "43;196;138", "239;77;94", "238;242;250"


def c(rvb, texte, gras=False):
    if not COULEUR:
        return texte
    return f"\033[{'1;' if gras else ''}38;2;{rvb}m{texte}\033[0m"


def ok(texte):
    print(c(VERT, "✓ ") + texte)


def non(texte):
    print(c(ROUGE, "✗ ") + texte, file=sys.stderr)


# ---- Le catalogue --------------------------------------------------------------
def fiche_valable(a):
    return (a.get("source") in ("flatpak", "apt")
            and bool(IDENTIFIANT_SAIN.match(a.get("identifiant", "")))
            and bool(a.get("slug") and a.get("nom")))


def lire_json(chemin):
    try:
        with open(chemin, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def catalogue(en_ligne=True):
    """(applications, origine). Le réseau d'abord, borné à six secondes."""
    if en_ligne:
        try:
            requete = urllib.request.Request(CATALOGUE_EN_LIGNE, headers={"User-Agent": "grenget"})
            with urllib.request.urlopen(requete, timeout=6) as r:
                donnees = json.loads(r.read().decode("utf-8"))
            applis = [a for a in donnees.get("applications", []) if fiche_valable(a)]
            if applis:
                os.makedirs(CACHE, exist_ok=True)
                with open(CATALOGUE_GARDE, "w", encoding="utf-8") as f:
                    json.dump(donnees, f, ensure_ascii=False)
                return applis, _("online", "en ligne")
        except (urllib.error.URLError, OSError, ValueError, TimeoutError):
            pass
    for chemin, origine in ((CATALOGUE_GARDE, _("last known", "dernier connu")), (CATALOGUE_LIVRE, _("shipped with the image", "livré avec l'image"))):
        donnees = lire_json(chemin)
        if donnees:
            applis = [a for a in donnees.get("applications", []) if fiche_valable(a)]
            if applis:
                return applis, origine
    return [], _("not found", "introuvable")


def simplifier(texte):
    """Minuscules, sans accents ni espaces : « Écran » trouve « ecran »."""
    table = str.maketrans("àâäéèêëîïôöùûüçœ", "aaaeeeeiioouuuco")
    return re.sub(r"[\s_-]+", "", texte.lower().translate(table))


def trouver(applis, nom):
    """La fiche désignée par un slug, un nom ou un identifiant exact."""
    s = simplifier(nom)
    for a in applis:
        if s in (simplifier(a["slug"]), simplifier(a["nom"]), simplifier(a["identifiant"])):
            return a
    return None


def installe(a):
    if a["source"] == "flatpak":
        return subprocess.run(["flatpak", "info", a["identifiant"]], capture_output=True).returncode == 0
    r = subprocess.run(["dpkg-query", "-W", "-f=${Status}", a["identifiant"]], capture_output=True, text=True)
    return "install ok installed" in r.stdout


def lanceur():
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        return ["sudo", "-n"]
    return ["pkexec"]


def ligne_appli(a, marque=False):
    puce = c(VERT, "●") if marque else c(GRIS, "○")
    print(f"  {puce} {c(BLEU, a['slug'].ljust(18), True)} {a['nom']}" + c(GRIS, f" — {a.get('description', '')[:60]}"))


# ---- Les sous-commandes --------------------------------------------------------
def chercher(args):
    if not args:
        non(_("Usage: grenget search <word>", "Usage : grenget chercher <mot>"))
        return 2
    mot = simplifier(" ".join(args))
    applis, origine = catalogue()
    trouvees = [a for a in applis if mot in simplifier(a["nom"]) or mot in simplifier(a["slug"])
                or mot in simplifier(a.get("description", "")) or mot in simplifier(a.get("rayon", ""))]
    if trouvees:
        print(c(GRIS, _(f"{len(trouvees)} app(s) · {origine} catalog", f"{len(trouvees)} application(s) · catalogue {origine}")))
        for a in trouvees[:40]:
            ligne_appli(a)
        print(c(GRIS, _("\nTo install: ", "\nPour installer : ")) + c(BLEU, f"grenget {V['installer']} {trouvees[0]['slug']}"))
        return 0
    print(c(GRIS, _(f"Nothing in the grenOS catalog for “{' '.join(args)}”. On Flathub:", f"Rien dans le catalogue grenOS pour « {' '.join(args)} ». Sur Flathub :")))
    r = subprocess.run(["flatpak", "search", " ".join(args)], capture_output=True, text=True)
    sortie = r.stdout.strip()
    if r.returncode == 0 and sortie and "No matches" not in sortie:
        print(sortie)
        print(c(GRIS, _("\nAn ID from the “Application ID” column installs too: ", "\nUn identifiant de la colonne « Application ID » s'installe aussi : "))
              + c(BLEU, f"grenget {V['installer']} org.example.App"))
    else:
        print(c(GRIS, _("  no results. ", "  aucun résultat. ")) + c(BLEU, f"grenget {V['proposer']}") + c(GRIS, _(" to ask for it.", " pour la demander.")))
    return 0


def installer(args):
    if not args:
        non(_("Usage: grenget install <app> [<app>…]", "Usage : grenget installer <application> [<application>…]"))
        return 2
    applis, _origine = catalogue()
    code_final = 0
    for nom in args:
        a = trouver(applis, nom)
        if a is None and ID_FLATHUB.match(nom):
            a = {"slug": nom, "nom": nom, "source": "flatpak", "identifiant": nom}
        if a is None:
            non(_(f"“{nom}” isn't in the catalog. ", f"« {nom} » n'est pas dans le catalogue. ") + c(GRIS, _("Search: ", "Cherche : ")) + c(BLEU, f"grenget {V['chercher']} {nom}"))
            code_final = 1
            continue
        if installe(a):
            ok(_(f"{a['nom']} is already installed.", f"{a['nom']} est déjà installé."))
            continue
        print(c(VIOLET, "● ") + c(BLANC, _(f"Installing {a['nom']}", f"Installation de {a['nom']}"), True) + c(GRIS, f" ({a['source']} · {a['identifiant']})"))
        if a["source"] == "flatpak":
            subprocess.run(["flatpak", "remote-add", "--if-not-exists", "flathub",
                            "https://dl.flathub.org/repo/flathub.flatpakrepo"], capture_output=True)
            code = subprocess.run(["flatpak", "install", "-y", "--noninteractive", "flathub", a["identifiant"]]).returncode
        else:
            # Le dépôt de l'éditeur (Claude Desktop…), branché seulement ici,
            # comme dans GrenPlace : voir /usr/lib/grenos/grenos-depot-editeur.
            editeur = os.path.isfile(f"/usr/share/grenos/depots/{a['identifiant']}.list")
            code = 0
            if editeur:
                code = subprocess.run(lanceur() + ["/usr/lib/grenos/grenos-depot-editeur", a["identifiant"]]).returncode
            if code == 0:
                subprocess.run(lanceur() + ["apt-get", "update", "-qq"])
                code = subprocess.run(lanceur() + ["apt-get", "install", "-y"]
                                      + (["--install-recommends"] if editeur else [])
                                      + [a["identifiant"]]).returncode
        if code == 0:
            ok(_(f"{a['nom']} is installed. It's in the menu, and opens with ", f"{a['nom']} est installé. Il est dans le menu, et s'ouvre par ")
               + c(BLEU, _(f"gren open {a['slug']}", f"gren ouvrir {a['slug']}")))
        else:
            non(_(f"Installing {a['nom']} stopped (code {code}).", f"L'installation de {a['nom']} s'est arrêtée (code {code})."))
            code_final = code
    return code_final


def enlever(args):
    if not args:
        non(_("Usage: grenget remove <app>", "Usage : grenget enlever <application>"))
        return 2
    applis, _origine = catalogue(en_ligne=False)
    code_final = 0
    for nom in args:
        a = trouver(applis, nom)
        if a is None and ID_FLATHUB.match(nom):
            a = {"slug": nom, "nom": nom, "source": "flatpak", "identifiant": nom}
        if a is None or not installe(a):
            non(_(f"“{nom}” isn't installed.", f"« {nom} » n'est pas installé."))
            code_final = 1
            continue
        if a["source"] == "flatpak":
            code = subprocess.run(["flatpak", "uninstall", "-y", "--noninteractive", a["identifiant"]]).returncode
        else:
            code = subprocess.run(lanceur() + ["apt-get", "remove", "-y", a["identifiant"]]).returncode
        if code == 0:
            ok(_(f"{a['nom']} is uninstalled. Your own files weren't touched.", f"{a['nom']} est désinstallé. Tes fichiers à toi n'ont pas été touchés."))
        else:
            non(_(f"Uninstalling {a['nom']} stopped (code {code}).", f"La désinstallation de {a['nom']} s'est arrêtée (code {code})."))
            code_final = code
    return code_final


def liste(_args):
    applis, origine = catalogue(en_ligne=False)
    flatpaks = set(subprocess.run(["flatpak", "list", "--app", "--columns=application"],
                                  capture_output=True, text=True).stdout.split())
    connues = [a for a in applis if (a["source"] == "flatpak" and a["identifiant"] in flatpaks)
               or (a["source"] == "apt" and installe(a))]
    print(c(VIOLET, "● ") + c(BLANC, _(f"{len(connues)} catalog app(s) installed", f"{len(connues)} application(s) du catalogue installée(s)"), True))
    for a in connues:
        ligne_appli(a, marque=True)
    autres = sorted(flatpaks - {a["identifiant"] for a in applis})
    if autres:
        print(c(GRIS, _(f"\n  and {len(autres)} other Flatpak(s): ", f"\n  et {len(autres)} autre(s) Flatpak : ")) + ", ".join(autres))
    return 0


def info(args):
    if not args:
        non(_("Usage: grenget info <app>", "Usage : grenget info <application>"))
        return 2
    applis, _origine = catalogue()
    a = trouver(applis, " ".join(args))
    if a is None:
        non(_(f"“{' '.join(args)}” isn't in the catalog.", f"« {' '.join(args)} » n'est pas dans le catalogue."))
        return 1
    print(c(VIOLET, "● ") + c(BLANC, a["nom"], True) + c(GRIS, f" — {a.get('editeur', '')}"))
    for etiquette, valeur in ((_("Category", "Rayon"), a.get("rayon", "")), ("Source", f"{a['source']} · {a['identifiant']}"),
                              (_("Website", "Site"), a.get("site", "")),
                              (_("Installed", "Installée"), (_("yes", "oui") if installe(a) else _("no", "non")))):
        print(f"  {c(GRIS, etiquette.ljust(10))} {valeur}")
    print(f"\n  {a.get('description', '')}")
    return 0


def maj(_args):
    print(c(VIOLET, "● ") + c(BLANC, _("Updating apps", "Mise à jour des applications"), True))
    code = subprocess.run(["flatpak", "update", "-y", "--noninteractive"]).returncode
    if code == 0:
        ok(_("Apps up to date. The system itself installs at the next restart: ", "Applications à jour. Le système, lui, s'installe au prochain redémarrage : ") + c(BLEU, "gren maj"))
    return code


def proposer(_args):
    print(c(VIOLET, "● ") + c(BLANC, _("Suggest an app for the grenOS catalog", "Proposer une application au catalogue grenOS"), True))
    print(c(GRIS, _("  A page explains everything and takes your suggestion: ", "  Une page explique tout et prend ta proposition : ")) + c(BLEU, PAGE))
    print(c(GRIS, _("  It goes into the queue, an automatic check verifies it,", "  Elle passe en attente, une vérification automatique la contrôle,")))
    print(c(GRIS, _("  then it's reviewed before it reaches GrenPlace and grenget.", "  puis elle est relue avant d'arriver dans GrenPlace et dans grenget.")))
    subprocess.Popen(["xdg-open", PAGE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


def temprep(args):
    """Des commandes envoyées à un autre PC du réseau, et leur sortie en retour
    (26 novembre). Un programme à part, en Python seul : copié tel quel sur un
    PC qui n'a pas encore la mise à jour, il marche aussi."""
    chemin = "/usr/lib/grenos/temprep"
    if not os.path.isfile(chemin):
        # Lancé depuis le dépôt (linux/config/includes.chroot/usr/bin/grenget).
        chemin = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../lib/grenos/temprep")
    os.execv(sys.executable, [sys.executable, chemin] + list(args))


def aide(_args):
    print(c(VIOLET, "● ") + c(BLANC, _("grenget — grenOS apps", "grenget — les applications de grenOS"), True))
    mot, nom = _("<word>", "<mot>"), _("<name>", "<nom>")
    for verbe, texte in ((f"{V['chercher']} {mot}", _("find an app", "trouver une application")),
                         (f"{V['installer']} {nom}", _("install it (several at once if you like)", "l'installer (plusieurs à la fois si tu veux)")),
                         (f"{V['enlever']} {nom}", _("uninstall it", "la désinstaller")),
                         (V["liste"], _("what's installed", "ce qui est installé")),
                         (f"info {nom}", _("its page", "sa fiche")),
                         (V["maj"], _("update the apps", "mettre les applications à jour")),
                         (V["proposer"], _("suggest an app for the catalog", "proposer une application au catalogue")),
                         (_("temprep open|send", "temprep ouvrir|envoyer"), _("commands sent to another PC on your network", "des commandes envoyées à un autre PC de ton réseau"))):
        print(f"  {c(BLEU, ('grenget ' + verbe).ljust(26))} {texte}")
    print(c(GRIS, _(f"\n  The catalog is GrenPlace's. How it works: {PAGE}", f"\n  Le catalogue est celui de GrenPlace. Comment ça marche : {PAGE}")))
    print(c(GRIS, _("  The French verbs work too (installer, chercher…).", "  Les verbes anglais marchent aussi (install, search…).")))
    return 0


COMMANDES = {"chercher": chercher, "installer": installer, "enlever": enlever, "liste": liste,
             "info": info, "maj": maj, "proposer": proposer, "aide": aide, "temprep": temprep}
# Les deux langues marchent toujours, quelle que soit celle de grenOS : un
# tutoriel écrit en français reste juste sur une machine en anglais.
SYNONYMES = {"search": "chercher", "install": "installer", "remove": "enlever", "uninstall": "enlever",
             "list": "liste", "show": "info", "upgrade": "maj", "update": "maj", "help": "aide",
             "suggest": "proposer"}


def main():
    args = sys.argv[1:]
    if args[:1] == ["--slugs"]:
        # Pour la complétion de grensh : rien que les noms, sans réseau.
        applis, _origine = catalogue(en_ligne=False)
        print(" ".join(a["slug"] for a in applis))
        return 0
    if not args or args[0] in ("-h", "--help"):
        return aide([])
    commande = SYNONYMES.get(args[0], args[0])
    if commande not in COMMANDES:
        non(_(f"“{args[0]}” isn't a grenget command. ", f"« {args[0]} » n'est pas une commande de grenget. ") + c(GRIS, _("Type ", "Tape ")) + c(BLEU, f"grenget {V['aide']}"))
        return 2
    return COMMANDES[commande](args[1:])


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
