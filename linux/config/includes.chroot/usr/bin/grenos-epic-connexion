#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""grenos-epic-connexion : se connecter à Epic Games (Heroic) dans le
NAVIGATEUR PRINCIPAL (24 novembre).

Grenofar, capture à l'appui : la connexion d'Epic dans Heroic ouvre sa
propre fenêtre « Connexion : comptes Google », vierge — ses comptes Google
sont enregistrés dans son navigateur principal (Réglages › Compte), pas là.
Heroic ne sait pas ouvrir sa page de connexion ailleurs. Mais l'outil Epic
qu'il embarque (legendary) accepte un « code d'autorisation » obtenu dans
n'importe quel navigateur. Donc :

  1. la page de connexion d'Epic s'ouvre dans le navigateur principal — là,
     « Se connecter avec Google » propose les comptes déjà enregistrés ;
  2. Epic affiche ensuite une petite page de texte qui contient
     "authorizationCode". Rien à copier (24 novembre, Grenofar : « il faut
     copier etc, règle ça ») : grenOS reconnaît l'onglet à son titre
     (« …/id/api/redirect… »), le copie lui-même (xdotool : Ctrl+A,
     Ctrl+C), lit le code dans le presse-papier, puis ferme l'onglet.
     Copier à la main ou coller dans la fenêtre reste possible ;
  3. grenOS la donne au legendary de Heroic, et relance Heroic : connecté.

Le code ne quitte jamais la machine : il va du presse-papier à legendary,
qui l'échange auprès d'Epic. Rien n'est écrit ailleurs que là où Heroic
range déjà son compte.

    grenos-epic-connexion            la fenêtre, et la page dans le navigateur
    grenos-epic-connexion --guetter  attendre la fenêtre de connexion de
                                     Heroic et proposer le navigateur à la
                                     place (lancé par grenos-session)
    grenos-epic-connexion --proposer XID   la question, pour cette fenêtre
"""
import json
import os
import re
import subprocess
import sys
import time

HEROIC = "com.heroicgameslauncher.hgl"
LEGENDARY = "/app/bin/heroic/resources/app.asar.unpacked/build/bin/x64/linux/legendary"
# L'identifiant client que Heroic et legendary utilisent pour Epic : la page
# finale affiche le code d'autorisation au lieu de rediriger.
CLIENT = "34a02cf8f4414e29b15921876da36f9a"
PAGE = ("https://www.epicgames.com/id/login?redirectUrl="
        "https%3A%2F%2Fwww.epicgames.com%2Fid%2Fapi%2Fredirect%3FclientId%3D" + CLIENT
        + "%26responseType%3Dcode")
# Le JSON brut (Chromium, Opera) ou la vue de Firefox, qui copie
# « authorizationCode	"…" » sans guillemets autour de la clé.
CODE = re.compile(r'authorizationCode[^0-9a-f]{0,8}([0-9a-f]{32})')
# Le titre de l'onglet de cette page : son adresse, faute de <title>.
TITRE_PAGE = "id/api/redirect"
# Où HEROIC range le compte Epic, pas le dossier de legendary seul.
DOSSIER = os.path.expanduser("~/.var/app/%s/config/heroic/legendaryConfig/legendary" % HEROIC)
CODE_SEUL = re.compile(r"^\s*([0-9a-f]{32})\s*$")


def dire(texte):
    subprocess.run(["grenos-dire", "epic : " + texte], capture_output=True)


def prevenir(titre, texte):
    subprocess.run(["notify-send", "--app-name=grenOS", "--icon=" + HEROIC, titre, texte],
                   capture_output=True)


def code_de(texte):
    """Le code d'autorisation dans ce texte (la page entière, ou le code seul)."""
    if not texte:
        return ""
    m = CODE.search(texte) or CODE_SEUL.match(texte)
    return m.group(1) if m else ""


def ouvrir_page():
    sys.path.insert(0, "/usr/lib/grenos")
    try:
        import navigateur
        navigateur.ouvrir([PAGE])
    except Exception:  # noqa: BLE001 — sans module, xdg-open fait la même chose
        subprocess.Popen(["xdg-open", PAGE])


def heroic_installe():
    r = subprocess.run(["flatpak", "info", HEROIC], capture_output=True)
    return r.returncode == 0


def connecter(code):
    """Donne le code au legendary de Heroic. Rendu : "" ou la raison du refus."""
    r = subprocess.run(
        ["flatpak", "run", "--command=" + LEGENDARY,
         "--env=LEGENDARY_CONFIG_PATH=" + DOSSIER,
         HEROIC, "auth", "--code", code],
        capture_output=True, text=True, timeout=120)
    sortie = (r.stdout + r.stderr)
    if r.returncode == 0 and "Successfully logged in" in sortie:
        nom = re.search(r'Successfully logged in as "([^"]+)"', sortie)
        return "", (nom.group(1) if nom else "")
    # Déjà connecté (legendary garde son compte) : ce n'est pas un échec —
    # avant, cette phrase s'affichait comme une erreur.
    if "credentials are still valid" in sortie:
        return "", compte_enregistre()
    if "expired" in sortie.lower() or "invalid" in sortie.lower():
        return "Ce code a déjà servi ou a expiré (il ne vaut que quelques minutes) : rouvre la page et recopie-la.", ""
    derniere = [l for l in sortie.splitlines() if l.strip()]
    return (derniere[-1] if derniere else "La connexion a échoué."), ""


def compte_enregistre():
    """Le nom du compte Epic que legendary garde déjà, ou ""."""
    try:
        with open(os.path.join(DOSSIER, "user.json"), encoding="utf-8") as f:
            return json.load(f).get("displayName", "")
    except (OSError, ValueError, AttributeError):
        return ""


def onglets_du_code():
    """Les fenêtres du navigateur qui montrent la page du code."""
    r = subprocess.run(["xdotool", "search", "--onlyvisible", "--name", TITRE_PAGE],
                       capture_output=True, text=True)
    return r.stdout.split()


def copier_onglet(xid):
    """Ctrl+A, Ctrl+C dans cette fenêtre : la page arrive au presse-papier."""
    subprocess.run(["xdotool", "windowactivate", "--sync", xid,
                    "key", "--clearmodifiers", "ctrl+a", "ctrl+c"], capture_output=True, timeout=10)


def fermer_onglet(xid):
    """Ferme l'onglet du code, s'il est toujours celui qu'on voit."""
    titre = subprocess.run(["xdotool", "getwindowname", xid], capture_output=True, text=True).stdout
    if TITRE_PAGE in titre:
        subprocess.run(["xdotool", "windowactivate", "--sync", xid,
                        "key", "--clearmodifiers", "ctrl+w"], capture_output=True, timeout=10)


def relancer_heroic():
    subprocess.run(["flatpak", "kill", HEROIC], capture_output=True)
    time.sleep(1.5)
    subprocess.Popen(["flatpak", "run", HEROIC], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


# ---- La fenêtre -----------------------------------------------------------------
def fenetre(fermer_popup=None):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    f = Gtk.Window(title="Connexion à Epic Games")
    f.set_icon_name(HEROIC)
    f.set_keep_above(True)
    f.set_position(Gtk.WindowPosition.CENTER)
    f.connect("destroy", Gtk.main_quit)

    boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    for cote in ("top", "bottom", "start", "end"):
        getattr(boite, "set_margin_" + cote)(18)
    f.add(boite)

    titre = Gtk.Label(xalign=0)
    titre.set_markup("<b><big>Se connecter avec ton navigateur</big></b>")
    boite.pack_start(titre, False, False, 0)
    etapes = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
    etapes.set_markup(
        "1. La page d'Epic Games s'est ouverte dans ton <b>navigateur principal</b> : "
        "connecte-toi (« Se connecter avec Google » y propose tes comptes enregistrés).\n"
        "2. C'est tout : quand Epic affiche sa page de texte (<tt>authorizationCode</tt>), "
        "grenOS la lit lui-même, ferme l'onglet et connecte Heroic.\n"
        "Si rien ne se passe : sur cette page, <b>Ctrl+A</b> puis <b>Ctrl+C</b>.")
    boite.pack_start(etapes, False, False, 0)

    champ = Gtk.Entry(placeholder_text="…ou colle ici le texte de la page (Ctrl+V)")
    boite.pack_start(champ, False, False, 0)
    etat = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
    etat.get_style_context().add_class("dim-label")
    etat.set_text("En attente du code dans le presse-papier…")
    boite.pack_start(etat, False, False, 0)

    rangee = Gtk.Box(spacing=8)
    rouvrir = Gtk.Button(label="Rouvrir la page")
    def rouvrir_page(*_):
        vu["essais"].clear()  # le nouvel onglet sera relu
        ouvrir_page()

    rouvrir.connect("clicked", rouvrir_page)
    fermer = Gtk.Button(label="Fermer")
    fermer.connect("clicked", lambda *_: f.destroy())
    rangee.pack_start(rouvrir, False, False, 0)
    rangee.pack_end(fermer, False, False, 0)
    boite.pack_start(rangee, False, False, 0)

    vu = {"code": "", "fini": False, "onglet": "", "essais": {}, "en_cours": False}

    def essayer(texte):
        code = code_de(texte)
        if not code or code == vu["code"] or vu["fini"]:
            return
        vu["code"] = code
        vu["en_cours"] = True
        etat.set_text("Code reçu, connexion de Heroic à Epic…")
        dire("code d'autorisation recu, connexion")

        def faire():
            souci, nom = connecter(code)
            GLib.idle_add(fini, souci, nom)

        import threading
        threading.Thread(target=faire, daemon=True).start()

    def fini(souci, nom):
        vu["en_cours"] = False
        if souci:
            etat.set_text(souci)
            dire("refus : " + souci)
            return False
        vu["fini"] = True
        if vu["onglet"]:
            fermer_onglet(vu["onglet"])
        # Le code n'a plus de valeur, mais on ne le laisse pas traîner.
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text("", -1)
        dire("connecte" + (" (" + nom + ")" if nom else ""))
        prevenir("Epic Games connecté", ("Compte %s. " % nom if nom else "") + "Heroic redémarre avec ton compte.")
        if fermer_popup:
            fermer_popup()
        relancer_heroic()
        f.destroy()
        return False

    presse = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)

    def regarder():
        if vu["fini"]:
            return False
        presse.request_text(lambda _p, t: essayer(t or ""))
        return True

    def chercher_onglet():
        """La page du code est-elle ouverte ? Alors on la copie nous-mêmes —
        trois fois au plus par fenêtre (une page encore en chargement)."""
        if vu["fini"]:
            return False
        if vu["en_cours"]:
            return True
        for xid in onglets_du_code():
            if vu["essais"].get(xid, 0) >= 3:
                continue
            vu["essais"][xid] = vu["essais"].get(xid, 0) + 1
            vu["onglet"] = xid
            etat.set_text("Page d'Epic trouvée, lecture du code…")
            dire("page du code vue dans le navigateur, copie automatique")
            copier_onglet(xid)
            f.present()
            break
        return True

    GLib.timeout_add(800, regarder)
    GLib.timeout_add(1500, chercher_onglet)
    champ.connect("changed", lambda c: essayer(c.get_text()))
    f.show_all()
    f.present()
    Gtk.main()


# ---- Le guet : la fenêtre de connexion de Heroic -------------------------------
# Les titres que prennent les fenêtres de connexion qu'ouvre Heroic (Epic, et
# Google / Apple / Facebook ouverts depuis la page d'Epic).
TITRES = re.compile(r"connexion|sign in|log ?in|comptes google|google accounts|epic games|apple|facebook",
                    re.I)


def fenetres_heroic():
    """{xid: titre} des fenêtres de Heroic."""
    r = subprocess.run(["xdotool", "search", "--class", HEROIC], capture_output=True, text=True)
    vues = {}
    for xid in r.stdout.split():
        t = subprocess.run(["xdotool", "getwindowname", xid], capture_output=True, text=True).stdout.strip()
        if t:
            vues[xid] = t
    return vues


def guetter():
    """Quand Heroic ouvre une fenêtre de connexion, proposer le navigateur."""
    deja = set()
    while True:
        time.sleep(2)
        try:
            vues = fenetres_heroic()
        except OSError:
            continue
        for xid, titre in vues.items():
            # La fenêtre principale s'appelle « Heroic Games Launcher ».
            if xid in deja or "heroic" in titre.lower() or not TITRES.search(titre):
                continue
            deja.add(xid)
            dire("fenetre de connexion de Heroic vue (%s), navigateur propose" % titre)
            subprocess.Popen([sys.argv[0], "--proposer", xid], start_new_session=True)
        deja &= set(vues)


def proposer(xid):
    """La question, à côté de la fenêtre de Heroic : navigateur, ou rester."""
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk
    d = Gtk.MessageDialog(message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                          text="Se connecter dans ton navigateur ?")
    d.set_title("Connexion à Epic Games")
    d.set_keep_above(True)
    d.format_secondary_text("Ton navigateur principal a déjà tes comptes (Google…) enregistrés. "
                            "grenOS donnera ensuite la connexion à Heroic.")
    d.add_button("Rester ici", Gtk.ResponseType.CANCEL)
    d.add_button("Utiliser mon navigateur", Gtk.ResponseType.OK)
    d.set_default_response(Gtk.ResponseType.OK)
    reponse = d.run()
    d.destroy()
    while Gtk.events_pending():
        Gtk.main_iteration()
    if reponse != Gtk.ResponseType.OK:
        dire("navigateur refuse, connexion dans Heroic")
        return 0
    subprocess.run(["xdotool", "windowclose", xid], capture_output=True)
    return main_connexion()


def main_connexion():
    if not heroic_installe():
        prevenir("Heroic n'est pas installé", "Installe-le depuis GrenLaunch › Plateformes.")
        return 1
    ouvrir_page()
    dire("page de connexion ouverte dans le navigateur principal")
    fenetre()
    return 0


def main():
    if len(sys.argv) > 2 and sys.argv[1] == "--proposer" and sys.argv[2].isdigit():
        return proposer(sys.argv[2])
    if "--guetter" in sys.argv:
        guetter()
        return 0
    return main_connexion()


if __name__ == "__main__":
    sys.exit(main())
