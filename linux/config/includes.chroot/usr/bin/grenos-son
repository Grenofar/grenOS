#!/usr/bin/env python3
"""Le son, en un clic : le volume, la sortie, et chaque application.

Un panneau qui s'ouvre au-dessus de la barre, en bas à gauche, et se referme
dès qu'on clique ailleurs. Trois choses, dans cet ordre d'usage :

  - le volume de la machine, et le silence d'un clic ;
  - par où le son sort — les enceintes, un casque, l'écran par HDMI ;
  - le volume de chaque application qui joue. C'est le mélangeur : baisser
    toute la machine parce qu'une seule application crie est une mauvaise
    réponse à un vrai problème.

Il se relit tout seul toutes les deux secondes : brancher un casque ou lancer
une vidéo change la liste sans qu'on ait à rouvrir le panneau.
"""
import sys

sys.path.insert(0, "/usr/lib/grenos")

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

import grenosui  # noqa: E402
import son as module_son  # noqa: E402

LARGEUR = 380
HAUTEUR_BARRE = 52

STYLE = """
#panneau-son {
    background-color: @fond;
    border: 1px solid @bord-clair;
    border-radius: 14px;
}
.bloc-son { padding: 14px 16px; }
.separateur-son { background-color: @bord; min-height: 1px; }
.nom-app { font-size: 13px; }
"""


RAYON = 14


def region_arrondie(largeur, hauteur, rayon):
    """Un rectangle aux coins arrondis, decoupe ligne par ligne.

    X11 tourne ici **sans composition** : c'est ce qui rend la souris fluide
    sans carte 3D, et c'est un choix qu'on ne revient pas dessus. Mais sans
    composition il n'y a pas de transparence : un `border-radius` ne fait que
    *ne pas peindre* les coins, et ce qui apparait dessous est le noir de la
    fenetre. Grenofar l'a vu du premier coup d'oeil : « les bords sont noirs
    dans l'overlay ».

    La seule facon d'avoir de vrais coins arrondis sans composition est de
    retirer les coins **de la fenetre elle-meme**. C'est ce que fait un masque
    de forme : les pixels hors de la region n'appartiennent plus a la fenetre,
    et c'est le bureau qu'on voit a travers, pas du noir.
    """
    region = cairo.Region()
    for y in range(hauteur):
        if y < rayon:
            ecart = rayon - 1 - y
        elif y >= hauteur - rayon:
            ecart = y - (hauteur - rayon)
        else:
            ecart = 0
        creux = rayon - int((rayon * rayon - ecart * ecart) ** 0.5) if ecart else 0
        region.union(cairo.RectangleInt(creux, y, max(1, largeur - 2 * creux), 1))
    return region


class PanneauSon(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("panneau-son")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_keep_above(True)
        self.set_size_request(LARGEUR, -1)
        self.attrape = None
        self.en_train = False

        colonne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(colonne)

        # ---- Le volume de la machine ---------------------------------------
        haut = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        haut.get_style_context().add_class("bloc-son")

        titre = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.image = Gtk.Image()
        titre.pack_start(self.image, False, False, 0)
        self.valeur = Gtk.Label(label="", xalign=0)
        self.valeur.get_style_context().add_class("entree-titre")
        titre.pack_start(self.valeur, True, True, 0)
        self.bouton_muet = grenosui.bouton("Couper", self.basculer_muet, "discret")
        titre.pack_end(self.bouton_muet, False, False, 0)
        haut.pack_start(titre, False, False, 0)

        self.curseur = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.curseur.set_draw_value(False)
        self.curseur.connect("value-changed", self.changer_volume)
        haut.pack_start(self.curseur, False, False, 0)
        colonne.pack_start(haut, False, False, 0)

        colonne.pack_start(self.trait(), False, False, 0)

        # ---- La sortie -----------------------------------------------------
        milieu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        milieu.get_style_context().add_class("bloc-son")
        etiquette = Gtk.Label(label="SORTIE", xalign=0)
        etiquette.get_style_context().add_class("section")
        milieu.pack_start(etiquette, False, False, 0)
        self.choix = Gtk.ComboBoxText()
        self.choix.connect("changed", self.changer_sortie)
        # La liste deroulante est une fenetre a part : elle prend le focus en
        # s'ouvrant. Sans ce drapeau, le panneau se fermerait au moment precis
        # ou l'on va choisir sa sortie audio — c'est-a-dire au pire moment.
        self.deroule = False
        self.choix.connect("notify::popup-shown", self.suivre_deroule)
        milieu.pack_start(self.choix, False, False, 0)
        colonne.pack_start(milieu, False, False, 0)

        colonne.pack_start(self.trait(), False, False, 0)

        # ---- Le mélangeur --------------------------------------------------
        self.bas = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.bas.get_style_context().add_class("bloc-son")
        etiquette = Gtk.Label(label="APPLICATIONS", xalign=0)
        etiquette.get_style_context().add_class("section")
        self.bas.pack_start(etiquette, False, False, 0)
        self.liste = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.bas.pack_start(self.liste, False, False, 0)
        colonne.pack_start(self.bas, False, False, 0)

        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self.clic)
        self.connect("key-press-event", self.touche)

        self.sorties = []
        self.relire()
        GLib.timeout_add_seconds(2, self.relire)

    def trait(self):
        ligne = Gtk.Box()
        ligne.get_style_context().add_class("separateur-son")
        return ligne

    # ---- Lire l'état ------------------------------------------------------
    def relire(self):
        """Relit le son sans écraser ce que la personne est en train de régler."""
        if self.en_train:
            return True

        volume = module_son.volume()
        muet = module_son.muet()
        self.curseur.set_value(volume)
        self.valeur.set_text("Silence" if muet else f"Volume {volume} %")
        nom_image = ("grenos-son-muet" if muet
                     else ("grenos-son-faible" if volume < 45 else "grenos-son"))
        self.image.set_from_icon_name(nom_image, Gtk.IconSize.LARGE_TOOLBAR)
        self.bouton_muet.get_child().get_children()[-1].set_text(
            "Rétablir" if muet else "Couper")

        nouvelles = module_son.sorties()
        if [n for n, _ in nouvelles] != [n for n, _ in self.sorties]:
            self.sorties = nouvelles
            courante = module_son.sortie_actuelle()
            self.choix.remove_all()
            for index, (nom, description) in enumerate(nouvelles):
                self.choix.append_text(description)
                if nom == courante:
                    self.choix.set_active(index)
            if nouvelles and self.choix.get_active() < 0:
                self.choix.set_active(0)

        self.poser_applications()
        return True

    def poser_applications(self):
        qui_jouent = module_son.applications_qui_jouent()
        for enfant in self.liste.get_children():
            self.liste.remove(enfant)
        if not qui_jouent:
            vide = Gtk.Label(label="Rien ne joue en ce moment.", xalign=0)
            vide.get_style_context().add_class("sous")
            self.liste.pack_start(vide, False, False, 0)
        for application in qui_jouent:
            ligne = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            nom = Gtk.Label(label=application["nom"], xalign=0)
            nom.get_style_context().add_class("nom-app")
            ligne.pack_start(nom, False, False, 0)
            curseur = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
            curseur.set_draw_value(False)
            curseur.set_value(application["volume"])
            curseur.connect("button-press-event", self.commencer)
            curseur.connect("button-release-event", self.finir)
            curseur.connect("value-changed",
                            lambda c, i=application["index"]:
                            module_son.regler_application(i, c.get_value()))
            ligne.pack_start(curseur, False, False, 0)
            self.liste.pack_start(ligne, False, False, 0)
        self.liste.show_all()

    # ---- Agir -------------------------------------------------------------
    def commencer(self, *_):
        self.en_train = True
        return False

    def finir(self, *_):
        self.en_train = False
        return False

    def changer_volume(self, curseur):
        module_son.regler_volume(curseur.get_value())

    def basculer_muet(self):
        module_son.basculer_muet()
        self.relire()

    def changer_sortie(self, combo):
        index = combo.get_active()
        if 0 <= index < len(self.sorties):
            module_son.choisir_sortie(self.sorties[index][0])

    # ---- S'ouvrir et se refermer ------------------------------------------
    def touche(self, _widget, evenement):
        if Gdk.keyval_name(evenement.keyval) == "Escape":
            self.partir()
            return True
        return False

    def clic(self, _widget, evenement):
        largeur, hauteur = self.get_size()
        if not (0 <= evenement.x < largeur and 0 <= evenement.y < hauteur):
            self.partir()
            return True
        return False

    def suivre_deroule(self, widget, _parametre):
        self.deroule = widget.get_property("popup-shown")
        return False

    def sortir_du_focus(self, *_):
        """Deuxieme filet : le panneau part des qu'il n'est plus la fenetre active.

        L'attrape du pointeur suffit *quand elle reussit*. Elle echoue quand une
        autre fenetre tient deja le pointeur — un menu ouvert, une fenetre en
        cours de deplacement —, et alors le panneau restait la, par-dessus
        tout, jusqu'a ce qu'on le retrouve pour le fermer. Perdre le focus est
        un signal que rien ne peut nous refuser.

        Sauf pendant qu'une liste deroulante est ouverte : elle est elle-meme
        une fenetre, et le focus lui revient. Fermer a ce moment-la, ce serait
        fermer le panneau au moment ou l'on va choisir sa sortie audio.
        """
        if self.deroule:
            return False
        self.partir()
        return False

    def decouper(self, *_):
        """Redonne au masque de forme la taille reelle de la fenetre.

        A faire a chaque changement de taille : le melangeur grandit quand une
        application se met a jouer, et un masque calcule pour l'ancienne
        hauteur couperait le bas du panneau.
        """
        cadre = self.get_window()
        if cadre is None:
            return
        largeur, hauteur = self.get_size()
        if (largeur, hauteur) == getattr(self, "decoupe", None):
            return
        self.decoupe = (largeur, hauteur)
        cadre.shape_combine_region(region_arrondie(largeur, hauteur, RAYON), 0, 0)

    def ouvrir(self):
        ecran = Gdk.Screen.get_default()
        self.show_all()
        _, hauteur = self.get_size()
        # En bas à gauche, juste au-dessus de la barre : là où se trouve
        # l'icône qui l'ouvre.
        self.move(10, ecran.get_height() - HAUTEUR_BARRE - hauteur - 8)
        self.present()

        self.decoupe = None
        self.decouper()
        self.connect("size-allocate", self.decouper)
        self.connect("focus-out-event", self.sortir_du_focus)

        # L'attrape ne peut pas se demander dans la foulée de `present()` : X
        # affiche la fenêtre de façon asynchrone et refuse le pointeur à une
        # fenêtre qu'il n'a pas encore mise à l'écran. Elle réessaie donc
        # jusqu'à ce que la fenêtre soit affichable.
        self.pris = False
        self.attrape = grenosui.Attrape(self, self.dire_attrape)
        self.connect("destroy", self.partir)

    def dire_attrape(self, pris):
        """Le port série dit si l'attrape a pris. C'est ce qui manquait."""
        self.pris = pris
        grenosui.dire("son : le pointeur est %s"
                      % ("attrape" if pris else "refuse, on compte sur le focus"))

    def partir(self, *_):
        """Le seul chemin de sortie, et il dit toujours qu'il part.

        Il y en avait quatre — Échap, le clic à côté, la perte du focus, la
        destruction de la fenêtre — et trois appelaient `Gtk.main_quit()` tout
        droit. Or `main_quit()` ne détruit pas la fenêtre : il sort de la
        boucle, le programme se termine, et `destroy` n'arrive jamais. La
        phrase « son ferme » vivait dans ce `destroy`.

        Résultat : le panneau se fermait bien au clic — la capture de la
        construction `36112644255` le montre, il n'est plus là — mais il ne le
        disait pas, et la CI concluait qu'il ne s'était pas fermé. **Le défaut
        était dans la preuve, pas dans le bureau.**
        """
        if getattr(self, "parti", False):
            return
        self.parti = True
        grenosui.dire("son ferme")
        if self.attrape is not None:
            self.attrape.lacher()
            self.attrape = None
        Gtk.main_quit()


def main():
    grenosui.habiller()
    grenosui.ajouter_style(STYLE)
    panneau = PanneauSon()
    panneau.ouvrir()
    # Le son est le seul reproche qu'il ait fait et qu'on n'ait pas encore pu
    # prouver autrement qu'en comptant les sorties. Dire le volume et l'etat
    # muet montre qu'on sait *lire* l'etat du melangeur, pas seulement lister
    # des peripheriques — c'est ce que fait le panneau quand on l'ouvre.
    grenosui.dire("son ouvert, %d sorties, volume %d%%, %s, panneau %dx%d"
                  % (len(module_son.sorties()), module_son.volume(),
                     "muet" if module_son.muet() else "actif",
                     *panneau.get_size()))
    Gtk.main()


if __name__ == "__main__":
    main()
