#!/bin/sh
# Jour ou nuit, pour tout le système d'un coup.
#
# Le choix tient dans un fichier d'une ligne. Nos fenêtres le lisent à
# l'ouverture, la barre le relit quand on la prévient, et les applications GTK
# du système suivent par leur propre réglage. Sans argument, on bascule — c'est
# ce que fait Meta+T.
#
#   grenos-theme [jour|nuit]

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/grenos"
mkdir -p "$CONFIG"

ACTUEL=nuit
[ -r "$CONFIG/theme" ] && ACTUEL=$(cat "$CONFIG/theme")

case "${1:-}" in
    jour|nuit) VOULU="$1" ;;
    "")        [ "$ACTUEL" = nuit ] && VOULU=jour || VOULU=nuit ;;
    *)         echo "usage: grenos-theme [jour|nuit]" >&2 ; exit 2 ;;
esac

echo "$VOULU" > "$CONFIG/theme"

# Les applications GTK du système : le même basculement, par leur réglage à
# elles. Sans cela, l'explorateur resterait sombre sur un bureau clair.
mkdir -p "$CONFIG/../gtk-3.0"
if [ "$VOULU" = jour ]; then
    SOMBRE=false
else
    SOMBRE=true
fi
SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
mkdir -p "$(dirname "$SETTINGS")"
cat > "$SETTINGS" <<EOF
[Settings]
gtk-theme-name=Adwaita
gtk-icon-theme-name=Adwaita
gtk-font-name=Inter 10
gtk-application-prefer-dark-theme=$SOMBRE
gtk-cursor-theme-name=Adwaita
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
EOF

# Le fond, puis la barre : elle se relance avec la nouvelle palette.
grenos-fond
pkill -USR1 -f "grenos-shell" 2>/dev/null || true
