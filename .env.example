# Copier en .env.local et remplir. NE JAMAIS committer .env.local.
# Le repo est public : une clé poussée ici est compromise en quelques minutes.

# --- Supabase ---
# supabase.com -> New project -> Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role : worker et secrets CI UNIQUEMENT. Jamais dans le front.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modèles ---
# aistudio.google.com/apikey — gratuit, sans CB.
# Flash uniquement : Pro n'est plus dans le tier gratuit depuis avril 2026.
GEMINI_API_KEY=

# console.mistral.ai — gratuit ("Experiment"), le plus gros volume de la liste.
# Exige vérification par téléphone + opt-in entraînement sur tes données.
# 500K TPM, 1 req/s, tous les modèles dont Codestral et Mistral Large.
MISTRAL_API_KEY=

# cloud.cerebras.ai — gratuit, optionnel. Très rapide, 1M tokens/jour,
# MAIS contexte plafonné à 8192 tokens. Testeur et micro-tâches uniquement.
CEREBRAS_API_KEY=

# platform.minimax.io — PAYANT (crédits d'essai à l'inscription).
# Laisser vide = la cascade reste 100 % gratuite. Rempli = utilisé en dernier
# recours, sous le plafond de dépense MINIMAX_BUDGET_USD.
MINIMAX_API_KEY=
MINIMAX_BUDGET_USD=5

# --- GitHub ---
# PAT fine-grained, scope : contents:write + actions:read sur Grenofar/grenOS
GITHUB_TOKEN=

# --- Front (Vercel) : seules ces deux variables atteignent le navigateur ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
