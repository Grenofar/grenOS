# =============================================================================
#  grenOS — .env.example  (modèle : copier en .env.local)
#  cp .env.example .env.local  puis remplis la droite du "=".
#  Il est déjà couvert par .gitignore (motif .env.*) — vérifié.
#
#  [OBLIGATOIRE] = rien ne démarre sans
#  [OPTIONNEL]   = laisse vide, le système fonctionne quand même
# =============================================================================


# -----------------------------------------------------------------------------
#  SUPABASE  [OBLIGATOIRE]  —  base, file de tâches, Realtime, auth
# -----------------------------------------------------------------------------
#  1. https://supabase.com  ->  New project  (région : Europe West de préférence)
#  2. Note bien le mot de passe Postgres, il n'est affiché qu'une fois.
#  3. Project Settings -> API  ->  copie les 3 valeurs ci-dessous.
#
#  Ressemble à : https://abcdefghijklm.supabase.co
SUPABASE_URL=

#  "anon public" — sans danger côté navigateur, protégée par RLS. Long JWT.
SUPABASE_ANON_KEY=

#  "service_role secret" — CONTOURNE TOUTES LES RÈGLES RLS.
#  Uniquement dans ce fichier et dans les secrets GitHub Actions.
#  Jamais dans le front, jamais dans un commit, jamais dans un log.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
#  GOOGLE GEMINI  [OBLIGATOIRE]  —  LE SEUL PROVIDER (D-015)
# -----------------------------------------------------------------------------
#  https://aistudio.google.com/apikey  ->  Create API key
#  Gratuit, sans carte bancaire.
#  Flash seulement : Pro a quitté le tier gratuit en avril 2026.
#
#  Une seule clé suffit pour les 3 modèles utilisés :
#      gemini-3.8-flash / gemini-3.7-flash / gemini-3.6-flash
#  Les quotas sont comptés PAR MODELE : ~1500 req/jour chacun,
#  donc ~4500 req/jour au total. Le routeur repartit la charge
#  entre les trois pour multiplier ton budget.
#
#  Commence par "AIza..."
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
#  AUTRES PROVIDERS  —  écartés pour l'instant (D-015). Ne remplis rien ici.
# -----------------------------------------------------------------------------
#  Mistral : écarté, l'opt-in à l'entraînement sur tes données n'a pas été retenu.
#  Cerebras : écarté, contexte plafonné à 8192 tokens.
#  MiniMax : pas de tier gratuit.
#
#  Tout le catalogue vit dans packages/router/src/models.ts. En rajouter un
#  plus tard = un adaptateur + quelques lignes. Aucun prompt d'agent ne nomme
#  un modèle, donc changer de provider ne touche jamais aux prompts.
#
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# MINIMAX_API_KEY=


# -----------------------------------------------------------------------------
#  GITHUB  [OBLIGATOIRE]  —  les agents poussent leurs branches, la CI teste
# -----------------------------------------------------------------------------
#  https://github.com/settings/personal-access-tokens/new
#  Type      : Fine-grained token
#  Repository: Grenofar/grenOS  (celui-là uniquement, pas "all repositories")
#  Expiration: 90 jours
#  Permissions -> Repository permissions :
#      Contents        = Read and write   (pousser les branches agent/*)
#      Actions         = Read             (lire le résultat des runs)
#      Pull requests   = Read and write   (optionnel, pour les PR d'agents)
#  Commence par "github_pat_..."
GITHUB_TOKEN=

#  Ne change que si tu renommes ou transfères le repo.
GITHUB_REPO=Grenofar/grenOS


# -----------------------------------------------------------------------------
#  FRONT VERCEL  —  seules ces 2 variables atteignent le navigateur
# -----------------------------------------------------------------------------
#  Recopie exactement les mêmes valeurs que SUPABASE_URL et SUPABASE_ANON_KEY.
#  Ne mets JAMAIS une autre clé derrière un préfixe NEXT_PUBLIC_ : tout ce qui
#  porte ce préfixe finit en clair dans le JavaScript envoyé au visiteur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

#  La liste des personnes autorisées N'EST PAS ici : elle vit dans la table
#  `operators`, parce que seule la base peut l'appliquer (RLS). Une variable
#  d'environnement ne protégerait rien.
#
#  Pour autoriser quelqu'un, dans le SQL Editor de Supabase :
#      insert into operators (email, label) values ('x@exemple.com', 'Nom')
#      on conflict (email) do nothing;
#  Pour retirer :
#      delete from operators where email = 'x@exemple.com';


# -----------------------------------------------------------------------------
#  RÉGLAGES DU WORKER  —  pas des secrets, valeurs par défaut correctes
# -----------------------------------------------------------------------------
#  Tâches simultanées. 3 est un bon compromis : au-delà les limites de débit
#  des providers créent de la file d'attente, pas de la vitesse.
MAX_CONCURRENT_TASKS=3

#  Le budget d'une mission se fixe à sa création, dans le formulaire du site.
#  Le nombre de tentatives par tâche vient du frontmatter de chaque agent
#  (agents/**/*.md) : un codeur a droit à 3 essais, un relecteur à 2.
#  Rien à régler ici — ces valeurs ont une seule source de vérité chacune.

#  Coupe-circuit global. true = les agents s'arrêtent, le site reste consultable.
#  Le bouton "kill switch" de l'UI écrit dans Supabase, pas ici — ceci est le
#  cran de sûreté manuel si le worker devient incontrôlable.
AGENTS_PAUSED=false

#  debug | info | warn  — "info" en régime normal.
LOG_LEVEL=info
