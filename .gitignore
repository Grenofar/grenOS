# Les paquets que la CI depose pour que l image les installe elle-meme.
linux/config/packages.chroot/

# Le site public vit dans son PROPRE depot (Grenofar/grenos-web-download),
# clone ici par commodite. Il ne doit jamais partir dans celui-ci.
grenos web download/

# grenos-ui : le binaire est compile par la CI et depose dans l arborescence
# de l image juste avant la construction ; le schema est regenere par Tauri.
linux/config/includes.chroot/usr/bin/grenos-ui
linux/config/includes.chroot/usr/bin/grenos-coins
linux/ui/gen/
linux/config/includes.chroot/usr/lib/grenos/grenos-shell-natif
linux/config/includes.chroot/usr/lib/grenos/grenos-bureau-natif
linux/config/includes.chroot/etc/grenos/date-construction

# Les schémas générés par tauri-build à chaque compilation du créateur.
createur/gen/
